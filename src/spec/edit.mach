# edits applied to a file's current text: exact replacements, line ranges, and vim commands
#
# every edit names what it expects to find. a find that matches nothing or more
# than it should is refused with the lines involved, and a line range outside
# the file is refused with the file's length, so a stale edit never lands in
# the wrong place. find_re matches the qark regex dialect and expands \0..\9
# captures in the replacement. an edit's "within" limits where it looks — a
# [first, last] line range, a string, or {find|find_re:..., occurrence:N} —
# and "occurrence" picks one hit by number, negative from the end.

use std.collections.vector;
use std.data.json;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_len;

use A: std.allocator;
use eng: qark.core.engine;
use jw: qark.rpc.jw;
use re: qark.core.regex;
use scan: qark.gen.scan;
use util: qark.util;

# matches a single edit may gather before it is refused as too broad
val MAX_HITS: usize = 32768;

# why an edit was refused
# ---
# code:  static code such as edit_not_found
# msg:   message owned by the edit allocator
# index: which edit in the list, 0-based
# line:  1-based line the message is about, 0 when none
pub rec Err {
    code:     str;
    msg:      str;
    index:    i64;
    line:     i64;
    col:      i64;
    cat:      str;
    scope_lo: i64;
    scope_hi: i64;
    actual:   str;
}

rec Text {
    name:   str;
    p:      *u8;
    n:      usize;
    crlf:   bool;
    normed: bool;
    mixed:  bool;
}

fun fail(e: *Err, code: str, msg: str, line: i64) bool {
    e.code = code;
    e.msg = msg;
    e.line = line;
    ret false;
}

fun decode_lenient(raw: *u8, raw_n: usize, out: *u8) usize {
    var i: usize = 0;
    var o: usize = 0;
    for (i < raw_n) {
        if (raw[i] == '\\' && i + 1 < raw_n) {
            val nx: u8 = raw[i + 1];
            if (nx == '"') { out[o] = '"'; o = o + 1; i = i + 2; cnt; }
            if (nx == '\\') { out[o] = '\\'; o = o + 1; i = i + 2; cnt; }
            if (nx == '/') { out[o] = '/'; o = o + 1; i = i + 2; cnt; }
            if (nx == 'n') { out[o] = '\n'; o = o + 1; i = i + 2; cnt; }
            if (nx == 'r') { out[o] = '\r'; o = o + 1; i = i + 2; cnt; }
            if (nx == 't') { out[o] = '\t'; o = o + 1; i = i + 2; cnt; }
            out[o] = '\\';
            out[o + 1] = nx;
            o = o + 2;
            i = i + 2;
            cnt;
        }
        out[o] = raw[i];
        o = o + 1;
        i = i + 1;
    }
    out[o] = 0;
    ret o;
}

fun get_str(a: *A.Allocator, obj: *json.Value, key: str, out: **u8, n: *usize) i64 {
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (!sel f.some) { ret 0; }
    if (!json.value_is_string(f.some)) { ret -1; }
    var raw_n: usize = 0;
    val raw: *u8 = json.value_string(f.some, ?raw_n);
    val got: res[*u8, A.Error] = A.allocate[u8](a, raw_n + 1);
    if (sel got.err) { ret -2; }
    val dec: res[usize, json.JsonError] = json.value_string_decode(f.some, got.ok, raw_n + 1);
    if (sel dec.err) {
        val len: usize = decode_lenient(raw, raw_n, got.ok);
        @out = got.ok;
        @n = len;
        ret 1;
    }
    if (dec.ok > raw_n) { ret -1; }
    got.ok[dec.ok] = 0;
    @out = got.ok;
    @n = dec.ok;
    ret 1;
}

fun get_int(obj: *json.Value, key: str, out: *i64) i64 {
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (!sel f.some) { ret 0; }
    if (!json.value_is_number(f.some) || json.value_is_float(f.some)) { ret -1; }
    @out = json.value_number(f.some);
    ret 1;
}

fun get_bool(obj: *json.Value, key: str) bool {
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (!sel f.some) { ret false; }
    if (!json.value_is_bool(f.some)) { ret false; }
    ret json.value_bool(f.some);
}

fun eol(t: *Text) str {
    if (t.crlf) { ret "\r\n"; }
    ret "\n";
}

# s with its line endings conformed to the file's: a lone \n becomes \r\n on a
# crlf file and \r\n becomes \n on an lf one; changed is false when nothing did
fun norm_text(a: *A.Allocator, t: *Text, s: *u8, sn: usize, out: **u8, on: *usize, changed: *bool) bool {
    if (t.mixed) {
        @changed = false;
        @out = s;
        @on = sn;
        ret true;
    }
    var w: jw.Jw = jw.init(a);
    var ch: bool = false;
    var i: usize = 0;
    for (i < sn) {
        if (t.crlf && s[i] == '\n' && (i == 0 || s[i - 1] != '\r')) {
            jw.raw(?w, "\r\n");
            ch = true;
            i = i + 1;
        }
        or (!t.crlf && s[i] == '\r' && i + 1 < sn && s[i + 1] == '\n') {
            jw.byte(?w, '\n');
            ch = true;
            i = i + 2;
        }
        or {
            jw.byte(?w, s[i]);
            i = i + 1;
        }
    }
    @changed = ch;
    if (!ch) {
        @out = s;
        @on = sn;
        ret true;
    }
    if (w.failed || w.buf == nil) { ret false; }
    @out = w.buf;
    @on = w.len;
    ret true;
}

fun matches_at(p: *u8, n: usize, at: usize, q: *u8, qn: usize) bool {
    if (at + qn > n) { ret false; }
    var i: usize = 0;
    for (i < qn) {
        if (p[at + i] != q[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun line_of(p: *u8, at: usize) i64 {
    var line: i64 = 1;
    var i: usize = 0;
    for (i < at) {
        if (p[i] == '\n') { line = line + 1; }
        i = i + 1;
    }
    ret line;
}

fun count_lines(t: *Text) usize {
    if (t.n == 0) { ret 0; }
    var lines: usize = 0;
    var i: usize = 0;
    for (i < t.n) {
        if (t.p[i] == '\n') { lines = lines + 1; }
        i = i + 1;
    }
    if (t.p[t.n - 1] != '\n') { lines = lines + 1; }
    ret lines;
}

# byte offset where 1-based line k starts; lines past the end start at n
fun line_start(t: *Text, k: usize) usize {
    if (k <= 1) { ret 0; }
    var line: usize = 1;
    var i: usize = 0;
    for (i < t.n) {
        if (t.p[i] == '\n') {
            line = line + 1;
            if (line == k) { ret i + 1; }
        }
        i = i + 1;
    }
    ret t.n;
}

fun splice(a: *A.Allocator, t: *Text, from: usize, to: usize, ins: *u8, insn: usize) bool {
    var w: jw.Jw = jw.init(a);
    jw.bytes(?w, t.p, from);
    jw.bytes(?w, ins, insn);
    jw.bytes(?w, (t.p::usize + to)::*u8, t.n - to);
    if (w.failed) { ret false; }
    if (w.buf == nil) {
        val empty: res[str, A.Error] = util.dup(a, "");
        if (sel empty.err) { ret false; }
        t.p = empty.ok;
        t.n = 0;
        ret true;
    }
    t.p = w.buf;
    t.n = w.len;
    ret true;
}

fun with_lines_key(a: *A.Allocator, t: *Text, obj: *json.Value, key: str, out: **u8, n: *usize) bool {
    var w: jw.Jw = jw.init(a);
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (!sel f.some) { ret false; }
    if (sel f.some) {
        if (json.value_is_array(f.some)) {
            var i: usize = 0;
            for (i < json.value_count(f.some)) {
                val g: opt[*json.Value] = json.value_get(f.some, i);
                if (sel g.some) {
                    if (!json.value_is_string(g.some)) { ret false; }
                    var raw_n: usize = 0;
                    json.value_string(g.some, ?raw_n);
                    val got: res[*u8, A.Error] = A.allocate[u8](a, raw_n + 1);
                    if (sel got.err) { ret false; }
                    val dec: res[usize, json.JsonError] = json.value_string_decode(g.some, got.ok, raw_n + 1);
                    if (sel dec.err) { ret false; }
                    jw.bytes(?w, got.ok, dec.ok);
                    jw.raw(?w, eol(t));
                }
                i = i + 1;
            }
        }
        or (json.value_is_string(f.some)) {
            var p: *u8 = nil;
            var pn: usize = 0;
            if (get_str(a, obj, key, ?p, ?pn) != 1) { ret false; }
            var p2: *u8 = nil;
            var p2n: usize = 0;
            var ch: bool = false;
            if (!norm_text(a, t, p, pn, ?p2, ?p2n, ?ch)) { ret false; }
            if (ch) { p = p2; pn = p2n; t.normed = true; }
            jw.bytes(?w, p, pn);
            if (pn > 0 && p[pn - 1] != '\n') { jw.raw(?w, eol(t)); }
        }
        or { ret false; }
    }
    if (w.failed) { ret false; }
    @out = w.buf;
    @n = w.len;
    ret true;
}

# the replacement lines for a range edit, each ending in the file's line ending
fun with_lines(a: *A.Allocator, t: *Text, obj: *json.Value, out: **u8, n: *usize) bool {
    if (with_lines_key(a, t, obj, "with", out, n)) { ret true; }
    ret with_lines_key(a, t, obj, "replace", out, n);
}

fun is_hspace(c: u8) bool {
    ret c == ' ' || c == '\t';
}

# copy src with runs of spaces and tabs folded to one space; returns the folded length
fun fold_space(src: *u8, n: usize, out: *u8, cap: usize) usize {
    var i: usize = 0;
    var o: usize = 0;
    var gap: bool = false;
    for (i < n && o + 1 < cap) {
        if (is_hspace(src[i])) { gap = o > 0; }
        or {
            if (gap && o + 1 < cap) {
                out[o] = ' ';
                o = o + 1;
                gap = false;
            }
            if (o + 1 < cap) {
                out[o] = src[i];
                o = o + 1;
            }
        }
        i = i + 1;
    }
    if (o < cap) { out[o] = 0; }
    ret o;
}

fun contains_at(hay: *u8, hn: usize, needle: *u8, nn: usize) bool {
    if (nn == 0 || nn > hn) { ret false; }
    var i: usize = 0;
    for (i + nn <= hn) {
        if (matches_at(hay, hn, i, needle, nn)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the 1-based line whose text matches the find's first line once extra spaces are ignored
fun near_space(file: *u8, n: usize, first: *u8, fn_: usize) i64 {
    var needle: [256]u8;
    val nn: usize = fold_space(first, fn_, ?needle[0], 256);
    if (nn == 0) { ret 0; }
    var line: i64 = 1;
    var start: usize = 0;
    var i: usize = 0;
    for (i <= n) {
        if (i == n || file[i] == '\n') {
            var end: usize = i;
            if (end > start && file[end - 1] == '\r') { end = end - 1; }
            var folded: [512]u8;
            val hn: usize = fold_space((file::usize + start)::*u8, end - start, ?folded[0], 512);
            if (contains_at(?folded[0], hn, ?needle[0], nn)) { ret line; }
            line = line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# every span the needle covers in t.p[lo,hi): (start,end) pairs into out.
# a regex needle searches the slice, so a match never strays past hi.
# 1 collected, 0 none, -1 bad pattern, -2 over MAX_HITS
fun collect(a: *A.Allocator, t: *Text, lo: usize, hi: usize, q: *u8, qn: usize, is_re: bool, out: *vector.Vector[usize]) i64 {
    var hits: i64 = 0;
    if (is_re) {
        val prog: res[re.Prog, A.Error] = re.compile(a, q, qn);
        if (sel prog.err) { ret -1; }
        var at: i64 = 0;
        for (at <= (hi - lo)::i64) {
            val m: re.Match = re.find(?prog.ok, (t.p::usize + lo)::*u8, (hi - lo)::i64, at);
            if (!m.ok) { brk; }
            vector.push[usize](out, lo + m.start::usize);
            vector.push[usize](out, lo + m.end::usize);
            hits = hits + 1;
            if (hits >= MAX_HITS::i64) { ret -2; }
            if (m.end <= at) { at = at + 1; }
            or { at = m.end; }
        }
        ret 1;
    }
    var at: usize = lo;
    for (at + qn <= hi) {
        if (matches_at(t.p, hi, at, q, qn)) {
            vector.push[usize](out, at);
            vector.push[usize](out, at + qn);
            hits = hits + 1;
            if (hits >= MAX_HITS::i64) { ret -2; }
            at = at + qn;
        }
        or { at = at + 1; }
    }
    ret 1;
}

# the line sharing the longest common prefix with the needle's first line and
# the column where it first differs; false when nothing is close
fun near_miss(t: *Text, q: *u8, qn: usize, line: *i64, col: *i64) bool {
    var fn_: usize = 0;
    for (fn_ < qn && q[fn_] != '\n' && q[fn_] != '\r') { fn_ = fn_ + 1; }
    if (fn_ < 4) { ret false; }
    var best: i64 = 0;
    var bc: usize = 0;
    var l: i64 = 1;
    var start: usize = 0;
    var i: usize = 0;
    for (i <= t.n) {
        if (i == t.n || t.p[i] == '\n') {
            var end: usize = i;
            if (end > start && t.p[end - 1] == '\r') { end = end - 1; }
            var cap: usize = end - start;
            if (cap > fn_) { cap = fn_; }
            if (cap > 512) { cap = 512; }
            var c: usize = 0;
            for (c < cap && t.p[start + c] == q[c]) { c = c + 1; }
            if (c > bc) {
                bc = c;
                best = l;
            }
            l = l + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if (best == 0 || bc * 2 < fn_) { ret false; }
    @line = best;
    @col = (bc + 1)::i64;
    ret true;
}

# report a not-found or ambiguous needle with the hit lines involved
fun hit_err(a: *A.Allocator, t: *Text, hits: *vector.Vector[usize], what: str, q: *u8, qn: usize, e: *Err) bool {
    val n: usize = hits.len / 2;
    if (n == 0) {
        var ml: i64 = 0;
        var mc: i64 = 0;
        var w: jw.Jw = jw.init(a);
        jw.raw(?w, what);
        if (q != nil && near_miss(t, q, qn, ?ml, ?mc)) {
            e.cat = "near_miss";
            e.col = mc;
            jw.raw(?w, " text not found; the closest line is the reported line, and they differ at column ");
            var num: [24]u8;
            val k: usize = util.fmt_i64(?num[0], 24, mc);
            jw.bytes(?w, ?num[0], k);
        }
        or {
            if (e.cat == nil) { e.cat = "not_found"; }
            jw.raw(?w, " text not found; read the file again and copy the text exactly");
        }
        if (w.failed || w.buf == nil) { ret fail(e, "edit_not_found", "text not found", 0); }
        ret fail(e, "edit_not_found", w.buf, ml);
    }
    e.cat = "ambiguous_match";
    var w: jw.Jw = jw.init(a);
    jw.raw(?w, what);
    jw.raw(?w, " text matches ");
    var num: [24]u8;
    val k: usize = util.fmt_i64(?num[0], 24, n::i64);
    jw.bytes(?w, ?num[0], k);
    jw.raw(?w, " times (lines");
    var i: usize = 0;
    for (i < n && i < 5) {
        jw.raw(?w, " ");
        val m: usize = util.fmt_i64(?num[0], 24, line_of(t.p, hits.data[i * 2]));
        jw.bytes(?w, ?num[0], m);
        i = i + 1;
    }
    jw.raw(?w, "); include surrounding lines to make it unique, set occurrence, set count, or set all to true");
    if (w.failed || w.buf == nil) { ret fail(e, "edit_ambiguous", "text matches more than once", line_of(t.p, hits.data[0])); }
    ret fail(e, "edit_ambiguous", w.buf, line_of(t.p, hits.data[0]));
}

fun resolve_symbol(a: *A.Allocator, t: *Text, sym_p: *u8, sym_n: usize, lo: *i64, hi: *i64, e: *Err) bool {
    val lang: str = scan.outline_lang(t.name);
    if (lang == nil) {
        ret fail(e, "edit_bad", "symbol edits require a supported language file (.py, .mach, .js, .ts, .ps1, .sh, .toml, .rs, .go)", 0);
    }
    val sr: i64 = scan.find_symbol(a, lang, t.p, t.n, sym_p, sym_n, lo, hi);
    if (sr == 1) {
        e.scope_lo = @lo;
        e.scope_hi = @hi;
        ret true;
    }
    if (sr == 2) {
        e.cat = "symbol_ambiguous";
        var w: jw.Jw = jw.init(a);
        jw.raw(?w, "symbol '");
        jw.bytes(?w, sym_p, sym_n);
        jw.raw(?w, "' appears more than once; qualify it as Parent.name or use a line range");
        if (w.failed || w.buf == nil) { ret fail(e, "edit_ambiguous", "symbol appears more than once", 0); }
        ret fail(e, "edit_ambiguous", w.buf, 0);
    }
    e.cat = "symbol_not_found";
    var w: jw.Jw = jw.init(a);
    jw.raw(?w, "symbol '");
    jw.bytes(?w, sym_p, sym_n);
    jw.raw(?w, "' not found; symbols in this file: ");
    jw.raw(?w, scan.list_symbol_names(a, lang, t.p, t.n));
    if (w.failed || w.buf == nil) { ret fail(e, "edit_not_found", "symbol not found", 0); }
    ret fail(e, "edit_not_found", w.buf, 0);
}

# the byte span an edit's "within" (or top-level "symbol") limits it to; the whole file when absent.
# a within is [first, last] lines, a string, {symbol:"..."}, or {find|find_re, occurrence}
fun scope(a: *A.Allocator, t: *Text, obj: *json.Value, sa: *usize, sb: *usize, e: *Err) bool {
    @sa = 0;
    @sb = t.n;
    val f: opt[*json.Value] = json.value_find(obj, "within");
    if (!sel f.some) {
        val top_sym: opt[*json.Value] = json.value_find(obj, "symbol");
        if (!sel top_sym.some) { ret true; }
        var sp: *u8 = nil;
        var spn: usize = 0;
        if (get_str(a, obj, "symbol", ?sp, ?spn) != 1 || spn == 0) {
            ret fail(e, "edit_bad", "symbol must be a non-empty string", 0);
        }
        var slo: i64 = 0;
        var shi: i64 = 0;
        if (!resolve_symbol(a, t, sp, spn, ?slo, ?shi, e)) { ret false; }
        @sa = line_start(t, slo::usize);
        @sb = line_start(t, (shi + 1)::usize);
        e.scope_lo = slo;
        e.scope_hi = shi;
        ret true;
    }
    if (json.value_is_array(f.some)) {
        if (json.value_count(f.some) != 2) {
            ret fail(e, "edit_bad", "within as a list must be [first, last], both 1-based and inclusive", 0);
        }
        var lo: i64 = 0;
        var hi: i64 = 0;
        val g0: opt[*json.Value] = json.value_get(f.some, 0);
        val g1: opt[*json.Value] = json.value_get(f.some, 1);
        if (sel g0.some) {
            if (json.value_is_number(g0.some)) { lo = json.value_number(g0.some); }
        }
        if (sel g1.some) {
            if (json.value_is_number(g1.some)) { hi = json.value_number(g1.some); }
        }
        val total: i64 = count_lines(t)::i64;
        if (lo < 1 || hi < lo || hi > total) {
            e.cat = "range_out_of_bounds";
            e.scope_lo = 1;
            e.scope_hi = total;
            ret fail(e, "edit_range", "within lines are outside the file", 0);
        }
        @sa = line_start(t, lo::usize);
        @sb = line_start(t, (hi + 1)::usize);
        e.scope_lo = lo;
        e.scope_hi = hi;
        ret true;
    }
    var wp: *u8 = nil;
    var wpn: usize = 0;
    var wre: bool = false;
    var wocc: i64 = 0;
    if (json.value_is_string(f.some)) {
        if (get_str(a, obj, "within", ?wp, ?wpn) != 1 || wpn == 0) {
            ret fail(e, "edit_bad", "within must be a non-empty string, {find|find_re|symbol:...}, or [first, last]", 0);
        }
    }
    or (json.value_is_object(f.some)) {
        val wsym: opt[*json.Value] = json.value_find(f.some, "symbol");
        if (sel wsym.some) {
            if (get_str(a, f.some, "symbol", ?wp, ?wpn) != 1 || wpn == 0) {
                ret fail(e, "edit_bad", "within symbol must be a non-empty string", 0);
            }
            var slo: i64 = 0;
            var shi: i64 = 0;
            if (!resolve_symbol(a, t, wp, wpn, ?slo, ?shi, e)) { ret false; }
            @sa = line_start(t, slo::usize);
            @sb = line_start(t, (shi + 1)::usize);
            e.scope_lo = slo;
            e.scope_hi = shi;
            ret true;
        }
        val wf: opt[*json.Value] = json.value_find(f.some, "find");
        val wr: opt[*json.Value] = json.value_find(f.some, "find_re");
        if (sel wf.some) {
            if (get_str(a, f.some, "find", ?wp, ?wpn) != 1 || wpn == 0) {
                ret fail(e, "edit_bad", "within find must be a non-empty string", 0);
            }
        }
        or (sel wr.some) {
            if (get_str(a, f.some, "find_re", ?wp, ?wpn) != 1 || wpn == 0) {
                ret fail(e, "edit_bad", "within find_re must be a non-empty string", 0);
            }
            wre = true;
        }
        or { ret fail(e, "edit_bad", "within needs find, find_re, or symbol", 0); }
        if (get_int(f.some, "occurrence", ?wocc) == -1) {
            ret fail(e, "edit_bad", "occurrence must be an integer", 0);
        }
    }
    or { ret fail(e, "edit_bad", "within must be a string, {find|find_re|symbol:...}, or [first, last]", 0); }
    if (!wre) {
        var w2: *u8 = nil;
        var w2n: usize = 0;
        var nrm: bool = false;
        if (!norm_text(a, t, wp, wpn, ?w2, ?w2n, ?nrm)) { ret fail(e, "oom", "out of memory", 0); }
        if (nrm) { wp = w2; wpn = w2n; t.normed = true; }
    }
    var hits: vector.Vector[usize] = vector.init[usize](a);
    val r: i64 = collect(a, t, 0, t.n, wp, wpn, wre, ?hits);
    if (r == -1) { ret fail(e, "edit_bad", "within pattern failed to compile", 0); }
    if (r == -2) { ret fail(e, "edit_too_many", "within matches too many times; narrow it", 0); }
    if (wocc == 0 && hits.len / 2 != 1) { ret hit_err(a, t, ?hits, "within", wp, wpn, e); }
    if (hits.len == 0) { ret hit_err(a, t, ?hits, "within", wp, wpn, e); }
    var ms: usize = 0;
    var me: usize = 0;
    if (wocc != 0) {
        var at: i64 = wocc - 1;
        if (wocc < 0) { at = (hits.len / 2)::i64 + wocc; }
        if (at < 0 || at >= (hits.len / 2)::i64) {
            ret fail(e, "edit_not_found", "within occurrence is outside the matches", line_of(t.p, hits.data[0]));
        }
        ms = hits.data[at::usize * 2];
        me = hits.data[at::usize * 2 + 1];
    }
    or {
        ms = hits.data[0];
        me = hits.data[1];
    }
    @sa = ms;
    @sb = me;
    e.scope_lo = line_of(t.p, ms);
    var end_off: usize = me;
    if (end_off > ms && end_off > 0 && t.p[end_off - 1] == '\n') { end_off = end_off - 1; }
    e.scope_hi = line_of(t.p, end_off);
    ret true;
}

fun find_edit(a: *A.Allocator, t: *Text, obj: *json.Value, e: *Err) bool {
    var sa: usize = 0;
    var sb: usize = 0;
    if (!scope(a, t, obj, ?sa, ?sb, e)) { ret false; }
    var q: *u8 = nil;
    var qn: usize = 0;
    if (get_str(a, obj, "find", ?q, ?qn) != 1 || qn == 0) { ret fail(e, "edit_bad", "find must be a non-empty string", 0); }
    var q2: *u8 = nil;
    var q2n: usize = 0;
    var nrm: bool = false;
    if (!norm_text(a, t, q, qn, ?q2, ?q2n, ?nrm)) { ret fail(e, "oom", "out of memory", 0); }
    if (nrm) { q = q2; qn = q2n; t.normed = true; }
    var rp: *u8 = nil;
    var rn: usize = 0;
    var rs: i64 = get_str(a, obj, "replace", ?rp, ?rn);
    if (rs == 0) { rs = get_str(a, obj, "with", ?rp, ?rn); }
    if (rs == -1) { ret fail(e, "edit_bad", "replace must be a string", 0); }
    if (rs == 0) { rp = ""; }
    var rp2: *u8 = nil;
    var rn2: usize = 0;
    var rch: bool = false;
    if (!norm_text(a, t, rp, rn, ?rp2, ?rn2, ?rch)) { ret fail(e, "oom", "out of memory", 0); }
    if (rch) { rp = rp2; rn = rn2; t.normed = true; }
    val all: bool = get_bool(obj, "all");
    var want: i64 = 1;
    if (get_int(obj, "count", ?want) == -1 || want < 1) { ret fail(e, "edit_bad", "count must be a positive integer", 0); }
    var occ: i64 = 0;
    if (get_int(obj, "occurrence", ?occ) == -1) { ret fail(e, "edit_bad", "occurrence must be an integer", 0); }
    var hits: vector.Vector[usize] = vector.init[usize](a);
    val rc: i64 = collect(a, t, sa, sb, q, qn, false, ?hits);
    if (rc == -2) { ret fail(e, "edit_too_many", "find text matches too many times; scope it with within", 0); }
    val n: usize = hits.len / 2;
    if (n == 0) {
        if (sa > 0 || sb < t.n) {
            var full_hits: vector.Vector[usize] = vector.init[usize](a);
            if (collect(a, t, 0, t.n, q, qn, false, ?full_hits) == 1 && full_hits.len >= 2) {
                e.cat = "not_in_scope";
                ret fail(e, "edit_not_found", "find text not found inside the active scope, though it appears outside the scope at the reported line", line_of(t.p, full_hits.data[0]));
            }
        }
        var first: usize = 0;
        for (first < qn && q[first] != '\n') { first = first + 1; }
        var s: usize = 0;
        for (s < first && (q[s] == ' ' || q[s] == '\t')) { s = s + 1; }
        var near: i64 = 0;
        if (first > s) {
            var k: usize = 0;
            for (k + (first - s) <= t.n && near == 0) {
                if (matches_at(t.p, t.n, k, (q::usize + s)::*u8, first - s)) { near = line_of(t.p, k); }
                k = k + 1;
            }
        }
        if (near > 0) {
            e.cat = "near_miss";
            ret fail(e, "edit_not_found", "find text not found; its first line appears at the reported line, so check indentation, whitespace, and the lines after it", near);
        }
        val spaced: i64 = near_space(t.p, t.n, q, first);
        if (spaced > 0) {
            e.cat = "whitespace_mismatch";
            ret fail(e, "edit_not_found", "find text not found; the reported line matches once extra spaces are removed", spaced);
        }
        var ml: i64 = 0;
        var mc: i64 = 0;
        if (near_miss(t, q, qn, ?ml, ?mc)) {
            e.cat = "near_miss";
            e.col = mc;
            var w3: jw.Jw = jw.init(a);
            jw.raw(?w3, "find text not found; the closest line is the reported line, and they differ at column ");
            var num: [24]u8;
            val mk: usize = util.fmt_i64(?num[0], 24, mc);
            jw.bytes(?w3, ?num[0], mk);
            if (w3.failed || w3.buf == nil) { ret fail(e, "edit_not_found", "text not found", 0); }
            ret fail(e, "edit_not_found", w3.buf, ml);
        }
        e.cat = "not_found";
        ret fail(e, "edit_not_found", "find text not found in the file; read the file again and copy the text exactly", 0);
    }
    if (occ != 0) {
        var at: i64 = occ - 1;
        if (occ < 0) { at = n::i64 + occ; }
        if (at < 0 || at >= n::i64) {
            e.cat = "range_out_of_bounds";
            ret fail(e, "edit_not_found", "occurrence is outside the matches", line_of(t.p, hits.data[0]));
        }
        if (!splice(a, t, hits.data[at::usize * 2], hits.data[at::usize * 2 + 1], rp, rn)) {
            ret fail(e, "oom", "out of memory", 0);
        }
        ret true;
    }
    if (!all && n != want::usize) {
        ret hit_err(a, t, ?hits, "find", q, qn, e);
    }
    var w: jw.Jw = jw.init(a);
    jw.bytes(?w, t.p, sa);
    var i: usize = sa;
    var run: usize = sa;
    for (i + qn <= sb) {
        if (matches_at(t.p, sb, i, q, qn)) {
            jw.bytes(?w, (t.p::usize + run)::*u8, i - run);
            jw.bytes(?w, rp, rn);
            i = i + qn;
            run = i;
        }
        or { i = i + 1; }
    }
    jw.bytes(?w, (t.p::usize + run)::*u8, t.n - run);
    if (w.failed) { ret fail(e, "oom", "out of memory", 0); }
    if (w.buf == nil) {
        t.p = "";
        t.n = 0;
    }
    or {
        t.p = w.buf;
        t.n = w.len;
    }
    ret true;
}

# write the replacement with \0..\9 expanded from the match's captures;
# \\ stays a backslash, any other \c keeps both bytes
fun expand_repl(w: *jw.Jw, p: *u8, r: *u8, rn: usize, m: *re.Match, base: usize) {
    var i: usize = 0;
    for (i < rn) {
        if (r[i] == '\\' && i + 1 < rn) {
            val c: u8 = r[i + 1];
            if (c >= '0' && c <= '9') {
                val gi: usize = (c - '0')::usize;
                if (m.cs[gi] >= 0 && m.ce[gi] >= m.cs[gi]) {
                    jw.bytes(w, (p::usize + base + m.cs[gi]::usize)::*u8, (m.ce[gi] - m.cs[gi])::usize);
                }
                i = i + 2;
                cnt;
            }
            if (c == '\\') {
                jw.byte(w, '\\');
                i = i + 2;
                cnt;
            }
        }
        jw.byte(w, r[i]);
        i = i + 1;
    }
}

# find_re: the qark regex dialect — . [] () | * + ? {} ^ $ \< \> \d \w \s —
# with captures \0..\9 in the replacement and all/count/occurrence/within
fun re_edit(a: *A.Allocator, t: *Text, obj: *json.Value, e: *Err) bool {
    var sa: usize = 0;
    var sb: usize = 0;
    if (!scope(a, t, obj, ?sa, ?sb, e)) { ret false; }
    var q: *u8 = nil;
    var qn: usize = 0;
    if (get_str(a, obj, "find_re", ?q, ?qn) != 1 || qn == 0) { ret fail(e, "edit_bad", "find_re must be a non-empty string", 0); }
    var rp: *u8 = nil;
    var rn: usize = 0;
    var rs: i64 = get_str(a, obj, "replace", ?rp, ?rn);
    if (rs == 0) { rs = get_str(a, obj, "with", ?rp, ?rn); }
    if (rs == -1) { ret fail(e, "edit_bad", "replace must be a string", 0); }
    if (rs == 0) { rp = ""; }
    var rp2: *u8 = nil;
    var rn2: usize = 0;
    var rch: bool = false;
    if (!norm_text(a, t, rp, rn, ?rp2, ?rn2, ?rch)) { ret fail(e, "oom", "out of memory", 0); }
    if (rch) { rp = rp2; rn = rn2; t.normed = true; }
    val all: bool = get_bool(obj, "all");
    var want: i64 = 1;
    if (get_int(obj, "count", ?want) == -1 || want < 1) { ret fail(e, "edit_bad", "count must be a positive integer", 0); }
    var occ: i64 = 0;
    if (get_int(obj, "occurrence", ?occ) == -1) { ret fail(e, "edit_bad", "occurrence must be an integer", 0); }
    val prog: res[re.Prog, A.Error] = re.compile(a, q, qn);
    if (sel prog.err) { ret fail(e, "edit_bad", "find_re pattern failed to compile", 0); }
    var progv: re.Prog = prog.ok;
    var hits: vector.Vector[re.Match] = vector.init[re.Match](a);
    var spans: vector.Vector[usize] = vector.init[usize](a);
    var at: i64 = 0;
    for (at <= (sb - sa)::i64) {
        val m: re.Match = re.find(?progv, (t.p::usize + sa)::*u8, (sb - sa)::i64, at);
        if (!m.ok) { brk; }
        vector.push[re.Match](?hits, m);
        vector.push[usize](?spans, sa + m.start::usize);
        vector.push[usize](?spans, sa + m.end::usize);
        if (hits.len >= MAX_HITS) {
            re.dnit(?progv);
            ret fail(e, "edit_too_many", "find_re matches too many times; narrow it or scope it with within", 0);
        }
        if (m.end <= at) { at = at + 1; }
        or { at = m.end; }
    }
    val n: usize = hits.len;
    if (n == 0) {
        re.dnit(?progv);
        if (t.crlf) {
            e.cat = "crlf_mismatch";
            ret fail(e, "edit_not_found", "find_re pattern matched nothing; the file uses CRLF line endings, so a newline in the pattern needs \\r\\n", 0);
        }
        e.cat = "not_found";
        ret fail(e, "edit_not_found", "find_re pattern matched nothing; check the dialect or read the file again", 0);
    }
    var occ_at: i64 = -1;
    if (occ != 0) {
        occ_at = occ - 1;
        if (occ < 0) { occ_at = n::i64 + occ; }
        if (occ_at < 0 || occ_at >= n::i64) {
            re.dnit(?progv);
            e.cat = "range_out_of_bounds";
            ret fail(e, "edit_not_found", "occurrence is outside the matches", line_of(t.p, spans.data[0]));
        }
    }
    or (!all && n != want::usize) {
        re.dnit(?progv);
        ret hit_err(a, t, ?spans, "find_re", nil, 0, e);
    }
    var w: jw.Jw = jw.init(a);
    jw.bytes(?w, t.p, sa);
    var run: usize = sa;
    var i: usize = 0;
    for (i < n) {
        if (occ_at < 0 || i::i64 == occ_at) {
            val m: re.Match = hits.data[i];
            val ms: usize = sa + m.start::usize;
            jw.bytes(?w, (t.p::usize + run)::*u8, ms - run);
            expand_repl(?w, t.p, rp, rn, ?hits.data[i], sa);
            run = sa + m.end::usize;
        }
        i = i + 1;
    }
    jw.bytes(?w, (t.p::usize + run)::*u8, t.n - run);
    re.dnit(?progv);
    if (w.failed) { ret fail(e, "oom", "out of memory", 0); }
    if (w.buf == nil) {
        t.p = "";
        t.n = 0;
    }
    or {
        t.p = w.buf;
        t.n = w.len;
    }
    ret true;
}

fun range_edit(a: *A.Allocator, t: *Text, obj: *json.Value, e: *Err) bool {
    val f: opt[*json.Value] = json.value_find(obj, "lines");
    if (!sel f.some) { ret fail(e, "edit_bad", "lines must be [first, last]", 0); }
    if (!json.value_is_array(f.some) || json.value_count(f.some) != 2) { ret fail(e, "edit_bad", "lines must be [first, last], both 1-based and inclusive", 0); }
    var lo: i64 = 0;
    var hi: i64 = 0;
    val g0: opt[*json.Value] = json.value_get(f.some, 0);
    val g1: opt[*json.Value] = json.value_get(f.some, 1);
    if (sel g0.some) {
        if (json.value_is_number(g0.some)) { lo = json.value_number(g0.some); }
    }
    if (sel g1.some) {
        if (json.value_is_number(g1.some)) { hi = json.value_number(g1.some); }
    }
    val total: i64 = count_lines(t)::i64;
    if (lo < 1 || hi < lo || hi > total) {
        e.cat = "range_out_of_bounds";
        e.scope_lo = 1;
        e.scope_hi = total;
        var w: jw.Jw = jw.init(a);
        jw.raw(?w, "lines is outside the file, which has ");
        var num: [24]u8;
        val k: usize = util.fmt_i64(?num[0], 24, total);
        jw.bytes(?w, ?num[0], k);
        jw.raw(?w, " lines");
        if (w.buf == nil) { ret fail(e, "edit_range", "lines is outside the file", 0); }
        ret fail(e, "edit_range", w.buf, 0);
    }
    var ins: *u8 = nil;
    var insn: usize = 0;
    if (!with_lines(a, t, obj, ?ins, ?insn)) { ret fail(e, "edit_bad", "a lines edit needs a with — a string or a list of strings", 0); }
    val from: usize = line_start(t, lo::usize);
    val to: usize = line_start(t, (hi + 1)::usize);
    if (to == t.n && t.n > 0 && t.p[t.n - 1] != '\n' && insn > 0) {
        var trim: usize = insn;
        if (trim > 0 && ins[trim - 1] == '\n') { trim = trim - 1; }
        if (trim > 0 && ins[trim - 1] == '\r') { trim = trim - 1; }
        insn = trim;
    }
    if (!splice(a, t, from, to, ins, insn)) { ret fail(e, "oom", "out of memory", 0); }
    ret true;
}

# the 1-based line an insert anchor names: the line containing the match,
# or the one after its last line when the insert goes after
fun anchor_line(a: *A.Allocator, t: *Text, obj: *json.Value, key: str, after: bool, e: *Err) i64 {
    var sa: usize = 0;
    var sb: usize = 0;
    if (!scope(a, t, obj, ?sa, ?sb, e)) { ret -1; }
    var wp: *u8 = nil;
    var wpn: usize = 0;
    var wre: bool = false;
    var wocc: i64 = 0;
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (!sel f.some) {
        fail(e, "edit_bad", "insert_before and insert_after take a 1-based line number or an anchor", 0);
        ret -1;
    }
    if (json.value_is_string(f.some)) {
        if (get_str(a, obj, key, ?wp, ?wpn) != 1 || wpn == 0) {
            fail(e, "edit_bad", "insert anchors take a non-empty string, {find|find_re:...}, or a line number", 0);
            ret -1;
        }
    }
    or (json.value_is_object(f.some)) {
        val asym: opt[*json.Value] = json.value_find(f.some, "symbol");
        if (sel asym.some) {
            if (get_str(a, f.some, "symbol", ?wp, ?wpn) != 1 || wpn == 0) {
                fail(e, "edit_bad", "insert anchor symbol must be a non-empty string", 0);
                ret -1;
            }
            var slo: i64 = 0;
            var shi: i64 = 0;
            if (!resolve_symbol(a, t, wp, wpn, ?slo, ?shi, e)) { ret -1; }
            if (!after) { ret slo; }
            ret shi + 1;
        }
        val wf: opt[*json.Value] = json.value_find(f.some, "find");
        val wr: opt[*json.Value] = json.value_find(f.some, "find_re");
        if (sel wf.some) {
            if (get_str(a, f.some, "find", ?wp, ?wpn) != 1 || wpn == 0) {
                fail(e, "edit_bad", "insert anchor find must be a non-empty string", 0);
                ret -1;
            }
        }
        or (sel wr.some) {
            if (get_str(a, f.some, "find_re", ?wp, ?wpn) != 1 || wpn == 0) {
                fail(e, "edit_bad", "insert anchor find_re must be a non-empty string", 0);
                ret -1;
            }
            wre = true;
        }
        or {
            fail(e, "edit_bad", "insert anchor needs find, find_re, or symbol", 0);
            ret -1;
        }
        if (get_int(f.some, "occurrence", ?wocc) == -1) {
            fail(e, "edit_bad", "occurrence must be an integer", 0);
            ret -1;
        }
    }
    or {
        fail(e, "edit_bad", "insert_before and insert_after take a 1-based line number or an anchor", 0);
        ret -1;
    }
    if (!wre) {
        var w2: *u8 = nil;
        var w2n: usize = 0;
        var nrm: bool = false;
        if (!norm_text(a, t, wp, wpn, ?w2, ?w2n, ?nrm)) { fail(e, "oom", "out of memory", 0); ret -1; }
        if (nrm) { wp = w2; wpn = w2n; t.normed = true; }
    }
    var hits: vector.Vector[usize] = vector.init[usize](a);
    val rc: i64 = collect(a, t, sa, sb, wp, wpn, wre, ?hits);
    if (rc == -1) {
        fail(e, "edit_bad", "insert anchor pattern failed to compile", 0);
        ret -1;
    }
    if (rc == -2) {
        fail(e, "edit_too_many", "insert anchor matches too many times; scope it with within", 0);
        ret -1;
    }
    val n: usize = hits.len / 2;
    if (n == 0) {
        hit_err(a, t, ?hits, "insert anchor", wp, wpn, e);
        ret -1;
    }
    var at: usize = 0;
    if (wocc != 0) {
        var pick: i64 = wocc - 1;
        if (wocc < 0) { pick = n::i64 + wocc; }
        if (pick < 0 || pick >= n::i64) {
            fail(e, "edit_not_found", "occurrence is outside the matches", line_of(t.p, hits.data[0]));
            ret -1;
        }
        at = pick::usize;
    }
    or (n != 1) {
        hit_err(a, t, ?hits, "insert anchor", wp, wpn, e);
        ret -1;
    }
    if (!after) { ret line_of(t.p, hits.data[at * 2]); }
    var last: usize = hits.data[at * 2 + 1];
    if (last > 0) { last = last - 1; }
    ret line_of(t.p, last) + 1;
}

fun insert_edit(a: *A.Allocator, t: *Text, obj: *json.Value, after: bool, e: *Err) bool {
    var key: str = "insert_before";
    if (after) { key = "insert_after"; }
    var at_line: i64 = 0;
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (sel f.some && json.value_is_number(f.some)) {
        var n: i64 = 0;
        if (get_int(obj, key, ?n) != 1) { ret fail(e, "edit_bad", "insert_before and insert_after take a 1-based line number", 0); }
        if (after) {
            if (n < 0) { ret fail(e, "edit_range", "insert position is outside the file", 0); }
            at_line = n + 1;
        }
        or { at_line = n; }
    }
    or {
        at_line = anchor_line(a, t, obj, key, after, e);
        if (at_line < 0) { ret false; }
    }
    val total: i64 = count_lines(t)::i64;
    if (at_line < 1 || at_line > total + 1) {
        ret fail(e, "edit_range", "insert position is outside the file", 0);
    }
    var ins: *u8 = nil;
    var insn: usize = 0;
    if (!with_lines(a, t, obj, ?ins, ?insn)) { ret fail(e, "edit_bad", "insert_before and insert_after need a with — a string or a list of strings", 0); }
    if (get_bool(obj, "auto_indent") && total >= 1 && insn > 0) {
        var ref_line: i64 = at_line;
        if (after && at_line > 1) { ref_line = at_line - 1; }
        if (ref_line > total) { ref_line = total; }
        if (ref_line < 1) { ref_line = 1; }
        val ref_off: usize = line_start(t, ref_line::usize);
        var ind_len: usize = 0;
        for (ref_off + ind_len < t.n && (t.p[ref_off + ind_len] == ' ' || t.p[ref_off + ind_len] == '\t')) {
            ind_len = ind_len + 1;
        }
        if (ind_len > 0) {
            var iw: jw.Jw = jw.init(a);
            var ii: usize = 0;
            var bol: bool = true;
            for (ii < insn) {
                val ch: u8 = ins[ii];
                if (bol && ch != '\n' && ch != '\r') {
                    jw.bytes(?iw, (t.p::usize + ref_off)::*u8, ind_len);
                    bol = false;
                }
                jw.byte(?iw, ch);
                if (ch == '\n') { bol = true; }
                ii = ii + 1;
            }
            if (!iw.failed && iw.buf != nil) {
                ins = iw.buf;
                insn = iw.len;
            }
        }
    }
    val at: usize = line_start(t, at_line::usize);
    if (at == t.n && t.n > 0 && t.p[t.n - 1] != '\n') {
        var w: jw.Jw = jw.init(a);
        jw.raw(?w, eol(t));
        jw.bytes(?w, ins, insn);
        if (w.failed) { ret fail(e, "oom", "out of memory", 0); }
        if (insn > 0) {
            var trim: usize = w.len;
            if (trim > 0 && w.buf[trim - 1] == '\n') { trim = trim - 1; }
            if (trim > 0 && w.buf[trim - 1] == '\r') { trim = trim - 1; }
            if (!splice(a, t, at, at, w.buf, trim)) { ret fail(e, "oom", "out of memory", 0); }
        }
        ret true;
    }
    if (!splice(a, t, at, at, ins, insn)) { ret fail(e, "oom", "out of memory", 0); }
    ret true;
}

fun indent_block_if_unindented(a: *A.Allocator, ins: *u8, insn: usize, spaces: i64, out_p: **u8, out_n: *usize) {
    @out_p = ins;
    @out_n = insn;
    if (spaces <= 0 || insn == 0) { ret; }
    if (ins[0] == ' ' || ins[0] == '\t') { ret; }
    var iw: jw.Jw = jw.init(a);
    var ii: usize = 0;
    var bol: bool = true;
    for (ii < insn) {
        val ch: u8 = ins[ii];
        if (bol && ch != '\n' && ch != '\r') {
            var s: i64 = 0;
            for (s < spaces) {
                jw.byte(?iw, ' ');
                s = s + 1;
            }
            bol = false;
        }
        jw.byte(?iw, ch);
        if (ch == '\n') { bol = true; }
        ii = ii + 1;
    }
    if (!iw.failed && iw.buf != nil) {
        @out_p = iw.buf;
        @out_n = iw.len;
    }
}

fun is_ident_byte(c: u8) bool {
    if (c >= 'a' && c <= 'z') { ret true; }
    if (c >= 'A' && c <= 'Z') { ret true; }
    if (c >= '0' && c <= '9') { ret true; }
    if (c == '_' || c == '$') { ret true; }
    ret false;
}

fun slice_trim_eq(a: *u8, a0: usize, a1: usize, b: *u8, b0: usize, b1: usize) bool {
    var s0: usize = a0;
    var s1: usize = a1;
    for (s0 < s1 && (a[s0] == ' ' || a[s0] == '\t' || a[s0] == '\r' || a[s0] == '\n')) { s0 = s0 + 1; }
    for (s1 > s0 && (a[s1 - 1] == ' ' || a[s1 - 1] == '\t' || a[s1 - 1] == '\r' || a[s1 - 1] == '\n')) { s1 = s1 - 1; }
    var t0: usize = b0;
    var t1: usize = b1;
    for (t0 < t1 && (b[t0] == ' ' || b[t0] == '\t' || b[t0] == '\r' || b[t0] == '\n')) { t0 = t0 + 1; }
    for (t1 > t0 && (b[t1 - 1] == ' ' || b[t1 - 1] == '\t' || b[t1 - 1] == '\r' || b[t1 - 1] == '\n')) { t1 = t1 - 1; }
    ret slice_eq(a, s0, s1, b, t0, t1);
}

fun is_regex_kw(p: *u8, k0: usize, k1: usize) bool {
    val len: usize = k1 - k0;
    if (len == 2) {
        if (p[k0] == 'i' && p[k0 + 1] == 'n') { ret true; }
        if (p[k0] == 'o' && p[k0 + 1] == 'f') { ret true; }
        if (p[k0] == 'd' && p[k0 + 1] == 'o') { ret true; }
    }
    if (len == 3 && p[k0] == 'n' && p[k0 + 1] == 'e' && p[k0 + 2] == 'w') { ret true; }
    if (len == 4) {
        if (p[k0] == 'c' && p[k0 + 1] == 'a' && p[k0 + 2] == 's' && p[k0 + 3] == 'e') { ret true; }
        if (p[k0] == 'v' && p[k0 + 1] == 'o' && p[k0 + 2] == 'i' && p[k0 + 3] == 'd') { ret true; }
        if (p[k0] == 'e' && p[k0 + 1] == 'l' && p[k0 + 2] == 's' && p[k0 + 3] == 'e') { ret true; }
    }
    if (len == 5) {
        if (p[k0] == 'y' && p[k0 + 1] == 'i' && p[k0 + 2] == 'e' && p[k0 + 3] == 'l' && p[k0 + 4] == 'd') { ret true; }
        if (p[k0] == 't' && p[k0 + 1] == 'h' && p[k0 + 2] == 'r' && p[k0 + 3] == 'o' && p[k0 + 4] == 'w') { ret true; }
        if (p[k0] == 'a' && p[k0 + 1] == 'w' && p[k0 + 2] == 'a' && p[k0 + 3] == 'i' && p[k0 + 4] == 't') { ret true; }
    }
    if (len == 6) {
        if (p[k0] == 'r' && p[k0 + 1] == 'e' && p[k0 + 2] == 't' && p[k0 + 3] == 'u' && p[k0 + 4] == 'r' && p[k0 + 5] == 'n') { ret true; }
        if (p[k0] == 't' && p[k0 + 1] == 'y' && p[k0 + 2] == 'p' && p[k0 + 3] == 'e' && p[k0 + 4] == 'o' && p[k0 + 5] == 'f') { ret true; }
        if (p[k0] == 'd' && p[k0 + 1] == 'e' && p[k0 + 2] == 'l' && p[k0 + 3] == 'e' && p[k0 + 4] == 't' && p[k0 + 5] == 'e') { ret true; }
    }
    ret false;
}

# Locate the signature/body separator ('{' for brace langs, ':' for python) on [s0, s1)
# and for single-line definitions locate the end of the body on that span.
fun find_sym_delim(p: *u8, s0: usize, s1: usize, is_py: bool, open_idx: *usize, close_idx: *usize) bool {
    var i: usize = s0;
    var pdepth: i64 = 0;
    var bdepth: i64 = 0;
    var found_open: bool = false;
    var in_str: u8 = 0;
    var last_sig: u8 = 0;
    var prev_kw0: usize = 0;
    var prev_kw1: usize = 0;
    for (i < s1) {
        val c: u8 = p[i];
        if (in_str != 0) {
            if (c == '\\' && i + 1 < s1) { i = i + 2; cnt; }
            if (c == in_str) { in_str = 0; last_sig = c; prev_kw0 = 0; prev_kw1 = 0; }
            i = i + 1;
            cnt;
        }
        if (c == '"' || c == '\'' || c == '`') {
            in_str = c;
            i = i + 1;
            cnt;
        }
        if (c == '/' && i + 1 < s1 && p[i + 1] == '/') {
            for (i < s1 && p[i] != '\n') { i = i + 1; }
            cnt;
        }
        if (c == '/' && i + 1 < s1 && p[i + 1] == '*') {
            i = i + 2;
            for (i + 1 < s1 && !(p[i] == '*' && p[i + 1] == '/')) { i = i + 1; }
            if (i + 1 < s1) { i = i + 2; }
            cnt;
        }
        if (is_py && c == '#') {
            for (i < s1 && p[i] != '\n') { i = i + 1; }
            cnt;
        }
        if (!is_py && c == '/') {
            if (last_sig == 0 || last_sig == '(' || last_sig == ',' || last_sig == '=' || last_sig == ':' || last_sig == '[' || last_sig == '!' || last_sig == '&' || last_sig == '|' || last_sig == '?' || last_sig == '{' || last_sig == '}' || last_sig == ';' || last_sig == '+' || last_sig == '-' || last_sig == '*' || last_sig == '%' || last_sig == '<' || last_sig == '>' || last_sig == '^' || last_sig == '~' || (last_sig == 'I' && is_regex_kw(p, prev_kw0, prev_kw1))) {
                i = i + 1;
                var in_cc: bool = false;
                for (i < s1 && p[i] != '\n') {
                    if (p[i] == '\\' && i + 1 < s1) { i = i + 2; cnt; }
                    if (p[i] == '[') { in_cc = true; }
                    or (p[i] == ']') { in_cc = false; }
                    or (p[i] == '/' && !in_cc) { i = i + 1; brk; }
                    i = i + 1;
                }
                last_sig = '/';
                prev_kw0 = 0;
                prev_kw1 = 0;
                cnt;
            }
        }
        if (is_ident_byte(c) && !(c >= '0' && c <= '9')) {
            val id0: usize = i;
            for (i < s1 && is_ident_byte(p[i])) { i = i + 1; }
            prev_kw0 = id0;
            prev_kw1 = i;
            last_sig = 'I';
            cnt;
        }
        if (!found_open) {
            if (c == '(' || c == '[') { pdepth = pdepth + 1; }
            or (c == ')' || c == ']') { if (pdepth > 0) { pdepth = pdepth - 1; } }
            or (is_py && c == ':' && pdepth == 0) {
                if (i + 1 < s1 && p[i + 1] == ':') { i = i + 2; cnt; }
                @open_idx = i;
                var le: usize = s1;
                for (le > i + 1 && (p[le - 1] == '\n' || p[le - 1] == '\r')) { le = le - 1; }
                @close_idx = le;
                ret true;
            }
            or (!is_py && c == '{' && pdepth == 0) {
                @open_idx = i;
                found_open = true;
                bdepth = 1;
            }
        }
        or {
            if (c == '{') { bdepth = bdepth + 1; }
            or (c == '}') {
                bdepth = bdepth - 1;
                if (bdepth == 0) {
                    @close_idx = i;
                    ret true;
                }
            }
        }
        if (c != ' ' && c != '\t' && c != '\r' && c != '\n') {
            last_sig = c;
            prev_kw0 = 0;
            prev_kw1 = 0;
        }
        i = i + 1;
    }
    if (found_open) {
        @close_idx = s1;
        ret true;
    }
    ret false;
}

fun is_decl_kw(p: *u8, k0: usize, k1: usize) bool {
    val len: usize = k1 - k0;
    if (len == 3) {
        if (p[k0] == 'l' && p[k0 + 1] == 'e' && p[k0 + 2] == 't') { ret true; }
        if (p[k0] == 'v' && p[k0 + 1] == 'a' && p[k0 + 2] == 'r') { ret true; }
        if (p[k0] == 'v' && p[k0 + 1] == 'a' && p[k0 + 2] == 'l') { ret true; }
    }
    if (len == 5 && p[k0] == 'c' && p[k0 + 1] == 'o' && p[k0 + 2] == 'n' && p[k0 + 3] == 's' && p[k0 + 4] == 't') {
        ret true;
    }
    ret false;
}

fun is_valid_ident_str(p: *u8, n: usize) bool {
    if (p == nil || n == 0) { ret false; }
    if (p[0] >= '0' && p[0] <= '9') { ret false; }
    if (!is_ident_byte(p[0])) { ret false; }
    var i: usize = 1;
    for (i < n) {
        if (!is_ident_byte(p[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# Check whether another symbol `os` shadows `name[0..name_n)` via its parameter list
# or (in Python) via local assignment inside its body.
fun symbol_shadows_name(t: *Text, lang: str, os: *scan.Sym, name: *u8, name_n: usize) bool {
    val sig0: usize = line_start(t, os.line::usize);
    val sig1: usize = line_start(t, (os.sig_end + 1)::usize);
    var i: usize = sig0;
    var pdepth: i64 = 0;
    var bdepth: i64 = 0;
    var in_default: bool = false;
    for (i < sig1) {
        val c: u8 = t.p[i];
        if (c == '"' || c == '\'' || c == '`') {
            val q: u8 = c;
            i = i + 1;
            for (i < sig1 && t.p[i] != q) {
                if (t.p[i] == '\\' && i + 1 < sig1) { i = i + 2; cnt; }
                i = i + 1;
            }
            if (i < sig1) { i = i + 1; }
            cnt;
        }
        if (c == '(') {
            if (pdepth == 0) { in_default = false; bdepth = 0; }
            pdepth = pdepth + 1;
            i = i + 1;
            cnt;
        }
        if (c == ')') {
            if (pdepth > 0) { pdepth = pdepth - 1; }
            if (pdepth == 0) { in_default = false; bdepth = 0; }
            i = i + 1;
            cnt;
        }
        if (pdepth == 1) {
            if (c == '{' || c == '[') { bdepth = bdepth + 1; i = i + 1; cnt; }
            if (c == '}' || c == ']') { if (bdepth > 0) { bdepth = bdepth - 1; } i = i + 1; cnt; }
            if (bdepth == 0 && (c == '=' || c == ':')) { in_default = true; i = i + 1; cnt; }
            if (bdepth == 0 && c == ',') { in_default = false; i = i + 1; cnt; }
        }
        if (pdepth > 0 && is_ident_byte(c) && !(c >= '0' && c <= '9')) {
            val id0: usize = i;
            for (i < sig1 && is_ident_byte(t.p[i])) { i = i + 1; }
            val id1: usize = i;
            if (pdepth == 1 && !in_default && id1 - id0 == name_n && slice_eq(t.p, id0, id1, name, 0, name_n)) {
                # Ignore TypeScript/Rust/Mach type annotations after ':'
                var prev: usize = id0;
                for (prev > sig0 && (t.p[prev - 1] == ' ' || t.p[prev - 1] == '\t')) { prev = prev - 1; }
                val is_type_annot: bool = prev > sig0 && t.p[prev - 1] == ':';
                if (!is_type_annot) { ret true; }
            }
            cnt;
        }
        i = i + 1;
    }
    if (util.eq(lang, "python")) {
        val body0: usize = sig1;
        val body1: usize = line_start(t, (os.end + 1)::usize);
        var bi: usize = body0;
        for (bi < body1) {
            var ls: usize = bi;
            var le: usize = bi;
            for (le < body1 && t.p[le] != '\n') { le = le + 1; }
            var k: usize = ls;
            for (k < le && (t.p[k] == ' ' || t.p[k] == '\t')) { k = k + 1; }
            if (k + name_n < le && slice_eq(t.p, k, k + name_n, name, 0, name_n) && !is_ident_byte(t.p[k + name_n])) {
                var a_i: usize = k + name_n;
                for (a_i < le && (t.p[a_i] == ' ' || t.p[a_i] == '\t')) { a_i = a_i + 1; }
                if (a_i < le && t.p[a_i] == '=' && (a_i + 1 >= le || t.p[a_i + 1] != '=')) {
                    ret true;
                }
            }
            bi = le + 1;
        }
    }
    ret false;
}

fun receiver_matches_method(t: *Text, sa: usize, id0: usize, sym: *scan.Sym, all_syms: *vector.Vector[scan.Sym]) bool {
    var k: usize = id0;
    for (k > sa && (t.p[k - 1] == ' ' || t.p[k - 1] == '\t')) { k = k - 1; }
    if (k > sa && (t.p[k - 1] == '.' || t.p[k - 1] == ':' || t.p[k - 1] == '>')) {
        k = k - 1;
        if (k > sa && (t.p[k - 1] == '?' || t.p[k - 1] == ':' || t.p[k - 1] == '-')) { k = k - 1; }
    }
    for (k > sa && (t.p[k - 1] == ' ' || t.p[k - 1] == '\t')) { k = k - 1; }
    val r1: usize = k;
    for (k > sa && is_ident_byte(t.p[k - 1])) { k = k - 1; }
    val r0: usize = k;
    val rlen: usize = r1 - r0;
    if (rlen == 0) { ret false; }
    val is_self_kw: bool = (rlen == 4 && slice_eq(t.p, r0, r1, "this", 0, 4)) ||
                           (rlen == 4 && slice_eq(t.p, r0, r1, "self", 0, 4)) ||
                           (rlen == 3 && slice_eq(t.p, r0, r1, "cls", 0, 3)) ||
                           (rlen == 5 && slice_eq(t.p, r0, r1, "super", 0, 5));
    if (is_self_kw) {
        if (sym.parent != nil && sym.parent_n > 0) {
            # Verify we are not inside a method belonging to a different parent class
            var si: usize = 0;
            for (si < all_syms.len) {
                val os: *scan.Sym = ?all_syms.data[si];
                if (os.parent != nil && os.parent_n > 0) {
                    val os0: usize = line_start(t, os.dec_start::usize);
                    val os1: usize = line_start(t, (os.end + 1)::usize);
                    if (id0 >= os0 && id0 < os1) {
                        if (os.parent_n != sym.parent_n || !slice_eq(os.parent, 0, os.parent_n, sym.parent, 0, sym.parent_n)) {
                            ret false;
                        }
                    }
                }
                si = si + 1;
            }
        }
        ret true;
    }
    if (sym.parent != nil && sym.parent_n > 0 && rlen == sym.parent_n && slice_eq(t.p, r0, r1, sym.parent, 0, sym.parent_n)) {
        ret true;
    }
    ret false;
}

fun is_arrow_param(p: *u8, sb: usize, id1: usize, out_block_arrow: *bool) bool {
    @out_block_arrow = false;
    var k: usize = id1;
    for (k < sb && (p[k] == ' ' || p[k] == '\t')) { k = k + 1; }
    if (k + 1 < sb && p[k] == '=' && p[k + 1] == '>') {
        var b: usize = k + 2;
        for (b < sb && (p[b] == ' ' || p[b] == '\t')) { b = b + 1; }
        if (b < sb && p[b] == '{') { @out_block_arrow = true; }
        ret true;
    }
    var pd: i64 = 1;
    for (k < sb && p[k] != '\n' && pd > 0) {
        if (p[k] == '(') { pd = pd + 1; }
        or (p[k] == ')') {
            pd = pd - 1;
            if (pd == 0) {
                var a: usize = k + 1;
                for (a < sb && (p[a] == ' ' || p[a] == '\t')) { a = a + 1; }
                if (a + 1 < sb && p[a] == '=' && p[a + 1] == '>') {
                    var b: usize = a + 2;
                    for (b < sb && (p[b] == ' ' || p[b] == '\t')) { b = b + 1; }
                    if (b < sb && p[b] == '{') { @out_block_arrow = true; }
                    ret true;
                }
                ret false;
            }
        }
        or (p[k] == ';') { ret false; }
        k = k + 1;
    }
    ret false;
}

# Collect code-token occurrences of sym.name in [sa, sb), skipping strings, comments,
# member accesses (.name), object literal keys ({ name: ... }), other symbols with the
# same name, and inner blocks that shadow sym.name with let/const/var/val.
fun collect_symbol_rename_hits(a: *A.Allocator, lang: str, t: *Text, sa: usize, sb: usize, sym: *scan.Sym, has_within: bool, hits: *vector.Vector[usize]) {
    val is_hash_lang: bool = util.eq(lang, "python") || util.eq(lang, "mach") || util.eq(lang, "ps1") || util.eq(lang, "sh") || util.eq(lang, "toml");
    var all_syms: vector.Vector[scan.Sym] = vector.init[scan.Sym](a);
    scan.collect_symbols(a, lang, t.p, t.n, ?all_syms);

    val sym_s0: usize = line_start(t, sym.dec_start::usize);
    val sym_s1: usize = line_start(t, (sym.end + 1)::usize);

    var shadow_depth: i64 = -1;
    var arrow_shadow_eol: bool = false;
    var bdepth: i64 = 0;
    var pdepth: i64 = 0;
    var last_sig: u8 = 0;
    var prev_kw0: usize = 0;
    var prev_kw1: usize = 0;
    var in_decl_lhs: bool = false;
    var decl_bdepth: i64 = 0;
    var decl_pdepth: i64 = 0;

    var i: usize = sa;
    for (i < sb) {
        val c: u8 = t.p[i];
        # Skip strings
        if (c == '"' || c == '\'') {
            val q: u8 = c;
            if (i + 2 < sb && t.p[i + 1] == q && t.p[i + 2] == q) {
                i = i + 3;
                for (i + 2 < sb && !(t.p[i] == q && t.p[i + 1] == q && t.p[i + 2] == q)) {
                    if (t.p[i] == '\\') { i = i + 1; }
                    i = i + 1;
                }
                if (i + 2 < sb) { i = i + 3; }
                or { i = sb; }
                last_sig = q;
                cnt;
            }
            i = i + 1;
            for (i < sb && t.p[i] != q && t.p[i] != '\n') {
                if (t.p[i] == '\\' && i + 1 < sb) { i = i + 2; cnt; }
                i = i + 1;
            }
            if (i < sb && t.p[i] == q) { i = i + 1; }
            last_sig = q;
            cnt;
        }
        if (c == '`') {
            i = i + 1;
            for (i < sb && t.p[i] != '`') {
                if (t.p[i] == '\\' && i + 1 < sb) { i = i + 2; cnt; }
                if (t.p[i] == '$' && i + 1 < sb && t.p[i + 1] == '{') {
                    # Recurse or scan inside template interpolation? Break out so tokens inside ${...} are scanned:
                    # Wait: simplest is to find matching '}' of ${...} and recursively collect hits on [i+2, close)!
                    var td: i64 = 1;
                    val expr_s: usize = i + 2;
                    i = i + 2;
                    for (i < sb && td > 0) {
                        if (t.p[i] == '\\' && i + 1 < sb) { i = i + 2; cnt; }
                        if (t.p[i] == '{') { td = td + 1; }
                        or (t.p[i] == '}') { td = td - 1; if (td == 0) { brk; } }
                        i = i + 1;
                    }
                    val expr_e: usize = i;
                    collect_symbol_rename_hits(a, lang, t, expr_s, expr_e, sym, has_within, hits);
                    if (i < sb && t.p[i] == '}') { i = i + 1; }
                    cnt;
                }
                i = i + 1;
            }
            if (i < sb && t.p[i] == '`') { i = i + 1; }
            last_sig = '`';
            cnt;
        }
        # Skip comments
        if (c == '/' && i + 1 < sb && t.p[i + 1] == '/') {
            for (i < sb && t.p[i] != '\n') { i = i + 1; }
            cnt;
        }
        if (c == '/' && i + 1 < sb && t.p[i + 1] == '*') {
            i = i + 2;
            for (i + 1 < sb && !(t.p[i] == '*' && t.p[i + 1] == '/')) { i = i + 1; }
            if (i + 1 < sb) { i = i + 2; }
            cnt;
        }
        if (is_hash_lang && c == '#') {
            for (i < sb && t.p[i] != '\n') { i = i + 1; }
            cnt;
        }
        # Skip JS regex literals
        if ((util.eq(lang, "node") || util.eq(lang, "js") || util.eq(lang, "ts")) && c == '/') {
            if (last_sig == 0 || last_sig == '(' || last_sig == ',' || last_sig == '=' || last_sig == ':' || last_sig == '[' || last_sig == '!' || last_sig == '&' || last_sig == '|' || last_sig == '?' || last_sig == '{' || last_sig == '}' || last_sig == ';' || last_sig == '+' || last_sig == '-' || last_sig == '*' || last_sig == '%' || last_sig == '<' || last_sig == '>' || last_sig == '^' || last_sig == '~' || (last_sig == 'I' && is_regex_kw(t.p, prev_kw0, prev_kw1))) {
                i = i + 1;
                var in_cc: bool = false;
                for (i < sb && t.p[i] != '\n') {
                    if (t.p[i] == '\\' && i + 1 < sb) { i = i + 2; cnt; }
                    if (t.p[i] == '[') { in_cc = true; }
                    or (t.p[i] == ']') { in_cc = false; }
                    or (t.p[i] == '/' && !in_cc) { i = i + 1; brk; }
                    i = i + 1;
                }
                last_sig = '/';
                prev_kw0 = 0;
                prev_kw1 = 0;
                cnt;
            }
        }
        if (c == '=' && (!in_decl_lhs || (bdepth == decl_bdepth && pdepth == decl_pdepth))) {
            in_decl_lhs = false;
        }
        if (c == ';' || (c == '\n' && pdepth == 0 && (!in_decl_lhs || bdepth == decl_bdepth))) {
            in_decl_lhs = false;
            arrow_shadow_eol = false;
        }
        if (c == '{') {
            bdepth = bdepth + 1;
            last_sig = c;
            prev_kw0 = 0; prev_kw1 = 0;
            i = i + 1;
            cnt;
        }
        if (c == '}') {
            if (shadow_depth >= 0 && bdepth == shadow_depth) {
                shadow_depth = -1;
            }
            if (bdepth > 0) { bdepth = bdepth - 1; }
            last_sig = c;
            prev_kw0 = 0; prev_kw1 = 0;
            i = i + 1;
            cnt;
        }
        if (c == '(' || c == '[') { pdepth = pdepth + 1; last_sig = c; prev_kw0 = 0; prev_kw1 = 0; i = i + 1; cnt; }
        if (c == ')' || c == ']') { if (pdepth > 0) { pdepth = pdepth - 1; } last_sig = c; prev_kw0 = 0; prev_kw1 = 0; i = i + 1; cnt; }

        if (is_ident_byte(c) && !(c >= '0' && c <= '9')) {
            val id0: usize = i;
            for (i < sb && is_ident_byte(t.p[i])) { i = i + 1; }
            val id1: usize = i;
            val id_len: usize = id1 - id0;
            if (is_decl_kw(t.p, id0, id1)) {
                in_decl_lhs = true;
                decl_bdepth = bdepth;
                decl_pdepth = pdepth;
            }
            if (id_len == sym.name_n && slice_eq(t.p, id0, id1, sym.name, 0, sym.name_n)) {
                var skip: bool = false;
                val is_member: bool = last_sig == '.' || last_sig == ':' || last_sig == '>';
                # 1. Check if inside a shadowed inner block (applies to bare identifiers, not member accesses like this.render())
                if (!is_member && ((shadow_depth >= 0 && bdepth >= shadow_depth) || arrow_shadow_eol)) {
                    skip = true;
                }
                # 2. Check if this is a new local variable declaration (let/const/var/val <name> or destructuring) or arrow parameter outside sym's own declaration line
                val sym_line_s: usize = line_start(t, sym.line::usize);
                val sym_line_e: usize = line_start(t, (sym.sig_end + 1)::usize);
                val on_sym_sig: bool = id0 >= sym_line_s && id0 < sym_line_e;
                if (!skip && !on_sym_sig && !is_member) {
                    var block_arrow: bool = false;
                    if (is_arrow_param(t.p, sb, id1, ?block_arrow)) {
                        if (block_arrow) { shadow_depth = bdepth + 1; }
                        or { arrow_shadow_eol = true; }
                        skip = true;
                    }
                    or ((is_decl_kw(t.p, prev_kw0, prev_kw1) && last_sig == 'I') || in_decl_lhs) {
                        if (bdepth > 0) { shadow_depth = bdepth; }
                        or { shadow_depth = 0; }
                        skip = true;
                    }
                }
                # 3. Check if preceded by member access (., ?., ::, ->)
                if (!skip && is_member) {
                    if (sym.parent == nil) {
                        skip = true;
                    }
                    or (!has_within && !receiver_matches_method(t, sa, id0, sym, ?all_syms)) {
                        skip = true;
                    }
                }
                # 4. Check if object literal property key ({ name: ... } or , name: ...) when not in destructuring LHS
                if (!skip && !in_decl_lhs && (last_sig == '{' || last_sig == ',') && pdepth == 0) {
                    var k: usize = id1;
                    for (k < sb && (t.p[k] == ' ' || t.p[k] == '\t')) { k = k + 1; }
                    if (k < sb && t.p[k] == ':' && !(k + 1 < sb && t.p[k + 1] == ':')) {
                        skip = true;
                    }
                }
                # 5. Check if inside another symbol with the same short name or one that shadows sym.name via parameters/locals
                if (!skip && !has_within) {
                    var si: usize = 0;
                    for (si < all_syms.len) {
                        val os: *scan.Sym = ?all_syms.data[si];
                        if (os.line != sym.line && (os.line > sym.line || !(id0 >= sym_s0 && id0 < sym_s1))) {
                            val os0: usize = line_start(t, os.dec_start::usize);
                            val os1: usize = line_start(t, (os.end + 1)::usize);
                            if (id0 >= os0 && id0 < os1) {
                                if (os.name_n == sym.name_n && slice_eq(os.name, 0, os.name_n, sym.name, 0, sym.name_n)) {
                                    skip = true;
                                    brk;
                                }
                                if (!is_member && symbol_shadows_name(t, lang, os, sym.name, sym.name_n)) {
                                    skip = true;
                                    brk;
                                }
                            }
                        }
                        si = si + 1;
                    }
                }
                if (!skip) {
                    vector.push[usize](hits, id0);
                    vector.push[usize](hits, id1);
                }
            }
            prev_kw0 = id0;
            prev_kw1 = id1;
            last_sig = 'I';
            cnt;
        }
        if (c != ' ' && c != '\t' && c != '\r' && c != '\n') {
            last_sig = c;
            prev_kw0 = 0;
            prev_kw1 = 0;
        }
        i = i + 1;
    }
}

fun symbol_edit(a: *A.Allocator, t: *Text, obj: *json.Value, e: *Err) bool {
    var sp: *u8 = nil;
    var spn: usize = 0;
    if (get_str(a, obj, "symbol", ?sp, ?spn) != 1 || spn == 0) {
        ret fail(e, "edit_bad", "symbol must be a non-empty string", 0);
    }
    val lang: str = scan.outline_lang(t.name);
    if (lang == nil) {
        ret fail(e, "edit_bad", "symbol edits require a supported language file (.py, .mach, .js, .ts, .ps1, .sh, .toml, .rs, .go)", 0);
    }
    var sym: scan.Sym;
    val sr: i64 = scan.find_symbol_ext(a, lang, t.p, t.n, sp, spn, ?sym);
    if (sr != 1) {
        var dlo: i64 = 0;
        var dhi: i64 = 0;
        resolve_symbol(a, t, sp, spn, ?dlo, ?dhi, e);
        ret false;
    }
    val is_py: bool = util.eq(lang, "python");
    val sig_s0: usize = line_start(t, sym.line::usize);
    val sig_s1: usize = line_start(t, (sym.sig_end + 1)::usize);
    val sym_end_s1: usize = line_start(t, (sym.end + 1)::usize);
    var delim_end: usize = sig_s1;
    if (!is_py) { delim_end = sym_end_s1; }
    var open_idx: usize = 0;
    var close_idx: usize = 0;
    val has_delim: bool = find_sym_delim(t.p, sig_s0, delim_end, is_py, ?open_idx, ?close_idx);

    # Optional precondition: "expect_signature"
    val exp_sig_f: opt[*json.Value] = json.value_find(obj, "expect_signature");
    if (sel exp_sig_f.some) {
        var esp: *u8 = nil;
        var espn: usize = 0;
        if (get_str(a, obj, "expect_signature", ?esp, ?espn) != 1 || espn == 0) {
            ret fail(e, "edit_bad", "expect_signature must be a non-empty string", sym.line);
        }
        var sig_match: bool = slice_trim_eq(t.p, sig_s0, sig_s1, esp, 0, espn);
        if (!sig_match && has_delim) {
            if (slice_trim_eq(t.p, sig_s0, open_idx, esp, 0, espn) || slice_trim_eq(t.p, sig_s0, open_idx + 1, esp, 0, espn)) {
                sig_match = true;
            }
        }
        if (!sig_match) {
            ret fail(e, "signature_mismatch", "symbol signature does not match expect_signature", sym.line);
        }
    }

    val ren_f: opt[*json.Value] = json.value_find(obj, "rename");
    val body_f: opt[*json.Value] = json.value_find(obj, "body");
    val sig_f: opt[*json.Value] = json.value_find(obj, "signature");
    val with_f: opt[*json.Value] = json.value_find(obj, "with");
    val rep_f: opt[*json.Value] = json.value_find(obj, "replace");
    var mode_count: usize = 0;
    if (sel ren_f.some) { mode_count = mode_count + 1; }
    if (sel body_f.some) { mode_count = mode_count + 1; }
    if (sel sig_f.some) { mode_count = mode_count + 1; }
    if (sel with_f.some) { mode_count = mode_count + 1; }
    if (sel rep_f.some) { mode_count = mode_count + 1; }
    if (mode_count > 1) {
        ret fail(e, "edit_bad", "symbol edit must specify only one of with, body, signature, or rename", sym.line);
    }

    # Mode 1: {"symbol": "name", "rename": "new_name"}
    if (sel ren_f.some) {
        var rnp: *u8 = nil;
        var rnn: usize = 0;
        if (get_str(a, obj, "rename", ?rnp, ?rnn) != 1 || rnn == 0 || !is_valid_ident_str(rnp, rnn)) {
            ret fail(e, "edit_bad", "symbol rename must be a valid non-empty identifier string", sym.line);
        }
        var sa: usize = 0;
        var sb: usize = t.n;
        val wf: opt[*json.Value] = json.value_find(obj, "within");
        val has_within: bool = sel wf.some;
        if (has_within) {
            if (!scope(a, t, obj, ?sa, ?sb, e)) { ret false; }
        }
        var hits: vector.Vector[usize] = vector.init[usize](a);
        collect_symbol_rename_hits(a, lang, t, sa, sb, ?sym, has_within, ?hits);
        if (hits.len == 0) {
            ret fail(e, "edit_not_found", "symbol identifier not found in scope", sym.line);
        }
        var w: jw.Jw = jw.init(a);
        var cur_off: usize = 0;
        var hi_i: usize = 0;
        val nhits: usize = hits.len / 2;
        for (hi_i < nhits) {
            val hs: usize = hits.data[hi_i * 2];
            val he: usize = hits.data[hi_i * 2 + 1];
            if (hs >= cur_off) {
                jw.bytes(?w, (t.p::usize + cur_off)::*u8, hs - cur_off);
                jw.bytes(?w, rnp, rnn);
                cur_off = he;
            }
            hi_i = hi_i + 1;
        }
        jw.bytes(?w, (t.p::usize + cur_off)::*u8, t.n - cur_off);
        if (w.failed || w.buf == nil) { ret fail(e, "oom", "out of memory", 0); }
        t.p = w.buf;
        t.n = w.len;
        ret true;
    }
    # Mode 2: {"symbol": "name", "body": "..."}
    if (sel body_f.some) {
        var ins: *u8 = nil;
        var insn: usize = 0;
        if (!with_lines_key(a, t, obj, "body", ?ins, ?insn)) {
            ret fail(e, "edit_bad", "symbol body must be a string or list of strings", sym.line);
        }
        if (sym.sig_end == sym.end && has_delim && close_idx > open_idx) {
            var trim_s: usize = 0;
            var trim_e: usize = insn;
            for (trim_s < trim_e && (ins[trim_s] == ' ' || ins[trim_s] == '\t' || ins[trim_s] == '\r' || ins[trim_s] == '\n')) { trim_s = trim_s + 1; }
            for (trim_e > trim_s && (ins[trim_e - 1] == ' ' || ins[trim_e - 1] == '\t' || ins[trim_e - 1] == '\r' || ins[trim_e - 1] == '\n')) { trim_e = trim_e - 1; }
            var bw: jw.Jw = jw.init(a);
            if (trim_e > trim_s) {
                jw.byte(?bw, ' ');
                jw.bytes(?bw, (ins::usize + trim_s)::*u8, trim_e - trim_s);
                if (!is_py) { jw.byte(?bw, ' '); }
            }
            if (bw.failed) { ret fail(e, "oom", "out of memory", 0); }
            var bp: *u8 = bw.buf;
            if (bp == nil) { bp = ""; }
            if (!splice(a, t, open_idx + 1, close_idx, bp, bw.len)) { ret fail(e, "oom", "out of memory", 0); }
            ret true;
        }
        var body_ind: i64 = sym.indent + 4;
        if (sym.sig_end < sym.end) {
            val b_off: usize = line_start(t, (sym.sig_end + 1)::usize);
            var existing_ind: usize = 0;
            for (b_off + existing_ind < t.n && (t.p[b_off + existing_ind] == ' ' || t.p[b_off + existing_ind] == '\t')) {
                existing_ind = existing_ind + 1;
            }
            if (existing_ind::i64 > sym.indent) { body_ind = existing_ind::i64; }
        }
        indent_block_if_unindented(a, ins, insn, body_ind, ?ins, ?insn);
        var from: usize = 0;
        var to: usize = 0;
        if (is_py) {
            from = line_start(t, (sym.sig_end + 1)::usize);
            to = line_start(t, (sym.end + 1)::usize);
        }
        or {
            if (sym.end > sym.sig_end) {
                from = line_start(t, (sym.sig_end + 1)::usize);
                to = line_start(t, sym.end::usize);
                if (has_delim && close_idx > open_idx) {
                    var open_tail_code: bool = false;
                    var ti: usize = open_idx + 1;
                    for (ti < sig_s1) {
                        val tc: u8 = t.p[ti];
                        if (tc != ' ' && tc != '\t' && tc != '\r' && tc != '\n') {
                            open_tail_code = true;
                            brk;
                        }
                        ti = ti + 1;
                    }
                    val end_line_s: usize = line_start(t, sym.end::usize);
                    var close_lead_code: bool = false;
                    if (close_idx >= end_line_s && close_idx <= sym_end_s1) {
                        var ci: usize = end_line_s;
                        for (ci < close_idx) {
                            val cc: u8 = t.p[ci];
                            if (cc != ' ' && cc != '\t') {
                                close_lead_code = true;
                                brk;
                            }
                            ci = ci + 1;
                        }
                    }
                    if (open_tail_code || close_lead_code) {
                        var mw: jw.Jw = jw.init(a);
                        if (open_tail_code) {
                            from = open_idx + 1;
                            if (t.crlf) { jw.raw(?mw, "\r\n"); }
                            or { jw.byte(?mw, '\n'); }
                        }
                        jw.bytes(?mw, ins, insn);
                        if (close_lead_code) {
                            to = close_idx;
                            var si_ind: i64 = 0;
                            for (si_ind < sym.indent) {
                                jw.byte(?mw, ' ');
                                si_ind = si_ind + 1;
                            }
                        }
                        if (mw.failed || mw.buf == nil) { ret fail(e, "oom", "out of memory", 0); }
                        ins = mw.buf;
                        insn = mw.len;
                    }
                }
            }
            or {
                from = line_start(t, (sym.sig_end + 1)::usize);
                to = line_start(t, (sym.end + 1)::usize);
            }
        }
        if (to == t.n && t.n > 0 && t.p[t.n - 1] != '\n' && insn > 0) {
            var trim: usize = insn;
            if (trim > 0 && ins[trim - 1] == '\n') { trim = trim - 1; }
            if (trim > 0 && ins[trim - 1] == '\r') { trim = trim - 1; }
            insn = trim;
        }
        if (!splice(a, t, from, to, ins, insn)) { ret fail(e, "oom", "out of memory", 0); }
        ret true;
    }
    # Mode 3: {"symbol": "name", "signature": "..."}
    if (sel sig_f.some) {
        var ins: *u8 = nil;
        var insn: usize = 0;
        if (!with_lines_key(a, t, obj, "signature", ?ins, ?insn)) {
            ret fail(e, "edit_bad", "symbol signature must be a string or list of strings", sym.line);
        }
        indent_block_if_unindented(a, ins, insn, sym.indent, ?ins, ?insn);
        val from: usize = line_start(t, sym.line::usize);
        if (has_delim) {
            var trim_e: usize = insn;
            for (trim_e > 0 && (ins[trim_e - 1] == '\n' || ins[trim_e - 1] == '\r' || ins[trim_e - 1] == ' ' || ins[trim_e - 1] == '\t')) { trim_e = trim_e - 1; }
            val delim_ch: u8 = t.p[open_idx];
            val ends_with_delim: bool = trim_e > 0 && ins[trim_e - 1] == delim_ch;
            if (sym.sig_end == sym.end || !ends_with_delim) {
                var sw: jw.Jw = jw.init(a);
                jw.bytes(?sw, ins, trim_e);
                var rep_to: usize = open_idx + 1;
                if (!ends_with_delim) {
                    if (open_idx > from && t.p[open_idx - 1] == ' ') { jw.byte(?sw, ' '); }
                    rep_to = open_idx;
                }
                if (sw.failed || sw.buf == nil) { ret fail(e, "oom", "out of memory", 0); }
                if (!splice(a, t, from, rep_to, sw.buf, sw.len)) { ret fail(e, "oom", "out of memory", 0); }
                ret true;
            }
        }
        val to: usize = line_start(t, (sym.sig_end + 1)::usize);
        if (!splice(a, t, from, to, ins, insn)) { ret fail(e, "oom", "out of memory", 0); }
        ret true;
    }
    # Mode 4: {"symbol": "name", "with": "..."} (full symbol replacement)
    var ins: *u8 = nil;
    var insn: usize = 0;
    if (!with_lines(a, t, obj, ?ins, ?insn)) { ret fail(e, "edit_bad", "a symbol edit needs with, body, signature, or rename", 0); }
    indent_block_if_unindented(a, ins, insn, sym.indent, ?ins, ?insn);
    var lo: i64 = sym.line;
    val hi: i64 = sym.end;
    if (sym.dec_start < sym.line && insn > 0) {
        var k: usize = 0;
        for (k < insn && (ins[k] == ' ' || ins[k] == '\t')) { k = k + 1; }
        if (k < insn && (ins[k] == '@' || (k + 1 < insn && ins[k] == '#' && ins[k + 1] == '['))) {
            lo = sym.dec_start;
        }
    }
    val from: usize = line_start(t, lo::usize);
    var to: usize = line_start(t, (hi + 1)::usize);
    if (!is_py && has_delim && close_idx >= sig_s0 && close_idx < sym_end_s1) {
        var after_close: usize = close_idx + 1;
        if (after_close < sym_end_s1 && t.p[after_close] == ';') { after_close = after_close + 1; }
        var has_tail_code: bool = false;
        var ti: usize = after_close;
        for (ti < sym_end_s1) {
            val tc: u8 = t.p[ti];
            if (tc != ' ' && tc != '\t' && tc != '\r' && tc != '\n') {
                has_tail_code = true;
                brk;
            }
            ti = ti + 1;
        }
        if (has_tail_code) {
            to = after_close;
            var trim_c: usize = insn;
            if (trim_c > 0 && ins[trim_c - 1] == '\n') { trim_c = trim_c - 1; }
            if (trim_c > 0 && ins[trim_c - 1] == '\r') { trim_c = trim_c - 1; }
            insn = trim_c;
        }
    }
    if (to == t.n && t.n > 0 && t.p[t.n - 1] != '\n' && insn > 0) {
        var trim: usize = insn;
        if (trim > 0 && ins[trim - 1] == '\n') { trim = trim - 1; }
        if (trim > 0 && ins[trim - 1] == '\r') { trim = trim - 1; }
        insn = trim;
    }
    if (!splice(a, t, from, to, ins, insn)) { ret fail(e, "oom", "out of memory", 0); }
    ret true;
}

# run an ex command or normal-mode keys over the text (or within span) in a sandboxed editor
fun vim_edit(a: *A.Allocator, name: str, t: *Text, obj: *json.Value, src: *u8, is_ex: bool, e: *Err) bool {
    var sa: usize = 0;
    var sb: usize = 0;
    if (!scope(a, t, obj, ?sa, ?sb, e)) { ret false; }
    val slice_p: *u8 = (t.p::usize + sa)::*u8;
    val slice_n: usize = sb - sa;
    val made: res[eng.Engine, A.Error] = eng.init(a);
    if (sel made.err) { ret fail(e, "oom", "out of memory", 0); }
    var ed: eng.Engine = made.ok;
    ed.sandbox = true;
    val had_final: bool = slice_n == 0 || slice_p[slice_n - 1] == '\n';
    val loaded: err[A.Error] = eng.load_current(?ed, name, slice_p, slice_n);
    if (sel loaded.err) {
        eng.dnit(?ed);
        ret fail(e, "oom", "out of memory", 0);
    }
    var ran: err[A.Error] = err[A.Error].ok{};
    if (is_ex) { ran = eng.command(?ed, src); }
    or { ran = eng.feed(?ed, src); }
    if (sel ran.err) {
        var code: str = "edit_keys";
        var msg: str = "the key sequence could not be parsed";
        if (is_ex) {
            code = "edit_ex";
            msg = "the ex command was refused; only substitute, global, delete, normal, and set run inside an edit";
        }
        if (ed.msg != nil) {
            msg = ed.msg;
            ed.msg = nil;
            if (str_contains(msg, "count is above")) { code = "edit_count"; }
            if (str_contains(msg, "macro nested")) { code = "edit_macro"; }
        }
        eng.dnit(?ed);
        ret fail(e, code, msg, 0);
    }
    if (is_ex && ed.msg != nil && util.eq(ed.msg, "unknown command")) {
        eng.dnit(?ed);
        ret fail(e, "edit_ex", "unknown ex command", 0);
    }
    val joined: res[str, A.Error] = eng.current_text(?ed);
    eng.dnit(?ed);
    if (sel joined.err) { ret fail(e, "oom", "out of memory", 0); }
    var p: *u8 = joined.ok;
    var n: usize = str_len(p);
    if (!had_final && n > 0 && p[n - 1] == '\n') { n = n - 1; }
    if (t.crlf) {
        var w: jw.Jw = jw.init(a);
        var i: usize = 0;
        for (i < n) {
            if (p[i] == '\n') { jw.raw(?w, "\r\n"); }
            or { jw.byte(?w, p[i]); }
            i = i + 1;
        }
        if (w.failed) { ret fail(e, "oom", "out of memory", 0); }
        if (w.buf != nil) {
            p = w.buf;
            n = w.len;
        }
    }
    if (sa == 0 && sb == t.n) {
        t.p = p;
        t.n = n;
        ret true;
    }
    if (!splice(a, t, sa, sb, p, n)) { ret fail(e, "oom", "out of memory", 0); }
    ret true;
}

fun line_text_at(a: *A.Allocator, t: *Text, ln: i64) str {
    if (ln < 1) { ret nil; }
    val from: usize = line_start(t, ln::usize);
    if (from >= t.n) { ret nil; }
    var to: usize = line_start(t, (ln + 1)::usize);
    if (to > from && t.p[to - 1] == '\n') { to = to - 1; }
    if (to > from && t.p[to - 1] == '\r') { to = to - 1; }
    var len: usize = to - from;
    if (len > 256) { len = 256; }
    val d: res[str, A.Error] = util.dup_n(a, (t.p::usize + from)::*u8, len);
    if (sel d.err) { ret nil; }
    ret d.ok;
}

# apply a json list of edits (or a single edit object) to text[0,n); the result comes from a
pub fun apply(a: *A.Allocator, name: str, text: *u8, n: usize, edits: *json.Value, out: **u8, out_len: *usize, e: *Err, norm: *bool, mixed: *bool) bool {
    e.code = nil;
    e.msg = nil;
    e.index = -1;
    e.line = 0;
    e.col = 0;
    e.cat = nil;
    e.scope_lo = 0;
    e.scope_hi = 0;
    e.actual = nil;
    @norm = false;
    @mixed = false;
    val single_obj: bool = json.value_is_object(edits);
    if (!single_obj && (!json.value_is_array(edits) || json.value_count(edits) == 0)) {
        ret fail(e, "edit_bad", "edits must be a non-empty list", 0);
    }
    var t: Text;
    t.name = name;
    t.p = text;
    t.n = n;
    t.crlf = false;
    t.normed = false;
    t.mixed = false;
    var i: usize = 0;
    var first_done: bool = false;
    for (i < n) {
        if (text[i] == '\n') {
            val is_crlf: bool = i > 0 && text[i - 1] == '\r';
            if (!first_done) { t.crlf = is_crlf; first_done = true; }
            or {
                if (is_crlf != t.crlf) { t.mixed = true; brk; }
            }
        }
        i = i + 1;
    }
    var edit_count: usize = 1;
    if (!single_obj) { edit_count = json.value_count(edits); }
    var k: usize = 0;
    for (k < edit_count) {
        e.index = k::i64;
        e.col = 0;
        e.cat = nil;
        e.scope_lo = 0;
        e.scope_hi = 0;
        e.actual = nil;
        var obj: *json.Value = edits;
        if (!single_obj) {
            val g: opt[*json.Value] = json.value_get(edits, k);
            if (!sel g.some) { ret fail(e, "edit_bad", "missing edit", 0); }
            obj = g.some;
        }
        if (!json.value_is_object(obj)) { ret fail(e, "edit_bad", "each edit must be an object", 0); }
        var ok: bool = false;
        val has_find: opt[*json.Value] = json.value_find(obj, "find");
        val has_find_re: opt[*json.Value] = json.value_find(obj, "find_re");
        val has_lines: opt[*json.Value] = json.value_find(obj, "lines");
        val has_before: opt[*json.Value] = json.value_find(obj, "insert_before");
        val has_after: opt[*json.Value] = json.value_find(obj, "insert_after");
        val has_append: opt[*json.Value] = json.value_find(obj, "append");
        val has_prepend: opt[*json.Value] = json.value_find(obj, "prepend");
        val has_ex: opt[*json.Value] = json.value_find(obj, "ex");
        val has_keys: opt[*json.Value] = json.value_find(obj, "keys");
        val has_sym: opt[*json.Value] = json.value_find(obj, "symbol");
        val has_within: opt[*json.Value] = json.value_find(obj, "within");
        val has_ren: opt[*json.Value] = json.value_find(obj, "rename");
        val has_body: opt[*json.Value] = json.value_find(obj, "body");
        val has_sig: opt[*json.Value] = json.value_find(obj, "signature");
        val has_sym_mode: bool = sel has_ren.some || sel has_body.some || sel has_sig.some;
        val sym_scopes_op: bool = !has_sym_mode && !sel has_within.some && (sel has_find.some || sel has_find_re.some || sel has_ex.some || sel has_keys.some);
        var op_count: usize = 0;
        if (sel has_find.some) { op_count = op_count + 1; }
        if (sel has_find_re.some) { op_count = op_count + 1; }
        if (sel has_lines.some) { op_count = op_count + 1; }
        if (sel has_before.some) { op_count = op_count + 1; }
        if (sel has_after.some) { op_count = op_count + 1; }
        if (sel has_append.some) { op_count = op_count + 1; }
        if (sel has_prepend.some) { op_count = op_count + 1; }
        if (sel has_ex.some) { op_count = op_count + 1; }
        if (sel has_keys.some) { op_count = op_count + 1; }
        if (sel has_sym.some && !sym_scopes_op) { op_count = op_count + 1; }
        if (op_count > 1) {
            ret fail(e, "edit_bad", "an edit must specify only one operation (find, find_re, lines, symbol, insert_before, insert_after, append, prepend, ex, or keys)", 0);
        }
        if (sel has_find_re.some) { ok = re_edit(a, ?t, obj, e); }
        or (sel has_find.some) { ok = find_edit(a, ?t, obj, e); }
        or (sel has_lines.some) { ok = range_edit(a, ?t, obj, e); }
        or (sel has_before.some) { ok = insert_edit(a, ?t, obj, false, e); }
        or (sel has_after.some) { ok = insert_edit(a, ?t, obj, true, e); }
        or (sel has_append.some || sel has_prepend.some) {
            var p: *u8 = nil;
            var pn: usize = 0;
            val is_append: bool = sel has_append.some;
            var key: str = "prepend";
            if (is_append) { key = "append"; }
            if (get_str(a, obj, key, ?p, ?pn) != 1) { ret fail(e, "edit_bad", "append and prepend take a string", 0); }
            var p2: *u8 = nil;
            var p2n: usize = 0;
            var ch: bool = false;
            if (!norm_text(a, ?t, p, pn, ?p2, ?p2n, ?ch)) { ret fail(e, "oom", "out of memory", 0); }
            if (ch) { p = p2; pn = p2n; t.normed = true; }
            if (is_append) { ok = splice(a, ?t, t.n, t.n, p, pn); }
            or { ok = splice(a, ?t, 0, 0, p, pn); }
            if (!ok) { ret fail(e, "oom", "out of memory", 0); }
        }
        or (sel has_ex.some || sel has_keys.some) {
            val is_ex: bool = sel has_ex.some;
            var key: str = "keys";
            if (is_ex) { key = "ex"; }
            var p: *u8 = nil;
            var pn: usize = 0;
            if (get_str(a, obj, key, ?p, ?pn) != 1 || pn == 0) { ret fail(e, "edit_bad", "ex and keys take a non-empty string", 0); }
            ok = vim_edit(a, name, ?t, obj, p, is_ex, e);
        }
        or (sel has_sym.some) {
            ok = symbol_edit(a, ?t, obj, e);
        }
        or {
            ret fail(e, "edit_bad", "an edit needs one of find, find_re, lines, symbol, insert_before, insert_after, append, prepend, ex, or keys", 0);
        }
        if (!ok) {
            if (e.line > 0 && e.actual == nil) {
                e.actual = line_text_at(a, ?t, e.line);
            }
            if (e.scope_lo <= 0 && t.n > 0) {
                e.scope_lo = 1;
                e.scope_hi = count_lines(?t)::i64;
            }
            ret false;
        }
        k = k + 1;
    }
    @norm = t.normed;
    @mixed = t.mixed;
    @out = t.p;
    @out_len = t.n;
    ret true;
}

fun slice_eq(a: *u8, a0: usize, a1: usize, b: *u8, b0: usize, b1: usize) bool {
    if (a1 < a0 || b1 < b0) { ret false; }
    val n: usize = a1 - a0;
    if (b1 - b0 != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (a[a0 + i] != b[b0 + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun key_is(k: str, klen: usize, want: str) bool {
    val wlen: usize = str_len(want);
    if (klen != wlen) { ret false; }
    ret slice_eq(k, 0, klen, want, 0, wlen);
}

fun line_eq_at(ot: *Text, ol: i64, nt: *Text, nl: i64) bool {
    val o0: usize = line_start(ot, ol::usize);
    val o1: usize = line_start(ot, (ol + 1)::usize);
    val n0: usize = line_start(nt, nl::usize);
    val n1: usize = line_start(nt, (nl + 1)::usize);
    ret slice_eq(ot.p, o0, o1, nt.p, n0, n1);
}

fun parse_sym_array(a: *A.Allocator, arr_v: *json.Value, out: *vector.Vector[str], e: *Err) bool {
    if (!json.value_is_array(arr_v) || json.value_count(arr_v) == 0) {
        ret fail(e, "contract_bad", "contract.symbols/methods must be a non-empty list of strings", 0);
    }
    var si: usize = 0;
    for (si < json.value_count(arr_v)) {
        val elem: opt[*json.Value] = json.value_get(arr_v, si);
        if (!sel elem.some) {
            ret fail(e, "contract_bad", "contract.symbols/methods elements must be non-empty strings", 0);
        }
        if (sel elem.some) {
            if (!json.value_is_string(elem.some)) {
                ret fail(e, "contract_bad", "contract.symbols/methods elements must be non-empty strings", 0);
            }
            var raw_n: usize = 0;
            val raw: *u8 = json.value_string(elem.some, ?raw_n);
            val got: res[*u8, A.Error] = A.allocate[u8](a, raw_n + 1);
            if (sel got.err) { ret fail(e, "oom", "out of memory", 0); }
            val spn: usize = decode_lenient(raw, raw_n, got.ok);
            if (spn == 0) {
                ret fail(e, "contract_bad", "contract.symbols/methods elements must be non-empty strings", 0);
            }
            if (out != nil) { vector.push[str](out, got.ok); }
        }
        si = si + 1;
    }
    ret true;
}

pub fun validate_contract_syntax(a: *A.Allocator, contract: *json.Value, e: *Err) bool {
    if (contract == nil) { ret true; }
    if (!json.value_is_object(contract)) {
        ret fail(e, "contract_bad", "contract must be an object", 0);
    }
    val kcount: usize = json.value_count(contract);
    var ki: usize = 0;
    for (ki < kcount) {
        val kf: opt[str] = json.value_key(contract, ki);
        val kl: usize = json.value_key_len(contract, ki);
        if (sel kf.some) {
            val k: str = kf.some;
            if (!key_is(k, kl, "lines") && !key_is(k, kl, "symbol") && !key_is(k, kl, "symbols") && !key_is(k, kl, "methods") && !key_is(k, kl, "preserve_signatures") && !key_is(k, kl, "max_lines_changed") && !key_is(k, kl, "max_changed_lines") && !key_is(k, kl, "forbid_delete")) {
                ret fail(e, "contract_bad", "unknown field in contract", 0);
            }
        }
        ki = ki + 1;
    }
    val fd_f: opt[*json.Value] = json.value_find(contract, "forbid_delete");
    if (sel fd_f.some) {
        if (!json.value_is_bool(fd_f.some)) {
            ret fail(e, "contract_bad", "contract.forbid_delete must be a boolean", 0);
        }
    }
    val ps_f: opt[*json.Value] = json.value_find(contract, "preserve_signatures");
    if (sel ps_f.some) {
        if (!json.value_is_bool(ps_f.some)) {
            ret fail(e, "contract_bad", "contract.preserve_signatures must be a boolean", 0);
        }
    }
    val lf: opt[*json.Value] = json.value_find(contract, "lines");
    if (sel lf.some) {
        if (!json.value_is_array(lf.some) || json.value_count(lf.some) != 2) {
            ret fail(e, "contract_bad", "contract.lines must be [first, last], 1-based and inclusive", 0);
        }
        var lo: i64 = 0;
        var hi: i64 = 0;
        val g0: opt[*json.Value] = json.value_get(lf.some, 0);
        val g1: opt[*json.Value] = json.value_get(lf.some, 1);
        if (sel g0.some) {
            if (json.value_is_number(g0.some) && !json.value_is_float(g0.some)) { lo = json.value_number(g0.some); }
        }
        if (sel g1.some) {
            if (json.value_is_number(g1.some) && !json.value_is_float(g1.some)) { hi = json.value_number(g1.some); }
        }
        if (lo < 1 || hi < lo) {
            ret fail(e, "contract_bad", "contract.lines must be [first, last], 1-based and inclusive", 0);
        }
    }
    val sym_f: opt[*json.Value] = json.value_find(contract, "symbol");
    if (sel sym_f.some) {
        var single_sym: *u8 = nil;
        var single_n: usize = 0;
        if (get_str(a, contract, "symbol", ?single_sym, ?single_n) != 1 || single_n == 0) {
            ret fail(e, "contract_bad", "contract.symbol must be a non-empty string", 0);
        }
    }
    var syms_v: vector.Vector[str] = vector.init[str](a);
    var meths_v: vector.Vector[str] = vector.init[str](a);
    val sf_arr: opt[*json.Value] = json.value_find(contract, "symbols");
    if (sel sf_arr.some) {
        if (!parse_sym_array(a, sf_arr.some, ?syms_v, e)) { ret false; }
    }
    val mf_arr: opt[*json.Value] = json.value_find(contract, "methods");
    if (sel mf_arr.some) {
        if (!parse_sym_array(a, mf_arr.some, ?meths_v, e)) { ret false; }
    }
    if (sel sf_arr.some && sel mf_arr.some) {
        if (syms_v.len != meths_v.len) {
            ret fail(e, "contract_bad", "contract.symbols and contract.methods cannot conflict", 0);
        }
        var ci: usize = 0;
        for (ci < syms_v.len) {
            if (!util.eq(syms_v.data[ci], meths_v.data[ci])) {
                ret fail(e, "contract_bad", "contract.symbols and contract.methods cannot conflict", 0);
            }
            ci = ci + 1;
        }
    }
    val mlc1: opt[*json.Value] = json.value_find(contract, "max_lines_changed");
    if (sel mlc1.some) {
        if (!json.value_is_number(mlc1.some) || json.value_is_float(mlc1.some) || json.value_number(mlc1.some) < 0) {
            ret fail(e, "contract_bad", "contract.max_lines_changed must be a non-negative integer", 0);
        }
    }
    val mlc2: opt[*json.Value] = json.value_find(contract, "max_changed_lines");
    if (sel mlc2.some) {
        if (!json.value_is_number(mlc2.some) || json.value_is_float(mlc2.some) || json.value_number(mlc2.some) < 0) {
            ret fail(e, "contract_bad", "contract.max_changed_lines must be a non-negative integer", 0);
        }
    }
    if (sel mlc1.some) {
        if (sel mlc2.some) {
            if (json.value_number(mlc1.some) != json.value_number(mlc2.some)) {
                ret fail(e, "contract_bad", "contract.max_lines_changed and contract.max_changed_lines cannot conflict", 0);
            }
        }
    }
    ret true;
}

# enforce a method/symbol/line scope contract between old_p[0..old_n) and new_p[0..new_n)
pub fun verify_contract(a: *A.Allocator, name: str, old_p: *u8, old_n: usize, new_p: *u8, new_n: usize, contract: *json.Value, e: *Err) bool {
    if (contract == nil) { ret true; }
    if (!validate_contract_syntax(a, contract, e)) { ret false; }

    var ot: Text;
    ot.name = name;
    ot.p = old_p;
    ot.n = old_n;
    var nt: Text;
    nt.name = name;
    nt.p = new_p;
    nt.n = new_n;
    val ototal: i64 = count_lines(?ot)::i64;
    val ntotal: i64 = count_lines(?nt)::i64;
    val lang: str = scan.outline_lang(name);

    # 1. Line range contract: "lines": [first, last]
    val lf: opt[*json.Value] = json.value_find(contract, "lines");
    if (sel lf.some) {
        var lo: i64 = 0;
        var hi: i64 = 0;
        val g0: opt[*json.Value] = json.value_get(lf.some, 0);
        val g1: opt[*json.Value] = json.value_get(lf.some, 1);
        if (sel g0.some) { lo = json.value_number(g0.some); }
        if (sel g1.some) { hi = json.value_number(g1.some); }
        if (lo < 1 || hi < lo || (ototal > 0 && hi > ototal)) {
            ret fail(e, "contract_bad", "contract.lines is outside the file", 0);
        }
        if (ototal == 0) {
            if (lo != 1 || ntotal > hi) {
                ret fail(e, "contract_violation", "edits modified lines outside the contracted line range", lo);
            }
        }
        or {
            val pre_end: usize = line_start(?ot, lo::usize);
            val suf_start: usize = line_start(?ot, (hi + 1)::usize);
            val suf_len: usize = old_n - suf_start;
            if (new_n < pre_end + suf_len) {
                ret fail(e, "contract_violation", "edits modified lines outside the contracted line range", lo);
            }
            if (!slice_eq(old_p, 0, pre_end, new_p, 0, pre_end)) {
                ret fail(e, "contract_violation", "edits modified lines before the contracted line range", 1);
            }
            if (!slice_eq(old_p, suf_start, old_n, new_p, new_n - suf_len, new_n)) {
                ret fail(e, "contract_violation", "edits modified lines after the contracted line range", hi + 1);
            }
        }
    }

    # 2. Symbol / method scope contract: "symbol": "name" or "symbols": ["a", "b"] or "methods": ["a", "b"]
    var sym_names: vector.Vector[str] = vector.init[str](a);
    val sym_f: opt[*json.Value] = json.value_find(contract, "symbol");
    if (sel sym_f.some) {
        var single_sym: *u8 = nil;
        var single_n: usize = 0;
        get_str(a, contract, "symbol", ?single_sym, ?single_n);
        vector.push[str](?sym_names, single_sym);
    }
    var arr_f: opt[*json.Value] = json.value_find(contract, "symbols");
    if (!sel arr_f.some) { arr_f = json.value_find(contract, "methods"); }
    if (sel arr_f.some) {
        if (!parse_sym_array(a, arr_f.some, ?sym_names, e)) { ret false; }
    }
    if (sym_names.len > 0) {
        if (lang == nil) {
            ret fail(e, "contract_bad", "symbol contracts require a supported language file", 0);
        }
        var o_los: vector.Vector[i64] = vector.init[i64](a);
        var o_his: vector.Vector[i64] = vector.init[i64](a);
        var n_los: vector.Vector[i64] = vector.init[i64](a);
        var n_his: vector.Vector[i64] = vector.init[i64](a);
        var i: usize = 0;
        for (i < sym_names.len) {
            val sn: str = sym_names.data[i];
            val sn_len: usize = str_len(sn);
            var osym: scan.Sym;
            if (scan.find_symbol_ext(a, lang, old_p, old_n, sn, sn_len, ?osym) != 1) {
                ret fail(e, "contract_bad", "contracted symbol not found in the original file", 0);
            }
            var nsym: scan.Sym;
            if (scan.find_symbol_ext(a, lang, new_p, new_n, sn, sn_len, ?nsym) != 1) {
                ret fail(e, "contract_violation", "contracted symbol was deleted or renamed without authorization", osym.line);
            }
            vector.push[i64](?o_los, osym.dec_start);
            vector.push[i64](?o_his, osym.end);
            vector.push[i64](?n_los, nsym.dec_start);
            vector.push[i64](?n_his, nsym.end);
            i = i + 1;
        }
        # sort spans by o_los
        var a_i: usize = 1;
        for (a_i < o_los.len) {
            var b_j: usize = a_i;
            for (b_j > 0 && o_los.data[b_j] < o_los.data[b_j - 1]) {
                val t1: i64 = o_los.data[b_j]; o_los.data[b_j] = o_los.data[b_j - 1]; o_los.data[b_j - 1] = t1;
                val t2: i64 = o_his.data[b_j]; o_his.data[b_j] = o_his.data[b_j - 1]; o_his.data[b_j - 1] = t2;
                val t3: i64 = n_los.data[b_j]; n_los.data[b_j] = n_los.data[b_j - 1]; n_los.data[b_j - 1] = t3;
                val t4: i64 = n_his.data[b_j]; n_his.data[b_j] = n_his.data[b_j - 1]; n_his.data[b_j - 1] = t4;
                b_j = b_j - 1;
            }
            a_i = a_i + 1;
        }
        var o_cur: usize = 0;
        var n_cur: usize = 0;
        i = 0;
        for (i < o_los.len) {
            val o_start: usize = line_start(?ot, o_los.data[i]::usize);
            val n_start: usize = line_start(?nt, n_los.data[i]::usize);
            if (!slice_eq(old_p, o_cur, o_start, new_p, n_cur, n_start)) {
                ret fail(e, "contract_violation", "edits modified lines outside the contracted symbol scope", o_los.data[i]);
            }
            o_cur = line_start(?ot, (o_his.data[i] + 1)::usize);
            n_cur = line_start(?nt, (n_his.data[i] + 1)::usize);
            i = i + 1;
        }
        if (!slice_eq(old_p, o_cur, old_n, new_p, n_cur, new_n)) {
            ret fail(e, "contract_violation", "edits modified lines after the contracted symbol scope", o_his.data[o_his.len - 1] + 1);
        }
    }

    # 3. Preserve signatures contract: "preserve_signatures": true
    if (get_bool(contract, "preserve_signatures")) {
        if (lang == nil) {
            ret fail(e, "contract_bad", "preserve_signatures requires a supported language file", 0);
        }
        val is_py: bool = util.eq(lang, "python");
        var old_syms: vector.Vector[scan.Sym] = vector.init[scan.Sym](a);
        var new_syms: vector.Vector[scan.Sym] = vector.init[scan.Sym](a);
        scan.collect_symbols(a, lang, old_p, old_n, ?old_syms);
        scan.collect_symbols(a, lang, new_p, new_n, ?new_syms);
        var used_ns: vector.Vector[bool] = vector.init[bool](a);
        var u_i: usize = 0;
        for (u_i < new_syms.len) {
            vector.push[bool](?used_ns, false);
            u_i = u_i + 1;
        }
        var oi: usize = 0;
        for (oi < old_syms.len) {
            val os: *scan.Sym = ?old_syms.data[oi];
            var found_ns: *scan.Sym = nil;
            var found_idx: usize = 0;
            var ni: usize = 0;
            for (ni < new_syms.len) {
                if (!used_ns.data[ni]) {
                    val cand: *scan.Sym = ?new_syms.data[ni];
                    if (cand.name_n == os.name_n && slice_eq(cand.name, 0, cand.name_n, os.name, 0, os.name_n)) {
                        val p_both_nil: bool = os.parent == nil && cand.parent == nil;
                        val p_match: bool = p_both_nil || (os.parent != nil && cand.parent != nil && os.parent_n == cand.parent_n && slice_eq(os.parent, 0, os.parent_n, cand.parent, 0, cand.parent_n));
                        if (p_match) {
                            found_ns = cand;
                            found_idx = ni;
                            brk;
                        }
                    }
                }
                ni = ni + 1;
            }
            if (found_ns == nil) {
                ret fail(e, "contract_violation", "a symbol was removed or renamed while preserve_signatures is active", os.line);
            }
            used_ns.data[found_idx] = true;
            val o_s0: usize = line_start(?ot, os.line::usize);
            var o_s1: usize = line_start(?ot, (os.sig_end + 1)::usize);
            var o_open: usize = 0;
            var o_close: usize = 0;
            if (find_sym_delim(old_p, o_s0, o_s1, is_py, ?o_open, ?o_close)) {
                o_s1 = o_open + 1;
            }
            val n_s0: usize = line_start(?nt, found_ns.line::usize);
            var n_s1: usize = line_start(?nt, (found_ns.sig_end + 1)::usize);
            var n_open: usize = 0;
            var n_close: usize = 0;
            if (find_sym_delim(new_p, n_s0, n_s1, is_py, ?n_open, ?n_close)) {
                n_s1 = n_open + 1;
            }
            if (!slice_trim_eq(old_p, o_s0, o_s1, new_p, n_s0, n_s1)) {
                ret fail(e, "contract_violation", "a symbol signature was modified while preserve_signatures is active", found_ns.line);
            }
            oi = oi + 1;
        }
    }

    # 4. Max lines changed contract: "max_lines_changed": N (or alias "max_changed_lines": N)
    var max_f: opt[*json.Value] = json.value_find(contract, "max_lines_changed");
    if (!sel max_f.some) { max_f = json.value_find(contract, "max_changed_lines"); }
    if (sel max_f.some) {
        if (!json.value_is_number(max_f.some) || json.value_is_float(max_f.some) || json.value_number(max_f.some) < 0) {
            ret fail(e, "contract_bad", "contract.max_lines_changed must be a non-negative integer", 0);
        }
        val max_chg: i64 = json.value_number(max_f.some);
        var pre_l: i64 = 1;
        for (pre_l <= ototal && pre_l <= ntotal) {
            if (!line_eq_at(?ot, pre_l, ?nt, pre_l)) { brk; }
            pre_l = pre_l + 1;
        }
        var o_suf: i64 = ototal;
        var n_suf: i64 = ntotal;
        for (o_suf >= pre_l && n_suf >= pre_l) {
            if (!line_eq_at(?ot, o_suf, ?nt, n_suf)) { brk; }
            o_suf = o_suf - 1;
            n_suf = n_suf - 1;
        }
        var total_chg: i64 = 0;
        var ol: i64 = pre_l;
        var nl: i64 = pre_l;
        for (ol <= o_suf || nl <= n_suf) {
            if (ol <= o_suf && nl <= n_suf && line_eq_at(?ot, ol, ?nt, nl)) {
                ol = ol + 1;
                nl = nl + 1;
                cnt;
            }
            # Find nearest resync point (ol2, nl2) within lookahead window
            var best_o: i64 = -1;
            var best_n: i64 = -1;
            var best_dist: i64 = 1000000;
            var do_i: i64 = 0;
            for (do_i <= 64 && ol + do_i <= o_suf + 1) {
                var dn_i: i64 = 0;
                for (dn_i <= 64 && nl + dn_i <= n_suf + 1) {
                    if (do_i + dn_i > 0 && do_i + dn_i < best_dist) {
                        if (ol + do_i <= o_suf && nl + dn_i <= n_suf && line_eq_at(?ot, ol + do_i, ?nt, nl + dn_i)) {
                            best_o = ol + do_i;
                            best_n = nl + dn_i;
                            best_dist = do_i + dn_i;
                        }
                    }
                    dn_i = dn_i + 1;
                }
                do_i = do_i + 1;
            }
            if (best_o >= 0 && best_n >= 0) {
                val ho: i64 = best_o - ol;
                val hn: i64 = best_n - nl;
                var hmax: i64 = ho;
                if (hn > hmax) { hmax = hn; }
                total_chg = total_chg + hmax;
                ol = best_o;
                nl = best_n;
            }
            or {
                var ro: i64 = 0;
                if (o_suf >= ol) { ro = o_suf - ol + 1; }
                var rn: i64 = 0;
                if (n_suf >= nl) { rn = n_suf - nl + 1; }
                var rmax: i64 = ro;
                if (rn > rmax) { rmax = rn; }
                total_chg = total_chg + rmax;
                brk;
            }
        }
        if (total_chg > max_chg) {
            ret fail(e, "contract_violation", "edits exceeded contract.max_lines_changed", pre_l);
        }
    }

    ret true;
}

use std.system.capability;

$if (capability.HOSTED) {
    use page: std.allocator.page;

    fun same(got: *u8, gn: usize, want: str) bool {
        if (gn != str_len(want)) { ret false; }
        var i: usize = 0;
        for (i < gn) {
            if (got[i] != want[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }

    fun run(a: *A.Allocator, src: str, spec: str, out: **u8, on: *usize, e: *Err, norm: *bool) bool {
        val pj: res[json.Value, json.JsonError] = json.parse(spec, str_len(spec), a);
        if (sel pj.err) { ret false; }
        var arr: json.Value = pj.ok;
        var mx: bool = false;
        ret apply(a, "f.txt", src, str_len(src), ?arr, out, on, e, norm, ?mx);
    }

    test edit__lf_find_on_crlf {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        if (!run(?a, "alpha\r\nbeta\r\ngamma\r\n", "[{\"find\":\"beta\\ngamma\",\"replace\":\"B\\nG\"}]", ?out, ?on, ?e, ?norm)) { ret 2; }
        if (!norm) { ret 3; }
        if (!same(out, on, "alpha\r\nB\r\nG\r\n")) { ret 4; }
        ret 0;
    }

    test edit__crlf_find_on_lf {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        if (!run(?a, "one\ntwo\nthree\n", "[{\"find\":\"one\\r\\ntwo\",\"replace\":\"ONE\\r\\nTWO\"}]", ?out, ?on, ?e, ?norm)) { ret 2; }
        if (!norm) { ret 3; }
        if (!same(out, on, "ONE\nTWO\nthree\n")) { ret 4; }
        ret 0;
    }

    test edit__within_and_anchor_norm {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        if (!run(?a, "alpha\r\nbeta\r\ngamma\r\n", "[{\"find\":\"beta\",\"replace\":\"BETA\",\"within\":\"beta\\ngamma\"},{\"insert_after\":\"alpha\",\"with\":\"mid\\n\"}]", ?out, ?on, ?e, ?norm)) { ret 2; }
        if (!norm) { ret 3; }
        if (!same(out, on, "alpha\r\nmid\r\nBETA\r\ngamma\r\n")) { ret 4; }
        ret 0;
    }

    test edit__no_norm_when_matching {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        if (!run(?a, "one\ntwo\n", "[{\"find\":\"two\",\"replace\":\"TWO\"}]", ?out, ?on, ?e, ?norm)) { ret 2; }
        if (norm) { ret 3; }
        if (!same(out, on, "one\nTWO\n")) { ret 4; }
        ret 0;
    }

    test edit__near_miss_reports_line_and_col {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        if (run(?a, "one\ntwo\nthree\n", "[{\"find\":\"threE\",\"replace\":\"x\"}]", ?out, ?on, ?e, ?norm)) { ret 2; }
        if (e.code == nil || !str_contains(e.code, "edit_not_found")) { ret 3; }
        if (e.line != 3) { ret 4; }
        if (e.msg == nil || !str_contains(e.msg, "column 5")) { ret 5; }
        ret 0;
    }

    test edit__re_crlf_hint {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        if (run(?a, "alpha\r\nbeta\r\n", "[{\"find_re\":\"alpha\\nbeta\",\"replace\":\"X\"}]", ?out, ?on, ?e, ?norm)) { ret 2; }
        if (e.code == nil || !str_contains(e.code, "edit_not_found")) { ret 3; }
        if (e.msg == nil || !str_contains(e.msg, "\\r\\n")) { ret 4; }
        ret 0;
    }

    test edit__symbol_scope_replace_and_vim_within {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        val src: str = "def a(x):\n    return x + 1\n\ndef b(x):\n    return x + 1\n";
        val spec: str = "[{\"symbol\":\"b\",\"find\":\"x + 1\",\"replace\":\"x + 2\"},{\"within\":{\"symbol\":\"a\"},\"ex\":\"%s/x/y/g\"},{\"insert_after\":{\"symbol\":\"a\"},\"with\":\"# between\"}]";
        val pj: res[json.Value, json.JsonError] = json.parse(spec, str_len(spec), ?a);
        if (sel pj.err) { ret 2; }
        var arr: json.Value = pj.ok;
        var out: *u8 = nil;
        var on: usize = 0;
        var e: Err;
        var norm: bool = false;
        var mx: bool = false;
        if (!apply(?a, "calc.py", src, str_len(src), ?arr, ?out, ?on, ?e, ?norm, ?mx)) { ret 3; }
        if (!same(out, on, "def a(y):\n    return y + 1\n# between\n\ndef b(x):\n    return x + 2\n")) { ret 4; }
        ret 0;
    }
}
