# primitive functions the boot environment binds

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use h: qark.vm.heap;
use v: qark.vm.value;

fun nth(vm: *v.Vm, args: *u32, n: i64, i: i64) u32 {
    if (i < 0 || i >= n) { ret v.NIL; }
    ret args[i::usize];
}

fun as_int(vm: *v.Vm, idx: u32) res[i64, v.VmError] {
    val c: *v.Cell = h.cell(vm, idx);
    if (c.kind != v.K_INT) { ret res[i64, v.VmError].err{v.VmError.type{}}; }
    ret res[i64, v.VmError].ok{c.n};
}

# invoke builtin `id` on n already-evaluated arguments
pub fun call(vm: *v.Vm, id: i64, args: *u32, n: i64) res[u32, v.VmError] {
    if (id == 0 || id == 1 || id == 2 || id == 3 || id == 10) {
        if (n < 2) { ret res[u32, v.VmError].err{v.VmError.args{}}; }
        val a: res[i64, v.VmError] = as_int(vm, nth(vm, args, n, 0));
        if (sel a.err) { ret res[u32, v.VmError].err{a.err}; }
        val b: res[i64, v.VmError] = as_int(vm, nth(vm, args, n, 1));
        if (sel b.err) { ret res[u32, v.VmError].err{b.err}; }
        var r: i64 = 0;
        if (id == 0) { r = a.ok + b.ok; }
        if (id == 1) { r = a.ok - b.ok; }
        if (id == 2) { r = a.ok * b.ok; }
        if (id == 3) {
            if (b.ok == 0) { ret res[u32, v.VmError].err{v.VmError.div0{}}; }
            r = a.ok / b.ok;
        }
        if (id == 10) {
            val made: res[u32, A.Error] = h.make_bool(vm, a.ok < b.ok);
            if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
            ret res[u32, v.VmError].ok{made.ok};
        }
        val made: res[u32, A.Error] = h.make_int(vm, r);
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    if (id == 4) {
        if (n != 2) { ret res[u32, v.VmError].err{v.VmError.args{}}; }
        val made: res[u32, A.Error] = h.cons(vm, nth(vm, args, n, 0), nth(vm, args, n, 1));
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    if (id == 5 || id == 6) {
        if (n != 1) { ret res[u32, v.VmError].err{v.VmError.args{}}; }
        val c: *v.Cell = h.cell(vm, nth(vm, args, n, 0));
        if (c.kind != v.K_PAIR) { ret res[u32, v.VmError].err{v.VmError.type{}}; }
        if (id == 5) { ret res[u32, v.VmError].ok{c.a}; }
        ret res[u32, v.VmError].ok{c.b};
    }
    if (id == 7) {
        val made: res[u32, A.Error] = h.make_bool(vm, nth(vm, args, n, 0) == v.NIL);
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    if (id == 8) {
        val made: res[u32, A.Error] = h.make_bool(vm, !h.truth(vm, nth(vm, args, n, 0)));
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    if (id == 9) {
        if (n != 2) { ret res[u32, v.VmError].err{v.VmError.args{}}; }
        val x: u32 = nth(vm, args, n, 0);
        val y: u32 = nth(vm, args, n, 1);
        var same: bool = x == y;
        val cx: *v.Cell = h.cell(vm, x);
        val cy: *v.Cell = h.cell(vm, y);
        if (cx.kind == v.K_INT && cy.kind == v.K_INT) { same = cx.n == cy.n; }
        if (cx.kind == v.K_STR && cy.kind == v.K_STR) {
            var ln: usize = 0;
            var rn: usize = 0;
            val ls: *u8 = h.str_data(vm, x, ?ln);
            val rs: *u8 = h.str_data(vm, y, ?rn);
            same = ln == rn;
            if (same) {
                var i: usize = 0;
                for (i < ln) {
                    if (ls[i] != rs[i]) { same = false; }
                    i = i + 1;
                }
            }
        }
        val made: res[u32, A.Error] = h.make_bool(vm, same);
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    if (id == 11) {
        var i: i64 = n - 1;
        var acc: u32 = v.NIL;
        for (i >= 0) {
            val made: res[u32, A.Error] = h.cons(vm, nth(vm, args, n, i), acc);
            if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
            acc = made.ok;
            i = i - 1;
        }
        ret res[u32, v.VmError].ok{acc};
    }
    if (id == 12) {
        var ln: usize = 0;
        h.str_data(vm, nth(vm, args, n, 0), ?ln);
        val made: res[u32, A.Error] = h.make_int(vm, ln::i64);
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    if (id == 13) {
        h.gc(vm);
        ret res[u32, v.VmError].ok{v.NIL};
    }
    if (id == 14) {
        val idx: u32 = nth(vm, args, n, 0);
        val c: *v.Cell = h.cell(vm, idx);
        var name: str = "nil";
        if (c.kind == v.K_BOOL) { name = "bool"; }
        if (c.kind == v.K_INT) { name = "int"; }
        if (c.kind == v.K_STR) { name = "string"; }
        if (c.kind == v.K_SYM) { name = "symbol"; }
        if (c.kind == v.K_PAIR) { name = "pair"; }
        if (c.kind == v.K_CLOSURE) { name = "closure"; }
        if (c.kind == v.K_MACRO) { name = "macro"; }
        if (c.kind == v.K_BUILTIN) { name = "builtin"; }
        if (idx == v.NIL) { name = "nil"; }
        val made: res[u32, A.Error] = h.intern(vm, name);
        if (sel made.err) { ret res[u32, v.VmError].err{v.VmError.oom{}}; }
        ret res[u32, v.VmError].ok{made.ok};
    }
    ret res[u32, v.VmError].err{v.VmError.apply{}};
}

# bind one builtin into the global environment
pub fun bind(vm: *v.Vm, name: str, id: i64) err[A.Error] {
    val sym: res[u32, A.Error] = h.intern(vm, name);
    if (sel sym.err) { ret err[A.Error].err{sym.err}; }
    val cell: res[u32, A.Error] = h.alloc(vm, v.K_BUILTIN);
    if (sel cell.err) { ret err[A.Error].err{cell.err}; }
    h.cell(vm, cell.ok).n = id;
    val pair: res[u32, A.Error] = h.cons(vm, sym.ok, cell.ok);
    if (sel pair.err) { ret err[A.Error].err{pair.err}; }
    val link: res[u32, A.Error] = h.cons(vm, pair.ok, vm.global);
    if (sel link.err) { ret err[A.Error].err{link.err}; }
    vm.global = link.ok;
    ret err[A.Error].ok{};
}
