# the write layer: apply a spec, read files with their hashes, and manage templates
#
# every operation writes one json object into the caller's writer: the result
# when it returns true, or an error object {code, message, ...} when it
# returns false. the ndjson worker, the mcp server, and the cli all wrap these
# same objects, so an agent sees one contract whichever way it connects.

use std.chrono.duration;
use std.chrono.time;
use std.collections.vector;
use std.crypto.rand;
use std.data.json;
use std.filesystem;
use io_error: std.io.error;
use std.process.env;
use std.text.utf8;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use check: qark.gen.check;
use commit: qark.gen.commit;
use diff: qark.gen.diff;
use pathx: qark.gen.pathx;
use scan: qark.gen.scan;
use jw: qark.rpc.jw;
use builtin: qark.spec.builtin;
use spec: qark.spec.spec;
use tmpl: qark.spec.tmpl;
use session: qark.session;
use util: qark.util;

pub val READ_MAX: usize = 262144;

fun truncate_utf8_len(p: *u8, n: usize, max: usize) usize {
    if (n <= max) { ret n; }
    if (p == nil || max == 0) { ret 0; }
    var k: usize = max;
    for (k > 0 && (p[k] & 192) == 128) {
        k = k - 1;
    }
    var steps: usize = 0;
    for (k > 0 && steps < 4 && !utf8.validate(p, k)) {
        k = k - 1;
        steps = steps + 1;
    }
    ret k;
}

fun hex_val(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a' + 10)::i64; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A' + 10)::i64; }
    ret -1;
}

fun decode_hex_bytes(a: *A.Allocator, hex_p: *u8, hex_n: usize, out_p: **u8, out_n: *usize) bool {
    if (hex_n % 2 != 0) { ret false; }
    val blen: usize = hex_n / 2;
    val got: res[*u8, A.Error] = A.allocate[u8](a, blen + 1);
    if (sel got.err) { ret false; }
    var i: usize = 0;
    for (i < blen) {
        val hi: i64 = hex_val(hex_p[i * 2]);
        val lo: i64 = hex_val(hex_p[i * 2 + 1]);
        if (hi < 0 || lo < 0) { ret false; }
        got.ok[i] = ((hi << 4) | lo)::u8;
        i = i + 1;
    }
    got.ok[blen] = 0;
    @out_p = got.ok;
    @out_n = blen;
    ret true;
}

fun now_us(start: time.Instant) i64 {
    val el: time.Elapsed = time.elapsed(start);
    if (sel el.ok) { ret duration.duration_usec(el.ok); }
    ret 0;
}

fun started() time.Instant {
    val now: time.InstantClock = time.instant();
    if (sel now.ok) { ret now.ok; }
    var zero: time.Instant;
    ret zero;
}

fun error_obj(w: *jw.Jw, code: str, msg: str) {
    jw.obj(w);
    jw.f_str(w, "code", code);
    jw.f_str(w, "message", msg);
}

pub fun simple_error(w: *jw.Jw, code: str, msg: str) bool {
    error_obj(w, code, msg);
    jw.obj_end(w);
    ret false;
}

fun spec_error(w: *jw.Jw, e: *spec.Err) bool {
    var code: str = e.code;
    if (code == nil) { code = "spec"; }
    var msg: str = e.msg;
    if (msg == nil) { msg = "the spec was refused"; }
    error_obj(w, code, msg);
    if (e.field != nil) { jw.f_str(w, "field", e.field); }
    if (e.path != nil) { jw.f_str(w, "path", e.path); }
    if (e.tname != nil) { jw.f_str(w, "template", e.tname); }
    if (e.line > 0) { jw.f_i64(w, "line", e.line); }
    if (e.col > 0) { jw.f_i64(w, "col", e.col); }
    if (e.cat != nil) { jw.f_str(w, "mismatch_category", e.cat); }
    if (e.scope_lo > 0 && e.scope_hi >= e.scope_lo) {
        jw.key(w, "target_lines");
        jw.arr(w);
        jw.i64_v(w, e.scope_lo);
        jw.i64_v(w, e.scope_hi);
        jw.arr_end(w);
    }
    if (e.actual != nil) { jw.f_str(w, "actual_line", e.actual); }
    jw.obj_end(w);
    ret false;
}

fun lines_of(p: *u8, n: usize) i64 {
    if (n == 0) { ret 0; }
    var k: i64 = 0;
    var i: usize = 0;
    for (i < n) {
        if (p[i] == '\n') { k = k + 1; }
        i = i + 1;
    }
    if (p[n - 1] != '\n') { k = k + 1; }
    ret k;
}

fun changed_line_range(old_p: *u8, old_n: usize, new_p: *u8, new_n: usize, out_lo: *i64, out_hi: *i64) {
    val total_new: i64 = lines_of(new_p, new_n);
    if (total_new <= 0) {
        @out_lo = 0;
        @out_hi = 0;
        ret;
    }
    if (old_p == nil || old_n == 0) {
        @out_lo = 1;
        @out_hi = total_new;
        ret;
    }
    var pfx: usize = 0;
    var min_n: usize = old_n;
    if (new_n < min_n) { min_n = new_n; }
    var first_line: i64 = 1;
    for (pfx < min_n && old_p[pfx] == new_p[pfx]) {
        if (new_p[pfx] == '\n') { first_line = first_line + 1; }
        pfx = pfx + 1;
    }
    var sfx: usize = 0;
    for (sfx < (old_n - pfx) && sfx < (new_n - pfx) && old_p[old_n - 1 - sfx] == new_p[new_n - 1 - sfx]) {
        sfx = sfx + 1;
    }
    val diff_end: usize = new_n - sfx;
    var last_line: i64 = first_line;
    var k: usize = pfx;
    for (k < diff_end) {
        if (new_p[k] == '\n' && k + 1 < diff_end) { last_line = last_line + 1; }
        k = k + 1;
    }
    if (first_line > total_new) { first_line = total_new; }
    if (last_line < first_line) { last_line = first_line; }
    if (last_line > total_new) { last_line = total_new; }
    @out_lo = first_line;
    @out_hi = last_line;
}

fun txn_id(out: *u8) {
    var rnd: [8]u8;
    rand.fill(?rnd[0], 8);
    util.fmt_hex(out, 17, ?rnd[0], 8);
}

# templates outside the spec: this session's, then the workspace's, then qark's own
fun lib_find(ctx: *u8, name: str, out: *spec.Tpl) bool {
    val s: *session.Session = ctx::*session.Session;
    var i: usize = 0;
    for (i < s.tpls.len) {
        val stpl: *spec.Tpl = ?s.tpls.data[i];
        val root_ok: bool = stpl.root == nil || s.root == nil || util.eq(stpl.root, s.root);
        if (root_ok && util.eq(stpl.name, name)) {
            @out = @stpl;
            ret true;
        }
        i = i + 1;
    }
    if (pathx.check(name) == pathx.P_OK) {
        var w: jw.Jw = jw.init(?s.ra);
        jw.raw(?w, ".qark/templates/");
        jw.raw(?w, name);
        jw.raw(?w, ".tmpl");
        if (!w.failed && w.buf != nil && commit.check_ancestry(?s.ra, s.root, w.buf) == nil) {
            val full: res[str, A.Error] = pathx.native(?s.ra, s.root, w.buf);
            if (sel full.ok) {
                val tm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(full.ok);
                if (sel tm.ok && tm.ok.kind == filesystem.KIND_FILE) {
                    val text: res[str, filesystem.FsError] = filesystem.read_string(?s.ra, full.ok);
                    if (sel text.ok) {
                        out.name = name;
                        out.lang = spec.lang_of(name);
                        out.body = text.ok;
                        out.len = str_len(text.ok);
                        out.src = "workspace";
                        out.desc = nil;
                        var path_w: jw.Jw = jw.init(?s.ra);
                        jw.raw(?path_w, ".qark/templates/");
                        jw.raw(?path_w, name);
                        jw.raw(?path_w, ".path");
                        val prel: str = jw.text(?path_w);
                        if (commit.check_ancestry(?s.ra, s.root, prel) == nil) {
                            val path_full: res[str, A.Error] = pathx.native(?s.ra, s.root, prel);
                            if (sel path_full.ok) {
                                val pm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(path_full.ok);
                                if (sel pm.ok && pm.ok.kind == filesystem.KIND_FILE) {
                                    val pat: res[str, filesystem.FsError] = filesystem.read_string(?s.ra, path_full.ok);
                                    if (sel pat.ok) { out.pathpat = pat.ok; }
                                }
                            }
                        }
                        ret true;
                    }
                }
            }
        }
    }
    ret builtin.find(name, out);
}

fun file_receipt(w: *jw.Jw, a: *A.Allocator, e: *commit.Entry, dry: bool, preview: bool, show_diff: bool) {
    jw.obj(w);
    jw.f_str(w, "path", e.rel);
    if (dry) { jw.f_str(w, "status", commit.plan_name(e.status)); }
    or { jw.f_str(w, "status", commit.status_name(e.status)); }
    if (e.status == commit.ST_CONFLICT) {
        jw.f_str(w, "reason", e.reason);
        jw.f_str(w, "message", commit.reason_message(e.reason));
        if (e.existed) { jw.f_str(w, "current_sha256", ?e.old_sha[0]); }
    }
    if (e.has_expect && e.status != commit.ST_CONFLICT) {
        jw.f_bool(w, "precondition_matched", true);
    }
    if (e.status == commit.ST_UNCHANGED) {
        if (e.edited) {
            jw.f_str(w, "reason", "no_change");
            jw.f_str(w, "message", "the edits produced the same bytes already on disk");
        }
        or {
            jw.f_str(w, "reason", "same_content");
            jw.f_str(w, "message", "the file already has this content");
        }
    }
    if (e.notes.len > 0) {
        jw.key(w, "notes");
        jw.arr(w);
        var ni: usize = 0;
        for (ni < e.notes.len) {
            jw.str_v(w, e.notes.data[ni]);
            ni = ni + 1;
        }
        jw.arr_end(w);
    }
    if (e.mode != commit.MODE_DELETE) {
        jw.f_str(w, "sha256", ?e.sha[0]);
        jw.f_i64(w, "bytes", e.len::i64);
        jw.f_i64(w, "lines", lines_of(e.data, e.len));
    }
    if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
        var clo: i64 = 0;
        var chi: i64 = 0;
        var oldp: *u8 = e.old;
        var oldn: usize = e.old_len;
        if (!e.existed) { oldp = nil; oldn = 0; }
        changed_line_range(oldp, oldn, e.data, e.len, ?clo, ?chi);
        if (clo > 0 && chi >= clo) {
            jw.key(w, "changed_lines");
            jw.arr(w);
            jw.i64_v(w, clo);
            jw.i64_v(w, chi);
            jw.arr_end(w);
        }
    }
    if (e.existed && (e.status == commit.ST_REPLACE || e.status == commit.ST_DELETE)) {
        jw.f_str(w, "prev_sha256", ?e.old_sha[0]);
    }
    if (e.rebased) {
        jw.f_bool(w, "rebased", true);
        jw.f_str(w, "base_sha256", ?e.base_sha[0]);
    }
    if (e.lang != nil) { jw.f_str(w, "lang", e.lang); }
    if (e.check != commit.CK_NONE) {
        jw.f_str(w, "check", check.check_name(e.check));
        if (e.check == commit.CK_FAILED) {
            if (e.ck_line > 0) { jw.f_i64(w, "line", e.ck_line); }
            if (e.ck_col > 0) { jw.f_i64(w, "col", e.ck_col); }
        }
        if (e.ck_cat != nil && e.check != commit.CK_OK) { jw.f_str(w, "check_category", e.ck_cat); }
        if (e.ck_msg != nil && e.check != commit.CK_OK) { jw.f_str(w, "check_message", e.ck_msg); }
        if (e.check == commit.CK_ERROR) {
            if (e.ck_exe != nil) { jw.f_str(w, "check_executable", e.ck_exe); }
            jw.f_i64(w, "check_exit_code", e.ck_exit);
            if (e.ck_stderr != nil) { jw.f_str(w, "check_stderr", e.ck_stderr); }
        }
    }
    var sl: str = e.lang;
    if (sl == nil) { sl = scan.outline_lang(e.rel); }
    if (sl != nil && (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE || e.status == commit.ST_DELETE)) {
        var sop: *u8 = e.old;
        var son: usize = e.old_len;
        var snp: *u8 = e.data;
        var snn: usize = e.len;
        if (!e.existed) { sop = nil; son = 0; }
        if (e.status == commit.ST_DELETE) { snp = nil; snn = 0; }
        if (sop == nil) { son = 0; }
        if (snp == nil) { snn = 0; }
        scan.semantic_diff(a, sl, sop, son, snp, snn, w);
    }
    if (show_diff && (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE || e.status == commit.ST_DELETE)) {
        var op: *u8 = e.old;
        var on: usize = e.old_len;
        var np: *u8 = e.data;
        var nn: usize = e.len;
        if (!e.existed) { op = nil; on = 0; }
        if (e.status == commit.ST_DELETE) { np = nil; nn = 0; }
        if (op == nil) { on = 0; }
        if (np == nil) { nn = 0; }
        var dw: jw.Jw = jw.init(a);
        diff.unified(a, op, on, np, nn, ?dw);
        if (!dw.failed && dw.len > 0) {
            jw.key(w, "diff");
            jw.str_n(w, dw.buf, dw.len);
        }
    }
    if (preview && e.mode != commit.MODE_DELETE) {
        val n: usize = truncate_utf8_len(e.data, e.len, READ_MAX);
        jw.key(w, "text");
        jw.str_n(w, e.data, n);
        if (n < e.len) { jw.f_bool(w, "truncated", true); }
    }
    if (e.rollback_state == commit.RB_RESTORED) {
        jw.f_str(w, "rollback_state", "restored");
    }
    or (e.rollback_state == commit.RB_FAILED) {
        jw.f_str(w, "rollback_state", "failed");
    }
    jw.obj_end(w);
}

fun files_list(w: *jw.Jw, set: *commit.Set, dry: bool, preview: bool, only_problems: bool, show_diff: bool, a: *A.Allocator) {
    jw.key(w, "files");
    jw.arr(w);
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        val problem: bool = e.status == commit.ST_CONFLICT || e.check == commit.CK_FAILED || e.check == commit.CK_ERROR;
        if (!only_problems || problem) { file_receipt(w, a, e, dry, preview, show_diff); }
        i = i + 1;
    }
    jw.arr_end(w);
}

fun counts(w: *jw.Jw, set: *commit.Set) {
    jw.f_i64(w, "created", commit.tally(set, commit.ST_CREATE));
    jw.f_i64(w, "replaced", commit.tally(set, commit.ST_REPLACE));
    jw.f_i64(w, "unchanged", commit.tally(set, commit.ST_UNCHANGED));
    jw.f_i64(w, "deleted", commit.tally(set, commit.ST_DELETE));
}

fun check_tally(set: *commit.Set, ck: u8) i64 {
    var n: i64 = 0;
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.check == ck && (e.lang != nil || e.custom_check)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun entry_eff_policy(sp_check: u8, e: *commit.Entry) u8 {
    if (e.check_policy == commit.CP_OFF) { ret spec.CHECK_OFF; }
    if (e.check_policy == commit.CP_REQUIRED) { ret spec.CHECK_REQUIRED; }
    if (e.check_policy == commit.CP_PERMISSIVE) { ret spec.CHECK_PERMISSIVE; }
    if (e.check_policy == commit.CP_STRICT) { ret spec.CHECK_ON; }
    ret sp_check;
}

fun check_policy_name(chk: u8) str {
    if (chk == spec.CHECK_OFF) { ret "off"; }
    if (chk == spec.CHECK_REQUIRED) { ret "required"; }
    if (chk == spec.CHECK_PERMISSIVE) { ret "permissive"; }
    ret "strict";
}

fun is_validation_complete(set: *commit.Set, chk: u8, val_ran: bool, val_ok: bool) bool {
    if (chk == spec.CHECK_OFF || chk == spec.CHECK_PERMISSIVE) { ret false; }
    if (val_ran && !val_ok) { ret false; }
    var ok_n: i64 = 0;
    var unchk_n: i64 = 0;
    var del_n: i64 = 0;
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
            val pol: u8 = entry_eff_policy(chk, e);
            if (pol == spec.CHECK_OFF || pol == spec.CHECK_PERMISSIVE) { ret false; }
            if (e.check == commit.CK_OK) { ok_n = ok_n + 1; }
            or (e.check == commit.CK_NONE) { unchk_n = unchk_n + 1; }
            or { ret false; }
        }
        or (e.status == commit.ST_DELETE) {
            val dpol: u8 = entry_eff_policy(chk, e);
            if (dpol == spec.CHECK_OFF || dpol == spec.CHECK_PERMISSIVE) { ret false; }
            del_n = del_n + 1;
        }
        i = i + 1;
    }
    if (unchk_n > 0 && !(val_ran && val_ok)) { ret false; }
    if (ok_n == 0 && !(val_ran && val_ok)) {
        if (unchk_n == 0 && del_n > 0) { ret true; }
        ret false;
    }
    ret true;
}

fun emit_checks_summary(w: *jw.Jw, set: *commit.Set) {
    var ok_n: i64 = 0;
    var fail_n: i64 = 0;
    var err_n: i64 = 0;
    var skip_n: i64 = 0;
    var unchk_n: i64 = 0;
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
            if (e.check == commit.CK_OK) { ok_n = ok_n + 1; }
            or (e.check == commit.CK_FAILED) { fail_n = fail_n + 1; }
            or (e.check == commit.CK_ERROR) { err_n = err_n + 1; }
            or (e.check == commit.CK_SKIPPED) { skip_n = skip_n + 1; }
            or { unchk_n = unchk_n + 1; }
        }
        i = i + 1;
    }
    jw.key(w, "checks");
    jw.obj(w);
    jw.f_i64(w, "ok", ok_n);
    jw.f_i64(w, "failed", fail_n);
    jw.f_i64(w, "error", err_n);
    jw.f_i64(w, "skipped", skip_n);
    jw.f_i64(w, "unchecked", unchk_n);
    jw.obj_end(w);
}

fun emit_checker_diagnostics(w: *jw.Jw, set: *commit.Set) {
    var first: *commit.Entry = nil;
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.check == commit.CK_ERROR && first == nil) {
            first = e;
        }
        i = i + 1;
    }
    if (first == nil) { ret; }
    jw.key(w, "checker_diagnostics");
    jw.obj(w);
    if (first.ck_cat != nil) { jw.f_str(w, "category", first.ck_cat); }
    or { jw.f_str(w, "category", "checker_error"); }
    if (first.lang != nil) { jw.f_str(w, "lang", first.lang); }
    if (first.ck_exe != nil) { jw.f_str(w, "executable", first.ck_exe); }
    jw.f_i64(w, "exit_code", first.ck_exit);
    if (first.ck_msg != nil) { jw.f_str(w, "message", first.ck_msg); }
    if (first.ck_stderr != nil) { jw.f_str(w, "stderr", first.ck_stderr); }
    jw.key(w, "affected_files");
    jw.arr(w);
    i = 0;
    for (i < commit.count(set)) {
        val e2: *commit.Entry = commit.entry(set, i);
        if (e2.check == commit.CK_ERROR) {
            jw.str_v(w, e2.rel);
        }
        i = i + 1;
    }
    jw.arr_end(w);
    jw.obj_end(w);
}

fun build_journal_line(s: *session.Session, sp: *spec.Spec, txn: *u8, val_ran: bool, val_ok: bool, out_buf: **u8, out_len: *usize) bool {
    var w: jw.Jw = jw.init(?s.ra);
    jw.obj(?w);
    jw.f_i64(?w, "v", 2);
    jw.f_str(?w, "event", "transaction.committed");
    val clock: time.Clock = time.now();
    if (sel clock.ok) { jw.f_i64(?w, "ts_ms", time.time_unix_msec(clock.ok)); }
    jw.f_str(?w, "txn", txn);
    if (sp.job != nil) { jw.f_str(?w, "job", sp.job); }
    if (sp.tag != nil) { jw.f_str(?w, "tag", sp.tag); }
    jw.f_str(?w, "spec_sha256", ?sp.sha[0]);
    jw.f_str(?w, "check_policy", check_policy_name(sp.check));
    jw.f_bool(?w, "validation_complete", is_validation_complete(?sp.set, sp.check, val_ran, val_ok));
    jw.f_i64(?w, "created", commit.tally(?sp.set, commit.ST_CREATE));
    jw.f_i64(?w, "replaced", commit.tally(?sp.set, commit.ST_REPLACE));
    jw.f_i64(?w, "deleted", commit.tally(?sp.set, commit.ST_DELETE));
    jw.key(?w, "files");
    jw.arr(?w);
    var i: usize = 0;
    for (i < commit.count(?sp.set)) {
        val e: *commit.Entry = commit.entry(?sp.set, i);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE || e.status == commit.ST_DELETE) {
            jw.obj(?w);
            jw.f_str(?w, "path", e.rel);
            jw.f_str(?w, "status", commit.status_name(e.status));
            if (e.mode != commit.MODE_DELETE) { jw.f_str(?w, "sha256", ?e.sha[0]); }
            if (e.existed) { jw.f_str(?w, "prev_sha256", ?e.old_sha[0]); }
            if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
                var clo: i64 = 0;
                var chi: i64 = 0;
                var oldp: *u8 = e.old;
                var oldn: usize = e.old_len;
                if (!e.existed) { oldp = nil; oldn = 0; }
                changed_line_range(oldp, oldn, e.data, e.len, ?clo, ?chi);
                if (clo > 0 && chi >= clo) {
                    jw.key(?w, "changed_lines");
                    jw.arr(?w);
                    jw.i64_v(?w, clo);
                    jw.i64_v(?w, chi);
                    jw.arr_end(?w);
                }
            }
            jw.obj_end(?w);
        }
        i = i + 1;
    }
    jw.arr_end(?w);
    jw.obj_end(?w);
    jw.byte(?w, '\n');
    if (w.failed || w.buf == nil) { ret false; }
    @out_buf = w.buf;
    @out_len = w.len;
    ret true;
}

fun build_undo_journal_line(s: *session.Session, set: *commit.Set, ev_name: str, txn: *u8, target_txn: str, out_buf: **u8, out_len: *usize) bool {
    var w: jw.Jw = jw.init(?s.ra);
    jw.obj(?w);
    jw.f_i64(?w, "v", 2);
    jw.f_str(?w, "event", ev_name);
    val clock: time.Clock = time.now();
    if (sel clock.ok) { jw.f_i64(?w, "ts_ms", time.time_unix_msec(clock.ok)); }
    jw.f_str(?w, "txn", txn);
    jw.f_str(?w, "target_txn", target_txn);
    jw.f_i64(?w, "created", commit.tally(set, commit.ST_CREATE));
    jw.f_i64(?w, "replaced", commit.tally(set, commit.ST_REPLACE));
    jw.f_i64(?w, "deleted", commit.tally(set, commit.ST_DELETE));
    jw.key(?w, "files");
    jw.arr(?w);
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE || e.status == commit.ST_DELETE) {
            jw.obj(?w);
            jw.f_str(?w, "path", e.rel);
            jw.f_str(?w, "status", commit.status_name(e.status));
            if (e.mode != commit.MODE_DELETE) { jw.f_str(?w, "sha256", ?e.sha[0]); }
            if (e.existed) { jw.f_str(?w, "prev_sha256", ?e.old_sha[0]); }
            jw.obj_end(?w);
        }
        i = i + 1;
    }
    jw.arr_end(?w);
    jw.obj_end(?w);
    jw.byte(?w, '\n');
    if (w.failed || w.buf == nil) { ret false; }
    @out_buf = w.buf;
    @out_len = w.len;
    ret true;
}

fun sync_path(p: str) bool {
    ret commit.sync_file(p);
}

fun find_val(obj: *json.Value, key: str) *json.Value {
    if (obj == nil) { ret nil; }
    val f: opt[*json.Value] = json.value_find(obj, key);
    if (sel f.some) { ret f.some; }
    ret nil;
}

fun get_val(arr: *json.Value, idx: usize) *json.Value {
    if (arr == nil) { ret nil; }
    val g: opt[*json.Value] = json.value_get(arr, idx);
    if (sel g.some) { ret g.some; }
    ret nil;
}

fun json_opt_str_eq(a: *A.Allocator, d1: *json.Value, d2: *json.Value, key: str) bool {
    val v1: *json.Value = find_val(d1, key);
    val v2: *json.Value = find_val(d2, key);
    if (v1 == nil && v2 == nil) { ret true; }
    if (v1 == nil || v2 == nil) { ret false; }
    if (!json.value_is_string(v1) || !json.value_is_string(v2)) { ret false; }
    var s1: *u8 = nil;
    var n1: usize = 0;
    var s2: *u8 = nil;
    var n2: usize = 0;
    if (!spec.decode_pub(a, v1, ?s1, ?n1) || !spec.decode_pub(a, v2, ?s2, ?n2)) { ret false; }
    if (s1 == nil || s2 == nil || n1 != n2) { ret false; }
    ret util.mem_eq(s1, s2, n1);
}

fun json_opt_i64_eq(d1: *json.Value, d2: *json.Value, key: str) bool {
    val v1: *json.Value = find_val(d1, key);
    val v2: *json.Value = find_val(d2, key);
    if (v1 == nil && v2 == nil) { ret true; }
    if (v1 == nil || v2 == nil) { ret false; }
    if (!json.value_is_number(v1) || json.value_is_float(v1)) { ret false; }
    if (!json.value_is_number(v2) || json.value_is_float(v2)) { ret false; }
    ret json.value_number(v1) == json.value_number(v2);
}

fun json_opt_bool_eq(d1: *json.Value, d2: *json.Value, key: str) bool {
    val v1: *json.Value = find_val(d1, key);
    val v2: *json.Value = find_val(d2, key);
    if (v1 == nil && v2 == nil) { ret true; }
    if (v1 == nil || v2 == nil) { ret false; }
    if (!json.value_is_bool(v1) || !json.value_is_bool(v2)) { ret false; }
    ret json.value_bool(v1) == json.value_bool(v2);
}

fun validate_journal_record(a: *A.Allocator, doc: *json.Value, out_txn: **u8, out_txn_n: *usize) bool {
    @out_txn = nil;
    @out_txn_n = 0;
    if (doc == nil || !json.value_is_object(doc)) { ret false; }
    val tf: *json.Value = find_val(doc, "txn");
    if (tf == nil || !json.value_is_string(tf)) { ret false; }
    var ltxn: *u8 = nil;
    var ltxn_n: usize = 0;
    if (!spec.decode_pub(a, tf, ?ltxn, ?ltxn_n) || ltxn == nil || ltxn_n == 0 || pathx.check(ltxn) != pathx.P_OK) {
        ret false;
    }
    val ff: *json.Value = find_val(doc, "files");
    if (ff == nil || !json.value_is_array(ff)) { ret false; }
    val fcnt: usize = json.value_count(ff);
    var fi: usize = 0;
    for (fi < fcnt) {
        val fg: *json.Value = get_val(ff, fi);
        if (fg == nil || !json.value_is_object(fg)) { ret false; }
        val fpf: *json.Value = find_val(fg, "path");
        val fstf: *json.Value = find_val(fg, "status");
        if (fpf == nil || !json.value_is_string(fpf) || fstf == nil || !json.value_is_string(fstf)) {
            ret false;
        }
        var fp: *u8 = nil;
        var fpn: usize = 0;
        var fst: *u8 = nil;
        var fstn: usize = 0;
        if (!spec.decode_pub(a, fpf, ?fp, ?fpn) || fp == nil || fpn == 0 || pathx.check(fp) != pathx.P_OK) {
            ret false;
        }
        if (!spec.decode_pub(a, fstf, ?fst, ?fstn) || fst == nil) {
            ret false;
        }
        val is_cr: bool = util.eq(fst, "created");
        val is_rp: bool = util.eq(fst, "replaced");
        val is_dl: bool = util.eq(fst, "deleted");
        if (!is_cr && !is_rp && !is_dl) { ret false; }
        if (is_cr || is_rp) {
            val fshf: *json.Value = find_val(fg, "sha256");
            var fsh: *u8 = nil;
            var fshn: usize = 0;
            if (fshf == nil || !json.value_is_string(fshf) || !spec.decode_pub(a, fshf, ?fsh, ?fshn) || fsh == nil || fshn != 64) {
                ret false;
            }
        }
        val fpsf: *json.Value = find_val(fg, "prev_sha256");
        if (fpsf != nil) {
            var fpsh: *u8 = nil;
            var fpshn: usize = 0;
            if (!json.value_is_string(fpsf) || !spec.decode_pub(a, fpsf, ?fpsh, ?fpshn) || fpsh == nil || fpshn != 64) {
                ret false;
            }
        }
        fi = fi + 1;
    }
    val vf: *json.Value = find_val(doc, "v");
    if (vf != nil) {
        if (!json.value_is_number(vf) || json.value_is_float(vf) || json.value_number(vf) != 2) {
            ret false;
        }
        val tsf: *json.Value = find_val(doc, "ts_ms");
        if (tsf == nil || !json.value_is_number(tsf) || json.value_is_float(tsf)) {
            ret false;
        }
        val crf: *json.Value = find_val(doc, "created");
        val rpf: *json.Value = find_val(doc, "replaced");
        val dlf: *json.Value = find_val(doc, "deleted");
        if (crf == nil || !json.value_is_number(crf) || json.value_is_float(crf) || json.value_number(crf) < 0) { ret false; }
        if (rpf == nil || !json.value_is_number(rpf) || json.value_is_float(rpf) || json.value_number(rpf) < 0) { ret false; }
        if (dlf == nil || !json.value_is_number(dlf) || json.value_is_float(dlf) || json.value_number(dlf) < 0) { ret false; }
        val evf: *json.Value = find_val(doc, "event");
        var ev_p: *u8 = nil;
        var ev_n: usize = 0;
        if (evf == nil || !json.value_is_string(evf) || !spec.decode_pub(a, evf, ?ev_p, ?ev_n) || ev_p == nil) {
            ret false;
        }
        if (util.eq(ev_p, "transaction.committed")) {
            val ssf: *json.Value = find_val(doc, "spec_sha256");
            var ssp: *u8 = nil;
            var ssn: usize = 0;
            if (ssf == nil || !json.value_is_string(ssf) || !spec.decode_pub(a, ssf, ?ssp, ?ssn) || ssp == nil || ssn != 64) {
                ret false;
            }
            val cpf: *json.Value = find_val(doc, "check_policy");
            var cpp: *u8 = nil;
            var cpn: usize = 0;
            if (cpf == nil || !json.value_is_string(cpf) || !spec.decode_pub(a, cpf, ?cpp, ?cpn) || cpp == nil || cpn == 0) {
                ret false;
            }
            val vcf: *json.Value = find_val(doc, "validation_complete");
            if (vcf == nil || !json.value_is_bool(vcf)) {
                ret false;
            }
        }
        or (util.eq(ev_p, "transaction.undone") || util.eq(ev_p, "transaction.redone")) {
            var has_tgt: bool = false;
            val tgf1: *json.Value = find_val(doc, "target_txn");
            val tgf2: *json.Value = find_val(doc, "reverted_txn");
            val tgf3: *json.Value = find_val(doc, "redone_txn");
            var tgp: *u8 = nil;
            var tgn: usize = 0;
            if (tgf1 != nil && json.value_is_string(tgf1) && spec.decode_pub(a, tgf1, ?tgp, ?tgn) && tgp != nil && tgn > 0 && pathx.check(tgp) == pathx.P_OK) {
                has_tgt = true;
            }
            or (tgf2 != nil && json.value_is_string(tgf2) && spec.decode_pub(a, tgf2, ?tgp, ?tgn) && tgp != nil && tgn > 0 && pathx.check(tgp) == pathx.P_OK) {
                has_tgt = true;
            }
            or (tgf3 != nil && json.value_is_string(tgf3) && spec.decode_pub(a, tgf3, ?tgp, ?tgn) && tgp != nil && tgn > 0 && pathx.check(tgp) == pathx.P_OK) {
                has_tgt = true;
            }
            if (!has_tgt) { ret false; }
        }
        or {
            ret false;
        }
    }
    or {
        val ts1: *json.Value = find_val(doc, "ts");
        if (ts1 == nil || !json.value_is_number(ts1) || json.value_is_float(ts1)) {
            ret false;
        }
    }
    @out_txn = ltxn;
    @out_txn_n = ltxn_n;
    ret true;
}

fun journal_records_match(a: *A.Allocator, d1: *json.Value, d2: *json.Value) bool {
    if (!json_opt_i64_eq(d1, d2, "v")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "event")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "txn")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "job")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "tag")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "spec_sha256")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "target_txn")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "reverted_txn")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "redone_txn")) { ret false; }
    if (!json_opt_str_eq(a, d1, d2, "check_policy")) { ret false; }
    if (!json_opt_bool_eq(d1, d2, "validation_complete")) { ret false; }
    if (!json_opt_i64_eq(d1, d2, "created")) { ret false; }
    if (!json_opt_i64_eq(d1, d2, "replaced")) { ret false; }
    if (!json_opt_i64_eq(d1, d2, "deleted")) { ret false; }
    val ff1: *json.Value = find_val(d1, "files");
    val ff2: *json.Value = find_val(d2, "files");
    if (ff1 == nil || ff2 == nil || !json.value_is_array(ff1) || !json.value_is_array(ff2)) {
        ret false;
    }
    val cnt: usize = json.value_count(ff1);
    if (cnt != json.value_count(ff2)) { ret false; }
    var i: usize = 0;
    for (i < cnt) {
        val g1: *json.Value = get_val(ff1, i);
        val g2: *json.Value = get_val(ff2, i);
        if (g1 == nil || g2 == nil || !json.value_is_object(g1) || !json.value_is_object(g2)) {
            ret false;
        }
        if (!json_opt_str_eq(a, g1, g2, "path")) { ret false; }
        if (!json_opt_str_eq(a, g1, g2, "status")) { ret false; }
        if (!json_opt_str_eq(a, g1, g2, "sha256")) { ret false; }
        if (!json_opt_str_eq(a, g1, g2, "prev_sha256")) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ensure_journal_line(a: *A.Allocator, root: str, set: *commit.Set, txn: *u8, line_p: *u8, line_n: usize, out_off: *i64) bool {
    @out_off = -1;
    if (line_p == nil || line_n == 0) { ret true; }
    if (txn == nil || txn[0] == 0) { ret false; }
    if (!commit.check_control_dir(a, root)) { ret false; }
    var exp_len: usize = line_n;
    for (exp_len > 0 && (line_p[exp_len - 1] == '\n' || line_p[exp_len - 1] == '\r')) {
        exp_len = exp_len - 1;
    }
    if (exp_len == 0) { ret false; }
    val exp_parsed: res[json.Value, json.JsonError] = json.parse(line_p, exp_len, a);
    if (sel exp_parsed.err) { ret false; }
    var exp_doc: json.Value = exp_parsed.ok;
    var exp_txn: *u8 = nil;
    var exp_txn_n: usize = 0;
    if (!validate_journal_record(a, ?exp_doc, ?exp_txn, ?exp_txn_n) || !util.eq(exp_txn, txn)) {
        ret false;
    }
    val jfull: res[str, A.Error] = pathx.native(a, root, ".qark/journal.ndjson");
    if (sel jfull.err) { ret false; }
    val jm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(jfull.ok);
    if (sel jm.err) {
        if (jm.err.kind == io_error.NOT_FOUND || jm.err.kind == io_error.NOT_DIRECTORY) {
            val off0: i64 = commit.journal(set, line_p, line_n);
            if (off0 < 0) { ret false; }
            @out_off = off0;
            ret true;
        }
        ret false;
    }
    if (jm.ok.kind != filesystem.KIND_FILE) { ret false; }
    val jbytes: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, jfull.ok);
    if (sel jbytes.err) { ret false; }
    val jp: *u8 = jbytes.ok.data;
    val jn: usize = jbytes.ok.len;
    if (jn == 0 || jp == nil) {
        val off1: i64 = commit.journal(set, line_p, line_n);
        if (off1 < 0) { ret false; }
        @out_off = off1;
        ret true;
    }
    var seen_txns: vector.Vector[str] = vector.init[str](a);
    var pos: usize = 0;
    var valid_end: usize = 0;
    var found_off: i64 = -1;
    var has_torn_tail: bool = false;
    for (pos < jn) {
        var nl: usize = pos;
        for (nl < jn && jp[nl] != '\n') { nl = nl + 1; }
        if (nl == jn) {
            has_torn_tail = true;
            brk;
        }
        var le: usize = nl;
        if (le > pos && jp[le - 1] == '\r') { le = le - 1; }
        var line_valid: bool = false;
        var ltxn: *u8 = nil;
        var ltxn_n: usize = 0;
        var doc: json.Value;
        if (le > pos) {
            val parsed: res[json.Value, json.JsonError] = json.parse((jp::usize + pos)::*u8, le - pos, a);
            if (sel parsed.ok) {
                doc = parsed.ok;
                if (validate_journal_record(a, ?doc, ?ltxn, ?ltxn_n)) {
                    line_valid = true;
                }
            }
        }
        if (!line_valid) {
            if (nl + 1 == jn && found_off < 0) {
                has_torn_tail = true;
                brk;
            }
            ret false;
        }
        var si: usize = 0;
        for (si < seen_txns.len) {
            if (util.eq(seen_txns.data[si], ltxn)) {
                ret false;
            }
            si = si + 1;
        }
        vector.push[str](?seen_txns, ltxn);
        if (util.eq(ltxn, txn)) {
            if (!journal_records_match(a, ?doc, ?exp_doc)) {
                ret false;
            }
            found_off = pos::i64;
        }
        valid_end = nl + 1;
        pos = nl + 1;
    }
    if (found_off >= 0) {
        if (has_torn_tail) {
            ret false;
        }
        @out_off = found_off;
        ret true;
    }
    if (!has_torn_tail) {
        val off: i64 = commit.journal(set, line_p, line_n);
        if (off < 0) { ret false; }
        @out_off = off;
        ret true;
    }
    val tail_p: *u8 = (jp::usize + valid_end)::*u8;
    val tail_n: usize = jn - valid_end;
    if (tail_n == 0 || tail_n >= line_n || !util.mem_eq(tail_p, line_p, tail_n)) {
        ret false;
    }
    val total_n: usize = valid_end + line_n;
    val buf: res[*u8, A.Error] = A.allocate[u8](a, total_n + 1);
    if (sel buf.err) { ret false; }
    var bi: usize = 0;
    for (bi < valid_end) {
        buf.ok[bi] = jp[bi];
        bi = bi + 1;
    }
    var li: usize = 0;
    for (li < line_n) {
        buf.ok[valid_end + li] = line_p[li];
        li = li + 1;
    }
    buf.ok[total_n] = 0;
    val wr_rep: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, jfull.ok, buf.ok, total_n, 384, 448);
    if (sel wr_rep.err) { ret false; }
    if (set.durable && (set.fail_sync || !sync_path(jfull.ok) || !commit.sync_parent_dir(a, jfull.ok))) { ret false; }
    @out_off = valid_end::i64;
    ret true;
}

fun peek_journal_offset(a: *A.Allocator, root: str) i64 {
    val jfull: res[str, A.Error] = pathx.native(a, root, ".qark/journal.ndjson");
    if (sel jfull.err) { ret 0; }
    val jm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(jfull.ok);
    if (sel jm.ok) {
        if (jm.ok.kind == filesystem.KIND_FILE) {
            ret jm.ok.size::i64;
        }
    }
    ret 0;
}

fun emit_hex_field(a: *A.Allocator, w: *jw.Jw, key: str, data: *u8, len: usize) {
    val hlen: usize = len * 2 + 1;
    val got: res[*u8, A.Error] = A.allocate[u8](a, hlen);
    if (sel got.ok) {
        val n: usize = util.fmt_hex(got.ok, hlen, data, len);
        jw.f_strn(w, key, got.ok, n);
    }
    or {
        w.failed = true;
    }
}

fun emit_set_files_snapshot(a: *A.Allocator, w: *jw.Jw, set: *commit.Set) bool {
    jw.key(w, "files");
    jw.arr(w);
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE || e.status == commit.ST_DELETE) {
            if (e.mode != commit.MODE_DELETE && (e.len > spec.MAX_FILE_BYTES || (e.len > 0 && e.data == nil))) {
                ret false;
            }
            if (e.existed && (e.old_len > spec.MAX_FILE_BYTES || (e.old_len > 0 && e.old == nil))) {
                ret false;
            }
            jw.obj(w);
            jw.f_str(w, "path", e.rel);
            jw.f_str(w, "status", commit.status_name(e.status));
            if (e.exec) { jw.f_bool(w, "exec", true); }
            if (e.has_target_perm) { jw.f_bool(w, "has_target_perm", true); }
            if (e.has_target_perm || e.target_perm != 0) { jw.f_i64(w, "target_perm", e.target_perm::i64); }
            if (e.mode != commit.MODE_DELETE) {
                jw.f_i64(w, "published_perm", commit.perm_for(e)::i64);
                jw.f_str(w, "sha256", ?e.sha[0]);
                if (e.len == 0) {
                    jw.f_str(w, "new_text", "");
                }
                or {
                    if (utf8.validate(e.data, e.len)) {
                        jw.f_strn(w, "new_text", e.data, e.len);
                    }
                    or {
                        emit_hex_field(a, w, "new_hex", e.data, e.len);
                    }
                }
            }
            if (e.existed) {
                jw.f_str(w, "prev_sha256", ?e.old_sha[0]);
                jw.f_i64(w, "old_perm", (e.old_perm & 511)::i64);
                if (e.old_len == 0) {
                    jw.f_str(w, "old_text", "");
                }
                or {
                    if (utf8.validate(e.old, e.old_len)) {
                        jw.f_strn(w, "old_text", e.old, e.old_len);
                    }
                    or {
                        emit_hex_field(a, w, "old_hex", e.old, e.old_len);
                    }
                }
            }
            jw.obj_end(w);
        }
        i = i + 1;
    }
    jw.arr_end(w);
    ret !w.failed;
}

fun write_undo_snapshot(s: *session.Session, sp: *spec.Spec, txn: *u8) bool {
    val a: *A.Allocator = ?s.ra;
    if (!commit.check_control_dir(a, s.root)) { ret false; }
    val lat_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/latest");
    var prev_p: *u8 = nil;
    var prev_n: usize = 0;
    if (sel lat_full.ok) {
        val lat_txt: res[str, filesystem.FsError] = filesystem.read_string(a, lat_full.ok);
        if (sel lat_txt.ok) {
            var lp: *u8 = lat_txt.ok;
            var ln: usize = str_len(lp);
            for (ln > 0 && (lp[ln - 1] == '\n' || lp[ln - 1] == '\r' || lp[ln - 1] == ' ')) { ln = ln - 1; }
            if (ln > 0) {
                prev_p = lp;
                prev_n = ln;
            }
        }
    }
    var w: jw.Jw = jw.init(a);
    jw.obj(?w);
    jw.f_str(?w, "txn", txn);
    if (sp.tag != nil) { jw.f_str(?w, "tag", sp.tag); }
    if (prev_p != nil && prev_n > 0) {
        jw.f_strn(?w, "prev_txn", prev_p, prev_n);
    }
    if (!emit_set_files_snapshot(a, ?w, ?sp.set)) { ret false; }
    jw.obj_end(?w);
    jw.byte(?w, '\n');
    if (w.failed || w.buf == nil) { ret false; }
    var pw: jw.Jw = jw.init(a);
    jw.raw(?pw, ".qark/undo/");
    jw.raw(?pw, txn);
    jw.raw(?pw, ".json");
    val snap_full: res[str, A.Error] = pathx.native(a, s.root, jw.text(?pw));
    if (sel snap_full.err) { ret false; }
    val wrote: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, snap_full.ok, w.buf, w.len, 384, 448);
    if (sel wrote.err) { ret false; }
    if (sp.set.durable && !commit.sync_parent_dir(a, snap_full.ok)) { ret false; }
    ret true;
}

fun commit_undo_pointers(s: *session.Session, txn: *u8) bool {
    val a: *A.Allocator = ?s.ra;
    if (!commit.check_control_dir(a, s.root)) { ret false; }
    val lat_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/latest");
    if (sel lat_full.err) { ret false; }
    val wrote: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, lat_full.ok, txn, str_len(txn), 384, 448);
    if (sel wrote.err) { ret false; }
    val redo_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/redo");
    if (sel redo_full.err) { ret false; }
    val rm: err[io_error.Error] = filesystem.remove_file(redo_full.ok);
    if (sel rm.err) {
        if (rm.err.kind != io_error.NOT_FOUND) { ret false; }
    }
    ret true;
}

fun remove_undo_snapshot(a: *A.Allocator, root: str, txn: *u8, durable: bool) {
    var pw: jw.Jw = jw.init(a);
    jw.raw(?pw, ".qark/undo/");
    jw.raw(?pw, txn);
    jw.raw(?pw, ".json");
    val snap_full: res[str, A.Error] = pathx.native(a, root, jw.text(?pw));
    if (sel snap_full.ok) {
        filesystem.remove_file(snap_full.ok);
        if (durable) { commit.sync_parent_dir(a, snap_full.ok); }
    }
}

fun write_wal_publishing(a: *A.Allocator, root: str, op_name: str, txn: *u8, set: *commit.Set, inline_files: bool) bool {
    if (!commit.check_control_dir(a, root)) { ret false; }
    var w: jw.Jw = jw.init(a);
    jw.obj(?w);
    jw.f_str(?w, "op", op_name);
    jw.f_str(?w, "txn", txn);
    jw.f_str(?w, "state", "publishing");
    if (set != nil && set.durable) {
        jw.f_bool(?w, "durable", true);
    }
    if (inline_files && set != nil) {
        if (!emit_set_files_snapshot(a, ?w, set)) { ret false; }
    }
    jw.obj_end(?w);
    jw.byte(?w, '\n');
    if (w.failed || w.buf == nil) { ret false; }
    val wal_full: res[str, A.Error] = pathx.native(a, root, ".qark/wal.json");
    if (sel wal_full.err) { ret false; }
    val wrote: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, wal_full.ok, w.buf, w.len, 384, 448);
    if (sel wrote.err) { ret false; }
    if (set != nil && set.durable && !commit.sync_parent_dir(a, wal_full.ok)) { ret false; }
    ret true;
}

fun write_wal_committed(a: *A.Allocator, root: str, op_name: str, txn: *u8, durable: bool, has_latest: bool, latest_txn: *u8, latest_n: usize, has_redo: bool, redo_buf: *u8, redo_n: usize, clear_redo: bool, j_buf: *u8, j_len: usize, idem_rel: str, idem_buf: *u8, idem_len: usize) bool {
    if (!commit.check_control_dir(a, root)) { ret false; }
    var w: jw.Jw = jw.init(a);
    jw.obj(?w);
    jw.f_str(?w, "op", op_name);
    jw.f_str(?w, "txn", txn);
    jw.f_str(?w, "state", "committed");
    if (durable) {
        jw.f_bool(?w, "durable", true);
    }
    if (has_latest) {
        if (latest_txn != nil && latest_n > 0) {
            jw.f_strn(?w, "latest_txn", latest_txn, latest_n);
        }
        or {
            jw.f_str(?w, "latest_txn", "");
        }
    }
    if (clear_redo) {
        jw.f_bool(?w, "clear_redo", true);
    }
    or (has_redo) {
        if (redo_buf != nil && redo_n > 0) {
            jw.f_strn(?w, "redo_buf", redo_buf, redo_n);
        }
        or {
            jw.f_str(?w, "redo_buf", "");
        }
    }
    if (j_buf != nil && j_len > 0) {
        jw.f_strn(?w, "journal_line", j_buf, j_len);
    }
    if (idem_rel != nil && idem_buf != nil && idem_len > 0) {
        jw.f_str(?w, "idem_rel", idem_rel);
        jw.f_strn(?w, "idem_buf", idem_buf, idem_len);
    }
    jw.obj_end(?w);
    jw.byte(?w, '\n');
    if (w.failed || w.buf == nil) { ret false; }
    val wal_full: res[str, A.Error] = pathx.native(a, root, ".qark/wal.json");
    if (sel wal_full.err) { ret false; }
    val wrote: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, wal_full.ok, w.buf, w.len, 384, 448);
    if (sel wrote.err) { ret false; }
    if (durable && !commit.sync_parent_dir(a, wal_full.ok)) { ret false; }
    ret true;
}

fun clear_wal(a: *A.Allocator, root: str, durable: bool) bool {
    val wal_full: res[str, A.Error] = pathx.native(a, root, ".qark/wal.json");
    if (sel wal_full.err) { ret false; }
    val rm: err[io_error.Error] = filesystem.remove_file(wal_full.ok);
    if (sel rm.err) {
        if (rm.err.kind != io_error.NOT_FOUND) { ret false; }
    }
    if (durable && !commit.sync_parent_dir(a, wal_full.ok)) { ret false; }
    ret true;
}

fun finalize_committed_wal(a: *A.Allocator, root: str, set: *commit.Set, txn: *u8, has_latest: bool, latest_p: *u8, latest_n: usize, has_redo: bool, redo_p: *u8, redo_n: usize, clear_redo: bool, j_buf: *u8, j_len: usize, idem_rel: str, idem_buf: *u8, idem_len: usize, out_joff: *i64) bool {
    if (!commit.check_control_dir(a, root)) { ret false; }
    if (j_buf != nil && j_len > 0) {
        if (!ensure_journal_line(a, root, set, txn, j_buf, j_len, out_joff)) {
            ret false;
        }
    }
    if (has_latest) {
        val lat_full: res[str, A.Error] = pathx.native(a, root, ".qark/undo/latest");
        if (sel lat_full.err) { ret false; }
        if (latest_p != nil && latest_n > 0) {
            val wr_lat: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, lat_full.ok, latest_p, latest_n, 384, 448);
            if (sel wr_lat.err) { ret false; }
            if (set.durable && !commit.sync_parent_dir(a, lat_full.ok)) { ret false; }
        }
        or {
            val rm_lat: err[io_error.Error] = filesystem.remove_file(lat_full.ok);
            if (sel rm_lat.err && rm_lat.err.kind != io_error.NOT_FOUND) { ret false; }
            if (set.durable && !commit.sync_parent_dir(a, lat_full.ok)) { ret false; }
        }
    }
    if (clear_redo || (has_redo && (redo_p == nil || redo_n == 0))) {
        val redo_full: res[str, A.Error] = pathx.native(a, root, ".qark/undo/redo");
        if (sel redo_full.err) { ret false; }
        val rm_redo: err[io_error.Error] = filesystem.remove_file(redo_full.ok);
        if (sel rm_redo.err && rm_redo.err.kind != io_error.NOT_FOUND) { ret false; }
        if (set.durable && !commit.sync_parent_dir(a, redo_full.ok)) { ret false; }
    }
    or (has_redo && redo_p != nil && redo_n > 0) {
        val redo_full2: res[str, A.Error] = pathx.native(a, root, ".qark/undo/redo");
        if (sel redo_full2.err) { ret false; }
        val wr_redo: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, redo_full2.ok, redo_p, redo_n, 384, 448);
        if (sel wr_redo.err) { ret false; }
        if (set.durable && !commit.sync_parent_dir(a, redo_full2.ok)) { ret false; }
    }
    if (idem_rel != nil && idem_buf != nil && idem_len > 0) {
        val irel_n: usize = str_len(idem_rel);
        if (irel_n <= 18 || !util.mem_eq(idem_rel, ".qark/idempotency/", 18) || pathx.check((idem_rel::usize + 18)::*u8) != pathx.P_OK || commit.check_ancestry(a, root, idem_rel) != nil) {
            ret false;
        }
        val ifull: res[str, A.Error] = pathx.native(a, root, idem_rel);
        if (sel ifull.err) { ret false; }
        val wr_idem: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, ifull.ok, idem_buf, idem_len, 384, 448);
        if (sel wr_idem.err) { ret false; }
        if (set.durable && !commit.sync_parent_dir(a, ifull.ok)) { ret false; }
    }
    if (!clear_wal(a, root, set.durable)) { ret false; }
    ret true;
}

fun has_pending_wal(a: *A.Allocator, root: str) bool {
    if (!commit.check_control_dir(a, root)) { ret true; }
    val wal_full: res[str, A.Error] = pathx.native(a, root, ".qark/wal.json");
    if (sel wal_full.err) { ret true; }
    val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(wal_full.ok);
    if (sel m.err) {
        if (m.err.kind == io_error.NOT_FOUND || m.err.kind == io_error.NOT_DIRECTORY) { ret false; }
        ret true;
    }
    ret true;
}

fun recovery_error(w: *jw.Jw, msg: str) bool {
    error_obj(w, "recovery_required", msg);
    jw.f_bool(w, "recovery_required", true);
    jw.obj_end(w);
    ret false;
}

# Recover an interrupted multi-file transaction recorded in .qark/wal.json
# Returns 0 when no WAL exists or recovery succeeded; returns -1 when recovery failed (leaving WAL intact).
fun recover_wal(a: *A.Allocator, root: str) i64 {
    if (!commit.check_control_dir(a, root)) { ret -1; }
    val wal_full: res[str, A.Error] = pathx.native(a, root, ".qark/wal.json");
    if (sel wal_full.err) { ret -1; }
    val wm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(wal_full.ok);
    if (sel wm.err) {
        if (wm.err.kind == io_error.NOT_FOUND || wm.err.kind == io_error.NOT_DIRECTORY) { ret 0; }
        ret -1;
    }
    if (wm.ok.kind != filesystem.KIND_FILE) { ret -1; }
    val wal_txt: res[str, filesystem.FsError] = filesystem.read_string(a, wal_full.ok);
    if (sel wal_txt.err) { ret -1; }
    val parsed: res[json.Value, json.JsonError] = json.parse(wal_txt.ok, str_len(wal_txt.ok), a);
    if (sel parsed.err) { ret -1; }
    var wdoc: json.Value = parsed.ok;
    if (!json.value_is_object(?wdoc)) { ret -1; }
    var wtxn: *u8 = nil;
    var wtxn_n: usize = 0;
    val tf: opt[*json.Value] = json.value_find(?wdoc, "txn");
    if (sel tf.some) {
        if (json.value_is_string(tf.some)) { spec.decode_pub(a, tf.some, ?wtxn, ?wtxn_n); }
    }
    if (wtxn == nil || wtxn_n == 0 || pathx.check(wtxn) != pathx.P_OK) { ret -1; }
    var wstate: *u8 = nil;
    var wstate_n: usize = 0;
    val st_f: opt[*json.Value] = json.value_find(?wdoc, "state");
    if (sel st_f.some) {
        if (json.value_is_string(st_f.some)) { spec.decode_pub(a, st_f.some, ?wstate, ?wstate_n); }
    }
    if (wstate == nil) { ret -1; }
    var wop: *u8 = "apply";
    var wop_n: usize = 5;
    val op_f: opt[*json.Value] = json.value_find(?wdoc, "op");
    if (sel op_f.some) {
        if (json.value_is_string(op_f.some)) { spec.decode_pub(a, op_f.some, ?wop, ?wop_n); }
    }
    val w_durable: bool = spec.fbool_pub(?wdoc, "durable");

    if (util.eq(wstate, "committed")) {
        var has_lat: bool = false;
        var l_p: *u8 = nil;
        var l_n: usize = 0;
        val lat_f: opt[*json.Value] = json.value_find(?wdoc, "latest_txn");
        if (sel lat_f.some) {
            if (!json.value_is_string(lat_f.some) || !spec.decode_pub(a, lat_f.some, ?l_p, ?l_n)) { ret -1; }
            has_lat = true;
        }
        val clr_redo: bool = spec.fbool_pub(?wdoc, "clear_redo");
        var has_rb: bool = false;
        var r_p: *u8 = nil;
        var r_n: usize = 0;
        val rb_f: opt[*json.Value] = json.value_find(?wdoc, "redo_buf");
        if (sel rb_f.some) {
            if (!json.value_is_string(rb_f.some) || !spec.decode_pub(a, rb_f.some, ?r_p, ?r_n)) { ret -1; }
            has_rb = true;
        }
        var jl_p: *u8 = nil;
        var jl_n: usize = 0;
        val jl_f: opt[*json.Value] = json.value_find(?wdoc, "journal_line");
        if (sel jl_f.some) {
            if (!json.value_is_string(jl_f.some) || !spec.decode_pub(a, jl_f.some, ?jl_p, ?jl_n)) { ret -1; }
        }
        var id_rel: *u8 = nil;
        var id_rel_n: usize = 0;
        var id_buf: *u8 = nil;
        var id_buf_n: usize = 0;
        val ir_f: opt[*json.Value] = json.value_find(?wdoc, "idem_rel");
        val ib_f: opt[*json.Value] = json.value_find(?wdoc, "idem_buf");
        if (sel ir_f.some) {
            if (!json.value_is_string(ir_f.some) || !spec.decode_pub(a, ir_f.some, ?id_rel, ?id_rel_n)) { ret -1; }
        }
        if (sel ib_f.some) {
            if (!json.value_is_string(ib_f.some) || !spec.decode_pub(a, ib_f.some, ?id_buf, ?id_buf_n)) { ret -1; }
        }
        var dummy_set: commit.Set = commit.init(a, root);
        dummy_set.durable = w_durable;
        var joff_out: i64 = -1;
        if (!finalize_committed_wal(a, root, ?dummy_set, wtxn, has_lat, l_p, l_n, has_rb, r_p, r_n, clr_redo, jl_p, jl_n, id_rel, id_buf, id_buf_n, ?joff_out)) {
            ret -1;
        }
        ret 0;
    }

    if (!util.eq(wstate, "publishing")) { ret -1; }

    var files_arr: *json.Value = nil;
    var has_snap_file: bool = false;
    var snap_path: str = nil;
    val in_ff: opt[*json.Value] = json.value_find(?wdoc, "files");
    var sdoc: json.Value;
    if (sel in_ff.some) {
        if (json.value_is_array(in_ff.some)) { files_arr = in_ff.some; }
    }
    if (files_arr == nil) {
        var pw: jw.Jw = jw.init(a);
        jw.raw(?pw, ".qark/undo/");
        jw.raw(?pw, wtxn);
        jw.raw(?pw, ".json");
        val snap_full: res[str, A.Error] = pathx.native(a, root, jw.text(?pw));
        if (sel snap_full.err) { ret -1; }
        snap_path = snap_full.ok;
        has_snap_file = true;
        val snap_txt: res[str, filesystem.FsError] = filesystem.read_string(a, snap_path);
        if (sel snap_txt.err) { ret -1; }
        val sp_parsed: res[json.Value, json.JsonError] = json.parse(snap_txt.ok, str_len(snap_txt.ok), a);
        if (sel sp_parsed.err) { ret -1; }
        sdoc = sp_parsed.ok;
        val ff: opt[*json.Value] = json.value_find(?sdoc, "files");
        if (sel ff.some) {
            if (json.value_is_array(ff.some)) { files_arr = ff.some; }
        }
    }
    if (files_arr == nil || json.value_count(files_arr) == 0) { ret -1; }

    var vi: usize = 0;
    for (vi < json.value_count(files_arr)) {
        val vg: opt[*json.Value] = json.value_get(files_arr, vi);
        if (!sel vg.some) { ret -1; }
        var vg_val: *json.Value = nil;
        if (sel vg.some) { vg_val = vg.some; }
        if (vg_val == nil || !json.value_is_object(vg_val)) { ret -1; }
        var vp: *u8 = nil;
        var vpn: usize = 0;
        var vst: *u8 = nil;
        var vstn: usize = 0;
        val vpf: opt[*json.Value] = json.value_find(vg_val, "path");
        val vstf: opt[*json.Value] = json.value_find(vg_val, "status");
        if (sel vpf.some) { spec.decode_pub(a, vpf.some, ?vp, ?vpn); }
        if (sel vstf.some) { spec.decode_pub(a, vstf.some, ?vst, ?vstn); }
        if (vp == nil || vpn == 0 || vst == nil || pathx.check(vp) != pathx.P_OK || commit.check_ancestry(a, root, vp) != nil) {
            ret -1;
        }
        val vfull: res[str, A.Error] = pathx.native(a, root, vp);
        if (sel vfull.err) { ret -1; }
        var vnsha: *u8 = nil;
        var vnshan: usize = 0;
        val vnsf: opt[*json.Value] = json.value_find(vg_val, "sha256");
        if (sel vnsf.some) { spec.decode_pub(a, vnsf.some, ?vnsha, ?vnshan); }
        var vpsha: *u8 = nil;
        var vpshan: usize = 0;
        val vpsf: opt[*json.Value] = json.value_find(vg_val, "prev_sha256");
        if (sel vpsf.some) { spec.decode_pub(a, vpsf.some, ?vpsha, ?vpshan); }
        var has_vpub_pm: bool = false;
        var vpub_pm: i32 = 420;
        val vpubf: *json.Value = find_val(vg_val, "published_perm");
        if (vpubf != nil && json.value_is_number(vpubf) && json.value_number(vpubf) >= 0) {
            vpub_pm = (json.value_number(vpubf)::u32 & 511)::i32;
            has_vpub_pm = true;
        }
        or {
            val vtpf: *json.Value = find_val(vg_val, "target_perm");
            if (vtpf != nil && json.value_is_number(vtpf) && json.value_number(vtpf) >= 0) {
                vpub_pm = (json.value_number(vtpf)::u32 & 511)::i32;
                has_vpub_pm = true;
            }
        }
        if (util.eq(vst, "created")) {
            if (vnsha == nil || vnshan != 64) { ret -1; }
            val cm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(vfull.ok);
            if (sel cm.ok) {
                if (cm.ok.kind != filesystem.KIND_FILE) { ret -1; }
                if (has_vpub_pm && commit.mode_supported_on_host(vpub_pm) && (cm.ok.mode & 511) != (vpub_pm::u32 & 511)) {
                    ret -1;
                }
                val cb: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, vfull.ok);
                if (sel cb.err) { ret -1; }
                var csha: [65]u8;
                commit.hash_hex(cb.ok.data, cb.ok.len, ?csha[0]);
                if (!util.eq(?csha[0], vnsha)) { ret -1; }
            }
            if (sel cm.err) {
                if (cm.err.kind != io_error.NOT_FOUND && cm.err.kind != io_error.NOT_DIRECTORY) {
                    ret -1;
                }
            }
        }
        or (util.eq(vst, "replaced") || util.eq(vst, "deleted")) {
            val is_rep: bool = util.eq(vst, "replaced");
            if (is_rep && (vnsha == nil || vnshan != 64)) { ret -1; }
            var vold_b: *u8 = nil;
            var vold_n: usize = 0;
            var vhas_old: bool = false;
            val votf: opt[*json.Value] = json.value_find(vg_val, "old_text");
            if (sel votf.some) {
                if (spec.decode_pub(a, votf.some, ?vold_b, ?vold_n)) { vhas_old = true; }
            }
            if (!vhas_old) {
                val vohf: opt[*json.Value] = json.value_find(vg_val, "old_hex");
                var vhp: *u8 = nil;
                var vhn: usize = 0;
                if (sel vohf.some) {
                    if (spec.decode_pub(a, vohf.some, ?vhp, ?vhn) && decode_hex_bytes(a, vhp, vhn, ?vold_b, ?vold_n)) {
                        vhas_old = true;
                    }
                }
            }
            if (!vhas_old) { ret -1; }
            var vexp_sha: [65]u8;
            commit.hash_hex(vold_b, vold_n, ?vexp_sha[0]);
            if (vpsha != nil && (vpshan != 64 || !util.eq(vpsha, ?vexp_sha[0]))) {
                ret -1;
            }
            var has_vold_pm: bool = false;
            var vold_pm: i32 = 420;
            val vopmf: *json.Value = find_val(vg_val, "old_perm");
            if (vopmf != nil && json.value_is_number(vopmf) && json.value_number(vopmf) >= 0) {
                vold_pm = (json.value_number(vopmf)::u32 & 511)::i32;
                has_vold_pm = true;
            }
            val rm_meta: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(vfull.ok);
            if (sel rm_meta.ok) {
                if (rm_meta.ok.kind != filesystem.KIND_FILE) { ret -1; }
                val rb_cur: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, vfull.ok);
                if (sel rb_cur.err) { ret -1; }
                var rcur_sha: [65]u8;
                commit.hash_hex(rb_cur.ok.data, rb_cur.ok.len, ?rcur_sha[0]);
                val old_pm_ok: bool = !has_vold_pm || !commit.mode_supported_on_host(vold_pm) || (rm_meta.ok.mode & 511) == (vold_pm::u32 & 511);
                val new_pm_ok: bool = !has_vpub_pm || !commit.mode_supported_on_host(vpub_pm) || (rm_meta.ok.mode & 511) == (vpub_pm::u32 & 511);
                val matches_old: bool = util.eq(?rcur_sha[0], ?vexp_sha[0]) && old_pm_ok;
                val matches_new: bool = is_rep && vnsha != nil && vnshan == 64 && util.eq(?rcur_sha[0], vnsha) && new_pm_ok;
                if (!matches_old && !matches_new) { ret -1; }
            }
            if (sel rm_meta.err) {
                if (is_rep) { ret -1; }
                if (rm_meta.err.kind != io_error.NOT_FOUND && rm_meta.err.kind != io_error.NOT_DIRECTORY) {
                    ret -1;
                }
            }
        }
        or {
            ret -1;
        }
        vi = vi + 1;
    }

    var i: usize = 0;
    for (i < json.value_count(files_arr)) {
        val g: opt[*json.Value] = json.value_get(files_arr, i);
        if (!sel g.some) { ret -1; }
        var g_val: *json.Value = nil;
        if (sel g.some) { g_val = g.some; }
        if (g_val == nil || !json.value_is_object(g_val)) { ret -1; }
        var p: *u8 = nil;
        var pn: usize = 0;
        var st: *u8 = nil;
        var stn: usize = 0;
        val pf: opt[*json.Value] = json.value_find(g_val, "path");
        val stf: opt[*json.Value] = json.value_find(g_val, "status");
        if (sel pf.some) { spec.decode_pub(a, pf.some, ?p, ?pn); }
        if (sel stf.some) { spec.decode_pub(a, stf.some, ?st, ?stn); }
        if (p == nil || pn == 0 || st == nil || pathx.check(p) != pathx.P_OK || commit.check_ancestry(a, root, p) != nil) {
            ret -1;
        }
        val ffull: res[str, A.Error] = pathx.native(a, root, p);
        if (sel ffull.err) { ret -1; }
        if (util.eq(st, "created")) {
            val rm: err[io_error.Error] = filesystem.remove_file(ffull.ok);
            if (sel rm.err && rm.err.kind != io_error.NOT_FOUND) { ret -1; }
            val m_after: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(ffull.ok);
            if (sel m_after.ok) { ret -1; }
            if (sel m_after.err && m_after.err.kind != io_error.NOT_FOUND && m_after.err.kind != io_error.NOT_DIRECTORY) {
                ret -1;
            }
            if (w_durable && !commit.sync_parent_dir(a, ffull.ok)) { ret -1; }
        }
        or (util.eq(st, "replaced") || util.eq(st, "deleted")) {
            var old_b: *u8 = nil;
            var old_n: usize = 0;
            var has_old: bool = false;
            val otf: opt[*json.Value] = json.value_find(g_val, "old_text");
            if (sel otf.some) {
                if (spec.decode_pub(a, otf.some, ?old_b, ?old_n)) { has_old = true; }
            }
            if (!has_old) {
                val ohf: opt[*json.Value] = json.value_find(g_val, "old_hex");
                var hp: *u8 = nil;
                var hn: usize = 0;
                if (sel ohf.some) {
                    if (spec.decode_pub(a, ohf.some, ?hp, ?hn) && decode_hex_bytes(a, hp, hn, ?old_b, ?old_n)) {
                        has_old = true;
                    }
                }
            }
            if (!has_old) { ret -1; }
            var psha: *u8 = nil;
            var pshan: usize = 0;
            val psf: opt[*json.Value] = json.value_find(g_val, "prev_sha256");
            if (sel psf.some) { spec.decode_pub(a, psf.some, ?psha, ?pshan); }
            var expected_sha: [65]u8;
            commit.hash_hex(old_b, old_n, ?expected_sha[0]);
            if (psha != nil && pshan == 64 && !util.eq(psha, ?expected_sha[0])) {
                ret -1;
            }
            var perm: u32 = 420;
            var has_pm: bool = false;
            val pmf: opt[*json.Value] = json.value_find(g_val, "old_perm");
            if (sel pmf.some) {
                if (json.value_is_number(pmf.some) && json.value_number(pmf.some) >= 0) {
                    perm = json.value_number(pmf.some)::u32;
                    has_pm = true;
                }
            }
            var perm_bits: i32 = (perm & 511)::i32;
            if (!has_pm && perm_bits == 0) { perm_bits = 420; }
            val wr: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, ffull.ok, old_b, old_n, perm_bits, 493);
            if (sel wr.err) { ret -1; }
            if (!commit.apply_file_mode(ffull.ok, perm_bits)) { ret -1; }
            if ((perm_bits & 256) != 0) {
                val verify_b: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, ffull.ok);
                if (sel verify_b.err) { ret -1; }
                var disk_sha: [65]u8;
                commit.hash_hex(verify_b.ok.data, verify_b.ok.len, ?disk_sha[0]);
                if (!util.eq(?disk_sha[0], ?expected_sha[0])) { ret -1; }
            }
            if (w_durable && !commit.sync_parent_dir(a, ffull.ok)) { ret -1; }
        }
        or {
            ret -1;
        }
        i = i + 1;
    }

    if (!clear_wal(a, root, w_durable)) { ret -1; }
    if (has_snap_file && snap_path != nil && util.eq(wop, "apply")) {
        filesystem.remove_file(snap_path);
        if (w_durable) { commit.sync_parent_dir(a, snap_path); }
    }
    ret 0;
}

fun undo_list(s: *session.Session, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    jw.obj(w);
    jw.key(w, "txns");
    jw.arr(w);
    var count: i64 = 0;
    val lat_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/latest");
    var cur: *u8 = nil;
    var cur_n: usize = 0;
    if (sel lat_full.ok) {
        val lat_txt: res[str, filesystem.FsError] = filesystem.read_string(a, lat_full.ok);
        if (sel lat_txt.ok) {
            var lp: *u8 = lat_txt.ok;
            var ln: usize = str_len(lp);
            for (ln > 0 && (lp[ln - 1] == '\n' || lp[ln - 1] == '\r' || lp[ln - 1] == ' ')) { ln = ln - 1; }
            if (ln > 0) {
                val d: res[str, A.Error] = util.dup_n(a, lp, ln);
                if (sel d.ok) {
                    cur = d.ok;
                    cur_n = ln;
                }
            }
        }
    }
    var steps: usize = 0;
    for (cur != nil && cur_n > 0 && steps < 64 && pathx.check(cur) == pathx.P_OK) {
        var pw: jw.Jw = jw.init(a);
        jw.raw(?pw, ".qark/undo/");
        jw.raw(?pw, cur);
        jw.raw(?pw, ".json");
        val snap_full: res[str, A.Error] = pathx.native(a, s.root, jw.text(?pw));
        var next_cur: *u8 = nil;
        var next_n: usize = 0;
        if (sel snap_full.ok) {
            val snap_txt: res[str, filesystem.FsError] = filesystem.read_string(a, snap_full.ok);
            if (sel snap_txt.ok) {
                val parsed: res[json.Value, json.JsonError] = json.parse(snap_txt.ok, str_len(snap_txt.ok), a);
                if (sel parsed.ok) {
                    var doc: json.Value = parsed.ok;
                    var fcnt: i64 = 0;
                    val ff: opt[*json.Value] = json.value_find(?doc, "files");
                    if (sel ff.some) {
                        if (json.value_is_array(ff.some)) { fcnt = json.value_count(ff.some)::i64; }
                    }
                    jw.obj(w);
                    jw.f_str(w, "txn", cur);
                    jw.f_i64(w, "files", fcnt);
                    val tgf: opt[*json.Value] = json.value_find(?doc, "tag");
                    if (sel tgf.some) {
                        if (json.value_is_string(tgf.some)) {
                            var tgp: *u8 = nil;
                            var tgn: usize = 0;
                            if (spec.decode_pub(a, tgf.some, ?tgp, ?tgn) && tgn > 0) {
                                jw.f_str(w, "tag", tgp);
                            }
                        }
                    }
                    val pf: opt[*json.Value] = json.value_find(?doc, "prev_txn");
                    if (sel pf.some) {
                        if (json.value_is_string(pf.some)) {
                            spec.decode_pub(a, pf.some, ?next_cur, ?next_n);
                            if (next_cur != nil && next_n > 0) {
                                jw.f_str(w, "prev_txn", next_cur);
                            }
                        }
                    }
                    jw.obj_end(w);
                    count = count + 1;
                }
            }
        }
        cur = next_cur;
        cur_n = next_n;
        steps = steps + 1;
    }
    jw.arr_end(w);
    jw.f_i64(w, "count", count);
    val redo_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/redo");
    if (sel redo_full.ok) {
        val rtxt: res[str, filesystem.FsError] = filesystem.read_string(a, redo_full.ok);
        if (sel rtxt.ok) {
            var rp: *u8 = rtxt.ok;
            var rn: usize = str_len(rp);
            var pos: usize = 0;
            for (pos < rn && (rp[pos] == '\n' || rp[pos] == '\r' || rp[pos] == ' ')) { pos = pos + 1; }
            var line_end: usize = pos;
            for (line_end < rn && rp[line_end] != '\n' && rp[line_end] != '\r') { line_end = line_end + 1; }
            for (line_end > pos && rp[line_end - 1] == ' ') { line_end = line_end - 1; }
            var start: usize = line_end;
            for (start > pos && rp[start - 1] != ' ') { start = start - 1; }
            if (line_end > start) { jw.f_strn(w, "redo_txn", (rp::usize + start)::*u8, line_end - start); }
        }
    }
    jw.obj_end(w);
    ret true;
}

fun find_rev_entry(set: *commit.Set, rel: str) i64 {
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (util.eq(e.rel, rel)) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

# redo a previously undone transaction sequence using persistent .qark/undo/<txn>.json snapshots
pub fun redo(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var steps: i64 = 1;
    var has_steps_arg: bool = false;
    val rstf: opt[*json.Value] = json.value_find(args, "steps");
    if (sel rstf.some) {
        if (!json.value_is_number(rstf.some) || json.value_is_float(rstf.some)) {
            ret simple_error(w, "spec_type", "steps must be an integer between 1 and 32");
        }
        steps = json.value_number(rstf.some);
        if (steps < 1 || steps > 32) {
            ret simple_error(w, "spec_range", "steps must be between 1 and 32");
        }
        has_steps_arg = true;
    }
    val dry: bool = spec.fbool_pub(args, "dry_run") || s.force_dry;
    val force: bool = spec.fbool_pub(args, "force");
    val show_diff: bool = spec.fbool_pub(args, "diff");
    val durable: bool = spec.fbool_pub(args, "durable") || s.durable;

    var fwd_set: commit.Set = commit.init(a, s.root);
    fwd_set.durable = durable;
    var held: commit.Lock;
    val locked: i64 = commit.lock(?fwd_set, s.lock_ms, ?held);
    if (locked == 1) { ret simple_error(w, "locked", "another qark process held the workspace lock"); }
    if (locked != 0) { ret simple_error(w, "lock_failed", "the workspace lock under .qark could not be taken"); }

    if (dry) {
        if (has_pending_wal(a, s.root)) {
            commit.unlock(?held);
            ret recovery_error(w, "an interrupted transaction requires workspace recovery before previewing redo");
        }
    }
    or {
        if (recover_wal(a, s.root) < 0) {
            commit.unlock(?held);
            ret recovery_error(w, "workspace recovery from an interrupted transaction failed; manual inspection is required");
        }
    }

    var txn_arg: *u8 = nil;
    var txn_arg_n: usize = 0;
    val tf: opt[*json.Value] = json.value_find(args, "txn");
    if (sel tf.some) {
        if (json.value_is_string(tf.some)) { spec.decode_pub(a, tf.some, ?txn_arg, ?txn_arg_n); }
    }
    var txns: [32]*u8;
    var txn_lens: [32]usize;
    var txn_cnt: usize = 0;
    var rem_redo_p: *u8 = nil;
    var rem_redo_n: usize = 0;
    var update_redo_stack: bool = true;
    if (txn_arg != nil && txn_arg_n > 0 && !util.eq(txn_arg, "latest") && !util.eq(txn_arg, "redo")) {
        if (pathx.check(txn_arg) != pathx.P_OK) {
            commit.unlock(?held);
            ret simple_error(w, "redo_missing", "invalid transaction id");
        }
        txns[0] = txn_arg;
        txn_lens[0] = txn_arg_n;
        txn_cnt = 1;
        update_redo_stack = false;
    }
    or {
        val redo_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/redo");
        if (sel redo_full.err) { commit.unlock(?held); ret simple_error(w, "oom", "out of memory"); }
        val redo_txt: res[str, filesystem.FsError] = filesystem.read_string(a, redo_full.ok);
        if (sel redo_txt.err) { commit.unlock(?held); ret simple_error(w, "redo_missing", "no undone transaction to redo in .qark/undo"); }
        var rp: *u8 = redo_txt.ok;
        var rn: usize = str_len(rp);
        for (rn > 0 && (rp[rn - 1] == '\n' || rp[rn - 1] == '\r' || rp[rn - 1] == ' ')) { rn = rn - 1; }
        var pos: usize = 0;
        var lines_popped: i64 = 0;
        for (pos < rn && lines_popped < steps) {
            for (pos < rn && (rp[pos] == '\n' || rp[pos] == '\r' || rp[pos] == ' ')) { pos = pos + 1; }
            if (pos >= rn) { brk; }
            var line_end: usize = pos;
            for (line_end < rn && rp[line_end] != '\n' && rp[line_end] != '\r') { line_end = line_end + 1; }
            var lpos: usize = pos;
            var line_toks: usize = 0;
            for (lpos < line_end && txn_cnt < 32) {
                for (lpos < line_end && rp[lpos] == ' ') { lpos = lpos + 1; }
                val start: usize = lpos;
                for (lpos < line_end && rp[lpos] != ' ') { lpos = lpos + 1; }
                if (lpos > start) {
                    val len_i: usize = lpos - start;
                    val d: res[str, A.Error] = util.dup_n(a, (rp::usize + start)::*u8, len_i);
                    if (sel d.err) { commit.unlock(?held); ret simple_error(w, "oom", "out of memory"); }
                    if (pathx.check(d.ok) != pathx.P_OK) {
                        commit.unlock(?held);
                        ret simple_error(w, "redo_missing", "invalid transaction id in .qark/undo/redo");
                    }
                    txns[txn_cnt] = d.ok;
                    txn_lens[txn_cnt] = len_i;
                    txn_cnt = txn_cnt + 1;
                    line_toks = line_toks + 1;
                }
            }
            if (line_toks > 0) {
                lines_popped = lines_popped + 1;
            }
            pos = line_end;
        }
        if (has_steps_arg && lines_popped < steps) {
            commit.unlock(?held);
            ret simple_error(w, "redo_missing", "not enough undone transactions in .qark/undo/redo for requested steps");
        }
        for (pos < rn && (rp[pos] == '\n' || rp[pos] == '\r' || rp[pos] == ' ')) { pos = pos + 1; }
        if (pos < rn) {
            rem_redo_p = (rp::usize + pos)::*u8;
            rem_redo_n = rn - pos;
        }
    }
    if (txn_cnt == 0) {
        commit.unlock(?held);
        ret simple_error(w, "redo_missing", "no undone transaction to redo in .qark/undo");
    }

    var ti: usize = 0;
    for (ti < txn_cnt) {
        val cur_txn: *u8 = txns[ti];
        var pw: jw.Jw = jw.init(a);
        jw.raw(?pw, ".qark/undo/");
        jw.raw(?pw, cur_txn);
        jw.raw(?pw, ".json");
        val snap_full: res[str, A.Error] = pathx.native(a, s.root, jw.text(?pw));
        if (sel snap_full.err) { commit.unlock(?held); ret simple_error(w, "oom", "out of memory"); }
        val snap_txt: res[str, filesystem.FsError] = filesystem.read_string(a, snap_full.ok);
        if (sel snap_txt.err) { commit.unlock(?held); ret simple_error(w, "redo_missing", "no snapshot found for that transaction"); }
        val parsed: res[json.Value, json.JsonError] = json.parse(snap_txt.ok, str_len(snap_txt.ok), a);
        if (sel parsed.err) { commit.unlock(?held); ret simple_error(w, "undo_corrupt", "the snapshot could not be parsed"); }
        var doc: json.Value = parsed.ok;
        val files_f: opt[*json.Value] = json.value_find(?doc, "files");
        if (!sel files_f.some) { commit.unlock(?held); ret simple_error(w, "undo_corrupt", "the snapshot has no files list"); }
        var files_arr: *json.Value = nil;
        if (sel files_f.some) { files_arr = files_f.some; }
        if (files_arr == nil || !json.value_is_array(files_arr)) {
            commit.unlock(?held);
            ret simple_error(w, "undo_corrupt", "the snapshot has no files list");
        }
        var i: usize = 0;
        for (i < json.value_count(files_arr)) {
            val g: opt[*json.Value] = json.value_get(files_arr, i);
            if (sel g.some) {
                var p: *u8 = nil;
                var pn: usize = 0;
                var st: *u8 = nil;
                var stn: usize = 0;
                var psha: *u8 = nil;
                var pshan: usize = 0;
                var sha: *u8 = nil;
                var shan: usize = 0;
                var new_t: *u8 = nil;
                var new_n: usize = 0;
                var has_new: bool = false;
                val pf: opt[*json.Value] = json.value_find(g.some, "path");
                val stf: opt[*json.Value] = json.value_find(g.some, "status");
                val psf: opt[*json.Value] = json.value_find(g.some, "prev_sha256");
                val shf: opt[*json.Value] = json.value_find(g.some, "sha256");
                val ntf: opt[*json.Value] = json.value_find(g.some, "new_text");
                if (sel pf.some) { spec.decode_pub(a, pf.some, ?p, ?pn); }
                if (sel stf.some) { spec.decode_pub(a, stf.some, ?st, ?stn); }
                if (sel psf.some) { spec.decode_pub(a, psf.some, ?psha, ?pshan); }
                if (sel shf.some) { spec.decode_pub(a, shf.some, ?sha, ?shan); }
                if (sel ntf.some) {
                    if (spec.decode_pub(a, ntf.some, ?new_t, ?new_n)) { has_new = true; }
                }
                if (!has_new) {
                    val nhf: opt[*json.Value] = json.value_find(g.some, "new_hex");
                    var hp: *u8 = nil;
                    var hn: usize = 0;
                    if (sel nhf.some) {
                        if (spec.decode_pub(a, nhf.some, ?hp, ?hn) && decode_hex_bytes(a, hp, hn, ?new_t, ?new_n)) {
                            has_new = true;
                        }
                    }
                }
                val is_exec: bool = spec.fbool_pub(g.some, "exec");
                var tperm: u32 = 0;
                var has_tperm: bool = false;
                val tpf: opt[*json.Value] = json.value_find(g.some, "target_perm");
                if (sel tpf.some) {
                    if (json.value_is_number(tpf.some) && json.value_number(tpf.some) >= 0) {
                        tperm = json.value_number(tpf.some)::u32;
                        has_tperm = true;
                    }
                }
                var operm: u32 = 0;
                var has_operm: bool = false;
                val opmf: opt[*json.Value] = json.value_find(g.some, "old_perm");
                if (sel opmf.some) {
                    if (json.value_is_number(opmf.some) && json.value_number(opmf.some) >= 0) {
                        operm = json.value_number(opmf.some)::u32;
                        has_operm = true;
                    }
                }
                if (p == nil || pn == 0 || st == nil || pathx.check(p) != pathx.P_OK) {
                    commit.unlock(?held);
                    ret simple_error(w, "undo_corrupt", "invalid file entry in snapshot");
                }
                if (has_new && sha != nil && shan == 64) {
                    var chk_sha: [65]u8;
                    commit.hash_hex(new_t, new_n, ?chk_sha[0]);
                    if (!util.eq(sha, ?chk_sha[0])) {
                        commit.unlock(?held);
                        ret simple_error(w, "undo_corrupt", "snapshot new_text hash does not match recorded sha256");
                    }
                }
                val same_sha: bool = util.eq(st, "replaced") && sha != nil && psha != nil && util.eq(sha, psha);
                val existing_idx: i64 = find_rev_entry(?fwd_set, p);
                if (existing_idx >= 0) {
                    val ent: *commit.Entry = commit.entry(?fwd_set, existing_idx::usize);
                    if (util.eq(st, "created") || util.eq(st, "replaced")) {
                        if (!has_new) {
                            commit.unlock(?held);
                            ret simple_error(w, "redo_unavailable", "snapshot does not hold new_text for a file");
                        }
                        ent.must_be_absent = false;
                        ent.force_delete = false;
                        ent.force_replace = same_sha;
                        ent.data = new_t;
                        ent.len = new_n;
                        ent.exec = is_exec;
                        ent.has_target_perm = has_tperm;
                        ent.target_perm = tperm;
                        commit.hash_hex(new_t, new_n, ?ent.sha[0]);
                        if (force) { ent.mode = commit.MODE_UPSERT; }
                        or (ent.pre_existed) { ent.mode = commit.MODE_REPLACE; }
                        or { ent.mode = commit.MODE_CREATE; }
                    }
                    or (util.eq(st, "deleted")) {
                        ent.mode = commit.MODE_DELETE;
                        ent.data = nil;
                        ent.len = 0;
                        ent.has_target_perm = false;
                        ent.target_perm = 0;
                        ent.force_replace = false;
                        ent.force_delete = force;
                        ent.must_be_absent = !ent.pre_existed;
                    }
                    or {
                        commit.unlock(?held);
                        ret simple_error(w, "undo_corrupt", "unknown status in snapshot");
                    }
                }
                or {
                    if (util.eq(st, "created")) {
                        if (!has_new) {
                            commit.unlock(?held);
                            ret simple_error(w, "redo_unavailable", "snapshot does not hold new_text for a created file");
                        }
                        var mode: u8 = commit.MODE_CREATE;
                        if (force) { mode = commit.MODE_UPSERT; }
                        val added: res[usize, A.Error] = commit.add(?fwd_set, p, new_t, new_n, mode);
                        if (sel added.ok) {
                            val ent: *commit.Entry = commit.entry(?fwd_set, added.ok);
                            ent.pre_existed = false;
                            ent.exec = is_exec;
                            ent.has_target_perm = has_tperm;
                            ent.target_perm = tperm;
                        }
                    }
                    or (util.eq(st, "replaced")) {
                        if (!has_new) {
                            commit.unlock(?held);
                            ret simple_error(w, "redo_unavailable", "snapshot does not hold new_text for a replaced file");
                        }
                        var mode: u8 = commit.MODE_REPLACE;
                        if (force) { mode = commit.MODE_UPSERT; }
                        val added: res[usize, A.Error] = commit.add(?fwd_set, p, new_t, new_n, mode);
                        if (sel added.ok) {
                            val ent: *commit.Entry = commit.entry(?fwd_set, added.ok);
                            ent.pre_existed = true;
                            ent.exec = is_exec;
                            ent.has_target_perm = has_tperm;
                            ent.target_perm = tperm;
                            ent.force_replace = same_sha;
                            if (!force && psha != nil) {
                                commit.set_expect(ent, psha);
                            }
                            if (!force && has_operm) {
                                ent.has_expect_perm = true;
                                ent.expect_perm = operm;
                            }
                        }
                    }
                    or (util.eq(st, "deleted")) {
                        val added: res[usize, A.Error] = commit.add(?fwd_set, p, nil, 0, commit.MODE_DELETE);
                        if (sel added.ok) {
                            val ent: *commit.Entry = commit.entry(?fwd_set, added.ok);
                            ent.pre_existed = true;
                            ent.force_delete = force;
                            if (!force && psha != nil) {
                                commit.set_expect(ent, psha);
                            }
                            if (!force && has_operm) {
                                ent.has_expect_perm = true;
                                ent.expect_perm = operm;
                            }
                        }
                    }
                    or {
                        commit.unlock(?held);
                        ret simple_error(w, "undo_corrupt", "unknown status in snapshot");
                    }
                }
            }
            i = i + 1;
        }
        ti = ti + 1;
    }

    val last_txn: *u8 = txns[txn_cnt - 1];
    val last_txn_n: usize = txn_lens[txn_cnt - 1];

    commit.observe(?fwd_set);
    val conflicts: i64 = commit.tally(?fwd_set, commit.ST_CONFLICT);
    if (conflicts > 0 && !dry) {
        commit.unlock(?held);
        error_obj(w, "conflict", "a file was modified since undo; nothing was redone. pass force: true to overwrite");
        files_list(w, ?fwd_set, false, false, true, false, a);
        jw.obj_end(w);
        ret false;
    }
    var rtxn: [17]u8;
    txn_id(?rtxn[0]);
    if (!dry) {
        var rj_buf: *u8 = nil;
        var rj_len: usize = 0;
        if (!build_undo_journal_line(s, ?fwd_set, "transaction.redone", ?rtxn[0], last_txn, ?rj_buf, ?rj_len)) {
            commit.unlock(?held);
            ret simple_error(w, "oom", "out of memory");
        }
        if (commit.dirty(?fwd_set)) {
            if (!write_wal_publishing(a, s.root, "redo", ?rtxn[0], ?fwd_set, true)) {
                clear_wal(a, s.root, fwd_set.durable);
                commit.unlock(?held);
                ret simple_error(w, "undo_failed", "could not persist write-ahead log under .qark before redo; nothing was written");
            }
            val out: commit.Outcome = commit.publish(?fwd_set);
            if (!out.ok) {
                if (!out.rollback_failed) {
                    clear_wal(a, s.root, fwd_set.durable);
                }
                commit.unlock(?held);
                error_obj(w, out.code, out.msg);
                if (out.rollback_failed) {
                    jw.f_bool(w, "rollback_failed", true);
                    jw.f_bool(w, "recovery_required", true);
                }
                jw.obj_end(w);
                ret false;
            }
        }
        val clr_redo: bool = update_redo_stack && rem_redo_n == 0;
        if (!write_wal_committed(a, s.root, "redo", ?rtxn[0], fwd_set.durable, update_redo_stack, last_txn, last_txn_n, update_redo_stack, rem_redo_p, rem_redo_n, clr_redo, rj_buf, rj_len, nil, nil, 0)) {
            val r_st: i64 = recover_wal(a, s.root);
            commit.unlock(?held);
            if (r_st < 0) {
                ret recovery_error(w, "redo WAL commit failed and automatic rollback also failed; workspace recovery is required");
            }
            ret simple_error(w, "journal_failed", "redo could not be committed in .qark/wal.json; changes were rolled back");
        }
        var rj_off: i64 = -1;
        if (!finalize_committed_wal(a, s.root, ?fwd_set, ?rtxn[0], update_redo_stack, last_txn, last_txn_n, update_redo_stack, rem_redo_p, rem_redo_n, clr_redo, rj_buf, rj_len, nil, nil, 0, ?rj_off)) {
            if (recover_wal(a, s.root) < 0) {
                commit.unlock(?held);
                ret recovery_error(w, "redo committed on disk, but finalizing .qark metadata failed; run any operation to complete recovery");
            }
        }
    }
    commit.unlock(?held);
    jw.obj(w);
    jw.f_str(w, "txn", ?rtxn[0]);
    if (s.root != nil) { jw.f_str(w, "root", s.root); }
    jw.f_str(w, "redone_txn", last_txn);
    if (txn_cnt > 1) {
        jw.f_i64(w, "steps_redone", txn_cnt::i64);
    }
    jw.f_bool(w, "dry_run", dry);
    if (fwd_set.durable) { jw.f_bool(w, "durable", true); }
    counts(w, ?fwd_set);
    files_list(w, ?fwd_set, dry, false, false, show_diff, a);
    jw.obj_end(w);
    ret true;
}

# revert one or more previously applied transactions atomically using .qark/undo/<txn>.json snapshots
pub fun undo(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    if (spec.fbool_pub(args, "list")) {
        ret undo_list(s, w);
    }
    if (spec.fbool_pub(args, "redo")) {
        ret redo(s, args, w);
    }
    val a: *A.Allocator = ?s.ra;
    var txn: *u8 = nil;
    var txn_n: usize = 0;
    val tf: opt[*json.Value] = json.value_find(args, "txn");
    if (sel tf.some) {
        if (json.value_is_string(tf.some)) { spec.decode_pub(a, tf.some, ?txn, ?txn_n); }
    }
    if (txn == nil) {
        val uf: opt[*json.Value] = json.value_find(args, "undo");
        if (sel uf.some) {
            if (json.value_is_string(uf.some)) { spec.decode_pub(a, uf.some, ?txn, ?txn_n); }
        }
    }
    if (txn != nil && util.eq(txn, "list")) {
        ret undo_list(s, w);
    }
    if (txn != nil && util.eq(txn, "redo")) {
        ret redo(s, args, w);
    }
    var steps: i64 = 1;
    val stf: opt[*json.Value] = json.value_find(args, "steps");
    if (sel stf.some) {
        if (!json.value_is_number(stf.some) || json.value_is_float(stf.some)) {
            ret simple_error(w, "spec_type", "steps must be an integer between 1 and 32");
        }
        steps = json.value_number(stf.some);
        if (steps < 1 || steps > 32) {
            ret simple_error(w, "spec_range", "steps must be between 1 and 32");
        }
    }
    val dry: bool = spec.fbool_pub(args, "dry_run") || s.force_dry;
    val force: bool = spec.fbool_pub(args, "force");
    val show_diff: bool = spec.fbool_pub(args, "diff");
    val durable: bool = spec.fbool_pub(args, "durable") || s.durable;

    var rev_set: commit.Set = commit.init(a, s.root);
    rev_set.durable = durable;
    var held: commit.Lock;
    val locked: i64 = commit.lock(?rev_set, s.lock_ms, ?held);
    if (locked == 1) { ret simple_error(w, "locked", "another qark process held the workspace lock"); }
    if (locked != 0) { ret simple_error(w, "lock_failed", "the workspace lock under .qark could not be taken"); }

    if (dry) {
        if (has_pending_wal(a, s.root)) {
            commit.unlock(?held);
            ret recovery_error(w, "an interrupted transaction requires workspace recovery before previewing undo");
        }
    }
    or {
        if (recover_wal(a, s.root) < 0) {
            commit.unlock(?held);
            ret recovery_error(w, "workspace recovery from an interrupted transaction failed; manual inspection is required");
        }
    }

    var head_txn: *u8 = nil;
    var head_n: usize = 0;
    val lat_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/latest");
    if (sel lat_full.ok) {
        val lat_txt: res[str, filesystem.FsError] = filesystem.read_string(a, lat_full.ok);
        if (sel lat_txt.ok) {
            var lp: *u8 = lat_txt.ok;
            var ln: usize = str_len(lp);
            for (ln > 0 && (lp[ln - 1] == '\n' || lp[ln - 1] == '\r' || lp[ln - 1] == ' ')) { ln = ln - 1; }
            if (ln > 0) {
                val d: res[str, A.Error] = util.dup_n(a, lp, ln);
                if (sel d.ok) {
                    head_txn = d.ok;
                    head_n = ln;
                }
            }
        }
    }

    var is_head_undo: bool = true;
    if (txn == nil || txn_n == 0 || util.eq(txn, "latest")) {
        if (head_txn == nil || head_n == 0) {
            commit.unlock(?held);
            ret simple_error(w, "undo_missing", "no transaction to undo in .qark/undo");
        }
        txn = head_txn;
        txn_n = head_n;
    }
    or {
        if (head_txn == nil || head_n == 0 || !util.eq(txn, head_txn)) {
            if (!force || steps > 1) {
                commit.unlock(?held);
                ret simple_error(w, "undo_not_latest", "cannot undo a non-latest transaction without force: true; pass txn: \"latest\" or force: true");
            }
            is_head_undo = false;
        }
    }
    if (txn_n == 0 || pathx.check(txn) != pathx.P_OK) {
        commit.unlock(?held);
        ret simple_error(w, "undo_missing", "invalid transaction id");
    }

    var undone_txns: [32]*u8;
    var undone_lens: [32]usize;
    var cur_txn: *u8 = txn;
    var cur_txn_n: usize = txn_n;
    var last_reverted: *u8 = txn;
    var prev_txn: *u8 = nil;
    var prev_n: usize = 0;
    var step_i: i64 = 0;

    for (step_i < steps) {
        if (cur_txn == nil || cur_txn_n == 0 || pathx.check(cur_txn) != pathx.P_OK) {
            commit.unlock(?held);
            ret simple_error(w, "undo_missing", "not enough transactions in undo history for requested steps");
        }
        undone_txns[step_i::usize] = cur_txn;
        undone_lens[step_i::usize] = cur_txn_n;
        var pw: jw.Jw = jw.init(a);
        jw.raw(?pw, ".qark/undo/");
        jw.raw(?pw, cur_txn);
        jw.raw(?pw, ".json");
        val snap_full: res[str, A.Error] = pathx.native(a, s.root, jw.text(?pw));
        if (sel snap_full.err) { commit.unlock(?held); ret simple_error(w, "oom", "out of memory"); }
        val snap_txt: res[str, filesystem.FsError] = filesystem.read_string(a, snap_full.ok);
        if (sel snap_txt.err) {
            commit.unlock(?held);
            ret simple_error(w, "undo_missing", "no undo snapshot found for that transaction");
        }
        val parsed: res[json.Value, json.JsonError] = json.parse(snap_txt.ok, str_len(snap_txt.ok), a);
        if (sel parsed.err) {
            commit.unlock(?held);
            ret simple_error(w, "undo_corrupt", "the undo snapshot could not be parsed");
        }
        var doc: json.Value = parsed.ok;
        prev_txn = nil;
        prev_n = 0;
        val prev_f: opt[*json.Value] = json.value_find(?doc, "prev_txn");
        if (sel prev_f.some) {
            if (json.value_is_string(prev_f.some)) {
                spec.decode_pub(a, prev_f.some, ?prev_txn, ?prev_n);
            }
        }
        val files_f: opt[*json.Value] = json.value_find(?doc, "files");
        if (!sel files_f.some) {
            commit.unlock(?held);
            ret simple_error(w, "undo_corrupt", "the undo snapshot has no files list");
        }
        var files_arr: *json.Value = nil;
        if (sel files_f.some) { files_arr = files_f.some; }
        if (files_arr == nil || !json.value_is_array(files_arr)) {
            commit.unlock(?held);
            ret simple_error(w, "undo_corrupt", "the undo snapshot has no files list");
        }
        var i: usize = 0;
        for (i < json.value_count(files_arr)) {
            val g: opt[*json.Value] = json.value_get(files_arr, i);
            if (sel g.some) {
                var p: *u8 = nil;
                var pn: usize = 0;
                var st: *u8 = nil;
                var stn: usize = 0;
                var sha: *u8 = nil;
                var shan: usize = 0;
                var psha: *u8 = nil;
                var pshan: usize = 0;
                var old_t: *u8 = nil;
                var old_n: usize = 0;
                var has_old: bool = false;
                val pf: opt[*json.Value] = json.value_find(g.some, "path");
                val stf2: opt[*json.Value] = json.value_find(g.some, "status");
                val shf: opt[*json.Value] = json.value_find(g.some, "sha256");
                val psf: opt[*json.Value] = json.value_find(g.some, "prev_sha256");
                val otf: opt[*json.Value] = json.value_find(g.some, "old_text");
                if (sel pf.some) { spec.decode_pub(a, pf.some, ?p, ?pn); }
                if (sel stf2.some) { spec.decode_pub(a, stf2.some, ?st, ?stn); }
                if (sel shf.some) { spec.decode_pub(a, shf.some, ?sha, ?shan); }
                if (sel psf.some) { spec.decode_pub(a, psf.some, ?psha, ?pshan); }
                if (sel otf.some) {
                    if (spec.decode_pub(a, otf.some, ?old_t, ?old_n)) { has_old = true; }
                }
                if (!has_old) {
                    val ohf: opt[*json.Value] = json.value_find(g.some, "old_hex");
                    var hp: *u8 = nil;
                    var hn: usize = 0;
                    if (sel ohf.some) {
                        if (spec.decode_pub(a, ohf.some, ?hp, ?hn) && decode_hex_bytes(a, hp, hn, ?old_t, ?old_n)) {
                            has_old = true;
                        }
                    }
                }
                var operm: u32 = 0;
                var has_operm: bool = false;
                val opmf: opt[*json.Value] = json.value_find(g.some, "old_perm");
                if (sel opmf.some) {
                    if (json.value_is_number(opmf.some) && json.value_number(opmf.some) >= 0) {
                        operm = json.value_number(opmf.some)::u32;
                        has_operm = true;
                    }
                }
                var pub_perm: u32 = 0;
                var has_pub_perm: bool = false;
                val ppf: opt[*json.Value] = json.value_find(g.some, "published_perm");
                if (sel ppf.some) {
                    if (json.value_is_number(ppf.some) && json.value_number(ppf.some) >= 0) {
                        pub_perm = json.value_number(ppf.some)::u32;
                        has_pub_perm = true;
                    }
                }
                if (!has_pub_perm) {
                    val tpf2: opt[*json.Value] = json.value_find(g.some, "target_perm");
                    if (sel tpf2.some) {
                        if (json.value_is_number(tpf2.some) && json.value_number(tpf2.some) >= 0) {
                            pub_perm = json.value_number(tpf2.some)::u32;
                            has_pub_perm = true;
                        }
                    }
                }
                if (p == nil || pn == 0 || st == nil || pathx.check(p) != pathx.P_OK) {
                    commit.unlock(?held);
                    ret simple_error(w, "undo_corrupt", "invalid file entry in undo snapshot");
                }
                if (has_old && psha != nil && pshan == 64) {
                    var chk_psha: [65]u8;
                    commit.hash_hex(old_t, old_n, ?chk_psha[0]);
                    if (!util.eq(psha, ?chk_psha[0])) {
                        commit.unlock(?held);
                        ret simple_error(w, "undo_corrupt", "undo snapshot old_text hash does not match recorded prev_sha256");
                    }
                }
                val same_sha: bool = util.eq(st, "replaced") && sha != nil && psha != nil && util.eq(sha, psha);
                val existing_idx: i64 = find_rev_entry(?rev_set, p);
                if (existing_idx >= 0) {
                    val ent: *commit.Entry = commit.entry(?rev_set, existing_idx::usize);
                    if (util.eq(st, "created")) {
                        ent.mode = commit.MODE_DELETE;
                        ent.data = nil;
                        ent.len = 0;
                        ent.has_target_perm = false;
                        ent.target_perm = 0;
                        ent.force_replace = false;
                        ent.force_delete = force;
                        ent.must_be_absent = !ent.pre_existed;
                    }
                    or (util.eq(st, "replaced") || util.eq(st, "deleted")) {
                        if (!has_old) {
                            commit.unlock(?held);
                            ret simple_error(w, "undo_unavailable", "undo snapshot does not hold previous text for a file");
                        }
                        ent.must_be_absent = false;
                        ent.force_delete = false;
                        ent.force_replace = same_sha;
                        ent.data = old_t;
                        ent.len = old_n;
                        ent.has_target_perm = has_operm;
                        ent.target_perm = operm;
                        commit.hash_hex(old_t, old_n, ?ent.sha[0]);
                        if (force) { ent.mode = commit.MODE_UPSERT; }
                        or (ent.pre_existed) { ent.mode = commit.MODE_REPLACE; }
                        or { ent.mode = commit.MODE_CREATE; }
                    }
                    or {
                        commit.unlock(?held);
                        ret simple_error(w, "undo_corrupt", "unknown status in undo snapshot");
                    }
                }
                or {
                    if (util.eq(st, "created")) {
                        val added: res[usize, A.Error] = commit.add(?rev_set, p, nil, 0, commit.MODE_DELETE);
                        if (sel added.ok) {
                            val ent: *commit.Entry = commit.entry(?rev_set, added.ok);
                            ent.pre_existed = true;
                            ent.force_delete = force;
                            if (!force && sha != nil) {
                                commit.set_expect(ent, sha);
                            }
                            if (!force && has_pub_perm) {
                                ent.has_expect_perm = true;
                                ent.expect_perm = pub_perm;
                            }
                        }
                    }
                    or (util.eq(st, "replaced")) {
                        if (!has_old) {
                            commit.unlock(?held);
                            ret simple_error(w, "undo_unavailable", "undo snapshot does not hold previous text for a replaced file");
                        }
                        var mode: u8 = commit.MODE_REPLACE;
                        if (force) { mode = commit.MODE_UPSERT; }
                        val added: res[usize, A.Error] = commit.add(?rev_set, p, old_t, old_n, mode);
                        if (sel added.ok) {
                            val ent: *commit.Entry = commit.entry(?rev_set, added.ok);
                            ent.pre_existed = true;
                            ent.has_target_perm = has_operm;
                            ent.target_perm = operm;
                            ent.force_replace = same_sha;
                            if (!force && sha != nil) {
                                commit.set_expect(ent, sha);
                            }
                            if (!force && has_pub_perm) {
                                ent.has_expect_perm = true;
                                ent.expect_perm = pub_perm;
                            }
                        }
                    }
                    or (util.eq(st, "deleted")) {
                        if (!has_old) {
                            commit.unlock(?held);
                            ret simple_error(w, "undo_unavailable", "undo snapshot does not hold previous text for a deleted file");
                        }
                        var mode: u8 = commit.MODE_CREATE;
                        if (force) { mode = commit.MODE_UPSERT; }
                        val added: res[usize, A.Error] = commit.add(?rev_set, p, old_t, old_n, mode);
                        if (sel added.ok) {
                            val ent: *commit.Entry = commit.entry(?rev_set, added.ok);
                            ent.pre_existed = false;
                            ent.has_target_perm = has_operm;
                            ent.target_perm = operm;
                        }
                    }
                    or {
                        commit.unlock(?held);
                        ret simple_error(w, "undo_corrupt", "unknown status in undo snapshot");
                    }
                }
            }
            i = i + 1;
        }
        last_reverted = cur_txn;
        cur_txn = prev_txn;
        cur_txn_n = prev_n;
        step_i = step_i + 1;
    }

    var redo_w: jw.Jw = jw.init(a);
    if (is_head_undo) {
        var rk: usize = steps::usize;
        for (rk > 0) {
            rk = rk - 1;
            if (redo_w.len > 0) { jw.byte(?redo_w, ' '); }
            jw.raw_vn(?redo_w, undone_txns[rk], undone_lens[rk]);
        }
        val ex_redo_full: res[str, A.Error] = pathx.native(a, s.root, ".qark/undo/redo");
        if (sel ex_redo_full.ok) {
            val ex_rtxt: res[str, filesystem.FsError] = filesystem.read_string(a, ex_redo_full.ok);
            if (sel ex_rtxt.ok) {
                var erp: *u8 = ex_rtxt.ok;
                var ern: usize = str_len(erp);
                var ers: usize = 0;
                for (ers < ern && (erp[ers] == '\n' || erp[ers] == '\r' || erp[ers] == ' ')) { ers = ers + 1; }
                for (ern > ers && (erp[ern - 1] == '\n' || erp[ern - 1] == '\r' || erp[ern - 1] == ' ')) { ern = ern - 1; }
                if (ern > ers) {
                    jw.byte(?redo_w, '\n');
                    jw.raw_vn(?redo_w, (erp::usize + ers)::*u8, ern - ers);
                }
            }
        }
    }

    commit.observe(?rev_set);
    val conflicts: i64 = commit.tally(?rev_set, commit.ST_CONFLICT);
    if (conflicts > 0 && !dry) {
        commit.unlock(?held);
        error_obj(w, "conflict", "a file was modified since that transaction; nothing was reverted. pass force: true to overwrite");
        files_list(w, ?rev_set, false, false, true, false, a);
        jw.obj_end(w);
        ret false;
    }
    var utxn: [17]u8;
    txn_id(?utxn[0]);
    if (!dry) {
        var uj_buf: *u8 = nil;
        var uj_len: usize = 0;
        if (!build_undo_journal_line(s, ?rev_set, "transaction.undone", ?utxn[0], last_reverted, ?uj_buf, ?uj_len)) {
            commit.unlock(?held);
            ret simple_error(w, "oom", "out of memory");
        }
        if (commit.dirty(?rev_set)) {
            if (!write_wal_publishing(a, s.root, "undo", ?utxn[0], ?rev_set, true)) {
                clear_wal(a, s.root, rev_set.durable);
                commit.unlock(?held);
                ret simple_error(w, "undo_failed", "could not persist write-ahead log under .qark before undo; nothing was reverted");
            }
            val out: commit.Outcome = commit.publish(?rev_set);
            if (!out.ok) {
                if (!out.rollback_failed) {
                    clear_wal(a, s.root, rev_set.durable);
                }
                commit.unlock(?held);
                error_obj(w, out.code, out.msg);
                if (out.rollback_failed) {
                    jw.f_bool(w, "rollback_failed", true);
                    jw.f_bool(w, "recovery_required", true);
                }
                jw.obj_end(w);
                ret false;
            }
        }
        if (!write_wal_committed(a, s.root, "undo", ?utxn[0], rev_set.durable, is_head_undo, prev_txn, prev_n, is_head_undo, redo_w.buf, redo_w.len, false, uj_buf, uj_len, nil, nil, 0)) {
            val r_st: i64 = recover_wal(a, s.root);
            commit.unlock(?held);
            if (r_st < 0) {
                ret recovery_error(w, "undo WAL commit failed and automatic rollback also failed; workspace recovery is required");
            }
            ret simple_error(w, "journal_failed", "undo could not be committed in .qark/wal.json; changes were rolled back");
        }
        var uj_off: i64 = -1;
        if (!finalize_committed_wal(a, s.root, ?rev_set, ?utxn[0], is_head_undo, prev_txn, prev_n, is_head_undo, redo_w.buf, redo_w.len, false, uj_buf, uj_len, nil, nil, 0, ?uj_off)) {
            if (recover_wal(a, s.root) < 0) {
                commit.unlock(?held);
                ret recovery_error(w, "undo committed on disk, but finalizing .qark metadata failed; run any operation to complete recovery");
            }
        }
    }
    commit.unlock(?held);
    jw.obj(w);
    jw.f_str(w, "txn", ?utxn[0]);
    if (s.root != nil) { jw.f_str(w, "root", s.root); }
    jw.f_str(w, "reverted_txn", last_reverted);
    if (is_head_undo && prev_txn != nil && prev_n > 0) {
        jw.f_str(w, "prev_txn", prev_txn);
    }
    if (steps > 1) {
        jw.f_i64(w, "steps_reverted", steps);
    }
    jw.f_bool(w, "dry_run", dry);
    if (rev_set.durable) { jw.f_bool(w, "durable", true); }
    counts(w, ?rev_set);
    files_list(w, ?rev_set, dry, false, false, show_diff, a);
    jw.obj_end(w);
    ret true;
}

fun push_event(ev_w: *jw.Jw, count: *i64, phase: str, status: str, us: i64, files: i64) {
    if (@count == 0) { jw.arr(ev_w); }
    jw.obj(ev_w);
    jw.f_str(ev_w, "phase", phase);
    jw.f_str(ev_w, "status", status);
    jw.f_ms(ev_w, "ms", us);
    if (files >= 0) { jw.f_i64(ev_w, "files", files); }
    jw.obj_end(ev_w);
    @count = @count + 1;
}

fun has_any_file_check(set: *commit.Set) bool {
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.check_policy == commit.CP_STRICT || e.check_policy == commit.CP_REQUIRED || e.check_policy == commit.CP_PERMISSIVE) {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun eval_check_block(set: *commit.Set, sp_check: u8, proj_val_ok: bool, out_failed: *i64, out_errored: *i64, out_req_unavail: *i64) bool {
    var failed_n: i64 = 0;
    var err_n: i64 = 0;
    var req_n: i64 = 0;
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
            val pol: u8 = entry_eff_policy(sp_check, e);
            if (pol != spec.CHECK_OFF) {
                if (e.check == commit.CK_FAILED) {
                    failed_n = failed_n + 1;
                }
                or (e.check == commit.CK_ERROR && pol != spec.CHECK_PERMISSIVE) {
                    err_n = err_n + 1;
                }
                or (pol == spec.CHECK_REQUIRED && (e.check == commit.CK_SKIPPED || (e.check == commit.CK_NONE && !proj_val_ok))) {
                    req_n = req_n + 1;
                }
            }
        }
        i = i + 1;
    }
    @out_failed = failed_n;
    @out_errored = err_n;
    @out_req_unavail = req_n;
    ret failed_n > 0 || err_n > 0 || req_n > 0;
}

# 0 no existing record, 1 matched & replayed into w, -1 mismatch or corrupt (error emitted into w)
fun check_idempotency(a: *A.Allocator, root: str, idem_rel: str, req_sha: *u8, w: *jw.Jw) i64 {
    if (idem_rel == nil) { ret 0; }
    if (!commit.check_control_dir(a, root)) {
        simple_error(w, "idempotency_corrupt", "invalid .qark/idempotency control directory");
        ret -1;
    }
    val ifull: res[str, A.Error] = pathx.native(a, root, idem_rel);
    if (sel ifull.err) {
        simple_error(w, "oom", "out of memory");
        ret -1;
    }
    val im: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(ifull.ok);
    if (sel im.err) {
        if (im.err.kind == io_error.NOT_FOUND || im.err.kind == io_error.NOT_DIRECTORY) { ret 0; }
        simple_error(w, "idempotency_corrupt", "could not inspect existing idempotency record");
        ret -1;
    }
    if (im.ok.kind != filesystem.KIND_FILE) {
        simple_error(w, "idempotency_corrupt", "idempotency record is not a regular file");
        ret -1;
    }
    val itxt: res[str, filesystem.FsError] = filesystem.read_string(a, ifull.ok);
    if (sel itxt.err) {
        simple_error(w, "idempotency_corrupt", "could not read existing idempotency record");
        ret -1;
    }
    val iparsed: res[json.Value, json.JsonError] = json.parse(itxt.ok, str_len(itxt.ok), a);
    if (sel iparsed.err) {
        simple_error(w, "idempotency_corrupt", "existing idempotency record is not valid json");
        ret -1;
    }
    var idoc: json.Value = iparsed.ok;
    if (!json.value_is_object(?idoc)) {
        simple_error(w, "idempotency_corrupt", "existing idempotency record root must be an object");
        ret -1;
    }
    var isha: *u8 = nil;
    var ishan: usize = 0;
    val isf: opt[*json.Value] = json.value_find(?idoc, "spec_sha256");
    if (sel isf.some) { spec.decode_pub(a, isf.some, ?isha, ?ishan); }
    if (isha == nil || ishan != 64) {
        simple_error(w, "idempotency_corrupt", "existing idempotency record is missing spec_sha256");
        ret -1;
    }
    if (!util.eq(isha, req_sha)) {
        simple_error(w, "idempotency_mismatch", "idempotency_key was already used with a different spec payload");
        ret -1;
    }
    val irec: opt[*json.Value] = json.value_find(?idoc, "receipt");
    if (!sel irec.some) {
        simple_error(w, "idempotency_corrupt", "existing idempotency record is missing receipt");
        ret -1;
    }
    spec.emit_json(w, irec.some, false, 0);
    ret 1;
}

# apply a spec: compile, observe, check, validate, then publish under the workspace lock
pub fun apply(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    if (json.value_is_object(args)) {
        val uf: opt[*json.Value] = json.value_find(args, "undo");
        if (sel uf.some) {
            if ((json.value_is_bool(uf.some) && json.value_bool(uf.some)) || json.value_is_string(uf.some)) {
                ret undo(s, args, w);
            }
        }
        val rf: opt[*json.Value] = json.value_find(args, "redo");
        if (sel rf.some) {
            if (json.value_is_bool(rf.some) && json.value_bool(rf.some)) {
                ret redo(s, args, w);
            }
        }
    }
    val a: *A.Allocator = ?s.ra;
    val t0: time.Instant = started();
    val stream: bool = spec.fbool_pub(args, "stream");
    val req_expect: bool = s.require_expect || spec.fbool_pub(args, "require_expect");
    var timeout_ms: i64 = check.TIMEOUT_MS;
    if (json.value_is_object(args)) {
        val tmf: opt[*json.Value] = json.value_find(args, "timeout_ms");
        if (sel tmf.some) {
            if (json.value_is_number(tmf.some) && json.value_number(tmf.some) > 0) {
                timeout_ms = json.value_number(tmf.some);
                if (timeout_ms < 100) { timeout_ms = 100; }
                if (timeout_ms > 600000) { timeout_ms = 600000; }
            }
        }
    }
    var ik_p: *u8 = nil;
    var ik_n: usize = 0;
    var idem_rel: str = nil;
    if (json.value_is_object(args)) {
        val ikf: opt[*json.Value] = json.value_find(args, "idempotency_key");
        if (sel ikf.some) {
            if (!json.value_is_string(ikf.some) || !spec.decode_pub(a, ikf.some, ?ik_p, ?ik_n) || ik_n == 0) {
                ret simple_error(w, "spec_type", "idempotency_key must be a non-empty string token");
            }
            val sl1: opt[usize] = util.index_byte(ik_p, ik_n, '/');
            val sl2: opt[usize] = util.index_byte(ik_p, ik_n, '\\');
            if (pathx.check(ik_p) != pathx.P_OK || sel sl1.some || sel sl2.some) {
                ret simple_error(w, "spec_type", "idempotency_key must be a single path-safe token");
            }
            var iw: jw.Jw = jw.init(a);
            jw.raw(?iw, ".qark/idempotency/");
            jw.raw(?iw, ik_p);
            jw.raw(?iw, ".json");
            idem_rel = jw.text(?iw);
        }
    }
    var ev_w: jw.Jw = jw.init(a);
    var ev_cnt: i64 = 0;
    var val_spec: *json.Value = nil;
    val vf: opt[*json.Value] = json.value_find(args, "validate");
    if (sel vf.some) { val_spec = vf.some; }
    or {
        val pcf: opt[*json.Value] = json.value_find(args, "project_check");
        if (sel pcf.some) { val_spec = pcf.some; }
    }
    if (s.require_check && val_spec != nil && json.value_is_bool(val_spec) && !json.value_bool(val_spec)) {
        ret simple_error(w, "check_unavailable", "session requires syntax checking (--require-check); validate cannot be disabled");
    }
    if (s.no_custom_exec && val_spec != nil && !(json.value_is_bool(val_spec) && !json.value_bool(val_spec))) {
        ret simple_error(w, "exec_forbidden", "custom validation command execution is disabled by --no-custom-exec");
    }

    var compact: jw.Jw = jw.init(a);
    spec.emit_json(?compact, args, false, 0);
    var req_sha: [65]u8;
    commit.hash_hex(compact.buf, compact.len, ?req_sha[0]);

    var held: commit.Lock;
    held.held = false;
    var has_early_lock: bool = false;

    # Acquire lock and check idempotency BEFORE spec.compile so concurrent or retried relative edits/moves/deletes are serialized and replayed cleanly
    if (idem_rel != nil) {
        var early_set: commit.Set = commit.init(a, s.root);
        val early_locked: i64 = commit.lock(?early_set, s.lock_ms, ?held);
        if (early_locked == 1) { ret simple_error(w, "locked", "another qark process held the workspace lock too long; nothing was written. retry the same request"); }
        if (early_locked != 0) { ret simple_error(w, "lock_failed", "the workspace lock under .qark could not be taken; nothing was written"); }
        has_early_lock = true;
        if (!s.force_dry && !spec.fbool_pub(args, "dry_run")) {
            if (recover_wal(a, s.root) < 0) {
                commit.unlock(?held);
                ret recovery_error(w, "workspace recovery from an interrupted transaction failed; manual inspection is required");
            }
        }
        val id_st0: i64 = check_idempotency(a, s.root, idem_rel, ?req_sha[0], w);
        if (id_st0 == 1) {
            commit.unlock(?held);
            ret true;
        }
        if (id_st0 < 0) {
            commit.unlock(?held);
            ret false;
        }
    }

    var sp: spec.Spec;
    var e: spec.Err;
    var lib: spec.Lib;
    lib.ctx = (s::usize)::*u8;
    lib.find = lib_find;
    if (!spec.compile(?sp, a, s.root, args, compact.buf, compact.len, ?lib, ?e)) {
        if (has_early_lock) { commit.unlock(?held); }
        ret spec_error(w, ?e);
    }
    if (s.strict_spec && sp.unknown_key != nil) {
        e.code = "spec_unknown_key";
        e.msg = sp.unknown_key;
        e.field = sp.unknown_fld;
        if (has_early_lock) { commit.unlock(?held); }
        ret spec_error(w, ?e);
    }
    if (s.durable) {
        sp.durable = true;
        sp.set.durable = true;
    }
    if (s.force_dry) { sp.dry = true; }
    if (s.require_check) {
        var top_chk_weak: bool = sp.check == spec.CHECK_OFF || sp.check == spec.CHECK_PERMISSIVE;
        if (json.value_is_object(args)) {
            val top_cf: opt[*json.Value] = json.value_find(args, "check");
            if (sel top_cf.some) {
                if (json.value_is_string(top_cf.some)) {
                    var tcp: *u8 = nil;
                    var tcn: usize = 0;
                    if (spec.decode_pub(a, top_cf.some, ?tcp, ?tcn) && util.eq(tcp, "strict")) {
                        top_chk_weak = true;
                    }
                }
            }
        }
        if (top_chk_weak) {
            if (has_early_lock) { commit.unlock(?held); }
            ret simple_error(w, "check_unavailable", "session requires syntax checking (--require-check); check policy cannot be weakened");
        }
        sp.check = spec.CHECK_REQUIRED;
        var pci: usize = 0;
        for (pci < commit.count(?sp.set)) {
            val pce: *commit.Entry = commit.entry(?sp.set, pci);
            if (pce.check_policy == commit.CP_OFF || pce.check_policy == commit.CP_PERMISSIVE || pce.check_policy == commit.CP_STRICT) {
                if (has_early_lock) { commit.unlock(?held); }
                ret simple_error(w, "check_unavailable", "session requires syntax checking (--require-check); per-file check policy cannot weaken required checking");
            }
            pce.check_policy = commit.CP_REQUIRED;
            pci = pci + 1;
        }
    }

    val preview: bool = spec.fbool_pub(args, "preview");
    val t_compile: i64 = now_us(t0);
    if (stream) { push_event(?ev_w, ?ev_cnt, "compile", "ok", t_compile, commit.count(?sp.set)::i64); }

    if (!has_early_lock) {
        val locked: i64 = commit.lock(?sp.set, s.lock_ms, ?held);
        if (locked == 1) { ret simple_error(w, "locked", "another qark process held the workspace lock too long; nothing was written. retry the same request"); }
        if (locked != 0) { ret simple_error(w, "lock_failed", "the workspace lock under .qark could not be taken; nothing was written"); }
    }

    if (sp.dry) {
        if (has_pending_wal(a, s.root)) {
            commit.unlock(?held);
            ret recovery_error(w, "an interrupted transaction requires workspace recovery before previewing changes");
        }
    }
    or {
        if (recover_wal(a, s.root) < 0) {
            commit.unlock(?held);
            ret recovery_error(w, "workspace recovery from an interrupted transaction failed; manual inspection is required");
        }
        if (idem_rel != nil) {
            val id_st1: i64 = check_idempotency(a, s.root, idem_rel, ?req_sha[0], w);
            if (id_st1 == 1) {
                commit.unlock(?held);
                ret true;
            }
            if (id_st1 < 0) {
                commit.unlock(?held);
                ret false;
            }
        }
    }

    commit.observe(?sp.set);
    var sz_i: usize = 0;
    for (sz_i < commit.count(?sp.set)) {
        val sze: *commit.Entry = commit.entry(?sp.set, sz_i);
        if ((sze.status == commit.ST_REPLACE || sze.status == commit.ST_DELETE) && sze.old_len > spec.MAX_FILE_BYTES) {
            commit.unlock(?held);
            error_obj(w, "spec_limit", "an existing file exceeds the 8 MiB transaction recovery snapshot limit; nothing was written");
            jw.f_str(w, "path", sze.rel);
            jw.obj_end(w);
            ret false;
        }
        sz_i = sz_i + 1;
    }
    if (req_expect) {
        var rxi: usize = 0;
        for (rxi < commit.count(?sp.set)) {
            val rxe: *commit.Entry = commit.entry(?sp.set, rxi);
            if (rxe.existed && (!rxe.has_expect || !rxe.user_expect)) {
                commit.unlock(?held);
                error_obj(w, "expect_required", "require_expect is true, but an existing file was modified or deleted without expect");
                jw.f_str(w, "path", rxe.rel);
                jw.f_str(w, "current_sha256", ?rxe.old_sha[0]);
                jw.obj_end(w);
                ret false;
            }
            rxi = rxi + 1;
        }
    }
    val conflicts: i64 = commit.tally(?sp.set, commit.ST_CONFLICT);
    if (stream) {
        var obs_st: str = "ok";
        if (conflicts > 0) { obs_st = "conflict"; }
        push_event(?ev_w, ?ev_cnt, "observe", obs_st, now_us(t0) - t_compile, conflicts);
    }
    if (conflicts > 0 && !sp.dry) {
        commit.unlock(?held);
        error_obj(w, "conflict", "a file conflicts with what is on disk; nothing was written. each conflict below names the reason and the current sha256");
        files_list(w, ?sp.set, false, false, true, false, a);
        jw.obj_end(w);
        ret false;
    }

    var t_check: i64 = t_compile;
    var val_ran: bool = false;
    var val_ok: bool = true;
    var val_msg: str = nil;
    val do_check: bool = sp.check != spec.CHECK_OFF || has_any_file_check(?sp.set);
    s.tools.no_custom_exec = s.no_custom_exec;
    if (do_check) {
        check.run(a, s.a, s.root, ?sp.set, ?s.tools, timeout_ms);
        if (!s.no_custom_exec && conflicts == 0 && check.has_staged(a, s.root, ?sp.set)) {
            check.run_staged(a, s.root, ?sp.set, timeout_ms);
        }
        t_check = now_us(t0);
    }
    if (!s.no_custom_exec && conflicts == 0 && (val_spec != nil || do_check)) {
        val t_dval0: i64 = now_us(t0);
        val_ok = check.run_project_validation(a, s.root, ?sp.set, val_spec, timeout_ms, ?val_ran, ?val_msg);
        if (val_ran && stream) {
            var dvst: str = "ok";
            if (!val_ok) { dvst = "failed"; }
            push_event(?ev_w, ?ev_cnt, "validate", dvst, now_us(t0) - t_dval0, -1);
        }
        t_check = now_us(t0);
    }

    var failed: i64 = 0;
    var errored: i64 = 0;
    var req_unavail: i64 = 0;
    val chk_blocked: bool = eval_check_block(?sp.set, sp.check, val_ran && val_ok, ?failed, ?errored, ?req_unavail);
    val total_errored: i64 = check_tally(?sp.set, commit.CK_ERROR);
    if (do_check && stream) {
        var chk_ev_st: str = "ok";
        if (chk_blocked) { chk_ev_st = "failed"; }
        push_event(?ev_w, ?ev_cnt, "check", chk_ev_st, t_check - t_compile, check_tally(?sp.set, commit.CK_OK));
    }
    val blocked: bool = chk_blocked || (val_ran && !val_ok);
    if (blocked && !sp.dry) {
        commit.unlock(?held);
        if (val_ran && !val_ok && failed == 0 && errored == 0) {
            error_obj(w, "check_failed", "project validation failed before commit; nothing was written");
        }
        or (failed > 0) {
            error_obj(w, "check_failed", "a file failed its syntax check; nothing was written. fix the lines named below and apply again");
        }
        or (errored > 0) {
            error_obj(w, "checker_error", "a syntax checker crashed or returned invalid output; nothing was written");
        }
        or {
            error_obj(w, "check_unavailable", "check is required but a checker could not run or no checker is configured for a file; nothing was written");
        }
        if (val_ran && !val_ok && val_msg != nil) {
            jw.f_str(w, "validation_message", val_msg);
        }
        jw.f_str(w, "check_policy", check_policy_name(sp.check));
        jw.f_bool(w, "validation_complete", false);
        emit_checks_summary(w, ?sp.set);
        if (total_errored > 0) {
            emit_checker_diagnostics(w, ?sp.set);
        }
        jw.key(w, "files");
        jw.arr(w);
        var i: usize = 0;
        for (i < commit.count(?sp.set)) {
            val en: *commit.Entry = commit.entry(?sp.set, i);
            val epol: u8 = entry_eff_policy(sp.check, en);
            if (en.check == commit.CK_FAILED || (en.check == commit.CK_ERROR && epol != spec.CHECK_PERMISSIVE) || (epol == spec.CHECK_REQUIRED && (en.check == commit.CK_SKIPPED || en.check == commit.CK_NONE))) {
                file_receipt(w, a, en, false, false, false);
            }
            i = i + 1;
        }
        jw.arr_end(w);
        jw.obj_end(w);
        ret false;
    }

    var txn: [17]u8;
    txn_id(?txn[0]);
    val is_dirty: bool = !sp.dry && commit.dirty(?sp.set);
    var journal: i64 = -1;
    if (is_dirty) {
        journal = peek_journal_offset(a, s.root);
        if (!write_undo_snapshot(s, ?sp, ?txn[0]) || !write_wal_publishing(a, s.root, "apply", ?txn[0], ?sp.set, false)) {
            if (clear_wal(a, s.root, sp.set.durable)) {
                remove_undo_snapshot(a, s.root, ?txn[0], sp.set.durable);
            }
            commit.unlock(?held);
            ret simple_error(w, "undo_failed", "could not persist undo snapshot or write-ahead log under .qark before commit; nothing was written");
        }
        val out: commit.Outcome = commit.publish(?sp.set);
        if (!out.ok) {
            if (!out.rollback_failed) {
                if (clear_wal(a, s.root, sp.set.durable)) {
                    remove_undo_snapshot(a, s.root, ?txn[0], sp.set.durable);
                }
            }
            commit.unlock(?held);
            error_obj(w, out.code, out.msg);
            if (out.index >= 0) { jw.f_str(w, "path", commit.entry(?sp.set, out.index::usize).rel); }
            if (out.rollback_failed) {
                jw.f_bool(w, "rollback_failed", true);
                jw.f_bool(w, "recovery_required", true);
                files_list(w, ?sp.set, false, false, false, false, a);
            }
            jw.obj_end(w);
            ret false;
        }
        s.written = s.written + commit.tally(?sp.set, commit.ST_CREATE) + commit.tally(?sp.set, commit.ST_REPLACE);
    }
    s.applies = s.applies + 1;
    val t_total: i64 = now_us(t0);
    if (stream) {
        push_event(?ev_w, ?ev_cnt, "commit", "ok", t_total - t_check, commit.tally(?sp.set, commit.ST_CREATE) + commit.tally(?sp.set, commit.ST_REPLACE));
        jw.arr_end(?ev_w);
    }
    var rw: jw.Jw = jw.init(a);
    jw.obj(?rw);
    jw.f_str(?rw, "txn", ?txn[0]);
    if (s.root != nil) { jw.f_str(?rw, "root", s.root); }
    jw.f_bool(?rw, "dry_run", sp.dry);
    if (sp.set.durable) {
        jw.f_bool(?rw, "durable", true);
    }
    if (sp.dry) {
        jw.f_bool(?rw, "ready", conflicts == 0 && !blocked);
    }
    jw.f_str(?rw, "check_policy", check_policy_name(sp.check));
    jw.f_bool(?rw, "validation_complete", is_validation_complete(?sp.set, sp.check, val_ran, val_ok));
    emit_checks_summary(?rw, ?sp.set);
    if (total_errored > 0) {
        emit_checker_diagnostics(?rw, ?sp.set);
    }
    if (val_ran) {
        if (val_ok) { jw.f_str(?rw, "validation", "ok"); }
        or {
            jw.f_str(?rw, "validation", "failed");
            if (val_msg != nil) { jw.f_str(?rw, "validation_message", val_msg); }
        }
    }
    if (sp.job != nil) { jw.f_str(?rw, "job", sp.job); }
    if (sp.dest != nil && sp.dest[0] != 0) { jw.f_str(?rw, "dest", sp.dest); }
    jw.f_str(?rw, "spec_sha256", ?sp.sha[0]);
    counts(?rw, ?sp.set);
    files_list(?rw, ?sp.set, sp.dry, preview, false, sp.diff, a);
    if (stream && !ev_w.failed && ev_w.len > 0) {
        jw.key(?rw, "events");
        jw.raw_vn(?rw, ev_w.buf, ev_w.len);
    }
    if (sp.warns.len > 0) {
        jw.key(?rw, "warnings");
        jw.arr(?rw);
        var wi: usize = 0;
        for (wi < sp.warns.len) {
            jw.str_v(?rw, sp.warns.data[wi]);
            wi = wi + 1;
        }
        jw.arr_end(?rw);
    }
    if (sp.manifest >= 0) { jw.f_str(?rw, "manifest", commit.entry(?sp.set, sp.manifest::usize).rel); }
    if (journal >= 0) { jw.f_i64(?rw, "journal_offset", journal); }
    jw.key(?rw, "ms");
    jw.obj(?rw);
    jw.f_ms(?rw, "compile", t_compile);
    jw.f_ms(?rw, "check", t_check - t_compile);
    jw.f_ms(?rw, "commit", t_total - t_check);
    jw.f_ms(?rw, "total", t_total);
    jw.obj_end(?rw);
    jw.obj_end(?rw);

    var idw_buf: *u8 = nil;
    var idw_len: usize = 0;
    if (!sp.dry && idem_rel != nil && !rw.failed && rw.buf != nil && rw.len >= 2) {
        var idw: jw.Jw = jw.init(a);
        jw.obj(?idw);
        jw.f_str(?idw, "spec_sha256", ?req_sha[0]);
        jw.key(?idw, "receipt");
        jw.raw_vn(?idw, rw.buf, rw.len - 1);
        jw.raw(?idw, ",\"replayed\":true,\"idempotent_replay\":true}");
        jw.obj_end(?idw);
        jw.byte(?idw, '\n');
        if (!idw.failed && idw.buf != nil) {
            idw_buf = idw.buf;
            idw_len = idw.len;
        }
    }

    if (is_dirty) {
        var j_buf: *u8 = nil;
        var j_len: usize = 0;
        val j_ok: bool = build_journal_line(s, ?sp, ?txn[0], val_ran, val_ok, ?j_buf, ?j_len);
        val id_ok: bool = idem_rel == nil || (idw_buf != nil && idw_len > 0);
        if (!j_ok || !id_ok || !write_wal_committed(a, s.root, "apply", ?txn[0], sp.set.durable, true, ?txn[0], str_len(?txn[0]), false, nil, 0, true, j_buf, j_len, idem_rel, idw_buf, idw_len)) {
            val r_st: i64 = recover_wal(a, s.root);
            commit.unlock(?held);
            if (r_st < 0) {
                ret recovery_error(w, "WAL commit failed after publish and automatic rollback also failed; workspace recovery is required");
            }
            ret simple_error(w, "journal_failed", "transaction could not be committed in .qark/wal.json; changes were rolled back");
        }
        if (!finalize_committed_wal(a, s.root, ?sp.set, ?txn[0], true, ?txn[0], str_len(?txn[0]), false, nil, 0, true, j_buf, j_len, idem_rel, idw_buf, idw_len, ?journal)) {
            if (recover_wal(a, s.root) < 0) {
                commit.unlock(?held);
                ret recovery_error(w, "transaction committed on disk, but finalizing .qark metadata failed; run any operation to complete recovery");
            }
        }
    }
    or (!sp.dry && idem_rel != nil) {
        if (idw_buf == nil || idw_len == 0 || !commit.check_control_dir(a, s.root) || commit.check_ancestry(a, s.root, idem_rel) != nil) {
            commit.unlock(?held);
            ret simple_error(w, "idempotency_failed", "could not persist .qark/idempotency record");
        }
        val ifull2: res[str, A.Error] = pathx.native(a, s.root, idem_rel);
        if (sel ifull2.err) {
            commit.unlock(?held);
            ret simple_error(w, "oom", "out of memory");
        }
        val wr_idem: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, ifull2.ok, idw_buf, idw_len, 384, 448);
        if (sel wr_idem.err) {
            commit.unlock(?held);
            ret simple_error(w, "idempotency_failed", "could not persist .qark/idempotency record");
        }
        if (sp.set.durable && (!commit.sync_file(ifull2.ok) || !commit.sync_parent_dir(a, ifull2.ok))) {
            commit.unlock(?held);
            ret simple_error(w, "idempotency_failed", "could not sync .qark/idempotency record");
        }
    }
    commit.unlock(?held);
    jw.raw_vn(w, rw.buf, rw.len);
    ret true;
}

fun name_lt(a: str, b: str) bool {
    var i: usize = 0;
    for (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    ret a[i] < b[i];
}

fun line_span_bytes(p: *u8, n: usize, use_lo: i64, use_hi: i64, from_out: *usize, to_out: *usize) {
    var line: i64 = 1;
    var i: usize = 0;
    var from: usize = n;
    var to: usize = n;
    if (use_lo <= 1) { from = 0; }
    for (i < n) {
        if (p[i] == '\n') {
            line = line + 1;
            if (line == use_lo) { from = i + 1; }
            if (line == use_hi + 1) {
                to = i + 1;
                brk;
            }
        }
        i = i + 1;
    }
    if (from > to) { from = to; }
    @from_out = from;
    @to_out = to;
}

fun read_one(s: *session.Session, rel_in: str, content: bool, rem_bytes: *usize, io_trunc: *bool, lo: i64, hi: i64, sym_p: *u8, sym_n: usize, syms_list: *vector.Vector[str], fold: bool, outline: bool, w: *jw.Jw) {
    val a: *A.Allocator = ?s.ra;
    jw.obj(w);
    val stripped: str = pathx.strip_root(s.root, rel_in);
    var rel: str = stripped;
    var root_dir: bool = util.eq(stripped, ".") || stripped[0] == 0;
    if (!root_dir) {
        val canon: res[str, A.Error] = pathx.canonical(a, stripped);
        if (sel canon.ok) { rel = canon.ok; }
        val r: i64 = pathx.check(rel);
        if (r != pathx.P_OK) {
            jw.f_str(w, "path", rel);
            jw.f_str(w, "error", pathx.code(r));
            jw.f_str(w, "message", pathx.message(r));
            jw.obj_end(w);
            ret;
        }
        val anc_err: str = commit.check_ancestry(a, s.root, rel);
        if (anc_err != nil) {
            jw.f_str(w, "path", rel);
            jw.f_str(w, "error", anc_err);
            jw.f_str(w, "message", "path traverses a symlink or non-directory ancestor");
            jw.obj_end(w);
            ret;
        }
    }
    jw.f_str(w, "path", rel);
    var full: str = s.root;
    if (!root_dir) {
        val f: res[str, A.Error] = pathx.native(a, s.root, rel);
        if (sel f.ok) { full = f.ok; }
    }
    val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(full);
    if (sel m.err) {
        jw.f_bool(w, "exists", false);
        jw.obj_end(w);
        ret;
    }
    jw.f_bool(w, "exists", true);
    if (m.ok.kind == filesystem.KIND_SYMLINK) {
        jw.f_str(w, "kind", "link");
        jw.f_str(w, "error", "path_link");
        jw.f_str(w, "message", "refusing to read symlink target");
        jw.obj_end(w);
        ret;
    }
    if (m.ok.kind == filesystem.KIND_DIR) {
        jw.f_str(w, "kind", "dir");
        val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(a, full);
        if (sel names.ok) {
            var list: vector.Vector[str] = names.ok;
            var i: usize = 1;
            for (i < list.len) {
                var j: usize = i;
                for (j > 0 && name_lt(list.data[j], list.data[j - 1])) {
                    val t: str = list.data[j];
                    list.data[j] = list.data[j - 1];
                    list.data[j - 1] = t;
                    j = j - 1;
                }
                i = i + 1;
            }
            jw.key(w, "entries");
            jw.arr(w);
            var k: usize = 0;
            for (k < list.len && k < 2000) {
                val name: str = list.data[k];
                val child: res[str, A.Error] = pathx.native(a, full, name);
                var kind: str = "file";
                if (sel child.ok) {
                    val cm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(child.ok);
                    if (sel cm.ok) {
                        if (cm.ok.kind == filesystem.KIND_DIR) { kind = "dir"; }
                        or (cm.ok.kind == filesystem.KIND_SYMLINK) { kind = "link"; }
                    }
                }
                jw.obj(w);
                jw.f_str(w, "name", name);
                jw.f_str(w, "kind", kind);
                jw.obj_end(w);
                k = k + 1;
            }
            jw.arr_end(w);
            if (list.len > 2000) {
                jw.f_bool(w, "truncated", true);
                @io_trunc = true;
            }
        }
        jw.obj_end(w);
        ret;
    }
    if (m.ok.kind != filesystem.KIND_FILE) {
        jw.f_str(w, "kind", "other");
        jw.obj_end(w);
        ret;
    }
    jw.f_str(w, "kind", "file");
    val got: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, full);
    if (sel got.err) {
        jw.f_str(w, "error", "unreadable");
        jw.obj_end(w);
        ret;
    }
    val p: *u8 = got.ok.data;
    val n: usize = got.ok.len;
    var hex: [65]u8;
    commit.hash_hex(p, n, ?hex[0]);
    jw.f_str(w, "sha256", ?hex[0]);
    jw.f_i64(w, "bytes", n::i64);
    jw.f_i64(w, "lines", lines_of(p, n));
    val olang: str = scan.outline_lang(rel);
    if (outline) {
        if (olang != nil && n > 0 && utf8.validate(p, n)) { scan.outline(a, olang, p, n, w); }
        or { jw.key(w, "symbols"); jw.arr(w); jw.arr_end(w); }
    }
    var use_lo: i64 = lo;
    var use_hi: i64 = hi;
    if (syms_list != nil && syms_list.len > 0) {
        if (olang == nil || n == 0 || !utf8.validate(p, n)) {
            jw.f_str(w, "error", "symbol_not_found");
            jw.obj_end(w);
            ret;
        }
        var si: usize = 0;
        for (si < syms_list.len) {
            var slo: i64 = 0;
            var shi: i64 = 0;
            val sn: str = syms_list.data[si];
            if (scan.find_symbol(a, olang, p, n, sn, str_len(sn), ?slo, ?shi) != 1) {
                jw.f_str(w, "error", "symbol_not_found");
                jw.f_str(w, "missing_symbol", sn);
                jw.f_str(w, "available_symbols", scan.list_symbol_names(a, olang, p, n));
                jw.obj_end(w);
                ret;
            }
            si = si + 1;
        }
    }
    if (!fold && sym_p != nil && sym_n > 0) {
        var slo: i64 = 0;
        var shi: i64 = 0;
        scan.find_symbol(a, olang, p, n, sym_p, sym_n, ?slo, ?shi);
        use_lo = slo;
        use_hi = shi;
        jw.f_str(w, "symbol", sym_p);
        jw.f_i64(w, "last_line", shi);
    }
    if (!fold && sym_p == nil && syms_list != nil && syms_list.len > 0) {
        jw.key(w, "spans");
        jw.arr(w);
        var any_trunc: bool = false;
        var si: usize = 0;
        for (si < syms_list.len) {
            var slo: i64 = 0;
            var shi: i64 = 0;
            val sn: str = syms_list.data[si];
            scan.find_symbol(a, olang, p, n, sn, str_len(sn), ?slo, ?shi);
            var sfrom: usize = 0;
            var sto: usize = n;
            line_span_bytes(p, n, slo, shi, ?sfrom, ?sto);
            jw.obj(w);
            jw.f_str(w, "symbol", sn);
            jw.f_i64(w, "first_line", slo);
            jw.f_i64(w, "last_line", shi);
            if (content) {
                val slen: usize = sto - sfrom;
                var stake: usize = slen;
                var scut: bool = false;
                if (stake > @rem_bytes) {
                    stake = truncate_utf8_len((p::usize + sfrom)::*u8, slen, @rem_bytes);
                    scut = true;
                    any_trunc = true;
                    @io_trunc = true;
                }
                jw.f_strn(w, "text", (p::usize + sfrom)::*u8, stake);
                if (scut) { jw.f_bool(w, "truncated", true); }
                if (@rem_bytes >= stake) { @rem_bytes = @rem_bytes - stake; }
                or { @rem_bytes = 0; }
            }
            jw.obj_end(w);
            si = si + 1;
        }
        jw.arr_end(w);
        if (any_trunc) { jw.f_bool(w, "truncated", true); }
        jw.obj_end(w);
        ret;
    }
    if (content) {
        if (n > 0 && !utf8.validate(p, n)) { jw.f_bool(w, "binary", true); }
        or (fold) {
            var fn_len: usize = n;
            val fp: *u8 = scan.fold_view(a, olang, p, n, syms_list, ?fn_len);
            jw.f_bool(w, "folded", true);
            var ftake: usize = fn_len;
            var fcut: bool = false;
            if (ftake > @rem_bytes) {
                ftake = truncate_utf8_len(fp, fn_len, @rem_bytes);
                fcut = true;
                @io_trunc = true;
            }
            if (@rem_bytes >= ftake) { @rem_bytes = @rem_bytes - ftake; }
            or { @rem_bytes = 0; }
            jw.f_strn(w, "text", fp, ftake);
            if (fcut) { jw.f_bool(w, "truncated", true); }
        }
        or {
            var from: usize = 0;
            var to: usize = n;
            if (use_lo > 0) {
                line_span_bytes(p, n, use_lo, use_hi, ?from, ?to);
                jw.f_i64(w, "first_line", use_lo);
            }
            var take: usize = to - from;
            var cut: bool = false;
            if (take > @rem_bytes) {
                take = truncate_utf8_len((p::usize + from)::*u8, take, @rem_bytes);
                cut = true;
                @io_trunc = true;
            }
            if (@rem_bytes >= take) { @rem_bytes = @rem_bytes - take; }
            or { @rem_bytes = 0; }
            jw.key(w, "text");
            jw.str_n(w, (p::usize + from)::*u8, take);
            if (cut) {
                jw.f_bool(w, "truncated", true);
                jw.f_i64(w, "next_byte_offset", (from + take)::i64);
            }
        }
    }
    jw.obj_end(w);
}

# read files with their sha256, so an agent can edit with expect; directories list their entries
pub fun read(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var content: bool = true;
    val cf: opt[*json.Value] = json.value_find(args, "content");
    if (sel cf.some) {
        if (json.value_is_bool(cf.some)) { content = json.value_bool(cf.some); }
    }
    var max: usize = READ_MAX;
    val mf: opt[*json.Value] = json.value_find(args, "max_bytes");
    if (sel mf.some) {
        if (json.value_is_number(mf.some) && json.value_number(mf.some) > 0) { max = json.value_number(mf.some)::usize; }
    }
    var outline: bool = false;
    val of2: opt[*json.Value] = json.value_find(args, "outline");
    if (sel of2.some) {
        if (json.value_is_bool(of2.some)) { outline = json.value_bool(of2.some); }
    }
    var fold: bool = false;
    val ff: opt[*json.Value] = json.value_find(args, "fold");
    if (sel ff.some) {
        if (json.value_is_bool(ff.some)) { fold = json.value_bool(ff.some); }
    }
    var lo: i64 = 0;
    var hi: i64 = 0;
    val lf: opt[*json.Value] = json.value_find(args, "lines");
    if (sel lf.some) {
        if (json.value_is_array(lf.some) && json.value_count(lf.some) == 2) {
            val g0: opt[*json.Value] = json.value_get(lf.some, 0);
            val g1: opt[*json.Value] = json.value_get(lf.some, 1);
            if (sel g0.some) { lo = json.value_number(g0.some); }
            if (sel g1.some) { hi = json.value_number(g1.some); }
            if (lo < 1 || hi < lo) { ret simple_error(w, "read_range", "lines must be [first, last], 1-based and inclusive"); }
        }
    }
    var sym_p: *u8 = nil;
    var sym_n: usize = 0;
    var syms_list: vector.Vector[str] = vector.init[str](a);
    val sf: opt[*json.Value] = json.value_find(args, "symbol");
    if (sel sf.some) {
        if (!json.value_is_string(sf.some) || !spec.decode_pub(a, sf.some, ?sym_p, ?sym_n) || sym_n == 0) {
            ret simple_error(w, "read_bad", "symbol must be a non-empty string");
        }
        vector.push[str](?syms_list, sym_p);
    }
    var rem_bytes: usize = max;
    var any_trunc: bool = false;
    val ssf: opt[*json.Value] = json.value_find(args, "symbols");
    if (sel ssf.some) {
        if (json.value_is_bool(ssf.some)) {
            if (json.value_bool(ssf.some)) { outline = true; }
        }
        or {
            if (!json.value_is_array(ssf.some)) { ret simple_error(w, "read_bad", "symbols must be a list of symbol names or true"); }
            if (json.value_count(ssf.some) > 64) { any_trunc = true; }
            var si: usize = 0;
            for (si < json.value_count(ssf.some) && si < 64) {
                val sg: opt[*json.Value] = json.value_get(ssf.some, si);
                if (sel sg.some) {
                    var sp: *u8 = nil;
                    var sn: usize = 0;
                    if (!json.value_is_string(sg.some) || !spec.decode_pub(a, sg.some, ?sp, ?sn) || sn == 0) {
                        ret simple_error(w, "read_bad", "each entry in symbols must be a non-empty string");
                    }
                    vector.push[str](?syms_list, sp);
                }
                si = si + 1;
            }
        }
    }
    jw.obj(w);
    jw.key(w, "files");
    jw.arr(w);
    var any: bool = false;
    val one: opt[*json.Value] = json.value_find(args, "path");
    if (sel one.some) {
        if (json.value_is_string(one.some)) {
            var p: *u8 = nil;
            var pn: usize = 0;
            if (spec.decode_pub(a, one.some, ?p, ?pn)) {
                read_one(s, p, content, ?rem_bytes, ?any_trunc, lo, hi, sym_p, sym_n, ?syms_list, fold, outline, w);
                any = true;
            }
        }
    }
    val many: opt[*json.Value] = json.value_find(args, "paths");
    if (sel many.some) {
        if (json.value_is_array(many.some)) {
            if (json.value_count(many.some) > 256) { any_trunc = true; }
            var i: usize = 0;
            for (i < json.value_count(many.some) && i < 256) {
                val g: opt[*json.Value] = json.value_get(many.some, i);
                if (sel g.some) {
                    if (json.value_is_string(g.some)) {
                        var p: *u8 = nil;
                        var pn: usize = 0;
                        if (spec.decode_pub(a, g.some, ?p, ?pn)) {
                            read_one(s, p, content, ?rem_bytes, ?any_trunc, lo, hi, sym_p, sym_n, ?syms_list, fold, outline, w);
                            any = true;
                        }
                    }
                }
                i = i + 1;
            }
        }
    }
    if (!any) {
        jw.clear(w);
        ret simple_error(w, "read_bad", "give path or paths, relative to the workspace root; use \".\" for the root directory");
    }
    jw.arr_end(w);
    if (any_trunc) { jw.f_bool(w, "truncated", true); }
    jw.obj_end(w);
    ret true;
}

# the leading {{!-- comment --}} of a template, first line only
fun description(a: *A.Allocator, body: *u8, n: usize) str {
    if (n < 6 || body[0] != '{' || body[1] != '{' || body[2] != '!') { ret nil; }
    var s: usize = 3;
    if (s + 1 < n && body[s] == '-' && body[s + 1] == '-') { s = s + 2; }
    for (s < n && (body[s] == ' ' || body[s] == '\t')) { s = s + 1; }
    var e: usize = s;
    for (e < n && body[e] != '\n' && body[e] != '\r') {
        if (body[e] == '-' && e + 3 < n && body[e + 1] == '-' && body[e + 2] == '}' && body[e + 3] == '}') { brk; }
        if (body[e] == '}' && e + 1 < n && body[e + 1] == '}') { brk; }
        e = e + 1;
    }
    for (e > s && (body[e - 1] == ' ' || body[e - 1] == '\t')) { e = e - 1; }
    val d: res[str, A.Error] = util.dup_n(a, (body::usize + s)::*u8, e - s);
    if (sel d.err) { ret nil; }
    ret d.ok;
}

fun template_entry(a: *A.Allocator, w: *jw.Jw, t: *spec.Tpl, show: bool) {
    jw.obj(w);
    jw.f_str(w, "name", t.name);
    jw.f_str(w, "source", t.src);
    if (t.lang != nil) { jw.f_str(w, "lang", t.lang); }
    var desc: str = t.desc;
    if (desc == nil) { desc = description(a, t.body, t.len); }
    if (desc != nil) { jw.f_str(w, "description", desc); }
    var names: vector.Vector[str] = vector.init[str](a);
    if (tmpl.names(a, t.body, t.len, ?names)) {
        jw.key(w, "vars");
        jw.arr(w);
        var i: usize = 0;
        for (i < names.len) {
            jw.str_v(w, names.data[i]);
            i = i + 1;
        }
        jw.arr_end(w);
    }
    if (show) {
        jw.key(w, "text");
        jw.str_n(w, t.body, t.len);
    }
    jw.obj_end(w);
}

fun pathx_native_or(a: *A.Allocator, root: str, rel: str) str {
    val p: res[str, A.Error] = pathx.native(a, root, rel);
    if (sel p.ok) { ret p.ok; }
    ret root;
}

fun list_workspace(s: *session.Session, w: *jw.Jw, dir_rel: str, depth: i64) {
    val a: *A.Allocator = ?s.ra;
    if (depth > 3) { ret; }
    if (commit.check_ancestry(a, s.root, dir_rel) != nil) { ret; }
    val full: res[str, A.Error] = pathx.native(a, s.root, dir_rel);
    if (sel full.err) { ret; }
    val dm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(full.ok);
    if (sel dm.err) { ret; }
    if (dm.ok.kind != filesystem.KIND_DIR) { ret; }
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(a, full.ok);
    if (sel names.err) { ret; }
    var i: usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        val child_rel: res[str, A.Error] = pathx.join(a, dir_rel, name);
        if (sel child_rel.ok) {
            val n: usize = str_len(name);
            if (n > 5 && util.eq((name::usize + n - 5)::*u8, ".tmpl")) {
                if (commit.check_ancestry(a, s.root, child_rel.ok) == nil) {
                    val t_full: res[str, A.Error] = pathx.native(a, s.root, child_rel.ok);
                    if (sel t_full.ok) {
                        val fm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(t_full.ok);
                        if (sel fm.ok && fm.ok.kind == filesystem.KIND_FILE) {
                            val text: res[str, filesystem.FsError] = filesystem.read_string(a, t_full.ok);
                            if (sel text.ok) {
                                val rel_n: usize = str_len(child_rel.ok);
                                val tname: res[str, A.Error] = util.dup_n(a, (child_rel.ok::usize + 16)::*u8, rel_n - 16 - 5);
                                if (sel tname.ok) {
                                    var t: spec.Tpl;
                                    t.name = tname.ok;
                                    t.lang = spec.lang_of(tname.ok);
                                    t.body = text.ok;
                                    t.len = str_len(text.ok);
                                    t.src = "workspace";
                                    template_entry(a, w, ?t, false);
                                }
                            }
                        }
                    }
                }
            }
            or {
                val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(pathx_native_or(a, s.root, child_rel.ok));
                if (sel m.ok) {
                    if (m.ok.kind == filesystem.KIND_DIR) { list_workspace(s, w, child_rel.ok, depth + 1); }
                }
            }
        }
        i = i + 1;
    }
}

# list every template an apply can name, or show one with its text
pub fun templates(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var show: *u8 = nil;
    var sn: usize = 0;
    val sf: opt[*json.Value] = json.value_find(args, "name");
    if (sel sf.some) {
        if (json.value_is_string(sf.some)) { spec.decode_pub(a, sf.some, ?show, ?sn); }
    }
    if (show != nil) {
        var t: spec.Tpl;
        if (!lib_find((s::usize)::*u8, show, ?t)) { ret simple_error(w, "tmpl_unknown", "no template has that name; list templates without a name to see them all"); }
        template_entry(a, w, ?t, true);
        ret true;
    }
    jw.obj(w);
    jw.key(w, "templates");
    jw.arr(w);
    var i: usize = 0;
    for (i < s.tpls.len) {
        val stpl: *spec.Tpl = ?s.tpls.data[i];
        if (stpl.root == nil || s.root == nil || util.eq(stpl.root, s.root)) {
            template_entry(a, w, stpl, false);
        }
        i = i + 1;
    }
    list_workspace(s, w, ".qark/templates", 0);
    i = 0;
    for (i < builtin.COUNT) {
        var t: spec.Tpl;
        if (builtin.at(i, ?t)) { template_entry(a, w, ?t, false); }
        i = i + 1;
    }
    jw.arr_end(w);
    jw.obj_end(w);
    ret true;
}

# keep a template for this session, and on disk under .qark/templates when persist is true
pub fun define(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var name: *u8 = nil;
    var nn: usize = 0;
    val nf: opt[*json.Value] = json.value_find(args, "name");
    if (!sel nf.some) { ret simple_error(w, "spec_field", "template.define needs a name such as etl/loader"); }
    if (!json.value_is_string(nf.some) || !spec.decode_pub(a, nf.some, ?name, ?nn)) { ret simple_error(w, "spec_field", "name must be a string"); }
    val canon: res[str, A.Error] = pathx.canonical(a, name);
    if (sel canon.err) { ret simple_error(w, "oom", "out of memory"); }
    val r: i64 = pathx.check(canon.ok);
    if (r != pathx.P_OK) { ret simple_error(w, pathx.code(r), "a template name is a relative path such as etl/loader"); }
    var body: *u8 = nil;
    var bn: usize = 0;
    val tf: opt[*json.Value] = json.value_find(args, "text");
    val lf: opt[*json.Value] = json.value_find(args, "lines");
    if (sel tf.some) {
        if (!json.value_is_string(tf.some) || !spec.decode_pub(a, tf.some, ?body, ?bn)) { ret simple_error(w, "spec_type", "text must be a string"); }
    }
    or (sel lf.some) {
        if (!json.value_is_array(lf.some) || !spec.lines_pub(a, lf.some, ?body, ?bn)) { ret simple_error(w, "spec_type", "lines must be a list of strings"); }
    }
    or { ret simple_error(w, "spec_field", "template.define needs text or lines"); }
    var probe_ctx: tmpl.Ctx;
    tmpl.ctx_init(?probe_ctx);
    var names: vector.Vector[str] = vector.init[str](a);
    if (!tmpl.names(a, body, bn, ?names)) { ret simple_error(w, "tmpl_syntax", "the template does not parse; render it with template.render to see where"); }
    var lang: str = spec.lang_of(canon.ok);
    var lp: *u8 = nil;
    var lpn: usize = 0;
    val lgf: opt[*json.Value] = json.value_find(args, "lang");
    if (sel lgf.some) {
        if (json.value_is_string(lgf.some) && spec.decode_pub(a, lgf.some, ?lp, ?lpn)) { lang = lp; }
    }
    var desc: *u8 = nil;
    var dn: usize = 0;
    val df: opt[*json.Value] = json.value_find(args, "description");
    if (sel df.some) {
        if (json.value_is_string(df.some)) { spec.decode_pub(a, df.some, ?desc, ?dn); }
    }
    var t: spec.Tpl;
    val n_c: res[str, A.Error] = util.dup(s.a, canon.ok);
    val b_c: res[str, A.Error] = util.dup_n(s.a, body, bn);
    if (sel n_c.err) { ret simple_error(w, "oom", "out of memory"); }
    if (sel b_c.err) { ret simple_error(w, "oom", "out of memory"); }
    t.name = n_c.ok;
    t.body = b_c.ok;
    t.len = bn;
    t.src = "session";
    t.root = nil;
    if (s.root != nil) {
        val r_c: res[str, A.Error] = util.dup(s.a, s.root);
        if (sel r_c.ok) { t.root = r_c.ok; }
    }
    t.lang = nil;
    if (lang != nil) {
        val l_c: res[str, A.Error] = util.dup(s.a, lang);
        if (sel l_c.ok) { t.lang = l_c.ok; }
    }
    t.desc = nil;
    if (desc != nil) {
        val d_c: res[str, A.Error] = util.dup(s.a, desc);
        if (sel d_c.ok) { t.desc = d_c.ok; }
    }
    val pathf: opt[*json.Value] = json.value_find(args, "path");
    if (sel pathf.some) {
        var pp: *u8 = nil;
        var pn: usize = 0;
        if (!json.value_is_string(pathf.some) || !spec.decode_pub(a, pathf.some, ?pp, ?pn)) { ret simple_error(w, "spec_type", "path must be a string, the pattern each row expands to"); }
        val p_c: res[str, A.Error] = util.dup_n(s.a, pp, pn);
        if (sel p_c.err) { ret simple_error(w, "oom", "out of memory"); }
        t.pathpat = p_c.ok;
    }
    var te: tmpl.Err;
    if (!tmpl.prepare(s.a, b_c.ok, bn, ?t.prog, ?te)) {
        var code: str = te.code;
        if (code == nil) { code = "tmpl_syntax"; }
        var msg: str = te.msg;
        if (msg == nil) { msg = "the template does not parse"; }
        ret simple_error(w, code, msg);
    }
    val want_persist: bool = spec.fbool_pub(args, "persist");
    if (want_persist && (s.force_dry || spec.fbool_pub(args, "dry_run"))) {
        ret simple_error(w, "dry_run_persist", "template.define cannot persist to disk when dry_run is enabled");
    }
    var persisted: str = nil;
    if (want_persist) {
        if (!commit.check_control_dir(a, s.root)) {
            ret simple_error(w, "path_link", "refusing to persist template: .qark control directory is invalid or a symlink");
        }
        var pw: jw.Jw = jw.init(a);
        jw.raw(?pw, ".qark/templates/");
        jw.raw(?pw, canon.ok);
        jw.raw(?pw, ".tmpl");
        val tmpl_rel: str = jw.text(?pw);
        var path_rel: jw.Jw = jw.init(a);
        jw.raw(?path_rel, ".qark/templates/");
        jw.raw(?path_rel, canon.ok);
        jw.raw(?path_rel, ".path");
        val p_rel: str = jw.text(?path_rel);
        if (commit.check_ancestry(a, s.root, tmpl_rel) != nil || commit.check_ancestry(a, s.root, p_rel) != nil) {
            ret simple_error(w, "path_link", "refusing to persist template through symlinked or non-directory ancestor");
        }
        val full: res[str, A.Error] = pathx.native(a, s.root, tmpl_rel);
        if (sel full.err) {
            ret simple_error(w, "oom", "out of memory");
        }
        val path_full: res[str, A.Error] = pathx.native(a, s.root, p_rel);
        if (sel path_full.err) {
            ret simple_error(w, "oom", "out of memory");
        }
        val tm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(full.ok);
        if (sel tm.ok) {
            if (tm.ok.kind != filesystem.KIND_FILE) {
                ret simple_error(w, "path_link", "refusing to overwrite non-regular file under .qark/templates");
            }
        }
        val pm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(path_full.ok);
        if (sel pm.ok) {
            if (pm.ok.kind != filesystem.KIND_FILE) {
                ret simple_error(w, "path_link", "refusing to overwrite non-regular .path file under .qark/templates");
            }
        }
        val wrote: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, full.ok, body, bn, 420, 493);
        if (sel wrote.err) {
            ret simple_error(w, "io_write", "could not persist template under .qark/templates");
        }
        if (t.pathpat != nil && t.pathpat[0] != 0) {
            val wrote_p: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, path_full.ok, t.pathpat, str_len(t.pathpat), 420, 493);
            if (sel wrote_p.err) {
                ret simple_error(w, "io_write", "could not persist template path pattern under .qark/templates");
            }
        }
        or {
            val rm_p: err[io_error.Error] = filesystem.remove_file(path_full.ok);
            if (sel rm_p.err) {
                if (rm_p.err.kind != io_error.NOT_FOUND) {
                    ret simple_error(w, "io_write", "could not remove stale template path pattern under .qark/templates");
                }
            }
        }
        persisted = tmpl_rel;
    }
    var replaced: bool = false;
    var i: usize = 0;
    for (i < s.tpls.len) {
        val cur_t: *spec.Tpl = ?s.tpls.data[i];
        val same_root: bool = cur_t.root == nil || t.root == nil || util.eq(cur_t.root, t.root);
        if (same_root && util.eq(cur_t.name, t.name)) {
            s.tpls.data[i] = t;
            replaced = true;
        }
        i = i + 1;
    }
    if (!replaced) { vector.push[spec.Tpl](?s.tpls, t); }
    jw.obj(w);
    jw.f_str(w, "name", t.name);
    jw.f_bool(w, "replaced", replaced);
    if (persisted != nil) { jw.f_str(w, "persisted", persisted); }
    jw.key(w, "vars");
    jw.arr(w);
    i = 0;
    for (i < names.len) {
        jw.str_v(w, names.data[i]);
        i = i + 1;
    }
    jw.arr_end(w);
    jw.obj_end(w);
    ret true;
}

# render a named or inline template against vars without writing anything
pub fun render(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var body: *u8 = nil;
    var bn: usize = 0;
    var tname: str = "tmpl";
    var lang: str = "text";
    val nf: opt[*json.Value] = json.value_find(args, "template");
    val tf: opt[*json.Value] = json.value_find(args, "tmpl");
    if (sel nf.some) {
        var name: *u8 = nil;
        var nn: usize = 0;
        if (!json.value_is_string(nf.some) || !spec.decode_pub(a, nf.some, ?name, ?nn)) { ret simple_error(w, "spec_type", "template must be a name"); }
        var t: spec.Tpl;
        if (!lib_find((s::usize)::*u8, name, ?t)) { ret simple_error(w, "tmpl_unknown", "no template has that name"); }
        body = t.body;
        bn = t.len;
        tname = t.name;
        if (t.lang != nil) { lang = t.lang; }
    }
    or (sel tf.some) {
        if (!json.value_is_string(tf.some) || !spec.decode_pub(a, tf.some, ?body, ?bn)) { ret simple_error(w, "spec_type", "tmpl must be template text"); }
    }
    or { ret simple_error(w, "spec_field", "template.render needs template (a name) or tmpl (text)"); }
    var c: tmpl.Ctx;
    tmpl.ctx_init(?c);
    var empty: json.Value;
    empty.kind = json.OBJECT;
    val vf: opt[*json.Value] = json.value_find(args, "vars");
    if (sel vf.some) {
        if (!json.value_is_object(vf.some)) { ret simple_error(w, "spec_type", "vars must be an object"); }
        tmpl.ctx_push(?c, vf.some);
    }
    or { tmpl.ctx_push(?c, ?empty); }
    var lib: spec.Lib;
    lib.ctx = (s::usize)::*u8;
    lib.find = lib_find;
    var tl: tmpl.Lib;
    var holder: spec.Spec;
    holder.inline = vector.init[spec.Tpl](a);
    holder.lib = ?lib;
    tl.ctx = ((?holder)::usize)::*u8;
    tl.find = spec.partial_find_pub;
    var out: *u8 = nil;
    var on: usize = 0;
    var te: tmpl.Err;
    if (!tmpl.render(a, tname, lang, body, bn, ?c, ?tl, ?out, ?on, ?te)) {
        error_obj(w, te.code, te.msg);
        if (te.tname != nil) { jw.f_str(w, "template", te.tname); }
        if (te.line > 0) { jw.f_i64(w, "line", te.line); }
        jw.obj_end(w);
        ret false;
    }
    jw.obj(w);
    jw.key(w, "text");
    jw.str_n(w, out, on);
    jw.f_i64(w, "bytes", on::i64);
    jw.obj_end(w);
    ret true;
}

fun listed(names: *vector.Vector[str], rel: str) bool {
    var i: usize = 0;
    for (i < names.len) {
        if (util.eq(names.data[i], rel)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun extras(s: *session.Session, w: *jw.Jw, base: str, sub: str, names: *vector.Vector[str], depth: i64, found: *i64) {
    val a: *A.Allocator = ?s.ra;
    if (depth > 8) { ret; }
    val dir_rel: res[str, A.Error] = pathx.join(a, base, sub);
    if (sel dir_rel.err) { ret; }
    val full: res[str, A.Error] = pathx.native(a, s.root, dir_rel.ok);
    if (sel full.err) { ret; }
    val entries: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(a, full.ok);
    if (sel entries.err) { ret; }
    var i: usize = 0;
    for (i < entries.ok.len) {
        val name: str = entries.ok.data[i];
        val rel: res[str, A.Error] = pathx.join(a, sub, name);
        if (sel rel.ok) {
            val child: res[str, A.Error] = pathx.native(a, full.ok, name);
            var is_dir: bool = false;
            if (sel child.ok) {
                val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(child.ok);
                if (sel m.ok) { is_dir = m.ok.kind == filesystem.KIND_DIR; }
            }
            if (is_dir) { extras(s, w, base, rel.ok, names, depth + 1, found); }
            or (!util.eq(rel.ok, "manifest.json") && !listed(names, rel.ok)) {
                jw.str_v(w, rel.ok);
                @found = @found + 1;
            }
        }
        i = i + 1;
    }
}

# check a job directory against its manifest: every listed file present with its hash, nothing unlisted
#
# a mismatch is still a report: verify returns true with ok false inside, and
# sets matched; it returns false only when there is no manifest to check against
pub fun verify(s: *session.Session, dir_in: str, w: *jw.Jw, matched: *bool) bool {
    @matched = false;
    val a: *A.Allocator = ?s.ra;
    val stripped: str = pathx.strip_root(s.root, dir_in);
    val canon: res[str, A.Error] = pathx.canonical(a, stripped);
    if (sel canon.err) { ret simple_error(w, "oom", "out of memory"); }
    val r: i64 = pathx.check(canon.ok);
    if (r != pathx.P_OK) { ret simple_error(w, pathx.code(r), "give the job directory relative to the workspace root, such as jobs/etl"); }
    val mrel: res[str, A.Error] = pathx.join(a, canon.ok, "manifest.json");
    if (sel mrel.err) { ret simple_error(w, "oom", "out of memory"); }
    val mfull: res[str, A.Error] = pathx.native(a, s.root, mrel.ok);
    if (sel mfull.err) { ret simple_error(w, "oom", "out of memory"); }
    val text: res[str, filesystem.FsError] = filesystem.read_string(a, mfull.ok);
    if (sel text.err) { ret simple_error(w, "no_manifest", "the directory has no readable manifest.json"); }
    val parsed: res[json.Value, json.JsonError] = json.parse(text.ok, str_len(text.ok), a);
    if (sel parsed.err) { ret simple_error(w, "bad_manifest", "manifest.json is not valid json"); }
    var doc: json.Value = parsed.ok;
    val files: opt[*json.Value] = json.value_find(?doc, "files");
    if (!sel files.some) { ret simple_error(w, "bad_manifest", "manifest.json has no files list"); }
    if (!json.value_is_array(files.some)) { ret simple_error(w, "bad_manifest", "manifest.json files is not a list"); }
    var names: vector.Vector[str] = vector.init[str](a);
    var bad: i64 = 0;
    jw.obj(w);
    jw.f_str(w, "dir", canon.ok);
    val jobf: opt[*json.Value] = json.value_find(?doc, "job");
    if (sel jobf.some) {
        if (json.value_is_string(jobf.some)) {
            var jn: usize = 0;
            val jp: *u8 = json.value_string(jobf.some, ?jn);
            jw.key(w, "job");
            jw.wire_str(w, jp, jn);
        }
    }
    jw.key(w, "files");
    jw.arr(w);
    var i: usize = 0;
    for (i < json.value_count(files.some)) {
        val g: opt[*json.Value] = json.value_get(files.some, i);
        if (sel g.some) {
            var p: *u8 = nil;
            var pn: usize = 0;
            var hp: *u8 = nil;
            var hn: usize = 0;
            val pf: opt[*json.Value] = json.value_find(g.some, "path");
            val hf: opt[*json.Value] = json.value_find(g.some, "sha256");
            var has_p: bool = false;
            var has_h: bool = false;
            if (sel pf.some) { has_p = json.value_is_string(pf.some) && spec.decode_pub(a, pf.some, ?p, ?pn); }
            if (sel hf.some) { has_h = json.value_is_string(hf.some) && spec.decode_pub(a, hf.some, ?hp, ?hn); }
            jw.obj(w);
            if (!has_p || !has_h || pathx.check(p) != pathx.P_OK) {
                jw.f_bool(w, "ok", false);
                jw.f_str(w, "reason", "entry has no safe path or no sha256");
                bad = bad + 1;
            }
            or {
                vector.push[str](?names, p);
                jw.f_str(w, "path", p);
                val frel: res[str, A.Error] = pathx.join(a, canon.ok, p);
                var ok: bool = false;
                var why: str = "missing";
                if (sel frel.ok) {
                    val ffull: res[str, A.Error] = pathx.native(a, s.root, frel.ok);
                    if (sel ffull.ok) {
                        val got: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, ffull.ok);
                        if (sel got.ok) {
                            var hex: [65]u8;
                            commit.hash_hex(got.ok.data, got.ok.len, ?hex[0]);
                            if (util.eq(?hex[0], hp)) { ok = true; }
                            or {
                                why = "sha256 differs from the manifest";
                                jw.f_str(w, "sha256", ?hex[0]);
                            }
                        }
                    }
                }
                jw.f_bool(w, "ok", ok);
                if (!ok) {
                    jw.f_str(w, "reason", why);
                    bad = bad + 1;
                }
            }
            jw.obj_end(w);
        }
        i = i + 1;
    }
    jw.arr_end(w);
    var extra: i64 = 0;
    jw.key(w, "unlisted");
    jw.arr(w);
    extras(s, w, canon.ok, "", ?names, 0, ?extra);
    jw.arr_end(w);
    jw.f_bool(w, "ok", bad == 0);
    jw.f_bool(w, "clean", extra == 0);
    jw.obj_end(w);
    @matched = bad == 0;
    ret true;
}

# resolved reference and impact graph for a symbol across the workspace
pub fun impact(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var sym_p: *u8 = nil;
    var sym_n: usize = 0;
    val sf: opt[*json.Value] = json.value_find(args, "symbol");
    if (sel sf.some) {
        if (json.value_is_string(sf.some)) { spec.decode_pub(a, sf.some, ?sym_p, ?sym_n); }
    }
    if (sym_p == nil || sym_n == 0) {
        val imf: opt[*json.Value] = json.value_find(args, "impact");
        if (sel imf.some) {
            if (json.value_is_string(imf.some)) { spec.decode_pub(a, imf.some, ?sym_p, ?sym_n); }
        }
    }
    if (sym_p == nil || sym_n == 0) {
        val pf: opt[*json.Value] = json.value_find(args, "pattern");
        if (sel pf.some) {
            if (json.value_is_string(pf.some)) { spec.decode_pub(a, pf.some, ?sym_p, ?sym_n); }
        }
    }
    if (sym_p == nil || sym_n == 0) {
        ret simple_error(w, "spec_field", "impact needs symbol (or pattern) naming the identifier to trace");
    }
    var glob_p: str = nil;
    val gf: opt[*json.Value] = json.value_find(args, "glob");
    if (sel gf.some) {
        var gp: *u8 = nil;
        var gn: usize = 0;
        if (!json.value_is_string(gf.some) || !spec.decode_pub(a, gf.some, ?gp, ?gn)) {
            ret simple_error(w, "spec_type", "glob must be a string such as **/*.py");
        }
        glob_p = pathx.strip_root(s.root, gp);
    }
    var path_p: str = nil;
    val df: opt[*json.Value] = json.value_find(args, "path");
    if (sel df.some) {
        var pp: *u8 = nil;
        var pn: usize = 0;
        if (!json.value_is_string(df.some) || !spec.decode_pub(a, df.some, ?pp, ?pn)) {
            ret simple_error(w, "spec_type", "path must be a string relative to the workspace root");
        }
        val sp_rel: str = pathx.strip_root(s.root, pp);
        if (!util.eq(sp_rel, ".") && sp_rel[0] != 0) {
            val canon: res[str, A.Error] = pathx.canonical(a, sp_rel);
            if (sel canon.err) { ret simple_error(w, "oom", "out of memory"); }
            val r: i64 = pathx.check(canon.ok);
            if (r != pathx.P_OK) { ret simple_error(w, pathx.code(r), pathx.message(r)); }
            path_p = canon.ok;
        }
    }
    if (!scan.impact_graph(a, s.root, sym_p, sym_n, path_p, glob_p, w)) {
        ret simple_error(w, "bad_pattern", "could not compute impact graph for that symbol");
    }
    ret true;
}

# read transaction events from .qark/journal.ndjson
pub fun events(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var offset: usize = 0;
    val of1: opt[*json.Value] = json.value_find(args, "since_offset");
    if (sel of1.some) {
        if (json.value_is_number(of1.some) && json.value_number(of1.some) > 0) {
            offset = json.value_number(of1.some)::usize;
        }
    }
    val of2: opt[*json.Value] = json.value_find(args, "offset");
    if (sel of2.some) {
        if (json.value_is_number(of2.some) && json.value_number(of2.some) > 0) {
            offset = json.value_number(of2.some)::usize;
        }
    }
    var limit: i64 = 100;
    val lf: opt[*json.Value] = json.value_find(args, "limit");
    if (sel lf.some) {
        if (json.value_is_number(lf.some) && json.value_number(lf.some) > 0) {
            limit = json.value_number(lf.some);
            if (limit > 1000) { limit = 1000; }
        }
    }
    val jfull: res[str, A.Error] = pathx.native(a, s.root, ".qark/journal.ndjson");
    if (sel jfull.err) { ret simple_error(w, "oom", "out of memory"); }
    val got: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, jfull.ok);
    jw.obj(w);
    jw.key(w, "events");
    jw.arr(w);
    var count: i64 = 0;
    var next_off: usize = 0;
    if (sel got.ok) {
        val p: *u8 = got.ok.data;
        val n: usize = got.ok.len;
        next_off = n;
        var i: usize = offset;
        if (i > n) { i = n; }
        for (i < n && count < limit) {
            var ls: usize = i;
            for (i < n && p[i] != '\n') { i = i + 1; }
            var le: usize = i;
            if (le > ls && p[le - 1] == '\r') { le = le - 1; }
            if (i < n && p[i] == '\n') { i = i + 1; }
            if (le > ls) {
                val parsed: res[json.Value, json.JsonError] = json.parse((p::usize + ls)::*u8, le - ls, a);
                if (sel parsed.ok) {
                    jw.raw_vn(w, (p::usize + ls)::*u8, le - ls);
                    count = count + 1;
                    next_off = i;
                }
            }
        }
    }
    jw.arr_end(w);
    jw.f_i64(w, "count", count);
    jw.f_i64(w, "next_offset", next_off::i64);
    jw.obj_end(w);
    ret true;
}

# run standalone project validation (or inspect capabilities, schema, events, or a job directory)
pub fun project_validate(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    if (json.value_is_object(args)) {
        if (spec.fbool_pub(args, "capabilities")) { ret capabilities(s, w); }
        val scf: opt[*json.Value] = json.value_find(args, "schema");
        if (sel scf.some) {
            if ((json.value_is_bool(scf.some) && json.value_bool(scf.some)) || json.value_is_string(scf.some)) {
                ret schema(s, args, w);
            }
        }
        val opf: opt[*json.Value] = json.value_find(args, "op");
        if (sel opf.some) {
            if (json.value_is_string(opf.some)) { ret schema(s, args, w); }
        }
        if (spec.fbool_pub(args, "events")) { ret events(s, args, w); }
        val df: opt[*json.Value] = json.value_find(args, "dir");
        if (sel df.some) {
            if (json.value_is_string(df.some)) {
                var dp: *u8 = nil;
                var dn: usize = 0;
                if (spec.decode_pub(?s.ra, df.some, ?dp, ?dn) && dn > 0) {
                    var matched: bool = false;
                    ret verify(s, dp, w, ?matched);
                }
            }
        }
    }
    if (s.no_custom_exec) {
        ret simple_error(w, "exec_forbidden", "custom validation command execution is disabled by --no-custom-exec");
    }
    val a: *A.Allocator = ?s.ra;
    var val_spec: *json.Value = nil;
    val vf: opt[*json.Value] = json.value_find(args, "validate");
    if (sel vf.some) { val_spec = vf.some; }
    or {
        val cf: opt[*json.Value] = json.value_find(args, "cmd");
        if (sel cf.some) { val_spec = cf.some; }
    }
    var ran: bool = false;
    var msg: str = nil;
    val ok: bool = check.run_project_validation(a, s.root, nil, val_spec, check.TIMEOUT_MS, ?ran, ?msg);
    if (!ran) {
        ret simple_error(w, "check_unconfigured", "no project validation command configured; pass validate/cmd or configure project in .qark/checks.json");
    }
    if (!ok) {
        error_obj(w, "check_failed", "project validation failed");
        if (msg != nil) { jw.f_str(w, "validation_message", msg); }
        jw.obj_end(w);
        ret false;
    }
    jw.obj(w);
    jw.f_bool(w, "ok", true);
    jw.f_str(w, "validation", "ok");
    if (msg != nil) { jw.f_str(w, "message", msg); }
    jw.obj_end(w);
    ret true;
}

# discoverable capabilities of this qark worker
pub fun capabilities(s: *session.Session, w: *jw.Jw) bool {
    check.probe(s.a, ?s.tools);
    jw.obj(w);
    jw.f_str(w, "name", "qark");
    jw.f_str(w, "version", spec.VERSION);
    jw.f_i64(w, "protocol", 2);
    jw.key(w, "features");
    jw.raw_v(w, "[\"ast_symbol_edits\",\"scope_contracts\",\"semantic_previews\",\"project_validation\",\"streaming_events\",\"persistent_undo_redo\",\"three_way_rebase\",\"impact_graph\",\"capabilities_schema\",\"signed_releases\",\"signature_fold\",\"glob_refactor\",\"fail_closed_checkers\",\"structured_repair_feedback\",\"validation_complete\"]");
    jw.key(w, "check_policies");
    jw.raw_v(w, "[\"strict\",\"required\",\"permissive\",\"off\"]");
    jw.key(w, "symbol_edit_modes");
    jw.raw_v(w, "[\"with\",\"body\",\"signature\",\"rename\"]");
    jw.key(w, "contract_fields");
    jw.raw_v(w, "[\"symbol\",\"symbols\",\"methods\",\"lines\",\"preserve_signatures\",\"max_lines_changed\",\"forbid_delete\"]");
    jw.key(w, "ops");
    jw.raw_v(w, "[\"apply\",\"undo\",\"redo\",\"read\",\"search\",\"impact\",\"events\",\"project.validate\",\"capabilities\",\"schema\",\"release.sign\",\"release.verify\",\"template.list\",\"template.define\",\"template.render\",\"job.verify\",\"session.info\",\"buf.create\",\"buf.set_lines\",\"keys.feed\",\"cmd.ex\",\"eval\",\"job.write\",\"validate.ident\"]");
    jw.key(w, "languages");
    jw.raw_v(w, "[\"mach\",\"python\",\"rust\",\"go\",\"javascript\",\"typescript\",\"c\",\"cpp\",\"powershell\",\"sh\",\"json\",\"toml\"]");
    jw.key(w, "limits");
    jw.obj(w);
    jw.f_i64(w, "files_per_apply", spec.MAX_FILES::i64);
    jw.f_i64(w, "bytes_per_file", spec.MAX_FILE_BYTES::i64);
    jw.f_i64(w, "bytes_per_apply", spec.MAX_TOTAL_BYTES::i64);
    jw.f_i64(w, "read_bytes", READ_MAX::i64);
    jw.f_i64(w, "lock_wait_ms", s.lock_ms);
    jw.obj_end(w);
    jw.key(w, "checkers");
    jw.obj(w);
    jw.f_str(w, "python", s.tools.python);
    jw.f_str(w, "node", s.tools.node);
    jw.f_str(w, "powershell", s.tools.pwsh);
    jw.f_str(w, "bash", s.tools.bash);
    jw.f_str(w, "json", "builtin");
    jw.f_str(w, "toml", "builtin");
    jw.obj_end(w);
    jw.obj_end(w);
    ret true;
}

fun is_known_schema_op(op: str) bool {
    if (op == nil || op[0] == 0) { ret false; }
    ret util.eq(op, "apply") || util.eq(op, "read") || util.eq(op, "search") ||
        util.eq(op, "impact") || util.eq(op, "undo") || util.eq(op, "redo") ||
        util.eq(op, "events") || util.eq(op, "project.validate") ||
        util.eq(op, "release.sign") || util.eq(op, "release.verify") ||
        util.eq(op, "capabilities") || util.eq(op, "schema") ||
        util.eq(op, "template.list") || util.eq(op, "template.define") ||
        util.eq(op, "template.render") || util.eq(op, "job.verify") ||
        util.eq(op, "session.info");
}

fun schema_match(filter_op: str, name: str) bool {
    if (filter_op == nil || filter_op[0] == 0) { ret true; }
    ret util.eq(filter_op, name);
}

# machine-readable operation and spec schemas
pub fun schema(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var filter_op: *u8 = nil;
    var filter_n: usize = 0;
    if (json.value_is_object(args)) {
        val of1: opt[*json.Value] = json.value_find(args, "op");
        if (sel of1.some) {
            if (json.value_is_string(of1.some)) { spec.decode_pub(a, of1.some, ?filter_op, ?filter_n); }
        }
        if (filter_op == nil || filter_n == 0) {
            val sf1: opt[*json.Value] = json.value_find(args, "schema");
            if (sel sf1.some) {
                if (json.value_is_string(sf1.some)) { spec.decode_pub(a, sf1.some, ?filter_op, ?filter_n); }
            }
        }
    }
    if (filter_op != nil && filter_n > 0 && !is_known_schema_op(filter_op)) {
        ret simple_error(w, "unknown_op", "unknown operation name for schema filter");
    }
    jw.obj(w);
    jw.f_str(w, "name", "qark");
    jw.f_str(w, "version", spec.VERSION);
    if (filter_op != nil && filter_n > 0) { jw.f_str(w, "filter", filter_op); }
    jw.key(w, "schemas");
    jw.obj(w);
    if (schema_match(filter_op, "apply")) {
        jw.key(w, "apply");
        jw.raw_v(w, "{\"fields\":[\"files\",\"path\",\"glob\",\"text\",\"lines\",\"tmpl\",\"template\",\"json\",\"edits\",\"move\",\"delete\",\"mode\",\"expect\",\"require_expect\",\"idempotency_key\",\"check\",\"contract\",\"scope\",\"rebase\",\"base_text\",\"validate\",\"project_check\",\"timeout_ms\",\"best_effort\",\"stream\",\"dry_run\",\"preview\",\"diff\",\"undo\",\"redo\",\"tag\",\"job\",\"dest\",\"vars\",\"templates\",\"expand\"],\"edit_fields\":[\"symbol\",\"with\",\"body\",\"signature\",\"expect_signature\",\"rename\",\"find\",\"find_re\",\"replace\",\"lines\",\"insert_before\",\"insert_after\",\"auto_indent\",\"append\",\"prepend\",\"ex\",\"keys\",\"within\",\"occurrence\",\"all\",\"count\"],\"contract_fields\":[\"symbol\",\"symbols\",\"methods\",\"lines\",\"preserve_signatures\",\"max_lines_changed\",\"max_changed_lines\",\"forbid_delete\"],\"check_policies\":[\"strict\",\"required\",\"permissive\",\"off\"],\"returns\":[\"txn\",\"root\",\"tag\",\"dry_run\",\"ready\",\"replayed\",\"idempotent_replay\",\"check_policy\",\"validation_complete\",\"checks\",\"checker_diagnostics\",\"created\",\"replaced\",\"unchanged\",\"deleted\",\"files\",\"events\"],\"error_fields\":[\"code\",\"message\",\"file\",\"line\",\"col\",\"mismatch_category\",\"target_lines\",\"actual_line\",\"checker_diagnostics\",\"files\",\"rollback_failed\",\"recovery_required\"]}");
    }
    if (schema_match(filter_op, "read")) {
        jw.key(w, "read");
        jw.raw_v(w, "{\"fields\":[\"path\",\"paths\",\"content\",\"lines\",\"symbol\",\"symbols\",\"fold\",\"outline\",\"max_bytes\"],\"returns\":[\"files\",\"truncated\"]}");
    }
    if (schema_match(filter_op, "search")) {
        jw.key(w, "search");
        jw.raw_v(w, "{\"fields\":[\"pattern\",\"regex\",\"icase\",\"glob\",\"path\",\"context\",\"max\",\"max_files\",\"all\",\"impact\"],\"returns\":[\"files\",\"matches\",\"truncated\"]}");
    }
    if (schema_match(filter_op, "impact")) {
        jw.key(w, "impact");
        jw.raw_v(w, "{\"fields\":[\"symbol\",\"pattern\",\"glob\",\"path\"],\"returns\":[\"symbol\",\"analysis_mode\",\"complete\",\"truncated\",\"definitions\",\"references\",\"imports\",\"dependents\",\"affected_files\",\"affected_symbols\"]}");
    }
    if (schema_match(filter_op, "undo")) {
        jw.key(w, "undo");
        jw.raw_v(w, "{\"fields\":[\"txn\",\"steps\",\"list\",\"redo\",\"dry_run\",\"force\",\"diff\"],\"returns\":[\"txn\",\"root\",\"reverted_txn\",\"steps_reverted\",\"dry_run\",\"created\",\"replaced\",\"unchanged\",\"deleted\",\"files\",\"txns\",\"count\"]}");
    }
    if (schema_match(filter_op, "redo")) {
        jw.key(w, "redo");
        jw.raw_v(w, "{\"fields\":[\"txn\",\"steps\",\"dry_run\",\"force\",\"diff\"],\"returns\":[\"txn\",\"root\",\"redone_txn\",\"steps_redone\",\"dry_run\",\"created\",\"replaced\",\"unchanged\",\"deleted\",\"files\"]}");
    }
    if (schema_match(filter_op, "events")) {
        jw.key(w, "events");
        jw.raw_v(w, "{\"fields\":[\"since_offset\",\"offset\",\"limit\"],\"returns\":[\"events\",\"count\",\"next_offset\"]}");
    }
    if (schema_match(filter_op, "project.validate")) {
        jw.key(w, "project.validate");
        jw.raw_v(w, "{\"fields\":[\"validate\",\"cmd\"],\"returns\":[\"ok\",\"validation\",\"message\"]}");
    }
    if (schema_match(filter_op, "release.sign")) {
        jw.key(w, "release.sign");
        jw.raw_v(w, "{\"fields\":[\"dir\",\"key\",\"version\"],\"returns\":[\"dir\",\"version\",\"algorithm\",\"manifest_sha256\",\"key_id\",\"signature\",\"files\"]}");
    }
    if (schema_match(filter_op, "release.verify")) {
        jw.key(w, "release.verify");
        jw.raw_v(w, "{\"fields\":[\"dir\",\"key\"],\"returns\":[\"ok\",\"verified\",\"version\",\"key_id\",\"manifest_sha256\",\"signature\",\"files_verified\"]}");
    }
    if (schema_match(filter_op, "capabilities")) {
        jw.key(w, "capabilities");
        jw.raw_v(w, "{\"fields\":[],\"returns\":[\"name\",\"version\",\"protocol\",\"features\",\"check_policies\",\"symbol_edit_modes\",\"contract_fields\",\"ops\",\"languages\",\"limits\",\"checkers\"]}");
    }
    if (schema_match(filter_op, "schema")) {
        jw.key(w, "schema");
        jw.raw_v(w, "{\"fields\":[\"op\",\"schema\"],\"returns\":[\"name\",\"version\",\"filter\",\"schemas\"]}");
    }
    if (schema_match(filter_op, "template.list")) {
        jw.key(w, "template.list");
        jw.raw_v(w, "{\"fields\":[\"name\"],\"returns\":[\"templates\"]}");
    }
    if (schema_match(filter_op, "template.define")) {
        jw.key(w, "template.define");
        jw.raw_v(w, "{\"fields\":[\"name\",\"text\",\"lines\",\"path\",\"lang\",\"description\",\"persist\"],\"returns\":[\"name\",\"replaced\",\"persisted\",\"vars\"]}");
    }
    if (schema_match(filter_op, "template.render")) {
        jw.key(w, "template.render");
        jw.raw_v(w, "{\"fields\":[\"template\",\"tmpl\",\"vars\"],\"returns\":[\"text\",\"bytes\"]}");
    }
    if (schema_match(filter_op, "job.verify")) {
        jw.key(w, "job.verify");
        jw.raw_v(w, "{\"fields\":[\"dir\"],\"returns\":[\"dir\",\"job\",\"files\",\"unlisted\",\"ok\",\"clean\"]}");
    }
    if (schema_match(filter_op, "session.info")) {
        jw.key(w, "session.info");
        jw.raw_v(w, "{\"fields\":[],\"returns\":[\"name\",\"version\",\"protocol\",\"root\",\"ops\",\"features\",\"check_policies\",\"limits\",\"checkers\",\"applies\",\"files_written\"]}");
    }
    jw.obj_end(w);
    jw.obj_end(w);
    ret true;
}

fun resolve_release_dir(a: *A.Allocator, root: str, dir_in: str) str {
    if (dir_in == nil || dir_in[0] == 0) { ret nil; }
    val is_abs_win: bool = str_len(dir_in) >= 2 && dir_in[1] == ':';
    val is_abs_unix: bool = dir_in[0] == '/' || dir_in[0] == '\\';
    if (is_abs_win || is_abs_unix) {
        val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(dir_in);
        if (sel m.ok) {
            if (m.ok.kind == filesystem.KIND_DIR) { ret dir_in; }
        }
        ret nil;
    }
    val canon: res[str, A.Error] = pathx.canonical(a, dir_in);
    if (sel canon.err) { ret nil; }
    if (pathx.check(canon.ok) != pathx.P_OK) { ret nil; }
    val full: res[str, A.Error] = pathx.native(a, root, canon.ok);
    if (sel full.err) { ret nil; }
    val m2: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(full.ok);
    if (sel m2.ok) {
        if (m2.ok.kind == filesystem.KIND_DIR) { ret full.ok; }
    }
    ret nil;
}

fun resolve_release_key(a: *A.Allocator, args: *json.Value) str {
    if (json.value_is_object(args)) {
        val kf: opt[*json.Value] = json.value_find(args, "key");
        if (sel kf.some) {
            var kp: *u8 = nil;
            var kn: usize = 0;
            if (json.value_is_string(kf.some) && spec.decode_pub(a, kf.some, ?kp, ?kn) && kn > 0) {
                ret kp;
            }
        }
    }
    val ev: res[opt[OwnedString], env.EnvError] = env.value(a, "QARK_RELEASE_KEY");
    if (sel ev.ok) {
        if (sel ev.ok.some) {
            if (ev.ok.some.data != nil && ev.ok.some.data[0] != 0) {
                ret ev.ok.some.data;
            }
        }
    }
    ret nil;
}

fun compute_release_sig(a: *A.Allocator, version: str, key: str, manifest_sha: str, sig_out: *u8, key_id_out: *u8) {
    val kn: usize = str_len(key);
    var kfull: [65]u8;
    commit.hmac_sha256_hex(a, key, kn, "qark-key-id-v1", 14, ?kfull[0]);
    var ki: usize = 0;
    for (ki < 16) {
        key_id_out[ki] = kfull[ki];
        ki = ki + 1;
    }
    key_id_out[16] = 0;

    var sw: jw.Jw = jw.init(a);
    jw.raw(?sw, "qark-release-sig-v1:");
    jw.raw(?sw, version);
    jw.raw(?sw, ":");
    jw.raw(?sw, manifest_sha);
    commit.hmac_sha256_hex(a, key, kn, sw.buf, sw.len, sig_out);
}

# sign a release directory: writes SHA256SUMS and RELEASE.json with HMAC-SHA256 signature
pub fun release_sign(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var dir_in: *u8 = nil;
    var dir_n: usize = 0;
    val df: opt[*json.Value] = json.value_find(args, "dir");
    if (sel df.some) {
        if (json.value_is_string(df.some)) { spec.decode_pub(a, df.some, ?dir_in, ?dir_n); }
    }
    if (dir_in == nil || dir_n == 0) {
        ret simple_error(w, "spec_field", "release.sign needs dir naming the release directory");
    }
    val full_dir: str = resolve_release_dir(a, s.root, dir_in);
    if (full_dir == nil) {
        ret simple_error(w, "release_dir", "release directory does not exist or is invalid");
    }
    val key: str = resolve_release_key(a, args);
    if (key == nil) {
        ret simple_error(w, "release_key_required", "release.sign requires an explicit key argument or QARK_RELEASE_KEY environment variable");
    }
    var ver: str = spec.VERSION;
    val vf: opt[*json.Value] = json.value_find(args, "version");
    if (sel vf.some) {
        var vp: *u8 = nil;
        var vn: usize = 0;
        if (json.value_is_string(vf.some) && spec.decode_pub(a, vf.some, ?vp, ?vn) && vn > 0) {
            ver = vp;
        }
    }
    val names_r: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(a, full_dir);
    if (sel names_r.err) {
        ret simple_error(w, "release_dir", "could not read release directory");
    }
    var list: vector.Vector[str] = names_r.ok;
    var i: usize = 1;
    for (i < list.len) {
        var j: usize = i;
        for (j > 0 && name_lt(list.data[j], list.data[j - 1])) {
            val t: str = list.data[j];
            list.data[j] = list.data[j - 1];
            list.data[j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
    var sums_w: jw.Jw = jw.init(a);
    var files_w: jw.Jw = jw.init(a);
    jw.arr(?files_w);
    var fcount: i64 = 0;
    i = 0;
    for (i < list.len) {
        val nm: str = list.data[i];
        if (!util.eq(nm, "RELEASE.json") && !util.eq(nm, "SHA256SUMS")) {
            val fpath: res[str, A.Error] = pathx.native(a, full_dir, nm);
            if (sel fpath.ok) {
                val fm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(fpath.ok);
                if (sel fm.ok) {
                    if (fm.ok.kind == filesystem.KIND_FILE) {
                        val fbytes: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, fpath.ok);
                        if (sel fbytes.err) {
                            ret simple_error(w, "io_read", "could not read a file in the release directory");
                        }
                        if (sel fbytes.ok) {
                            var fsha: [65]u8;
                            commit.hash_hex(fbytes.ok.data, fbytes.ok.len, ?fsha[0]);
                            jw.raw(?sums_w, ?fsha[0]);
                            jw.raw(?sums_w, "  ");
                            jw.raw(?sums_w, nm);
                            jw.byte(?sums_w, '\n');

                            jw.obj(?files_w);
                            jw.f_str(?files_w, "path", nm);
                            jw.f_str(?files_w, "sha256", ?fsha[0]);
                            jw.f_i64(?files_w, "bytes", fbytes.ok.len::i64);
                            jw.obj_end(?files_w);
                            fcount = fcount + 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    jw.arr_end(?files_w);
    if (sums_w.failed || files_w.failed) {
        ret simple_error(w, "oom", "out of memory");
    }
    if (fcount == 0) {
        ret simple_error(w, "release_empty", "no release files found in directory to sign");
    }
    var sums_sha: [65]u8;
    commit.hash_hex(sums_w.buf, sums_w.len, ?sums_sha[0]);
    var sig_hex: [65]u8;
    var key_id: [17]u8;
    compute_release_sig(a, ver, key, ?sums_sha[0], ?sig_hex[0], ?key_id[0]);

    val sums_full: res[str, A.Error] = pathx.native(a, full_dir, "SHA256SUMS");
    if (sel sums_full.err) { ret simple_error(w, "oom", "out of memory"); }
    val w_sums: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, sums_full.ok, sums_w.buf, sums_w.len, 420, 493);
    if (sel w_sums.err) { ret simple_error(w, "io_write", "could not write SHA256SUMS"); }

    var rel_w: jw.Jw = jw.init(a);
    jw.obj(?rel_w);
    jw.f_str(?rel_w, "name", "qark");
    jw.f_str(?rel_w, "version", ver);
    jw.f_str(?rel_w, "algorithm", "hmac-sha256-v1");
    jw.f_str(?rel_w, "key_id", ?key_id[0]);
    jw.f_str(?rel_w, "manifest_sha256", ?sums_sha[0]);
    jw.f_str(?rel_w, "signature", ?sig_hex[0]);
    jw.key(?rel_w, "files");
    jw.raw_vn(?rel_w, files_w.buf, files_w.len);
    jw.obj_end(?rel_w);
    jw.byte(?rel_w, '\n');

    val rel_full: res[str, A.Error] = pathx.native(a, full_dir, "RELEASE.json");
    if (sel rel_full.err) { ret simple_error(w, "oom", "out of memory"); }
    val w_rel: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, rel_full.ok, rel_w.buf, rel_w.len, 420, 493);
    if (sel w_rel.err) { ret simple_error(w, "io_write", "could not write RELEASE.json"); }

    jw.obj(w);
    jw.f_str(w, "dir", dir_in);
    jw.f_str(w, "version", ver);
    jw.f_str(w, "algorithm", "hmac-sha256-v1");
    jw.f_str(w, "key_id", ?key_id[0]);
    jw.f_str(w, "manifest_sha256", ?sums_sha[0]);
    jw.f_str(w, "signature", ?sig_hex[0]);
    jw.f_i64(w, "files", fcount);
    jw.obj_end(w);
    ret true;
}

# verify a signed release directory against RELEASE.json and SHA256SUMS
pub fun release_verify(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    val a: *A.Allocator = ?s.ra;
    var dir_in: *u8 = nil;
    var dir_n: usize = 0;
    val df: opt[*json.Value] = json.value_find(args, "dir");
    if (sel df.some) {
        if (json.value_is_string(df.some)) { spec.decode_pub(a, df.some, ?dir_in, ?dir_n); }
    }
    if (dir_in == nil || dir_n == 0) {
        ret simple_error(w, "spec_field", "release.verify needs dir naming the release directory");
    }
    val full_dir: str = resolve_release_dir(a, s.root, dir_in);
    if (full_dir == nil) {
        ret simple_error(w, "release_dir", "release directory does not exist or is invalid");
    }
    val key: str = resolve_release_key(a, args);
    if (key == nil) {
        ret simple_error(w, "release_key_required", "release.verify requires an explicit key argument or QARK_RELEASE_KEY environment variable");
    }
    val sums_full: res[str, A.Error] = pathx.native(a, full_dir, "SHA256SUMS");
    val rel_full: res[str, A.Error] = pathx.native(a, full_dir, "RELEASE.json");
    if (sel sums_full.err) { ret simple_error(w, "oom", "out of memory"); }
    if (sel rel_full.err) { ret simple_error(w, "oom", "out of memory"); }
    val sums_b: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, sums_full.ok);
    if (sel sums_b.err) { ret simple_error(w, "release_missing", "SHA256SUMS is missing in the release directory"); }
    val rel_t: res[str, filesystem.FsError] = filesystem.read_string(a, rel_full.ok);
    if (sel rel_t.err) { ret simple_error(w, "release_missing", "RELEASE.json is missing in the release directory"); }
    val parsed: res[json.Value, json.JsonError] = json.parse(rel_t.ok, str_len(rel_t.ok), a);
    if (sel parsed.err) { ret simple_error(w, "release_corrupt", "RELEASE.json is not valid json"); }
    var doc: json.Value = parsed.ok;

    var actual_sums_sha: [65]u8;
    commit.hash_hex(sums_b.ok.data, sums_b.ok.len, ?actual_sums_sha[0]);

    var ver: *u8 = nil;
    var vern: usize = 0;
    var msha: *u8 = nil;
    var mshan: usize = 0;
    var sig: *u8 = nil;
    var sign: usize = 0;
    val vf: opt[*json.Value] = json.value_find(?doc, "version");
    val mf: opt[*json.Value] = json.value_find(?doc, "manifest_sha256");
    val sf: opt[*json.Value] = json.value_find(?doc, "signature");
    if (sel vf.some) { spec.decode_pub(a, vf.some, ?ver, ?vern); }
    if (sel mf.some) { spec.decode_pub(a, mf.some, ?msha, ?mshan); }
    if (sel sf.some) { spec.decode_pub(a, sf.some, ?sig, ?sign); }
    if (ver == nil || msha == nil || sig == nil) {
        ret simple_error(w, "release_corrupt", "RELEASE.json is missing version, manifest_sha256, or signature");
    }
    if (!util.eq(?actual_sums_sha[0], msha)) {
        ret simple_error(w, "release_tampered", "SHA256SUMS does not match manifest_sha256 in RELEASE.json");
    }
    var exp_sig: [65]u8;
    var exp_kid: [17]u8;
    compute_release_sig(a, ver, key, msha, ?exp_sig[0], ?exp_kid[0]);
    if (!util.eq(?exp_sig[0], sig)) {
        ret simple_error(w, "release_bad_signature", "release signature verification failed");
    }
    val ff: opt[*json.Value] = json.value_find(?doc, "files");
    if (!sel ff.some) { ret simple_error(w, "release_corrupt", "RELEASE.json has no files list"); }
    if (!json.value_is_array(ff.some)) { ret simple_error(w, "release_corrupt", "RELEASE.json files is not a list"); }
    val f_total: usize = json.value_count(ff.some);
    if (f_total == 0) { ret simple_error(w, "release_corrupt", "RELEASE.json files list cannot be empty"); }
    var verified_cnt: i64 = 0;
    var seen_paths: vector.Vector[str] = vector.init[str](a);
    var rebuilt_sums: jw.Jw = jw.init(a);
    var i: usize = 0;
    for (i < f_total) {
        val g: opt[*json.Value] = json.value_get(ff.some, i);
        if (!sel g.some) { ret simple_error(w, "release_corrupt", "invalid file entry in RELEASE.json"); }
        if (!json.value_is_object(g.some)) { ret simple_error(w, "release_corrupt", "file entry in RELEASE.json must be an object"); }
        var fp: *u8 = nil;
        var fpn: usize = 0;
        var fsha: *u8 = nil;
        var fshan: usize = 0;
        val fpf: opt[*json.Value] = json.value_find(g.some, "path");
        val fsf: opt[*json.Value] = json.value_find(g.some, "sha256");
        if (sel fpf.some) { spec.decode_pub(a, fpf.some, ?fp, ?fpn); }
        if (sel fsf.some) { spec.decode_pub(a, fsf.some, ?fsha, ?fshan); }
        if (fp == nil || fpn == 0 || fsha == nil || fshan != 64 || pathx.check(fp) != pathx.P_OK) {
            ret simple_error(w, "release_corrupt", "invalid file entry in RELEASE.json");
        }
        if (listed(?seen_paths, fp)) {
            ret simple_error(w, "release_corrupt", "duplicate file entry in RELEASE.json");
        }
        vector.push[str](?seen_paths, fp);
        jw.raw(?rebuilt_sums, fsha);
        jw.raw(?rebuilt_sums, "  ");
        jw.raw(?rebuilt_sums, fp);
        jw.byte(?rebuilt_sums, '\n');

        val item_full: res[str, A.Error] = pathx.native(a, full_dir, fp);
        if (sel item_full.err) { ret simple_error(w, "oom", "out of memory"); }
        val item_b: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, item_full.ok);
        if (sel item_b.err) {
            error_obj(w, "release_tampered", "a file listed in RELEASE.json is missing");
            jw.f_str(w, "path", fp);
            jw.obj_end(w);
            ret false;
        }
        var item_hex: [65]u8;
        commit.hash_hex(item_b.ok.data, item_b.ok.len, ?item_hex[0]);
        if (!util.eq(?item_hex[0], fsha)) {
            error_obj(w, "release_tampered", "a release file's sha256 does not match RELEASE.json");
            jw.f_str(w, "path", fp);
            jw.f_str(w, "expected_sha256", fsha);
            jw.f_str(w, "actual_sha256", ?item_hex[0]);
            jw.obj_end(w);
            ret false;
        }
        verified_cnt = verified_cnt + 1;
        i = i + 1;
    }
    if (rebuilt_sums.len != sums_b.ok.len || !util.mem_eq(rebuilt_sums.buf, sums_b.ok.data, sums_b.ok.len)) {
        ret simple_error(w, "release_tampered", "RELEASE.json files list does not match signed SHA256SUMS");
    }
    val dir_names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(a, full_dir);
    if (sel dir_names.ok) {
        var di: usize = 0;
        for (di < dir_names.ok.len) {
            val nm: str = dir_names.ok.data[di];
            if (!util.eq(nm, "RELEASE.json") && !util.eq(nm, "SHA256SUMS")) {
                val fpath: res[str, A.Error] = pathx.native(a, full_dir, nm);
                if (sel fpath.ok) {
                    val fm: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(fpath.ok);
                    if (sel fm.ok) {
                        if (fm.ok.kind == filesystem.KIND_FILE && !listed(?seen_paths, nm)) {
                            error_obj(w, "release_tampered", "unsigned extra file present in release directory");
                            jw.f_str(w, "path", nm);
                            jw.obj_end(w);
                            ret false;
                        }
                    }
                }
            }
            di = di + 1;
        }
    }
    jw.obj(w);
    jw.f_bool(w, "ok", true);
    jw.f_bool(w, "verified", true);
    jw.f_str(w, "dir", dir_in);
    jw.f_str(w, "version", ver);
    jw.f_str(w, "key_id", ?exp_kid[0]);
    jw.f_str(w, "manifest_sha256", ?actual_sums_sha[0]);
    jw.f_str(w, "signature", sig);
    jw.f_i64(w, "files_verified", verified_cnt);
    jw.obj_end(w);
    ret true;
}

# grep or list the workspace; matches group per file with that file's sha256
#
# pattern is literal text unless regex is true, which reads it as the qark
# dialect: . [] () | * + ? {} ^ $ \< \> \d \w \s. glob narrows which files
# (* stays within a directory, ** crosses). with no pattern it lists the
# matching paths instead. skips .git, .qark, node_modules, and friends
# unless all is true; skips binary files and files over 4 MiB.
pub fun search(s: *session.Session, args: *json.Value, w: *jw.Jw) bool {
    if (json.value_is_object(args)) {
        val imf: opt[*json.Value] = json.value_find(args, "impact");
        if (sel imf.some) {
            if ((json.value_is_bool(imf.some) && json.value_bool(imf.some)) || json.value_is_string(imf.some)) {
                ret impact(s, args, w);
            }
        }
    }
    val a: *A.Allocator = ?s.ra;
    var o: scan.Opts;
    o.pat = nil;
    o.patn = 0;
    o.is_re = false;
    o.icase = false;
    o.glob = nil;
    o.path = "";
    o.ctx = 0;
    o.max = 100;
    o.max_files = 20000;
    o.all = false;
    val pf: opt[*json.Value] = json.value_find(args, "pattern");
    if (sel pf.some) {
        var p: *u8 = nil;
        var pn: usize = 0;
        if (!json.value_is_string(pf.some) || !spec.decode_pub(a, pf.some, ?p, ?pn)) {
            ret simple_error(w, "spec_type", "pattern must be a string");
        }
        o.pat = p;
        o.patn = pn;
    }
    val rf: opt[*json.Value] = json.value_find(args, "regex");
    if (sel rf.some) {
        if (json.value_is_bool(rf.some)) { o.is_re = json.value_bool(rf.some); }
    }
    val ic: opt[*json.Value] = json.value_find(args, "icase");
    if (sel ic.some) {
        if (json.value_is_bool(ic.some)) { o.icase = json.value_bool(ic.some); }
    }
    val al: opt[*json.Value] = json.value_find(args, "all");
    if (sel al.some) {
        if (json.value_is_bool(al.some)) { o.all = json.value_bool(al.some); }
    }
    val gf: opt[*json.Value] = json.value_find(args, "glob");
    if (sel gf.some) {
        var g: *u8 = nil;
        var gn: usize = 0;
        if (!json.value_is_string(gf.some) || !spec.decode_pub(a, gf.some, ?g, ?gn)) {
            ret simple_error(w, "spec_type", "glob must be a string such as **/*.py");
        }
        o.glob = pathx.strip_root(s.root, g);
    }
    val xf: opt[*json.Value] = json.value_find(args, "context");
    if (sel xf.some) {
        if (json.value_is_number(xf.some)) {
            o.ctx = json.value_number(xf.some);
            if (o.ctx < 0) { o.ctx = 0; }
            if (o.ctx > 20) { o.ctx = 20; }
        }
    }
    val mf: opt[*json.Value] = json.value_find(args, "max");
    if (sel mf.some) {
        if (json.value_is_number(mf.some)) {
            o.max = json.value_number(mf.some);
            if (o.max < 1) { o.max = 1; }
            if (o.max > 100000) { o.max = 100000; }
        }
    }
    val mf2: opt[*json.Value] = json.value_find(args, "max_files");
    if (sel mf2.some) {
        if (json.value_is_number(mf2.some)) {
            o.max_files = json.value_number(mf2.some);
            if (o.max_files < 1) { o.max_files = 1; }
            if (o.max_files > 200000) { o.max_files = 200000; }
        }
    }
    val df: opt[*json.Value] = json.value_find(args, "path");
    if (sel df.some) {
        var p: *u8 = nil;
        var pn: usize = 0;
        if (!json.value_is_string(df.some) || !spec.decode_pub(a, df.some, ?p, ?pn)) {
            ret simple_error(w, "spec_type", "path must be a string, a directory relative to the workspace root");
        }
        val sp_rel: str = pathx.strip_root(s.root, p);
        if (!util.eq(sp_rel, ".") && sp_rel[0] != 0) {
            val canon: res[str, A.Error] = pathx.canonical(a, sp_rel);
            if (sel canon.err) { ret simple_error(w, "oom", "out of memory"); }
            val r: i64 = pathx.check(canon.ok);
            if (r != pathx.P_OK) { ret simple_error(w, pathx.code(r), pathx.message(r)); }
            o.path = canon.ok;
        }
    }
    if (!scan.run(a, s.root, ?o, w)) {
        ret simple_error(w, "bad_pattern", "the pattern is not a valid qark regex; it supports . [] () | * + ? {} ^ $ \\< \\> \\d \\w \\s");
    }
    ret true;
}

# what this worker is, where it writes, and what it can check
pub fun info(s: *session.Session, w: *jw.Jw) bool {
    check.probe(s.a, ?s.tools);
    jw.obj(w);
    jw.f_str(w, "name", "qark");
    jw.f_str(w, "version", spec.VERSION);
    jw.f_i64(w, "protocol", 2);
    jw.f_str(w, "root", s.root);
    jw.key(w, "ops");
    jw.raw_v(w, "[\"apply\",\"undo\",\"redo\",\"read\",\"search\",\"impact\",\"events\",\"project.validate\",\"capabilities\",\"schema\",\"release.sign\",\"release.verify\",\"template.list\",\"template.define\",\"template.render\",\"job.verify\",\"session.info\",\"buf.create\",\"buf.set_lines\",\"keys.feed\",\"cmd.ex\",\"eval\",\"job.write\",\"validate.ident\"]");
    jw.key(w, "features");
    jw.raw_v(w, "[\"ast_symbol_edits\",\"scope_contracts\",\"semantic_previews\",\"project_validation\",\"streaming_events\",\"persistent_undo_redo\",\"three_way_rebase\",\"impact_graph\",\"capabilities_schema\",\"signed_releases\",\"signature_fold\",\"glob_refactor\",\"fail_closed_checkers\",\"structured_repair_feedback\",\"validation_complete\"]");
    jw.key(w, "check_policies");
    jw.raw_v(w, "[\"strict\",\"required\",\"permissive\",\"off\"]");
    jw.f_i64(w, "search_file_bytes", scan.MAX_SCAN_BYTES::i64);
    jw.key(w, "limits");
    jw.obj(w);
    jw.f_i64(w, "files_per_apply", spec.MAX_FILES::i64);
    jw.f_i64(w, "bytes_per_file", spec.MAX_FILE_BYTES::i64);
    jw.f_i64(w, "bytes_per_apply", spec.MAX_TOTAL_BYTES::i64);
    jw.f_i64(w, "read_bytes", READ_MAX::i64);
    jw.f_i64(w, "lock_wait_ms", s.lock_ms);
    jw.obj_end(w);
    jw.key(w, "checkers");
    jw.obj(w);
    jw.f_str(w, "python", s.tools.python);
    jw.f_str(w, "node", s.tools.node);
    jw.f_str(w, "powershell", s.tools.pwsh);
    jw.f_str(w, "bash", s.tools.bash);
    jw.f_str(w, "json", "builtin");
    jw.f_str(w, "toml", "builtin");
    jw.obj_end(w);
    jw.f_i64(w, "applies", s.applies);
    jw.f_i64(w, "files_written", s.written);
    jw.obj_end(w);
    ret true;
}
