# key notation: bytes, specials, and <C-x> chords

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use util: qark.util;

pub val KIND_BYTE: u8 = 1;
pub val KIND_SPEC: u8 = 2;

pub val MOD_CTRL:  u8 = 1;
pub val MOD_ALT:   u8 = 2;
pub val MOD_SHIFT: u8 = 4;

pub val SP_ESC:   u16 = 1;
pub val SP_CR:    u16 = 2;
pub val SP_TAB:   u16 = 3;
pub val SP_BS:    u16 = 4;
pub val SP_DEL:   u16 = 5;
pub val SP_UP:    u16 = 6;
pub val SP_DOWN:  u16 = 7;
pub val SP_LEFT:  u16 = 8;
pub val SP_RIGHT: u16 = 9;
pub val SP_HOME:  u16 = 10;
pub val SP_END:   u16 = 11;
pub val SP_PGUP:  u16 = 12;
pub val SP_PGDN:  u16 = 13;
pub val SP_SPACE: u16 = 14;
pub val SP_F1:    u16 = 20;

# one decoded key
pub rec Key {
    kind:    u8;
    mods:    u8;
    byte:    u8;
    special: u16;
}

# a growable key sequence
pub rec Seq {
    a:    *A.Allocator;
    data: *Key;
    len:  usize;
    cap:  usize;
}

# an empty sequence
pub fun seq_init(a: *A.Allocator) Seq {
    var s: Seq;
    s.a = a;
    ret s;
}

# release a sequence
pub fun seq_dnit(s: *Seq) {
    if (s.data != nil) { A.deallocate[Key](s.a, s.data, s.cap); }
    s.data = nil;
    s.len = 0;
    s.cap = 0;
}

# append one key
pub fun seq_push(s: *Seq, k: Key) err[A.Error] {
    if (s.len >= s.cap) {
        var ncap: usize = 16;
        if (s.cap > 0) { ncap = s.cap * 2; }
        var got: res[*Key, A.Error];
        if (s.data == nil) { got = A.allocate[Key](s.a, ncap); }
        or { got = A.reallocate[Key](s.a, s.data, s.cap, ncap); }
        if (sel got.err) { ret err[A.Error].err{got.err}; }
        s.data = got.ok;
        s.cap = ncap;
    }
    s.data[s.len] = k;
    s.len = s.len + 1;
    ret err[A.Error].ok{};
}

# a plain byte key
pub fun byte_key(b: u8) Key {
    ret Key{kind: KIND_BYTE, mods: 0, byte: b, special: 0};
}

# a special key
pub fun spec_key(sp: u16, mods: u8) Key {
    ret Key{kind: KIND_SPEC, mods: mods, byte: 0, special: sp};
}

fun token_eq(p: *u8, n: usize, lit: str) bool {
    if (n != str_len(lit)) { ret false; }
    var i: usize = 0;
    for (i < n) {
        var c: u8 = p[i];
        var d: u8 = lit[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        if (d >= 'A' && d <= 'Z') { d = d + 32; }
        if (c != d) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun special_of(p: *u8, n: usize) u16 {
    if (token_eq(p, n, "esc"))    { ret SP_ESC; }
    if (token_eq(p, n, "cr"))     { ret SP_CR; }
    if (token_eq(p, n, "enter"))  { ret SP_CR; }
    if (token_eq(p, n, "tab"))    { ret SP_TAB; }
    if (token_eq(p, n, "bs"))     { ret SP_BS; }
    if (token_eq(p, n, "del"))    { ret SP_DEL; }
    if (token_eq(p, n, "up"))     { ret SP_UP; }
    if (token_eq(p, n, "down"))   { ret SP_DOWN; }
    if (token_eq(p, n, "left"))   { ret SP_LEFT; }
    if (token_eq(p, n, "right"))  { ret SP_RIGHT; }
    if (token_eq(p, n, "home"))   { ret SP_HOME; }
    if (token_eq(p, n, "end"))    { ret SP_END; }
    if (token_eq(p, n, "pageup")) { ret SP_PGUP; }
    if (token_eq(p, n, "pagedown")) { ret SP_PGDN; }
    if (token_eq(p, n, "space"))  { ret SP_SPACE; }
    if (token_eq(p, n, "lt"))     { ret 0; }
    if (n >= 2 && (p[0] == 'f' || p[0] == 'F')) {
        var v: u16 = 0;
        var i: usize = 1;
        for (i < n && p[i] >= '0' && p[i] <= '9') {
            v = v * 10 + (p[i] - '0')::u16;
            i = i + 1;
        }
        if (i == n && v >= 1 && v <= 12) { ret SP_F1 + (v - 1); }
    }
    ret 0;
}

# parse a notation string into keys; raw bytes outside <> are byte keys
# ---
# ret: ok, or invalid when a chord is unfinished or unknown
pub fun parse(s: str, out: *Seq) err[A.Error] {
    if (s == nil) { ret err[A.Error].ok{}; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        if (s[i] == '<' && i + 1 < n) {
            var j: usize = i + 1;
            for (j < n && s[j] != '>') { j = j + 1; }
            if (j >= n) { ret err[A.Error].err{A.Error.invalid{}}; }
            var mods: u8 = 0;
            var p: usize = i + 1;
            for (p + 1 < j && s[p + 1] == '-') {
                var m: u8 = s[p];
                if (m >= 'A' && m <= 'Z') { m = m + 32; }
                if (m == 'c') { mods = mods | MOD_CTRL; }
                or (m == 'a' || m == 'm') { mods = mods | MOD_ALT; }
                or (m == 's') { mods = mods | MOD_SHIFT; }
                or { brk; }
                p = p + 2;
            }
            val tn: usize = j - p;
            if (tn == 2 && token_eq((s::usize + p)::*u8, 2, "lt")) {
                val pushed: err[A.Error] = seq_push(out, byte_key('<'));
                if (sel pushed.err) { ret pushed; }
            }
            or (tn == 1) {
                var ch: u8 = s[p];
                if ((mods & MOD_SHIFT) != 0 && ch >= 'a' && ch <= 'z') { ch = ch - 32; }
                if ((mods & MOD_CTRL) != 0 && ch >= 'a' && ch <= 'z') { ch = ch - 'a' + 1; }
                if ((mods & MOD_CTRL) != 0 && ch >= 'A' && ch <= 'Z') { ch = ch - 'A' + 1; }
                var k: Key = byte_key(ch);
                k.mods = mods;
                val pushed: err[A.Error] = seq_push(out, k);
                if (sel pushed.err) { ret pushed; }
            }
            or {
                val sp: u16 = special_of((s::usize + p)::*u8, tn);
                if (sp == 0 && !token_eq((s::usize + p)::*u8, tn, "lt")) {
                    ret err[A.Error].err{A.Error.invalid{}};
                }
                var k: Key = spec_key(sp, mods);
                if (token_eq((s::usize + p)::*u8, tn, "lt")) { k = byte_key('<'); }
                val pushed: err[A.Error] = seq_push(out, k);
                if (sel pushed.err) { ret pushed; }
            }
            i = j + 1;
        }
        or {
            var ch: u8 = s[i];
            var k: Key = byte_key(ch);
            if (ch == '\n') { k = spec_key(SP_CR, 0); }
            if (ch == '\t') { k = spec_key(SP_TAB, 0); }
            val pushed: err[A.Error] = seq_push(out, k);
            if (sel pushed.err) { ret pushed; }
            i = i + 1;
        }
    }
    ret err[A.Error].ok{};
}

# append the notation of one key onto a growable string
pub fun encode(a: *A.Allocator, buf: **u8, len: *usize, cap: *usize, k: Key) err[A.Error] {
    if (k.kind == KIND_BYTE && k.mods == 0 && k.byte >= 32 && k.byte != '<') {
        ret util.append_byte(a, buf, len, cap, k.byte);
    }
    val open: err[A.Error] = util.append_byte(a, buf, len, cap, '<');
    if (sel open.err) { ret open; }
    if ((k.mods & MOD_CTRL) != 0) {
        val m: err[A.Error] = util.append_str(a, buf, len, cap, "C-");
        if (sel m.err) { ret m; }
    }
    if ((k.mods & MOD_ALT) != 0) {
        val m: err[A.Error] = util.append_str(a, buf, len, cap, "A-");
        if (sel m.err) { ret m; }
    }
    if (k.kind == KIND_SPEC) {
        var name: str = "Esc";
        if (k.special == SP_CR)    { name = "CR"; }
        if (k.special == SP_TAB)   { name = "Tab"; }
        if (k.special == SP_BS)    { name = "BS"; }
        if (k.special == SP_DEL)   { name = "Del"; }
        if (k.special == SP_UP)    { name = "Up"; }
        if (k.special == SP_DOWN)  { name = "Down"; }
        if (k.special == SP_LEFT)  { name = "Left"; }
        if (k.special == SP_RIGHT) { name = "Right"; }
        if (k.special == SP_HOME)  { name = "Home"; }
        if (k.special == SP_END)   { name = "End"; }
        if (k.special == SP_PGUP)  { name = "PageUp"; }
        if (k.special == SP_PGDN)  { name = "PageDown"; }
        if (k.special == SP_SPACE) { name = "Space"; }
        if (k.special >= SP_F1 && k.special < SP_F1 + 12) {
            var tmp: [4]u8;
            tmp[0] = 'F';
            val num: u16 = k.special - SP_F1 + 1;
            if (num >= 10) {
                tmp[1] = '1';
                tmp[2] = ('0'::u16 + (num - 10))::u8;
                tmp[3] = 0;
            }
            or {
                tmp[1] = ('0'::u16 + num)::u8;
                tmp[2] = 0;
            }
            val m: err[A.Error] = util.append_str(a, buf, len, cap, ?tmp[0]);
            if (sel m.err) { ret m; }
        }
        or {
            val m: err[A.Error] = util.append_str(a, buf, len, cap, name);
            if (sel m.err) { ret m; }
        }
    }
    or {
        var ch: u8 = k.byte;
        if (ch < 32) { ch = ch - 1 + 'a'; }
        val m: err[A.Error] = util.append_byte(a, buf, len, cap, ch);
        if (sel m.err) { ret m; }
    }
    ret util.append_byte(a, buf, len, cap, '>');
}

# true when two keys are the same chord
pub fun same(a: Key, b: Key) bool {
    if (a.kind != b.kind || a.mods != b.mods) { ret false; }
    if (a.kind == KIND_SPEC) { ret a.special == b.special; }
    ret a.byte == b.byte;
}

use std.system.capability;

$if (capability.HOSTED) {
    use page: std.allocator.page;

    test parse__ctrl_and_bytes {
        var a: A.Allocator;
        val made: err[A.Error] = page.make(?a);
        if (sel made.err) { ret 1; }
        var s: Seq = seq_init(?a);
        val p: err[A.Error] = parse("<C-w>ab<Esc>", ?s);
        if (sel p.err) { ret 2; }
        if (s.len != 4) { ret 3; }
        if (s.data[0].byte != 23) { ret 4; }
        if ((s.data[0].mods & MOD_CTRL) == 0) { ret 5; }
        if (s.data[1].byte != 'a' || s.data[2].byte != 'b') { ret 6; }
        if (s.data[3].kind != KIND_SPEC || s.data[3].special != SP_ESC) { ret 7; }
        seq_dnit(?s);
        ret 0;
    }
}
