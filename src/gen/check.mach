# syntax checks on change-set bytes before anything is published
#
# json and toml parse in this process. python, node, and powershell each get
# one helper process for all of their files. bash gets one `bash -n` per file.
# .qark/checks.json can add a command for any other extension; that command
# sees the new bytes at a preview path and a non-zero exit refuses the apply.

use std.collections.vector;
use std.data.json;
use toml: std.data.toml;
use std.filesystem;
use io_error: std.io.error;
use std.process.env;
use std.process.exec;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use commit: qark.gen.commit;
use path: std.types.path;
use pathx: qark.gen.pathx;
use warm: qark.gen.warm;
use jw: qark.rpc.jw;
use runner: qark.run.runner;
use util: qark.util;

#[embed("../../scripts/checkers/check.py")]
val PY_SRC: [_]u8;
#[embed("../../scripts/checkers/check.cjs")]
val JS_SRC: [_]u8;
#[embed("../../scripts/checkers/check.ps1")]
val PS_SRC: [_]u8;

pub val TIMEOUT_MS: i64 = 20000;

# checker programs found on this host, each looked up on first use; nil when absent
# ---
# warm: the session's long-lived checkers for python, node, and powershell
pub rec Tools {
    seen:           [4]bool;
    python:         str;
    node:           str;
    pwsh:           str;
    bash:           str;
    warm:           [3]warm.Warm;
    no_custom_exec: bool;
}

rec Run {
    lang:    str;
    batch:   bool;
    items:   vector.Vector[usize];
    job:     runner.Job;
    started: bool;
    warm:    bool;
    argv:    [12]*u8;
    argc:    usize;
    input:   *u8;
    input_n: usize;
    external: bool;
    stage:   bool;
    preview: str;
    cwd:     str;
}

fun from_env(a: *A.Allocator, name: str) str {
    val v: res[opt[OwnedString], env.EnvError] = env.value(a, name);
    if (sel v.ok) {
        if (sel v.ok.some) {
            if (v.ok.some.data != nil && v.ok.some.data[0] != 0) { ret v.ok.some.data; }
        }
    }
    ret nil;
}

fun locate(a: *A.Allocator, var_name: str, first: str, second: str) str {
    val set: str = from_env(a, var_name);
    if (set != nil) { ret set; }
    if (first != nil) {
        val r: res[str, exec.Error] = exec.resolve(a, first);
        if (sel r.ok) { ret r.ok; }
    }
    if (second != nil) {
        val r: res[str, exec.Error] = exec.resolve(a, second);
        if (sel r.ok) { ret r.ok; }
    }
    ret nil;
}

# the program for a checker, found once and remembered; a is a long-lived allocator
pub fun tool(a: *A.Allocator, t: *Tools, lang: str) str {
    if (util.eq(lang, "python")) {
        if (!t.seen[0]) {
            t.python = locate(a, "QARK_PYTHON", "python", "python3");
            t.seen[0] = true;
        }
        ret t.python;
    }
    if (util.eq(lang, "node")) {
        if (!t.seen[1]) {
            t.node = locate(a, "QARK_NODE", "node", nil);
            t.seen[1] = true;
        }
        ret t.node;
    }
    if (util.eq(lang, "powershell")) {
        if (!t.seen[2]) {
            t.pwsh = locate(a, "QARK_PWSH", "pwsh", "powershell");
            t.seen[2] = true;
        }
        ret t.pwsh;
    }
    if (!t.seen[3]) {
        $if ($mach.build.os == $mach.os.windows) {
            t.bash = from_env(a, "QARK_BASH");
        }
        $or {
            t.bash = locate(a, "QARK_BASH", "bash", nil);
        }
        t.seen[3] = true;
    }
    ret t.bash;
}

# look up every checker, for reporting
pub fun probe(a: *A.Allocator, t: *Tools) {
    tool(a, t, "python");
    tool(a, t, "node");
    tool(a, t, "powershell");
    tool(a, t, "bash");
}

fun line_at(p: *u8, off: usize, n: usize, col: *i64) i64 {
    var line: i64 = 1;
    var last: usize = 0;
    var i: usize = 0;
    for (i < off && i < n) {
        if (p[i] == '\n') {
            line = line + 1;
            last = i + 1;
        }
        i = i + 1;
    }
    @col = (off - last + 1)::i64;
    ret line;
}

fun native_json(a: *A.Allocator, e: *commit.Entry) {
    val parsed: res[json.Value, json.JsonError] = json.parse(e.data, e.len, a);
    if (sel parsed.ok) {
        if (e.check != commit.CK_FAILED && e.check != commit.CK_ERROR) {
            e.check = commit.CK_OK;
        }
        ret;
    }
    var off: usize = 0;
    var msg: str = "invalid json";
    if (sel parsed.err) {
        if (sel parsed.err.syntax) { off = parsed.err.syntax; }
        or (sel parsed.err.depth) {
            off = parsed.err.depth;
            msg = "json nests deeper than 128 levels";
        }
        or {
            e.check = commit.CK_ERROR;
            e.ck_cat = "oom";
            e.ck_msg = "out of memory while checking json";
            ret;
        }
    }
    e.check = commit.CK_FAILED;
    e.ck_line = line_at(e.data, off, e.len, ?e.ck_col);
    e.ck_msg = msg;
}

fun native_toml(a: *A.Allocator, e: *commit.Entry) {
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(a, e.data);
    if (sel parsed.ok) {
        if (e.check != commit.CK_FAILED && e.check != commit.CK_ERROR) {
            e.check = commit.CK_OK;
        }
        ret;
    }
    var off: usize = 0;
    if (sel parsed.err) {
        if (sel parsed.err.syntax) { off = parsed.err.syntax; }
        or (sel parsed.err.overflow) { off = parsed.err.overflow; }
        or (sel parsed.err.depth) { off = parsed.err.depth; }
    }
    e.check = commit.CK_FAILED;
    e.ck_line = line_at(e.data, off, e.len, ?e.ck_col);
    e.ck_msg = "invalid toml";
}

fun embedded_py(a: *A.Allocator) res[str, A.Error] {
    val n: usize = $length_of(PY_SRC);
    val got: res[*u8, A.Error] = A.allocate[u8](a, n + 1);
    if (sel got.err) { ret res[str, A.Error].err{got.err}; }
    var i: usize = 0;
    for (i < n) {
        got.ok[i] = PY_SRC[i];
        i = i + 1;
    }
    got.ok[n] = 0;
    ret res[str, A.Error].ok{got.ok};
}

fun embedded_js(a: *A.Allocator) res[str, A.Error] {
    val n: usize = $length_of(JS_SRC);
    val got: res[*u8, A.Error] = A.allocate[u8](a, n + 1);
    if (sel got.err) { ret res[str, A.Error].err{got.err}; }
    var i: usize = 0;
    for (i < n) {
        got.ok[i] = JS_SRC[i];
        i = i + 1;
    }
    got.ok[n] = 0;
    ret res[str, A.Error].ok{got.ok};
}

fun embedded_ps(a: *A.Allocator) res[str, A.Error] {
    val n: usize = $length_of(PS_SRC);
    val got: res[*u8, A.Error] = A.allocate[u8](a, n + 1);
    if (sel got.err) { ret res[str, A.Error].err{got.err}; }
    var i: usize = 0;
    for (i < n) {
        got.ok[i] = PS_SRC[i];
        i = i + 1;
    }
    got.ok[n] = 0;
    ret res[str, A.Error].ok{got.ok};
}

# install a helper script under .qark/checkers when it is missing or stale; returns its host path
fun script(a: *A.Allocator, root: str, name: str, body: str) str {
    if (!commit.check_control_dir(a, root)) { ret nil; }
    val rel: res[str, A.Error] = pathx.join(a, ".qark/checkers", name);
    if (sel rel.err) { ret nil; }
    if (commit.check_ancestry(a, root, rel.ok) != nil) { ret nil; }
    val full: res[str, A.Error] = pathx.native(a, root, rel.ok);
    if (sel full.err) { ret nil; }
    val cur: res[str, filesystem.FsError] = filesystem.read_string(a, full.ok);
    if (sel cur.ok) {
        if (util.eq(cur.ok, body)) { ret full.ok; }
    }
    val wrote: err[filesystem.FsError] = filesystem.replace_bytes_atomic(a, full.ok, body, str_len(body), 420, 493);
    if (sel wrote.err) { ret nil; }
    ret full.ok;
}

fun skip_all(set: *commit.Set, r: *Run, why: str) {
    mark_all(set, r, why, false);
}

fun fail_all(set: *commit.Set, r: *Run, why: str) {
    mark_all(set, r, why, true);
}

fun mark_all(set: *commit.Set, r: *Run, why: str, failed: bool) {
    var i: usize = 0;
    for (i < r.items.len) {
        val e: *commit.Entry = commit.entry(set, r.items.data[i]);
        if (failed) {
            e.check = commit.CK_FAILED;
            e.ck_cat = "project_check";
            e.ck_msg = why;
        }
        or {
            if (e.check != commit.CK_FAILED && e.check != commit.CK_ERROR) {
                e.check = commit.CK_SKIPPED;
                e.ck_cat = "tool_missing";
                e.ck_msg = why;
            }
        }
        i = i + 1;
    }
}

fun sanitize_excerpt(a: *A.Allocator, s: str) str {
    if (s == nil || s[0] == 0) { ret nil; }
    var start: usize = 0;
    for (s[start] == ' ' || s[start] == '\t' || s[start] == '\r' || s[start] == '\n') { start = start + 1; }
    if (s[start] == 0) { ret nil; }
    var max_n: usize = 512;
    var buf: res[*u8, A.Error] = A.allocate[u8](a, max_n + 1);
    if (sel buf.err) { ret nil; }
    var o: usize = 0;
    var i: usize = start;
    for (s[i] != 0 && o < max_n) {
        val c: u8 = s[i];
        if (c == '\r') {
            i = i + 1;
            cnt;
        }
        if (c < 32 && c != '\n' && c != '\t') {
            buf.ok[o] = ' ';
            o = o + 1;
            i = i + 1;
            cnt;
        }
        buf.ok[o] = c;
        o = o + 1;
        i = i + 1;
    }
    for (o > 0 && (buf.ok[o - 1] == ' ' || buf.ok[o - 1] == '\t' || buf.ok[o - 1] == '\n')) { o = o - 1; }
    buf.ok[o] = 0;
    if (o == 0) { ret nil; }
    ret buf.ok;
}

fun error_all(a: *A.Allocator, set: *commit.Set, r: *Run, cat: str, why: str, exit_code: i64, raw_stderr: str) {
    val clean_err: str = sanitize_excerpt(a, raw_stderr);
    var exe: str = r.argv[0];
    if (exe == nil) { exe = r.lang; }
    var i: usize = 0;
    for (i < r.items.len) {
        val e: *commit.Entry = commit.entry(set, r.items.data[i]);
        e.check = commit.CK_ERROR;
        e.ck_cat = cat;
        e.ck_msg = why;
        e.ck_exe = exe;
        e.ck_exit = exit_code;
        e.ck_stderr = clean_err;
        i = i + 1;
    }
}

fun first_line(a: *A.Allocator, s: str) str {
    if (s == nil) { ret ""; }
    var n: usize = 0;
    for (s[n] != 0 && s[n] != '\n' && s[n] != '\r') { n = n + 1; }
    val d: res[str, A.Error] = util.dup_n(a, s, n);
    if (sel d.err) { ret ""; }
    ret d.ok;
}

fun pending(e: *commit.Entry) bool {
    ret (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) && e.check_policy != commit.CP_OFF;
}

fun is_pkg_json(rel: str) bool {
    if (rel == nil) { ret false; }
    if (util.eq(rel, "package.json")) { ret true; }
    val n: usize = str_len(rel);
    if (n > 13 && util.eq((rel::usize + n - 13)::*u8, "/package.json")) { ret true; }
    ret false;
}

fun warm_index(lang: str) usize {
    if (util.eq(lang, "python")) { ret 0; }
    if (util.eq(lang, "node")) { ret 1; }
    ret 2;
}

# find the program, install the helper, and build argv and stdin; false when the run was skipped
fun prepare(a: *A.Allocator, keep: *A.Allocator, root: str, set: *commit.Set, tools: *Tools, r: *Run) bool {
    val program: str = tool(keep, tools, r.lang);
    r.argv[0] = program;
    var helper: str = nil;
    val custom_helper: str = from_env(a, "QARK_CHECKER_SCRIPT");
    if (util.eq(r.lang, "python")) {
        if (program == nil) {
            skip_all(set, r, "python was not found; install it or set QARK_PYTHON");
            ret false;
        }
        if (custom_helper != nil) { helper = custom_helper; }
        or {
            val body: res[str, A.Error] = embedded_py(a);
            if (sel body.ok) { helper = script(a, root, "check.py", body.ok); }
        }
    }
    or (util.eq(r.lang, "node")) {
        if (program == nil) {
            skip_all(set, r, "node was not found; install it or set QARK_NODE");
            ret false;
        }
        if (custom_helper != nil) { helper = custom_helper; }
        or {
            if (commit.check_control_dir(a, root) && commit.check_ancestry(a, root, ".qark/checkers/check.js") == nil) {
                val old_js: res[str, A.Error] = pathx.native(a, root, ".qark/checkers/check.js");
                if (sel old_js.ok) { filesystem.remove_file(old_js.ok); }
            }
            val body: res[str, A.Error] = embedded_js(a);
            if (sel body.ok) { helper = script(a, root, "check.cjs", body.ok); }
        }
    }
    or (util.eq(r.lang, "powershell")) {
        if (program == nil) {
            skip_all(set, r, "powershell was not found; set QARK_PWSH");
            ret false;
        }
        if (custom_helper != nil) { helper = custom_helper; }
        or {
            val body: res[str, A.Error] = embedded_ps(a);
            if (sel body.ok) { helper = script(a, root, "check.ps1", body.ok); }
        }
    }
    or {
        if (program == nil) {
            skip_all(set, r, "bash was not found; set QARK_BASH");
            ret false;
        }
    }
    if (r.batch && helper == nil) {
        error_all(a, set, r, "helper_install", "the checker helper could not be installed under .qark/checkers", -1, nil);
        ret false;
    }
    var argc: usize = 1;
    if (util.eq(r.lang, "powershell")) {
        r.argv[1] = "-NoProfile";
        r.argv[2] = "-NonInteractive";
        r.argv[3] = "-ExecutionPolicy";
        r.argv[4] = "Bypass";
        r.argv[5] = "-File";
        r.argv[6] = helper;
        argc = 7;
    }
    or (r.batch) {
        r.argv[1] = helper;
        argc = 2;
    }
    or {
        r.argv[1] = "-n";
        argc = 2;
    }
    r.argc = argc;
    r.argv[argc] = nil;
    if (r.batch) {
        var w: jw.Jw = jw.init(a);
        jw.arr(?w);
        var i: usize = 0;
        for (i < r.items.len) {
            val e: *commit.Entry = commit.entry(set, r.items.data[i]);
            jw.obj(?w);
            jw.f_str(?w, "name", e.rel);
            jw.key(?w, "text");
            jw.str_n(?w, e.data, e.len);
            if (i == 0 && util.eq(r.lang, "node")) {
                jw.f_str(?w, "root", root);
                jw.key(?w, "packages");
                jw.arr(?w);
                var pi: usize = 0;
                for (pi < commit.count(set)) {
                    val pe: *commit.Entry = commit.entry(set, pi);
                    if (is_pkg_json(pe.rel)) {
                        jw.obj(?w);
                        jw.f_str(?w, "name", pe.rel);
                        val del: bool = pe.mode == commit.MODE_DELETE || pe.status == commit.ST_DELETE;
                        jw.f_bool(?w, "deleted", del);
                        if (!del && pe.data != nil) {
                            jw.key(?w, "text");
                            jw.str_n(?w, pe.data, pe.len);
                        }
                        jw.obj_end(?w);
                    }
                    pi = pi + 1;
                }
                jw.arr_end(?w);
            }
            jw.obj_end(?w);
            i = i + 1;
        }
        jw.arr_end(?w);
        if (w.failed) {
            error_all(a, set, r, "oom", "out of memory while preparing a check", -1, nil);
            ret false;
        }
        r.input = w.buf;
        r.input_n = w.len;
    }
    or {
        val e: *commit.Entry = commit.entry(set, r.items.data[0]);
        r.input = e.data;
        r.input_n = e.len;
        if (r.input == nil) { r.input = ""; }
    }
    ret true;
}

fun spawn_once(a: *A.Allocator, set: *commit.Set, r: *Run, timeout_ms: i64) {
    if (r.external) {
        val found: res[str, exec.Error] = exec.resolve(a, r.argv[0]);
        if (sel found.err) {
            fail_all(set, r, "the project checker was not found on PATH");
            ret;
        }
        r.argv[0] = found.ok;
    }
    val started: err[exec.Error] = runner.start(a, ?r.argv[0], r.cwd, r.input, r.input_n, timeout_ms, ?r.job);
    if (sel started.err) {
        if (r.external) { fail_all(set, r, "the project checker could not be started"); }
        or { error_all(a, set, r, "spawn_failed", "the checker could not be started", -1, nil); }
        ret;
    }
    r.started = true;
}

# send the run to this session's warm checker, starting one when needed
fun send_warm(keep: *A.Allocator, tools: *Tools, r: *Run) bool {
    if (from_env(keep, "QARK_CHECKER_SCRIPT") != nil) { ret false; }
    val w: *warm.Warm = ?tools.warm[warm_index(r.lang)];
    warm.reap_if_dead(w);
    if (!w.alive) {
        var argv: [12]*u8;
        var i: usize = 0;
        for (i < r.argc) {
            argv[i] = r.argv[i];
            i = i + 1;
        }
        if (util.eq(r.lang, "powershell")) {
            argv[r.argc] = "-serve";
            argv[r.argc + 1] = "-idle";
            argv[r.argc + 2] = "120";
            argv[r.argc + 3] = nil;
        }
        or {
            argv[r.argc] = "--serve";
            argv[r.argc + 1] = "120";
            argv[r.argc + 2] = nil;
        }
        if (!warm.start(keep, w, ?argv[0])) { ret false; }
    }
    ret warm.send(w, r.input, r.input_n);
}

# stop every warm checker; the session calls this when it closes
pub fun shutdown(tools: *Tools) {
    var i: usize = 0;
    for (i < 3) {
        warm.stop(?tools.warm[i]);
        i = i + 1;
    }
}

fun bash_line(s: str) i64 {
    if (s == nil) { ret 0; }
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] == 'l' && s[i + 1] == 'i' && s[i + 2] == 'n' && s[i + 3] == 'e' && s[i + 4] == ' ') {
            var j: usize = i + 5;
            var v: i64 = 0;
            var any: bool = false;
            for (s[j] >= '0' && s[j] <= '9') {
                v = v * 10 + (s[j] - '0')::i64;
                any = true;
                j = j + 1;
            }
            if (any) { ret v; }
        }
        i = i + 1;
    }
    ret 0;
}

fun parse_colon_loc(s: str, out_line: *i64, out_col: *i64) bool {
    if (s == nil) { ret false; }
    var i: usize = 0;
    for (s[i] != 0) {
        if (s[i] == ':' && s[i + 1] >= '1' && s[i + 1] <= '9') {
            var j: usize = i + 1;
            var ln: i64 = 0;
            for (s[j] >= '0' && s[j] <= '9') {
                ln = ln * 10 + (s[j] - '0')::i64;
                j = j + 1;
            }
            if (s[j] == ':' && s[j + 1] >= '1' && s[j + 1] <= '9') {
                var k: usize = j + 1;
                var col: i64 = 0;
                for (s[k] >= '0' && s[k] <= '9') {
                    col = col * 10 + (s[k] - '0')::i64;
                    k = k + 1;
                }
                @out_line = ln;
                @out_col = col;
                ret true;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun checker_msg(a: *A.Allocator, s: str) str {
    if (s == nil) { ret ""; }
    var n1: usize = 0;
    for (s[n1] != 0 && s[n1] != '\n' && s[n1] != '\r') { n1 = n1 + 1; }
    var i: usize = n1;
    for (s[i] == '\r' || s[i] == '\n' || s[i] == ' ' || s[i] == '\t') { i = i + 1; }
    if (s[i] == '-' && s[i + 1] == '-' && s[i + 2] == '>') {
        var e2: usize = i;
        for (s[e2] != 0 && s[e2] != '\n' && s[e2] != '\r') { e2 = e2 + 1; }
        val n2: usize = e2 - i;
        val buf: res[*u8, A.Error] = A.allocate[u8](a, n1 + n2 + 4);
        if (sel buf.ok) {
            var p: usize = 0;
            for (p < n1) {
                buf.ok[p] = s[p];
                p = p + 1;
            }
            buf.ok[n1] = ' ';
            buf.ok[n1 + 1] = '(';
            var q: usize = 0;
            for (q < n2) {
                buf.ok[n1 + 2 + q] = s[i + q];
                q = q + 1;
            }
            buf.ok[n1 + 2 + n2] = ')';
            buf.ok[n1 + 3 + n2] = 0;
            ret buf.ok;
        }
    }
    ret first_line(a, s);
}

fun finish_run(a: *A.Allocator, set: *commit.Set, r: *Run) {
    val done: res[runner.RunResult, exec.Error] = runner.finish(a, ?r.job);
    if (sel done.err) {
        if (r.external) { fail_all(set, r, "the project checker failed to run"); }
        or { error_all(a, set, r, "run_failed", "the checker failed to run", -1, nil); }
        ret;
    }
    val out: runner.RunResult = done.ok;
    if (out.timed_out) {
        if (r.external) { fail_all(set, r, "the project checker timed out"); }
        or { error_all(a, set, r, "timeout", "the checker timed out", -1, out.stderr); }
        ret;
    }
    if (!r.batch) {
        var code: u8 = commit.CK_OK;
        var line: i64 = 0;
        var col: i64 = 0;
        var msg: str = nil;
        if (out.exit != 0) {
            code = commit.CK_FAILED;
            var diag: str = out.stderr;
            if (diag == nil || diag[0] == 0) { diag = out.stdout; }
            line = bash_line(diag);
            if (line == 0) { parse_colon_loc(diag, ?line, ?col); }
            msg = checker_msg(a, diag);
        }
        var i: usize = 0;
        for (i < r.items.len) {
            val e: *commit.Entry = commit.entry(set, r.items.data[i]);
            if (code == commit.CK_FAILED || (e.check != commit.CK_FAILED && e.check != commit.CK_ERROR)) {
                e.check = code;
                if (code == commit.CK_FAILED) {
                    if (r.external) { e.ck_cat = "project_check"; }
                    or { e.ck_cat = "syntax_error"; }
                }
                e.ck_line = line;
                e.ck_col = col;
                e.ck_msg = msg;
            }
            i = i + 1;
        }
        ret;
    }
    var diag_raw: str = out.stderr;
    if (diag_raw == nil || diag_raw[0] == 0) { diag_raw = out.stdout; }
    if (out.exit != 0) {
        var cmsg: str = first_line(a, out.stderr);
        if (cmsg == nil || cmsg[0] == 0) { cmsg = "the checker exited with a non-zero status"; }
        error_all(a, set, r, "crash", cmsg, out.exit, diag_raw);
        ret;
    }
    if (out.stdout == nil || out.stdout[0] == 0) {
        var emsg: str = first_line(a, out.stderr);
        if (emsg == nil || emsg[0] == 0) { emsg = "the checker produced no output"; }
        error_all(a, set, r, "empty_output", emsg, out.exit, diag_raw);
        ret;
    }
    var bad_cat: str = nil;
    var bad_why: str = nil;
    if (!assign_batch(a, set, r, out.stdout, str_len(out.stdout), ?bad_cat, ?bad_why)) {
        error_all(a, set, r, bad_cat, bad_why, out.exit, diag_raw);
    }
}

# put a checker's json answer onto the run's entries; false when it does not fit the run
fun assign(a: *A.Allocator, set: *commit.Set, r: *Run, text: *u8, n: usize) bool {
    var cat: str = nil;
    var why: str = nil;
    ret assign_batch(a, set, r, text, n, ?cat, ?why);
}

fun assign_batch(a: *A.Allocator, set: *commit.Set, r: *Run, text: *u8, n: usize, out_cat: *str, out_why: *str) bool {
    val parsed: res[json.Value, json.JsonError] = json.parse(text, n, a);
    if (sel parsed.err) {
        @out_cat = "malformed_output";
        @out_why = "the checker's output was not understood";
        ret false;
    }
    var doc: json.Value = parsed.ok;
    if (!json.value_is_array(?doc)) {
        @out_cat = "malformed_output";
        @out_why = "the checker's output was not a json array";
        ret false;
    }
    if (json.value_count(?doc) != r.items.len) {
        @out_cat = "count_mismatch";
        @out_why = "the checker returned the wrong number of results";
        ret false;
    }
    var v: usize = 0;
    for (v < r.items.len) {
        val gv: opt[*json.Value] = json.value_get(?doc, v);
        var item_valid: bool = false;
        if (sel gv.some) {
            if (json.value_is_object(gv.some)) {
                val okv: opt[*json.Value] = json.value_find(gv.some, "ok");
                if (sel okv.some) {
                    if (json.value_is_bool(okv.some)) { item_valid = true; }
                }
            }
        }
        if (!item_valid) {
            @out_cat = "malformed_output";
            @out_why = "the checker returned a malformed result item";
            ret false;
        }
        v = v + 1;
    }
    var i: usize = 0;
    for (i < r.items.len) {
        val e: *commit.Entry = commit.entry(set, r.items.data[i]);
        val g: opt[*json.Value] = json.value_get(?doc, i);
        if (sel g.some) {
            val okf: opt[*json.Value] = json.value_find(g.some, "ok");
            var ok: bool = false;
            if (sel okf.some) {
                if (json.value_is_bool(okf.some)) { ok = json.value_bool(okf.some); }
            }
            if (ok) {
                if (e.check != commit.CK_FAILED && e.check != commit.CK_ERROR) {
                    e.check = commit.CK_OK;
                }
            }
            or {
                e.check = commit.CK_FAILED;
                e.ck_cat = "syntax_error";
                val lf: opt[*json.Value] = json.value_find(g.some, "line");
                if (sel lf.some) {
                    if (json.value_is_number(lf.some)) { e.ck_line = json.value_number(lf.some); }
                }
                val cf: opt[*json.Value] = json.value_find(g.some, "col");
                if (sel cf.some) {
                    if (json.value_is_number(cf.some)) { e.ck_col = json.value_number(cf.some); }
                }
                e.ck_msg = "syntax error";
                val mf: opt[*json.Value] = json.value_find(g.some, "msg");
                if (sel mf.some) {
                    if (json.value_is_string(mf.some)) {
                        var raw_n: usize = 0;
                        json.value_string(mf.some, ?raw_n);
                        val buf: res[*u8, A.Error] = A.allocate[u8](a, raw_n + 1);
                        if (sel buf.ok) {
                            val dec: res[usize, json.JsonError] = json.value_string_decode(mf.some, buf.ok, raw_n + 1);
                            if (sel dec.ok) {
                                if (dec.ok <= raw_n) {
                                    buf.ok[dec.ok] = 0;
                                    e.ck_msg = buf.ok;
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    ret true;
}

fun same_cmd(r: *Run, argv: **u8, argc: usize) bool {
    if (!r.stage || r.argc != argc) { ret false; }
    var i: usize = 0;
    for (i < argc) {
        if (!util.eq(r.argv[i], argv[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun make_temp_dir(a: *A.Allocator, prefix: str) str {
    val tf: res[filesystem.TempFile, filesystem.FsError] = filesystem.temp_create(a, prefix);
    if (sel tf.err) { ret nil; }
    var tmp: filesystem.TempFile = tf.ok;
    var w: jw.Jw = jw.init(a);
    jw.raw(?w, tmp.path);
    jw.raw(?w, ".d");
    val dir_path: str = jw.text(?w);
    if (w.failed || dir_path == nil) {
        filesystem.temp_close_and_remove(?tmp);
        ret nil;
    }
    val mk: err[io_error.Error] = filesystem.create_dir(dir_path, 448);
    filesystem.temp_close_and_remove(?tmp);
    if (sel mk.err) { ret nil; }
    ret dir_path;
}

fun skip_stage_dir(name: str) bool {
    if (name == nil || name[0] == 0) { ret true; }
    ret util.eq(name, ".qark");
}

fun say_stage_err(a: *A.Allocator, prefix: str, rel: str) str {
    var w: jw.Jw = jw.init(a);
    jw.raw(?w, prefix);
    if (rel != nil) { jw.raw(?w, rel); }
    if (w.failed || w.buf == nil) { ret prefix; }
    ret jw.text(?w);
}

fun verify_staged_candidates(a: *A.Allocator, stage_dir: str, set: *commit.Set, idx: *vector.Vector[usize]) bool {
    if (stage_dir == nil || set == nil) { ret true; }
    var ok_all: bool = true;
    var count: usize = commit.count(set);
    if (idx != nil) { count = idx.len; }
    var k: usize = 0;
    for (k < count) {
        var ei: usize = k;
        if (idx != nil) { ei = idx.data[k]; }
        val e: *commit.Entry = commit.entry(set, ei);
        if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
            val dst: res[str, A.Error] = pathx.native(a, stage_dir, e.rel);
            var mutated: bool = false;
            if (sel dst.ok) {
                val got: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, dst.ok);
                if (sel got.ok) {
                    var got_sha: [65]u8;
                    commit.hash_hex(got.ok.data, got.ok.len, ?got_sha[0]);
                    if (!util.eq(?got_sha[0], ?e.sha[0])) { mutated = true; }
                }
                or { mutated = true; }
            }
            or { mutated = true; }
            if (mutated) {
                e.check = commit.CK_ERROR;
                e.ck_cat = "stage_mutated";
                e.ck_msg = "validator modified or deleted the staged candidate file during validation";
                ok_all = false;
            }
        }
        or (e.status == commit.ST_DELETE) {
            val dst: res[str, A.Error] = pathx.native(a, stage_dir, e.rel);
            if (sel dst.ok) {
                val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(dst.ok);
                if (sel m.ok) {
                    e.check = commit.CK_ERROR;
                    e.ck_cat = "stage_mutated";
                    e.ck_msg = "validator recreated a staged deleted file during validation";
                    ok_all = false;
                }
            }
        }
        k = k + 1;
    }
    ret ok_all;
}

fun copy_workspace_dir(a: *A.Allocator, src_root: str, dst_root: str, dir_rel: str, depth: i64, files_seen: *i64, bytes_seen: *usize, out_err: *str) bool {
    if (depth > 32) {
        if (out_err != nil && @out_err == nil) { @out_err = "workspace directory tree exceeds maximum staging depth (32 levels)"; }
        ret false;
    }
    var src_full: str = src_root;
    if (dir_rel != nil && dir_rel[0] != 0) {
        val j: res[str, A.Error] = pathx.native(a, src_root, dir_rel);
        if (sel j.err) { ret false; }
        src_full = j.ok;
    }
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(a, src_full);
    if (sel names.err) {
        if (out_err != nil && @out_err == nil) { @out_err = say_stage_err(a, "could not read workspace directory while staging: ", dir_rel); }
        ret false;
    }
    var i: usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (!skip_stage_dir(name)) {
            var rel: str = name;
            if (dir_rel != nil && dir_rel[0] != 0) {
                val jn: res[str, A.Error] = pathx.join(a, dir_rel, name);
                if (sel jn.err) { ret false; }
                rel = jn.ok;
            }
            val child: res[str, A.Error] = pathx.native(a, src_root, rel);
            if (sel child.err) { ret false; }
            val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(child.ok);
            if (sel m.err) {
                if (out_err != nil && @out_err == nil) { @out_err = say_stage_err(a, "could not inspect workspace path while staging: ", rel); }
                ret false;
            }
            if (m.ok.kind == filesystem.KIND_DIR) {
                val dst_dir: res[str, A.Error] = pathx.native(a, dst_root, rel);
                if (sel dst_dir.err) { ret false; }
                val mkd: err[filesystem.FsError] = filesystem.create_dir_all(a, dst_dir.ok, 493);
                if (sel mkd.err) { ret false; }
                if (!copy_workspace_dir(a, src_root, dst_root, rel, depth + 1, files_seen, bytes_seen, out_err)) { ret false; }
            }
            or (m.ok.kind == filesystem.KIND_FILE) {
                @files_seen = @files_seen + 1;
                if (@files_seen > 16384) {
                    if (out_err != nil && @out_err == nil) { @out_err = "workspace exceeds maximum staged file count (16384 files)"; }
                    ret false;
                }
                if (m.ok.size > 33554432) {
                    if (out_err != nil && @out_err == nil) { @out_err = say_stage_err(a, "workspace file exceeds 32 MiB staging limit: ", rel); }
                    ret false;
                }
                if (@bytes_seen + m.ok.size > 268435456) {
                    if (out_err != nil && @out_err == nil) { @out_err = "workspace exceeds 256 MiB total staging budget"; }
                    ret false;
                }
                @bytes_seen = @bytes_seen + m.ok.size;
                val dst_file: res[str, A.Error] = pathx.native(a, dst_root, rel);
                if (sel dst_file.err) { ret false; }
                val pr: res[str, A.Error] = path.parent(a, dst_file.ok);
                if (sel pr.err) { ret false; }
                val mkp: err[filesystem.FsError] = filesystem.create_dir_all(a, pr.ok, 493);
                if (sel mkp.err) { ret false; }
                val got: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, child.ok);
                if (sel got.err) {
                    if (out_err != nil && @out_err == nil) { @out_err = say_stage_err(a, "could not read workspace file while staging: ", rel); }
                    ret false;
                }
                var datap: *u8 = got.ok.data;
                if (datap == nil) { datap = ""; }
                var perm: i32 = (m.ok.mode & 511)::i32;
                if (perm == 0) { perm = 420; }
                val wr: err[filesystem.FsError] = filesystem.write_bytes(dst_file.ok, datap, got.ok.len, perm);
                if (sel wr.err) { ret false; }
            }
            or {
                if (out_err != nil && @out_err == nil) { @out_err = say_stage_err(a, "workspace contains a symbolic link or special file that cannot be staged: ", rel); }
                ret false;
            }
        }
        i = i + 1;
    }
    ret true;
}

# build an isolated disposable staging tree with the workspace + candidate changes
fun make_stage_tree(a: *A.Allocator, root: str, set: *commit.Set, out_err: *str) str {
    if (out_err != nil) { @out_err = nil; }
    val stage_dir: str = make_temp_dir(a, "qark_stage");
    if (stage_dir == nil) {
        if (out_err != nil) { @out_err = "could not create temporary staging directory"; }
        ret nil;
    }
    var files_seen: i64 = 0;
    var bytes_seen: usize = 0;
    if (!copy_workspace_dir(a, root, stage_dir, "", 0, ?files_seen, ?bytes_seen, out_err)) {
        filesystem.remove_all(a, stage_dir);
        ret nil;
    }
    if (set != nil) {
        var i: usize = 0;
        for (i < commit.count(set)) {
            val e: *commit.Entry = commit.entry(set, i);
            if (e.status == commit.ST_CREATE || e.status == commit.ST_REPLACE) {
                val dst: res[str, A.Error] = pathx.native(a, stage_dir, e.rel);
                if (sel dst.err) {
                    filesystem.remove_all(a, stage_dir);
                    ret nil;
                }
                val pr: res[str, A.Error] = path.parent(a, dst.ok);
                if (sel pr.err) {
                    filesystem.remove_all(a, stage_dir);
                    ret nil;
                }
                val mkp: err[filesystem.FsError] = filesystem.create_dir_all(a, pr.ok, 493);
                if (sel mkp.err) {
                    filesystem.remove_all(a, stage_dir);
                    ret nil;
                }
                if (e.status == commit.ST_REPLACE) {
                    filesystem.remove_file(dst.ok);
                }
                var cperm: i32 = 420;
                if (e.has_target_perm || e.target_perm != 0) {
                    cperm = (e.target_perm & 511)::i32;
                }
                or (e.exec) {
                    if (e.existed && e.has_old_perm) {
                        cperm = ((e.old_perm | 73) & 511)::i32;
                    }
                    or {
                        cperm = 493;
                    }
                }
                or (e.existed && (e.has_old_perm || (e.old_perm & 511) != 0)) {
                    cperm = (e.old_perm & 511)::i32;
                }
                var datap: *u8 = e.data;
                if (datap == nil) { datap = ""; }
                val wr: err[filesystem.FsError] = filesystem.write_bytes(dst.ok, datap, e.len, cperm);
                if (sel wr.err) {
                    filesystem.remove_all(a, stage_dir);
                    ret nil;
                }
            }
            or (e.status == commit.ST_DELETE) {
                val dst: res[str, A.Error] = pathx.native(a, stage_dir, e.rel);
                if (sel dst.err) {
                    filesystem.remove_all(a, stage_dir);
                    ret nil;
                }
                val rm: err[io_error.Error] = filesystem.remove_file(dst.ok);
                if (sel rm.err) {
                    if (rm.err.kind != io_error.NOT_FOUND) {
                        filesystem.remove_all(a, stage_dir);
                        ret nil;
                    }
                }
            }
            i = i + 1;
        }
    }
    ret stage_dir;
}

# 0 absent, 1 loaded into @out_doc, -1 invalid/unreadable (@out_err set)
fun read_checks_config(a: *A.Allocator, root: str, set: *commit.Set, out_doc: *json.Value, out_err: *str) i64 {
    @out_err = nil;
    var src: *u8 = nil;
    var n: usize = 0;
    var have_src: bool = false;
    if (set != nil) {
        var si: usize = 0;
        for (si < commit.count(set)) {
            val se: *commit.Entry = commit.entry(set, si);
            if (util.eq(se.rel, ".qark/checks.json")) {
                if (se.status == commit.ST_DELETE) { ret 0; }
                if (se.status == commit.ST_CREATE || se.status == commit.ST_REPLACE) {
                    src = se.data;
                    n = se.len;
                    have_src = true;
                }
            }
            si = si + 1;
        }
    }
    if (!have_src) {
        val cfg_rel: res[str, A.Error] = pathx.native(a, root, ".qark/checks.json");
        if (sel cfg_rel.err) {
            @out_err = ".qark/checks.json path could not be resolved";
            ret -1;
        }
        val m: res[filesystem.Metadata, io_error.Error] = filesystem.metadata_link(cfg_rel.ok);
        if (sel m.err) {
            if (m.err.kind == io_error.NOT_FOUND || m.err.kind == io_error.NOT_DIRECTORY) { ret 0; }
            @out_err = ".qark/checks.json could not be inspected";
            ret -1;
        }
        if (m.ok.kind != filesystem.KIND_FILE) {
            @out_err = ".qark/checks.json must be a regular file";
            ret -1;
        }
        val text: res[str, filesystem.FsError] = filesystem.read_string(a, cfg_rel.ok);
        if (sel text.err) {
            @out_err = ".qark/checks.json could not be read";
            ret -1;
        }
        src = text.ok;
        n = str_len(src);
    }
    if (src == nil) { src = ""; }
    if (n >= 3 && src[0] == 239 && src[1] == 187 && src[2] == 191) {
        src = (src::usize + 3)::*u8;
        n = n - 3;
    }
    val parsed: res[json.Value, json.JsonError] = json.parse(src, n, a);
    if (sel parsed.err) {
        @out_err = ".qark/checks.json is not valid json";
        ret -1;
    }
    var doc: json.Value = parsed.ok;
    if (!json.value_is_object(?doc)) {
        @out_err = ".qark/checks.json root must be a json object";
        ret -1;
    }
    @out_doc = doc;
    ret 1;
}

# .qark/checks.json maps an extension to a command. {file} is one file's new
# bytes under an isolated preview dir. {root} is an isolated staged workspace
# tree so a project checker sees the edit without mutating the live workspace.
fun queue_project_checks(a: *A.Allocator, root: str, stage_root: str, set: *commit.Set, runs: *vector.Vector[Run], want_root: bool, no_custom_exec: bool) {
    var doc: json.Value;
    var cfg_err: str = nil;
    val cfg_st: i64 = read_checks_config(a, root, set, ?doc, ?cfg_err);
    if (cfg_st < 0) {
        if (!want_root) {
            var ci: usize = 0;
            for (ci < commit.count(set)) {
                val ce: *commit.Entry = commit.entry(set, ci);
                if (pending(ce)) {
                    ce.custom_check = true;
                    ce.check = commit.CK_ERROR;
                    ce.ck_cat = "config_error";
                    ce.ck_msg = cfg_err;
                }
                ci = ci + 1;
            }
        }
        ret;
    }
    if (cfg_st == 0) { ret; }
    var eff_root: str = stage_root;
    if (eff_root == nil) { eff_root = root; }
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (pending(e)) {
            val ext: str = path.extension(e.rel);
            var spec: opt[*json.Value] = json.value_find(?doc, ext);
            if (!sel spec.some && no_custom_exec) {
                spec = json.value_find(?doc, "project");
                if (!sel spec.some) { spec = json.value_find(?doc, "*"); }
            }
            if (sel spec.some) {
                e.custom_check = true;
                if (e.lang == nil) { e.lang = ext; }
                if (no_custom_exec) {
                    if (!want_root) {
                        e.check = commit.CK_ERROR;
                        e.ck_cat = "exec_forbidden";
                        e.ck_msg = "custom checker execution in .qark/checks.json is disabled by --no-custom-exec";
                    }
                }
                or (json.value_is_array(spec.some) && json.value_count(spec.some) > 0 && json.value_count(spec.some) < 10) {
                    var argv: [12]*u8;
                    var argc: usize = 0;
                    var is_root: bool = false;
                    var has_file: bool = false;
                    var bad: bool = false;
                    var w: usize = 0;
                    val words: usize = json.value_count(spec.some);
                    for (w < words && !bad && argc < 12) {
                        val g: opt[*json.Value] = json.value_get(spec.some, w);
                        if (sel g.some) {
                            if (json.value_is_string(g.some)) {
                                var raw_n: usize = 0;
                                json.value_string(g.some, ?raw_n);
                                val buf: res[*u8, A.Error] = A.allocate[u8](a, raw_n + 1);
                                if (sel buf.ok) {
                                    val dec: res[usize, json.JsonError] = json.value_string_decode(g.some, buf.ok, raw_n + 1);
                                    if (sel dec.ok) {
                                        val n: usize = dec.ok;
                                        if (n <= raw_n && (n > 0 || argc > 0)) {
                                            buf.ok[n] = 0;
                                            if (util.eq(buf.ok, "{root}")) {
                                                is_root = true;
                                                argv[argc] = eff_root;
                                            }
                                            or (util.eq(buf.ok, "{file}")) {
                                                has_file = true;
                                                argv[argc] = nil;
                                            }
                                            or { argv[argc] = buf.ok; }
                                            argc = argc + 1;
                                        }
                                        or { bad = true; }
                                    }
                                    or { bad = true; }
                                }
                                or { bad = true; }
                            }
                            or { bad = true; }
                        }
                        or { bad = true; }
                        w = w + 1;
                    }
                    if (bad || argc == 0) {
                        if (!want_root) {
                            e.check = commit.CK_ERROR;
                            e.ck_cat = "config_error";
                            e.ck_msg = "invalid checker command arguments in .qark/checks.json";
                        }
                    }
                    or (is_root == want_root) {
                        if (is_root) {
                            var stage_file_ok: bool = true;
                            if (has_file) {
                                val sf_full: res[str, A.Error] = pathx.native(a, eff_root, e.rel);
                                if (sel sf_full.ok) {
                                    var sc: usize = 0;
                                    for (sc < argc) {
                                        if (argv[sc] == nil) { argv[sc] = sf_full.ok; }
                                        sc = sc + 1;
                                    }
                                }
                                or { stage_file_ok = false; }
                            }
                            if (!stage_file_ok) {
                                e.check = commit.CK_ERROR;
                                e.ck_cat = "stage_error";
                                e.ck_msg = "the project checker could not resolve the staged file path";
                            }
                            or {
                                var found: i64 = -1;
                                var k: usize = 0;
                                for (k < runs.len) {
                                    if (same_cmd(?runs.data[k], ?argv[0], argc)) { found = k::i64; }
                                    k = k + 1;
                                }
                                if (found >= 0) {
                                    vector.push[usize](?runs.data[found::usize].items, i);
                                }
                                or {
                                    var r: Run;
                                    r.lang = ext;
                                    r.external = true;
                                    r.stage = true;
                                    r.cwd = eff_root;
                                    r.argc = argc;
                                    var c: usize = 0;
                                    for (c < argc) {
                                        r.argv[c] = argv[c];
                                        c = c + 1;
                                    }
                                    r.argv[argc] = nil;
                                    r.items = vector.init[usize](a);
                                    vector.push[usize](?r.items, i);
                                    vector.push[Run](runs, r);
                                }
                            }
                        }
                        or {
                            var queued_prev: bool = false;
                            val pdir: str = make_temp_dir(a, "qark_prev");
                            if (pdir != nil) {
                                val full: res[str, A.Error] = pathx.native(a, pdir, e.rel);
                                if (sel full.ok) {
                                    val parent: res[str, A.Error] = path.parent(a, full.ok);
                                    if (sel parent.ok) { filesystem.create_dir_all(a, parent.ok, 448); }
                                    var datap: *u8 = e.data;
                                    if (datap == nil) { datap = ""; }
                                    val wr: err[filesystem.FsError] = filesystem.write_bytes(full.ok, datap, e.len, 384);
                                    if (sel wr.ok) {
                                        var c: usize = 0;
                                        for (c < argc) {
                                            if (argv[c] == nil) { argv[c] = full.ok; }
                                            c = c + 1;
                                        }
                                        if (!has_file && argc < 11) {
                                            argv[argc] = full.ok;
                                            argc = argc + 1;
                                        }
                                        var r: Run;
                                        r.lang = ext;
                                        r.external = true;
                                        r.cwd = root;
                                        r.preview = pdir;
                                        r.argc = argc;
                                        c = 0;
                                        for (c < argc) {
                                            r.argv[c] = argv[c];
                                            c = c + 1;
                                        }
                                        r.argv[argc] = nil;
                                        r.items = vector.init[usize](a);
                                        vector.push[usize](?r.items, i);
                                        vector.push[Run](runs, r);
                                        queued_prev = true;
                                    }
                                    or { filesystem.remove_all(a, pdir); }
                                }
                                or { filesystem.remove_all(a, pdir); }
                            }
                            if (!queued_prev) {
                                e.check = commit.CK_ERROR;
                                e.ck_cat = "stage_error";
                                e.ck_msg = "the custom checker could not stage the preview file";
                            }
                        }
                    }
                }
                or {
                    if (!want_root) {
                        e.check = commit.CK_ERROR;
                        e.ck_cat = "config_error";
                        e.ck_msg = "checker command in .qark/checks.json must be an array of 1..9 strings";
                    }
                }
            }
        }
        i = i + 1;
    }
}

# check every entry that would be written; results land on the entries
# ---
# a:    request allocator for inputs and outputs
# keep: long-lived allocator for the program paths remembered in tools
pub fun run(a: *A.Allocator, keep: *A.Allocator, root: str, set: *commit.Set, tools: *Tools, timeout_ms: i64) {
    var runs: vector.Vector[Run] = vector.init[Run](a);
    val langs: [3]str = [3]str{"python", "node", "powershell"};
    var li: usize = 0;
    for (li < 3) {
        var r: Run;
        r.lang = langs[li];
        r.batch = true;
        r.items = vector.init[usize](a);
        var i: usize = 0;
        for (i < commit.count(set)) {
            val e: *commit.Entry = commit.entry(set, i);
            if (pending(e) && util.eq(e.lang, r.lang)) { vector.push[usize](?r.items, i); }
            i = i + 1;
        }
        if (r.items.len > 0) { vector.push[Run](?runs, r); }
        li = li + 1;
    }
    var i: usize = 0;
    for (i < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, i);
        if (pending(e)) {
            if (util.eq(e.lang, "json")) { native_json(a, e); }
            or (util.eq(e.lang, "toml")) { native_toml(a, e); }
            or (util.eq(e.lang, "bash")) {
                var r: Run;
                r.lang = "bash";
                r.batch = false;
                r.items = vector.init[usize](a);
                vector.push[usize](?r.items, i);
                vector.push[Run](?runs, r);
            }
        }
        i = i + 1;
    }
    queue_project_checks(a, root, nil, set, ?runs, false, tools.no_custom_exec);
    var k: usize = 0;
    for (k < runs.len) {
        val r: *Run = ?runs.data[k];
        if (r.external) { spawn_once(a, set, r, timeout_ms); }
        or {
            if (prepare(a, keep, root, set, tools, r)) {
                if (r.batch && send_warm(keep, tools, r)) { r.warm = true; }
                or { spawn_once(a, set, r, timeout_ms); }
            }
        }
        k = k + 1;
    }
    k = 0;
    for (k < runs.len) {
        val r: *Run = ?runs.data[k];
        if (r.warm) {
            var line: *u8 = nil;
            var n: usize = 0;
            val w: *warm.Warm = ?tools.warm[warm_index(r.lang)];
            var done: bool = false;
            if (warm.receive(w, timeout_ms, a, ?line, ?n)) { done = assign(a, set, r, line, n); }
            if (!done) {
                warm.stop(w);
                spawn_once(a, set, r, timeout_ms);
            }
        }
        if (r.started) { finish_run(a, set, r); }
        if (r.preview != nil) {
            verify_staged_candidates(a, r.preview, set, ?r.items);
            filesystem.remove_all(a, r.preview);
        }
        k = k + 1;
    }
}

pub fun has_staged(a: *A.Allocator, root: str, set: *commit.Set) bool {
    if (!commit.dirty(set)) { ret false; }
    var doc: json.Value;
    var cfg_err: str = nil;
    val st: i64 = read_checks_config(a, root, set, ?doc, ?cfg_err);
    ret st != 0;
}

# project checkers whose command names {root}. candidate changes are validated
# in an isolated staging tree so the live workspace is never mutated before commit.
pub fun run_staged(a: *A.Allocator, root: str, set: *commit.Set, timeout_ms: i64) {
    var probe_runs: vector.Vector[Run] = vector.init[Run](a);
    queue_project_checks(a, root, root, set, ?probe_runs, true, false);
    if (probe_runs.len == 0) { ret; }
    var stage_err: str = nil;
    val stage_dir: str = make_stage_tree(a, root, set, ?stage_err);
    if (stage_dir == nil) {
        if (stage_err == nil) { stage_err = "the project checker could not stage the workspace files"; }
        var f: usize = 0;
        for (f < probe_runs.len) {
            error_all(a, set, ?probe_runs.data[f], "stage_error", stage_err, -1, nil);
            f = f + 1;
        }
        ret;
    }
    var runs: vector.Vector[Run] = vector.init[Run](a);
    queue_project_checks(a, root, stage_dir, set, ?runs, true, false);
    var k: usize = 0;
    for (k < runs.len) {
        val r: *Run = ?runs.data[k];
        spawn_once(a, set, r, timeout_ms);
        k = k + 1;
    }
    k = 0;
    for (k < runs.len) {
        val r: *Run = ?runs.data[k];
        if (r.started) { finish_run(a, set, r); }
        k = k + 1;
    }
    verify_staged_candidates(a, stage_dir, set, nil);
    filesystem.remove_all(a, stage_dir);
}

pub fun check_name(ck: u8) str {
    if (ck == commit.CK_OK) { ret "ok"; }
    if (ck == commit.CK_FAILED) { ret "failed"; }
    if (ck == commit.CK_ERROR) { ret "error"; }
    if (ck == commit.CK_SKIPPED) { ret "skipped"; }
    ret "none";
}

fun mark_project_failed(set: *commit.Set, msg: str, ln: i64, col: i64, is_infra: bool) {
    if (set == nil) { ret; }
    var ci: usize = 0;
    for (ci < commit.count(set)) {
        val e: *commit.Entry = commit.entry(set, ci);
        if (pending(e)) {
            if (is_infra) {
                e.check = commit.CK_ERROR;
                e.ck_cat = "project_check_error";
            }
            or {
                e.check = commit.CK_FAILED;
                e.ck_cat = "project_check";
            }
            e.ck_msg = msg;
            if (ln > 0) { e.ck_line = ln; }
            if (col > 0) { e.ck_col = col; }
        }
        ci = ci + 1;
    }
}

# run a project-wide validation command against an isolated staged workspace before commit
pub fun run_project_validation(a: *A.Allocator, root: str, set: *commit.Set, val_spec: *json.Value, timeout_ms: i64, ran: *bool, out_msg: *str) bool {
    @ran = false;
    @out_msg = nil;
    if (val_spec != nil && json.value_is_bool(val_spec) && !json.value_bool(val_spec)) {
        ret true;
    }
    if (val_spec == nil && set != nil && !commit.dirty(set)) {
        ret true;
    }
    var cmd_arr: *json.Value = nil;
    var eff_timeout: i64 = timeout_ms;
    var doc: json.Value;
    if (val_spec != nil && json.value_is_array(val_spec)) {
        cmd_arr = val_spec;
    }
    or (val_spec != nil && json.value_is_object(val_spec)) {
        val cf: opt[*json.Value] = json.value_find(val_spec, "cmd");
        if (sel cf.some) {
            if (json.value_is_array(cf.some)) { cmd_arr = cf.some; }
        }
        val tf: opt[*json.Value] = json.value_find(val_spec, "timeout_ms");
        if (sel tf.some) {
            if (json.value_is_number(tf.some)) {
                val tv: i64 = json.value_number(tf.some);
                if (tv > 0) { eff_timeout = tv; }
            }
        }
        if (cmd_arr == nil) {
            @ran = true;
            @out_msg = "validate object must provide a non-empty cmd string array";
            mark_project_failed(set, @out_msg, 0, 0, true);
            ret false;
        }
    }
    or (val_spec == nil || (json.value_is_bool(val_spec) && json.value_bool(val_spec))) {
        var cfg_err: str = nil;
        val cfg_st: i64 = read_checks_config(a, root, set, ?doc, ?cfg_err);
        if (cfg_st < 0) {
            @ran = true;
            @out_msg = cfg_err;
            mark_project_failed(set, @out_msg, 0, 0, true);
            ret false;
        }
        if (cfg_st > 0) {
            val pf: opt[*json.Value] = json.value_find(?doc, "project");
            if (sel pf.some) {
                if (json.value_is_array(pf.some)) { cmd_arr = pf.some; }
                or (json.value_is_object(pf.some)) {
                    val pcf: opt[*json.Value] = json.value_find(pf.some, "cmd");
                    if (sel pcf.some) {
                        if (json.value_is_array(pcf.some)) { cmd_arr = pcf.some; }
                    }
                    val ptf: opt[*json.Value] = json.value_find(pf.some, "timeout_ms");
                    if (sel ptf.some) {
                        if (json.value_is_number(ptf.some) && json.value_number(ptf.some) > 0) {
                            eff_timeout = json.value_number(ptf.some);
                        }
                    }
                }
                if (cmd_arr == nil) {
                    @ran = true;
                    @out_msg = "project validator in .qark/checks.json must be a command array or object with cmd";
                    mark_project_failed(set, @out_msg, 0, 0, true);
                    ret false;
                }
            }
            if (cmd_arr == nil) {
                val sf: opt[*json.Value] = json.value_find(?doc, "*");
                if (sel sf.some) {
                    if (json.value_is_array(sf.some)) { cmd_arr = sf.some; }
                    or (json.value_is_object(sf.some)) {
                        val scf: opt[*json.Value] = json.value_find(sf.some, "cmd");
                        if (sel scf.some) {
                            if (json.value_is_array(scf.some)) { cmd_arr = scf.some; }
                        }
                        val stf: opt[*json.Value] = json.value_find(sf.some, "timeout_ms");
                        if (sel stf.some) {
                            if (json.value_is_number(stf.some) && json.value_number(stf.some) > 0) {
                                eff_timeout = json.value_number(stf.some);
                            }
                        }
                    }
                    if (cmd_arr == nil) {
                        @ran = true;
                        @out_msg = "wildcard validator in .qark/checks.json must be a command array or object with cmd";
                        mark_project_failed(set, @out_msg, 0, 0, true);
                        ret false;
                    }
                }
            }
        }
        if (cmd_arr == nil) {
            if (val_spec == nil) {
                ret true;
            }
            @ran = true;
            @out_msg = "validate:true requested, but no project validator is configured in .qark/checks.json";
            mark_project_failed(set, @out_msg, 0, 0, true);
            ret false;
        }
    }
    or {
        @ran = true;
        @out_msg = "validate must be a boolean, a command array, or an object with cmd";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    val words: usize = json.value_count(cmd_arr);
    if (words == 0 || words >= 11) {
        @ran = true;
        @out_msg = "project validator command must have between 1 and 10 arguments";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    var stage_err: str = nil;
    val stage_dir: str = make_stage_tree(a, root, set, ?stage_err);
    if (stage_dir == nil) {
        @ran = true;
        if (stage_err != nil) { @out_msg = stage_err; }
        or { @out_msg = "project validator could not stage workspace files"; }
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    var argv: [12]*u8;
    var argc: usize = 0;
    var w: usize = 0;
    var bad_arg: bool = false;
    for (w < words && argc < 11) {
        val g: opt[*json.Value] = json.value_get(cmd_arr, w);
        var arg_ok: bool = false;
        if (sel g.some) {
            if (json.value_is_string(g.some)) {
                var raw_n: usize = 0;
                json.value_string(g.some, ?raw_n);
                val buf: res[*u8, A.Error] = A.allocate[u8](a, raw_n + 1);
                if (sel buf.ok) {
                    val dec: res[usize, json.JsonError] = json.value_string_decode(g.some, buf.ok, raw_n + 1);
                    if (sel dec.ok) {
                        buf.ok[dec.ok] = 0;
                        if (buf.ok[0] != 0 || argc > 0) {
                            if (util.eq(buf.ok, "{root}")) { argv[argc] = stage_dir; }
                            or { argv[argc] = buf.ok; }
                            argc = argc + 1;
                            arg_ok = true;
                        }
                    }
                }
            }
        }
        if (!arg_ok) { bad_arg = true; }
        w = w + 1;
    }
    if (bad_arg || argc == 0 || argc != words) {
        filesystem.remove_all(a, stage_dir);
        @ran = true;
        @out_msg = "project validator command arguments must be non-empty strings";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    argv[argc] = nil;
    val found: res[str, exec.Error] = exec.resolve(a, argv[0]);
    if (sel found.err) {
        filesystem.remove_all(a, stage_dir);
        @ran = true;
        @out_msg = "project validator program was not found on PATH";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    argv[0] = found.ok;
    @ran = true;
    var job: runner.Job;
    val started: err[exec.Error] = runner.start(a, ?argv[0], stage_dir, nil, 0, eff_timeout, ?job);
    if (sel started.err) {
        filesystem.remove_all(a, stage_dir);
        @out_msg = "project validator could not be started";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    val done: res[runner.RunResult, exec.Error] = runner.finish(a, ?job);
    val candidates_intact: bool = verify_staged_candidates(a, stage_dir, set, nil);
    filesystem.remove_all(a, stage_dir);
    if (sel done.err) {
        @out_msg = "project validator failed to run";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    val out: runner.RunResult = done.ok;
    if (out.timed_out) {
        @out_msg = "project validator timed out";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    if (out.exit != 0) {
        var diag: str = out.stderr;
        if (diag == nil || diag[0] == 0) { diag = out.stdout; }
        @out_msg = checker_msg(a, diag);
        if (@out_msg == nil || @out_msg[0] == 0) { @out_msg = "project validation failed"; }
        var ln: i64 = 0;
        var col: i64 = 0;
        parse_colon_loc(diag, ?ln, ?col);
        mark_project_failed(set, @out_msg, ln, col, false);
        ret false;
    }
    if (!candidates_intact) {
        @out_msg = "project validator modified a staged candidate file during validation";
        mark_project_failed(set, @out_msg, 0, 0, true);
        ret false;
    }
    @out_msg = "ok";
    ret true;
}
